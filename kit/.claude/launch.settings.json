{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "typesafe@typesafe-ai": false,
    "jev-belay@jev-belay": true,
    "jev-steer-or-queue@jev-steer-or-queue": false,
    "compact-adviser@compact-adviser": false,
    "handoff@two-tier-mods": true
  },
  "pluginConfigs": {
    "jev-belay@jev-belay": {
      "options": {
        "threshold": 0.75,
        "log": true,
        "shadow": true,
        "check": "^bin/(check|gate)-"
      }
    },
    "handoff@two-tier-mods": {
      "options": {
        "threshold": 70,
        "handoffDir": "handoffs",
        "autoClear": true,
        "minTurns": 2,
        "language": "ru"
      }
    }
  },
  "skillOverrides": {
    "brain-init": "off",
    "memory-protocol": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:grilling": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:role-checker": "off",
    "anthropic-skills:role-hypothesis-generator": "off",
    "anthropic-skills:role-hypothesis-judge": "off",
    "anthropic-skills:role-research": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:team-lead": "off",
    "anthropic-skills:team-lead-brief": "off",
    "anthropic-skills:xlsx": "off"
  },
  "env": {
    "JEV_MODEL": "jev-1.13.0",
    "JEV_ROUTER_JEV_MODEL": "jev-1.13.0",
    "QUICKSILVER_MODEL": "jev-1.13.0"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Project: <проект> — <что он делает, одной фразой>. Primary use: software development.",
      "Source control: <GitHub org/repo проекта> — pushing feature branches there is routine; main changes only after the operator's acceptance.",
      "Trusted domains: <API вендоров и хосты, которые вызывает проект>.",
      "Key services: <CI, сервер проекта, деплой — или «нет»>."
    ]
  }
}
