         f"flaky={'OK' if flaky else 'нет'} ohne={'block' if block else 'нет'} · с меткой, красный — rc {fl[0]} «{fl[1]}»; без метки — rc {no[0]} «{no[1]}» · FLAKY и зелёные: {flaky_text} · блок, rc 1: {block_text}")
    # ── SPEC-v3.5: линты выдачи F4, F5, F7 ──
    kroot = "kit" if os.path.isdir("kit/docs") else "."

    def tmpl(edits=()):
        """`--templates` на копии шаблонов кита во /tmp/two-tier-v3, правки — (файл, было, стало): красная сторона — шаблон без строки."""
        d = tempfile.mkdtemp(prefix="check-budget-tmpl-", dir=TMP)
        try:
            for rel in dict.fromkeys(list(TEMPLATES) + list(CONTRACT) + ["budgets.json"]):
                if os.path.isfile(f"{kroot}/{rel}"):
                    write(os.path.join(d, kroot, rel), read(f"{kroot}/{rel}"))
            for rel, a, z in edits:
                q = os.path.join(d, kroot, rel)
                txt = read(q)
                if a not in txt:
                    return None, [f"в {rel} нет строки «{a[:40]}» — красную сторону не собрать"]
                write(q, txt.replace(a, z))
            r = subprocess.run([sys.executable, me, "--templates"], cwd=d, capture_output=True, text=True)
            return r.returncode, r.stdout.splitlines()
        finally:
            shutil.rmtree(d, ignore_errors=True)

    def tline(res, rule):
        return next((" ".join(l.split()) for l in res[1] if re.match(rf"(OK|WARN|FAIL)\s+{rule}:", l)), "нет строки")

    def tred(res, rel, phrase):  # красная: rc 1, один FAIL — строка contract называет файл и фразу
        line = tline(res, "contract") if res[0] is None else next((" ".join(l.split()) for l in res[1] if l.startswith("FAIL contract") and rel in l), "нет строки")
        return res[0] == 1 and phrase in line and "BUDGET_FAIL: 1" in res[1], line

    t_green = tmpl()
    contract_ok = lambda rel: t_green[0] == 0 and any(l.startswith("OK   contract") and rel in l for l in t_green[1])
    vor = f"--templates шаблонов {kroot}/ — rc {t_green[0]}"

    def sp(text, files={}, commits=(), prompt=None):  # фикстура линтов выдачи: git с HEAD на коммите запроса, правило на SPEC-1
        return {"docs/PROMPT.txt": prompt if prompt is not None else "Read first: docs/SPEC-1.md\nBranch phase-1 only.\n", "docs/SPEC-1.md": text, **files}, list(commits)
    lr = lambda rule, text, files={}, commits=(), prompt=None: run_side(*sp(text, files, commits, prompt), rule)

    def plain_line(text, rule, files={}, commits=()):  # настоящий скрипт на фикстуре: строка BUDGET_ правила
        fs, cs = sp(text, files, commits)
        rc, lines = plain(fs, cs)
        return rc, next((l for l in lines if l.startswith(f"BUDGET_FAIL {rule}") or l.startswith(f"BUDGET_WARN {rule}")), "нет строки")

    # F4 — ранняя планка: форма F58.1 SPEC-11 (заголовок и строка таблицы называют пункт, пункт ссылается на ключ planken:)
