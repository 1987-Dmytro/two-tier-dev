        ("ключ из двух токенов", 0, "FLAKY bash tests/t.sh rc=3", test_run({"flaky": {"bash tests/t.sh": "решение"}})),
        ("с меткой, убит сигналом", 0, "FLAKY bash tests/t.sh rc=-9", test_run(label, "kill -9 $$\n")),
        ("с меткой, зелёный", 0, "TEST_OK", test_run(label, green)),
    ])
    block, block_text = judge([
        ("без метки", 1, "TEST_FAIL bash tests/t.sh rc=3", no),
        ("вывод не UTF-8", 1, "TEST_FAIL", test_run({"flaky": {}}, "printf '\\377\\376'; exit 3\n")),
