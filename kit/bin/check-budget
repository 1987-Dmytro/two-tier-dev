         f"ohne={without[0]} mit={withl[1].rsplit('поправок: ', 1)[-1] if 'поправок: ' in withl[1] else '?'} · без строки — «{without[1]}»; со строкой — «{withl[1]}» · "
         f"bin/check-budget на фикстуре — {'BUDGET_FAIL scope-growth F2' if named else 'нет строки BUDGET_FAIL scope-growth F2'}; две новые, одна строка — «{two[1][:20]}» · FAIL: {ohne_text} · OK: {mit_text}")
    # F2.3
    K = {"korridor": {"word": {"p95": 3300, "max": 6500}}, "flaky": {}}
