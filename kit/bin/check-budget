    bx = {"bin/x": "x\n", "Makefile": "check-live:\n\ttrue\nregress:\n\ttrue\n"}
    ps = lambda items, sec1="", files=bx, prompt=None: lr(rule_spec_paths, spec5(basis.format("нет"), sec1, items), files, (), prompt)
    item = lambda tok: f"  - `F1.1` {tok} печатает X\n"
    f52 = judge([
        ("путь вне HEAD", "FAIL", "bin/nope:", ps(item("`bin/nope`"))),
