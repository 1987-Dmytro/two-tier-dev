           tred(tmpl([("docs/PLAN.template.md", "Пункт ранней планки — отчёт", "Пункт ранней планки")]), "PLAN.template.md", "Пункт ранней планки — отчёт")]
    v43 = contract_ok("SPEC.template.md") and contract_ok("PLAN.template.md")
    emit("F4.3", v43 and all(r for r, _ in r43),
         f"vorlage={'OK' if v43 else 'нет'} rot={'OK' if all(r for r, _ in r43) else 'нет'} · {vor}, {tline(t_green, 'contract')[:60]}… · без строки в §2 SPEC — «{r43[0][1][:160]}» · без строки в PLAN — «{r43[1][1][:160]}»")
    if all(ok_all[-3:]):
        print("PLANKA_EARLY_OK")

    # F5 — судьи на базе и пути спеки
    def spec5(sec5="", sec1="", items="  - `F1.1` `bin/x` печатает X\n"):
        return (f"# SPEC-1\n\n## 1. Дизайн\n{sec1}\n## 2. Фичи\n- **F1 x** · готово: F1.1 · чек: `bin/x` → `X_OK` · служит: S1 · after: —\n{items}\n"
