        ("таблица", "WARN", p95, pn(item(key) + "\n| звено | p95 |\n|---|---|\n| word | 3300 |\n")),
        ("следующая строка прозы", "WARN", p95, pn("\nСудья — `planken:korridor.word`.\nПредел 3300 мс.\n")),
    ])
    clean = "чисел коридора в тексте нет"
    fine, fine_text = judge([
        ("ключ без чисел", "OK", clean, pn(item(key))),
        ("33000 и F3300.1", "OK", clean, pn(item(f"{key}, пункт 33000 и F3300.1"))),
        ("точка сразу за ключом", "OK", clean, pn(item("`bin/x` судит planken:korridor.word."))),
        ("число лишь в токене ключа", "OK", clean, pn(item("`bin/x` судит `planken:3300`"), {"3300": {"p95": 3300}})),
        ("ключ по-русски есть", "OK", clean, pn(item("`bin/x` судит `planken:коридор.слово`"), {"коридор": {"слово": {"p95": 3300}}})),
    ])
    keyred, keyred_text = judge([
        ("нет файла", "FAIL", "нет файла checks/planken.json", nof),
        ("нет ключа", "FAIL", "ключей нет в checks/planken.json — korridor.nope", pn(item("`bin/x` судит `planken:korridor.nope`"))),
        ("нет ключа, хвост по-русски", "FAIL", "ключей нет в checks/planken.json — korridor.нет", pn(item("`bin/x` судит `planken:korridor.нет`"))),
        ("ключ по-русски, нет файла", "FAIL", "ключи коридор — нет файла", pn(item("`bin/x` судит `planken:коридор`"), None)),
        ("файл не JSON", "FAIL", "checks/planken.json не JSON", pn(item(key), "{")),
    ])
    p_inl = plain({**pr, **pfile(K), "docs/SPEC-1.md": top + item(f"{key}, p95 3300 мс")})
    warned = "BUDGET_WARN planken-inline" in p_inl[1]
    emit("F2.3", inline and fine and keyred and warned,
         f"inline={inl[0]} ohne={nof[0]} · число рядом — «{inl[1]}»; нет файла — «{nof[1]}» · bin/check-budget на фикстуре — {'BUDGET_WARN planken-inline' if warned else 'нет строки BUDGET_WARN planken-inline'} · "
         f"WARN: {inline_text} · OK: {fine_text} · FAIL: {keyred_text}")
    # F2.4
    gt = os.path.join(os.path.dirname(me), "gate-test")
    red, green = "echo x; exit 3\n", "exit 0\n"

    def test_run(planken, script=red, argv=("bash", "tests/t.sh"), sub=None, name="tests/t.sh"):
        def go():
            if sub:
                os.chdir(sub)
            r = subprocess.run([gt, *argv], capture_output=True, text=True)
            return r.returncode, " ".join((r.stdout + r.stderr).split())[-90:]
        return in_fixture({name: script, **pfile(planken)}, [], go)
    label = {"flaky": {"tests/t.sh": "решение 388: настенное время"}}
    decision = lambda v: test_run({"flaky": {"tests/t.sh": v}})
    fl, no = test_run(label), test_run({"flaky": {}})
    flaky, flaky_text = judge([
        ("с меткой, красный", 0, "FLAKY bash tests/t.sh rc=3 · решение 388", fl),
        ("метка корня, тест из подкаталога", 0, "FLAKY bash t.sh rc=3", test_run({"flaky": {"t.sh": "решение"}}, argv=("bash", "t.sh"), sub="tests")),
        ("ключ из двух токенов", 0, "FLAKY bash tests/t.sh rc=3", test_run({"flaky": {"bash tests/t.sh": "решение"}})),
        ("с меткой, убит сигналом", 0, "FLAKY bash tests/t.sh rc=-9", test_run(label, "kill -9 $$\n")),
        ("с меткой, зелёный", 0, "TEST_OK", test_run(label, green)),
    ])
    block, block_text = judge([
        ("без метки", 1, "TEST_FAIL bash tests/t.sh rc=3", no),
        ("вывод не UTF-8", 1, "TEST_FAIL", test_run({"flaky": {}}, "printf '\\377\\376'; exit 3\n")),
        ("нет файла", 1, "TEST_FAIL", test_run(None)),
        ("файл не JSON", 1, "TEST_FAIL", test_run("{")),
        ("корень файла — список", 1, "TEST_FAIL", test_run("[]")),
        ("flaky — список", 1, "TEST_FAIL", test_run({"flaky": ["tests/t.sh"]})),
        ("метка другого теста", 1, "TEST_FAIL", test_run({"flaky": {"tests/other.sh": "x"}})),
        ("t.sh на tests/test.sh", 1, "TEST_FAIL", test_run({"flaky": {"t.sh": "решение"}}, argv=("bash", "tests/test.sh"), name="tests/test.sh")),
        ("пустой ключ", 1, "TEST_FAIL", test_run({"flaky": {"": "x"}}, argv=("bash", "tests/t.sh", ""))),
        ("пробельный ключ", 1, "TEST_FAIL", test_run({"flaky": {" ": "x"}}, argv=("bash", "tests/t.sh", "", ""))),
        ("решение пустое", 1, "TEST_FAIL", decision("")),
        ("решение из пробелов", 1, "TEST_FAIL", decision("  ")),
        ("решение false", 1, "TEST_FAIL", decision(False)),
        ("решение null", 1, "TEST_FAIL", decision(None)),
        ("убит сигналом", 1, "TEST_FAIL bash tests/t.sh rc=-9", test_run({"flaky": {}}, "kill -9 $$\n")),
        ("команды нет", 1, "TEST_FAIL /nonexistent/test-cmd rc=127", test_run({"flaky": {}}, argv=("/nonexistent/test-cmd",))),
        ("команды нет, с меткой", 1, "TEST_FAIL /nonexistent/test-cmd rc=127", test_run({"flaky": {"/nonexistent/test-cmd": "решение"}}, argv=("/nonexistent/test-cmd",))),
        ("скрипта нет, с меткой", 1, "TEST_FAIL bash tests/gone.sh rc=127", test_run({"flaky": {"tests/gone.sh": "решение"}}, argv=("bash", "tests/gone.sh"))),
        ("нет права на запуск, с меткой", 1, "TEST_FAIL tests/t.sh rc=127", test_run({"flaky": {"tests/t.sh": "решение"}}, argv=("tests/t.sh",))),
        ("rc 126, с меткой", 1, "TEST_FAIL bash tests/t.sh rc=126", test_run(label, "exit 126\n")),
    ])
    emit("F2.4", flaky and block,
         f"flaky={'OK' if flaky else 'нет'} ohne={'block' if block else 'нет'} · с меткой, красный — rc {fl[0]} «{fl[1]}»; без метки — rc {no[0]} «{no[1]}» · FLAKY и зелёные: {flaky_text} · блок, rc 1: {block_text}")
    cur = rule_planka(dict(b)) + rule_scope(dict(b)) + rule_planken(dict(b))
    for s_, r_, m_ in cur:
        print(f"{s_:4} {r_}: {m_}")
    if all(ok_all) and not any(s_ == "FAIL" for s_, _, _ in cur):
        print("BUDGET_LINT_OK")
        return 0
    print("BUDGET_LINT_FAIL")
    return 1


TEMPLATES = {  # шаблон кита → куда его кладёт пример в проекте
    "docs/INTENT.template.md": "intent/INTENT.md", "docs/SPEC.template.md": "docs/SPEC-1.md",
    "docs/PROMPT.template.txt": "docs/PROMPT.txt", "docs/PLAN.template.md": "docs/PLAN-1.md",
    "docs/PROGRESS.template.md": "docs/PROGRESS.md", "docs/STATUS.template.md": "docs/STATUS.md",
    "docs/PROCESS.template.md": "docs/PROCESS.md", "REVIEW.md": "docs/reviews/1-1.md", "CLAUDE.md": "CLAUDE.md",
    ".abide/rubric.json": ".abide/rubric.json",  # v3.3, F7.3: база рубрики кита — как её кладёт bin/two-tier-init
}


CONTRACT = {  # v3.1, F6: фаза под ultracode рождается из шаблонов — фразы, без которых шаблон её не ведёт
    "docs/SPEC.template.md": ["Регрессия модуля при закрытии", "`DEPLOY_OK` только после `REGRESS_OK`", "Правило закрытия", "гейт не закрывается с красным", "Окно деплоя", "`LIVE_OK`", "Паспорт модуля", "`DEPLOY_FAIL step=passport`"],  # v3.4, F4.4: живой текст §5
    "docs/GATE.template.md": ["| 0 |", "контрольный прогон", "гейт не закрывается с красным", "`bin/check-fenster`", "`FENSTER_GRUEN"],  # v3.4, F4.4: строка 0 таблицы
    "docs/PROMPT.template.txt": ["bin/verify-phase", "VERDICT: PASS", "its blocking findings fixed in this session",
                                 "Workflow agents edit only inside their own worktrees", "never push to main",
                                 "spec-gate", "`STOP: <id>`", "launch-line argument"],
    "docs/PROCESS.template.md": ["| инструмент | форма | id | вкл | фича или чек | установка | удаление |",
                                 "claude --permission-mode auto --model claude-opus-5-5 --effort ultracode",
                                 "--setting-sources project,local", '-- "$(cat docs/PROMPT.txt)"', "--strict-mcp-config", "% недели"],
    "CLAUDE.md": ["Агенты воркфлоу", "worktree", "главная сессия", "по точным путям", "Push в `main` запрещён", "/verify-phase",
                  "## Rules for every commit", "abide check", ".abide/rubric.json"],
}


def contract_text(f, text):
    """Где читаются фразы договора (v3.4, F4.4): SPEC — живой текст §5, GATE — строка таблицы «| 0 |»; HTML-комментарий — не текст. Прочие шаблоны — весь файл."""
    live = re.sub(r"<!--.*?(?:-->|\Z)", "", text, flags=re.S)
    if f == "docs/SPEC.template.md":
        return next(iter(re.findall(r"^## 5\b.*?(?=^## |\Z)", live, re.M | re.S)), "")
    if f == "docs/GATE.template.md":
        return next((l for l in live.splitlines() if l.startswith("| 0 |")), "")
    return text


def templates():
    """Пример — шаблон как есть, только номер фазы, пин и Read first подставлены; плейсхолдеры <…> остаются, кроме ячейки планки: незаполненная — FAIL planka-source (F2.1),
    в примере — «ранняя»."""
    root = "kit" if os.path.isdir("kit/docs") else "."
    missing = [t for t in list(TEMPLATES) + list(CONTRACT) if not os.path.isfile(f"{root}/{t}")]
    if missing:
        return report([("FAIL", "templates", f"нет шаблонов {missing}")])
    b, out = load_budgets(f"{root}/budgets.json")
    if not b:
        return report(out)
    for f, words in CONTRACT.items():
        text = contract_text(f, read(f"{root}/{f}"))
        miss = [w for w in words if w not in text]
        out.append(("FAIL" if miss else "OK", "contract", f"{root}/{f}: фраз {len(words)}, нет — {'; '.join(miss) or 'ничего'}"))
    slash = re.compile("/" + "goal" + r"\b")  # v3.2: фазу запускает стартовый запрос — команды в ките не остаётся (строка не ловит сама себя)
    hits = []
    kit_paths = [os.path.join(d, f) for top in (".claude", "bin") for d, _, fs in os.walk(f"{root}/{top}") for f in fs]
    kit_paths += [f"{root}/{t}" for t in list(TEMPLATES) + ["docs/LAUNCH.md"] if os.path.isfile(f"{root}/{t}")]
    for path in sorted(set(kit_paths)):  # только файлы кита: архив и история проекта (C1) не в счёт
        try:
            n = len(slash.findall(read(path)))
        except (UnicodeDecodeError, OSError):
            continue
        hits += [f"{os.path.relpath(path, root)}: {n}"] if n else []
    out.append(("FAIL" if hits else "OK", "no-goal", f"упоминаний команды {slash.pattern[:5]} в {root}/ — {'; '.join(hits) or 'нет'}"))
    if root == "kit":  # v3.2, F7: кит, который получает новый проект, — без схемы GOAL (в проекте прежнее имя — WARN, см. rule_prompt)
        kd = json.loads(read("kit/budgets.json"))["defaults"]
        own = kd.get("owner", [])
        old = (["нет prompt_chars"] if "prompt_chars" not in kd else []) + (["goal_chars"] if "goal_chars" in kd else []) \
            + (["нет docs/PROMPT.txt в owner"] if "docs/PROMPT.txt" not in own else []) + (["docs/GOAL.txt в owner"] if "docs/GOAL.txt" in own else []) \
            + [f"kit/CLAUDE.md:{i}" for i, l in enumerate(read("kit/CLAUDE.md").splitlines(), 1) if re.search(r"GOAL|\bgoal\b", l)]
        out.append(("FAIL" if old else "OK", "kit-prompt", f"kit/budgets.json и kit/CLAUDE.md — стартовый запрос v3.2: "
                    + ("; ".join(old) if old else "prompt_chars, docs/PROMPT.txt в owner, схемы GOAL нет")))
    pin = pin_of(read(f"{root}/docs/INTENT.template.md"))
    subs = [("<n>", "1"), ("<current review file or nothing>", "docs/reviews/1-1.md"),
            ("<первые 12 знаков git hash-object>", pin), ("<файл, n, p50/p95 — или «ранняя»>", "ранняя")]
    fs = {}
    for t, dst in TEMPLATES.items():
        text = read(f"{root}/{t}")
        for a, z in subs:
            text = text.replace(a, z)
        fs[dst] = text
        print(f"пример: {root}/{t} → {dst}")
    return report(out + in_fixture(fs, None, lambda: run(b)))


def main(argv):
    if argv[:1] == ["--self-test"]:
        return self_test(argv[1:])
    if argv == ["--templates"]:
        return templates()
    if argv == ["--lints"]:
        return lints()
    if argv:
        print(__doc__)
        return 2
    b, out = load_budgets()
    return report(out + run(b) if b else out)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
