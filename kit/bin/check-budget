        ("SPEC после запроса", "OK", "фич на выдаче 3, сейчас 3", sc([("Тимлид: SPEC", spec_of(feats=("F1", "F2", "F3")), [])], pr)),
        ("запрос назвал SPEC не сразу", "OK", "фич на выдаче 2, сейчас 2",
         sc(grown() + [("Тимлид: запрос", pr, [])], {"docs/PROMPT.txt": "Read first: docs/OTHER.md\n", "docs/SPEC-1.md": lint_fixture_spec("ранняя")})),
