#!/usr/bin/env python3
"""check-budget — бюджеты two-tier-dev механикой (SPEC-v3 §1).

  bin/check-budget                        правила над корнем проекта: строка OK/WARN/FAIL на правило, BUDGET_OK или exit 1
  bin/check-budget --self-test [группа…]  зелёная и красная фикстура на каждое правило: <ГРУППА>_OK … SELFTEST_OK
  bin/check-budget --templates            шаблоны кита, развёрнутые примером во временный проект: BUDGET_OK
  bin/check-budget --lints                линты спеки (SPEC-v3.4 F2) обеими сторонами на фикстурах и на текущей SPEC: BUDGET_LINT_OK

budgets.json: {"defaults": кит, "project": только ужесточение — число не выше defaults, owner_add}.
Знаки — символы Unicode. Пути правил — от корня проекта; в репо кита те же правила видят kit/.
SPEC и PLAN — файлы текущей фазы: первый `Read first:` стартового запроса docs/PROMPT.txt (v3.2; нет его — прежнее имя
docs/GOAL.txt) и PLAN с тем же суффиксом.
"""
import contextlib, fnmatch, glob, hashlib, io, json, os, re, shutil, subprocess, sys, tempfile

TMP = "/tmp/two-tier-v3"
FEATURE = re.compile(r"- \*\*(F\d+)")
ITEM = re.compile(r"^\s+- `(F\d+\.\d+)`(.*)$")  # пункт фичи SPEC-v3.3
# место чтения пункта (F1.3): команда, файл или маркер в обратных кавычках — или слово места
PLACE = re.compile(r"`[^`]+`|(?i:блок|отказ|вердикт|отч[её]т|\bчек|печата|CHANGELOG|README|шаблон|строк[аиу] запуска)")
JUDGE = re.compile(r"судья:\s*\S")
SCOPE_NOTE = "- Вне объёма"  # строка объёма в §3 — не запрет, судьи не требует
DOLLAR_DIGIT = re.compile(r"\$\d")
MARKER = re.compile(r"\[NEEDS CLARIFICATION:[^\]]+\]")
CODE = re.compile(r"```.*?```|`[^`\n]*`", re.S)  # маркер в обратных кавычках не считается
FILES = {
    "team_lead_copy": ["docs/drafts/team-lead-v6.md"],
    "brief_copy": ["docs/drafts/team-lead-brief.md"],
    "role_copy": ["docs/drafts/role-*.md"],
    "grilling_copy": ["docs/drafts/grilling*.md", "kit/.claude/skills/grilling/SKILL.md", ".claude/skills/grilling/SKILL.md"],
    "skill": ["kit/.claude/skills/*/SKILL.md", ".claude/skills/*/SKILL.md"],
    "claude_md": ["kit/CLAUDE.md", "CLAUDE.md"],
    "intent": ["intent/INTENT.md"],
    "progress": ["docs/PROGRESS.md"],
}
SIZES = [  # ключ budgets.json · файлы · мера
    ("team_lead_copy_lines", "team_lead_copy", "lines"), ("team_lead_copy_chars", "team_lead_copy", "chars"),
    ("brief_copy_lines", "brief_copy", "lines"), ("brief_copy_chars", "brief_copy", "chars"),
    ("role_copy_chars", "role_copy", "chars"), ("grilling_copy_chars", "grilling_copy", "chars"),
    ("skill_chars", "skill", "chars"), ("claude_md_lines", "claude_md", "lines"),
    ("intent_chars", "intent", "chars"), ("progress_lines", "progress", "lines"),
]
REQUIRED = [k for k, _, _ in SIZES] + ["dollar_digit", "spec_feature_chars", "plan_lines",
                                       "read_first_files", "read_first_chars", "review_blocking", "owner"]
PROMPTS = ["docs/PROMPT.txt", "docs/GOAL.txt"]  # v3.2: стартовый запрос; прежнее имя — до переноса тимлидом или апгрейдом
PLANKEN = "checks/planken.json"  # v3.4, F2.3: параметры судей — файл тимлида; SPEC ссылается ключом `planken:<ключ>`
KEYREF = re.compile(r"planken:([A-Za-z0-9_](?:[\w.-]*[A-Za-z0-9_])?)")
AMEND = re.compile(r"Поправка\s+[^:\n<>]+:\s*слово оператора\s+[^\s<>]+")  # v3.4, F2.2: строка поправки объёма в §0 SPEC
LINT_RULES = ("planka-source", "scope-growth", "planken-inline", "planken-key")  # строка BUDGET_<статус> <правило> — для гейта и тимлида


def read(p):
    with open(p, encoding="utf-8") as f:
        return f.read()


def write(p, text):
    os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        f.write(text)


def files(patterns):
    return sorted({p for pat in patterns for p in glob.glob(pat)})


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, encoding="utf-8", errors="replace")


def check(rule, value, limit, what, weight="FAIL"):
    return ("OK" if value <= limit else weight, rule, f"{what} {value}/{limit}")


def is_tl(path, owner):
    return any(path.startswith(e) if e.endswith("/") else fnmatch.fnmatchcase(path, e) for e in owner)


def with_prompt(owner):
    """v3.2: стартовый запрос наследует владение прежнего имени — docs/GOAL.txt в списке тимлида значит и docs/PROMPT.txt."""
    return owner + ["docs/PROMPT.txt"] if "docs/GOAL.txt" in owner and "docs/PROMPT.txt" not in owner else owner


def load_budgets(path="budgets.json"):
    try:
        raw = json.loads(read(path))
    except (OSError, ValueError) as e:
        return None, [("FAIL", "budgets", f"{path}: {e.__class__.__name__}")]
    d, p = raw.get("defaults", {}), raw.get("project") or {}
    out = [("FAIL", "budgets", f"defaults без ключа {k}") for k in REQUIRED if k not in d]
    if out:
        return None, out
    b = dict(d)
    b["owner"] = with_prompt(d["owner"])
    for k, v in p.items():
        if k == "owner_add" and isinstance(v, list) and all(isinstance(x, str) for x in v):
            b["owner"] = b["owner"] + v
        elif k in d and k != "owner" and type(v) is int and v <= d[k]:
            b[k] = v
        else:
            out.append(("FAIL", "budgets", f"project.{k}={v!r}: проект только ужесточает (defaults: {d.get(k)!r})"))
    out.append(("OK", "budgets", f"defaults кита — {len(d)} ключей, ключей проекта — {len(p)}"))
    kit = "kit/budgets.json"
    if path == "budgets.json" and os.path.isfile(kit):  # репо кита: ключ, нового в ките, тимлид вносит в свой budgets.json сам
        try:
            new = {k: v for k, v in json.loads(read(kit))["defaults"].items() if k not in d and k != "owner"}
        except (OSError, ValueError, KeyError):
            new = {}
        if new:
            b.update(new)
            out.append(("WARN", "budgets", f"ключей кита нет в budgets.json — {', '.join(sorted(new))}: взяты из {kit}; вносит тимлид"))
    return b, out


def phase():
    """(текст стартового запроса, Read first, SPEC, PLAN, путь запроса) или None, если запроса нет."""
    path = next((p for p in PROMPTS if os.path.isfile(p)), None)
    if not path:
        return None
    g = read(path)
    m = re.search(r"^Read first:(.*)$", g, re.M)
    rf = [x.strip() for x in m.group(1).split(",") if x.strip()] if m else []
    spec = rf[0] if rf and re.fullmatch(r"(.*/)?SPEC-[^/]+\.md", rf[0]) else None
    plan = re.sub(r"SPEC-([^/]+)$", r"PLAN-\1", spec) if spec else None
    return g, rf, spec, plan, path


def rule_sizes(b):
    out = []
    for key, rule, kind in SIZES:
        for f in files(FILES[rule]):  # «если есть»: нет файла — нет строки
            t = read(f)
            out.append(check(key, len(t.splitlines()) if kind == "lines" else len(t), b[key], f,
                             "WARN" if key == "intent_chars" else "FAIL"))
    return out


def rule_dollar(b):
    fs = files(FILES["skill"] + FILES["team_lead_copy"] + FILES["brief_copy"])
    bad = [f"{f}: {n}" for f in fs for n in [len(DOLLAR_DIGIT.findall(read(f)))] if n > b["dollar_digit"]]
    return [("FAIL" if bad else "OK", "dollar_digit", "`$` с цифрой — " + ("; ".join(bad) if bad else f"0 в {len(fs)} файлах"))]


def rule_prompt(b):
    ph = phase()
    if not ph:
        return [("OK", "prompt", "нет docs/PROMPT.txt — фаза не открыта, правила фазы пропущены")]
    g, rf, _, _, path = ph
    key = "prompt_chars" if "prompt_chars" in b else "goal_chars"  # прежний budgets.json проекта — прежнее имя ключа
    if key not in b:
        return [("FAIL", "prompt", "в budgets.json нет prompt_chars")]
    out = [check(key, len(g), b[key], f"{path}, знаков")]
    if path != PROMPTS[0]:
        out.append(("WARN", "prompt", f"стартовый запрос — прежнее имя {path}; переносит тимлид (git mv в {PROMPTS[0]}) или two-tier-upgrade"))
    if not rf:
        return out + [("FAIL", "prompt", f"в {path} нет строки Read first:")]
    out.append(check("read_first_files", len(rf), b["read_first_files"], "Read first, файлов"))
    missing = [p for p in rf if not os.path.isfile(p)]
    if missing:
        out.append(("FAIL", "goal", f"Read first: нет файлов {missing}"))
    total = sum(len(read(p)) for p in rf + ["CLAUDE.md"] if os.path.isfile(p))
    return out + [check("read_first_chars", total, b["read_first_chars"], "Read first + CLAUDE.md, знаков")]


def blocks(lines):
    """[(F<n>, строки блока)]: строка фичи и под ней её пункты «  - `F<n>.<k>` …» (SPEC-v3.3)."""
    out = []
    for l in lines:
        f, it = FEATURE.match(l), ITEM.match(l)
        if f:
            out.append((f.group(1), [l]))
        elif out and out[-1][0] and not l.strip():
            continue  # пустая строка внутри списка пунктов блок не кончает
        elif it and out and len(out[-1][1]) and it.group(1).startswith(out[-1][0] + "."):
            out[-1][1].append(l)
        elif out:
            out.append((None, []))  # блок кончился
    return [(f, ls) for f, ls in out if f]


def rule_spec(b):
    ph = phase()
    if not ph:
        return []
    spec = ph[2]
    if not spec or not os.path.isfile(spec):
        return [("FAIL", "spec", f"первый файл Read first — не существующий docs/SPEC-*.md: {(ph[1] or ['нет'])[0]}")]
    text = read(spec)
    feats = [l for l in text.splitlines() if FEATURE.match(l)]
    long = [f"{FEATURE.match(l).group(1)}: {len(l)}" for l in feats if len(l) > b["spec_feature_chars"]]
    if not feats:
        return [("FAIL", "spec", f"{spec}: нет строк фич «- **F<n> …»")]
    out = [("FAIL" if long else "OK", "spec_feature_chars",
            f"{spec}: фич {len(feats)}, длиннее {b['spec_feature_chars']} знаков — {', '.join(long) or 'нет'}")]
    bl = blocks(text.splitlines())
    items = [ITEM.match(l) for _, ls in bl for l in ls[1:]]
    if not items:  # SPEC до v3.3 — без пунктов: правила пунктов и судей не про него
        return out
    lim = b.get("spec_block_chars", 900)  # ключ кита v3.3; в budgets.json проекта до v3.3 его нет — предел кита
    big = [f"{f}: {len(chr(10).join(ls))}" for f, ls in bl if len(chr(10).join(ls)) > lim]
    out.append(("FAIL" if big else "OK", "spec_block_chars", f"{spec}: блоков фич {len(bl)}, длиннее {lim} знаков — {', '.join(big) or 'нет'}"))
    blind = [m.group(1) for m in items if not PLACE.search(m.group(2))]
    have = {m.group(1) for m in items}
    rng = [re.search(r"готово:\s*(F\d+)\.(\d+)\s*[–-]\s*\1\.(\d+)\s*·", ls[0]) for _, ls in bl]
    lost = [f"{r.group(1)}.{k}" for r in rng if r for k in range(int(r.group(2)), int(r.group(3)) + 1) if f"{r.group(1)}.{k}" not in have]
    out.append(("FAIL" if blind or lost else "OK", "spec_items", f"{spec}: пунктов {len(items)}, без места чтения — {', '.join(blind) or 'нет'}"
                + (f"; в «готово:» без строки пункта — {', '.join(lost)}" if lost else "")))
    sec = re.search(r"^## 3\.[^\n]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    rows = [l for l in (sec.group(1).splitlines() if sec else []) if l.startswith("- ") and not l.startswith(SCOPE_NOTE)]
    nojudge = [f"«{l[2:40]}…»" for l in rows if not JUDGE.search(l)]
    out.append(("FAIL" if nojudge or not sec else "OK", "spec_judges",
                f"{spec}: строк §3 {len(rows)}, без «судья:» — {', '.join(nojudge) or ('нет' if sec else 'нет раздела «## 3.»')}"))
    return out


def issued(spec, prompt):
    """SPEC выдана: HEAD впереди последнего коммита стартового запроса, после него SPEC не менялась, на диске запрос и SPEC чисты."""
    at = git("log", "-1", "--format=%H", "--", prompt).stdout.strip()
    if not at or at == git("rev-parse", "HEAD").stdout.strip():
        return False
    return not git("log", "-1", "--format=%H", f"{at}..HEAD", "--", spec).stdout.strip() and not git("status", "--porcelain", "--", spec, prompt).stdout.strip()


def landing_rows(text):
    """Планки таблиц посадки: [(звено, ячейка «измерено у нас»)]; разделитель и итоговая строка (жирная первая ячейка) — не планки."""
    rows, col = [], None
    for l in text.splitlines():
        if not l.lstrip().startswith("|"):
            col = None
            continue
        cells = [c.strip() for c in l.strip().strip("|").split("|")]
        if col is None:
            col = next((i for i, c in enumerate(cells) if "измерено у нас" in c), None)
        elif not set(cells[0]) <= set("-: ") and not cells[0].startswith("**"):
            rows.append((cells[0], cells[col] if col < len(cells) else ""))
    return rows


def rule_planka(b):
    """v3.4, F2.1: планка без файла распределения — красная до выдачи SPEC (SPEC-v3.4 §1); выданная SPEC — файл тимлида, у неё WARN."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    rows, bad = landing_rows(read(spec)), []
    for name, cell in rows:
        f = re.search(r"docs/evidence/[^\s`,;()]+", cell)
        why = None if "ранняя" in cell else "нет docs/evidence/<файл>" if not f else f"нет файла {f.group(0)}" if not os.path.isfile(f.group(0)) \
            else "нет n=" if not re.search(r"\bn\s*=\s*\d", cell) else "нет p50/p95" if not (re.search("p50", cell, re.I) and re.search("p95", cell, re.I)) else None
        if why:
            bad.append(f"«{name[:40]}»: {why}")
    if not rows:
        return []
    if not bad:
        return [("OK", "planka-source", f"{spec}: планок {len(rows)}, у всех файл распределения или «ранняя»")]
    weight, note = ("WARN", " (SPEC уже выдана: правит тимлид)") if issued(spec, prompt) else ("FAIL", "")
    return [(weight, "planka-source", f"{spec}: планок {len(rows)}, без файла распределения и без «ранняя» — {'; '.join(bad)}{note}")]


def rule_scope(b):
    """v3.4, F2.2: новая фича против SPEC на коммите стартового запроса — только строкой «Поправка» в §0; поправки считаются."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    at = git("log", "-1", "--format=%H", "--", prompt).stdout.strip()
    base = git("show", f"{at}:{spec}") if at else None
    if not base or base.returncode:
        return [("OK", "scope-growth", f"{spec}: на коммите {prompt} SPEC нет — счёта нет")]
    ids = lambda text: [m.group(1) for l in text.splitlines() for m in [FEATURE.match(l)] if m]
    text = read(spec)
    was, now = ids(base.stdout), ids(text)
    new = [f for f in now if f not in was]
    sec0 = re.search(r"^## 0\.[^\n]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    k = len(AMEND.findall(sec0.group(1))) if sec0 else 0
    if len(new) > k:
        return [("FAIL", "scope-growth", f"{' '.join(new[k:])}: новая фича без строки «Поправка <решение>: слово оператора <дата>» в §0 {spec}; фич на выдаче {len(was)}, сейчас {len(now)}, поправок: {k}")]
    return [("OK", "scope-growth", f"{spec}: фич на выдаче {len(was)}, сейчас {len(now)}, поправок: {k}")]


def numbers(v):
    if isinstance(v, dict):
        return [n for x in v.values() for n in numbers(x)]
    if isinstance(v, list):
        return [n for x in v for n in numbers(x)]
    return [v] if type(v) in (int, float) else []


def rule_planken(b):
    """v3.4, F2.3: `planken:<ключ>` — ключ есть в checks/planken.json, а чисел его коридора нет в тексте блока SPEC."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec = ph[2]
    lines = read(spec).splitlines()
    refs = sorted({k for l in lines for k in KEYREF.findall(l)})
    if not refs:
        return []
    try:
        data = json.loads(read(PLANKEN))
    except OSError:
        return [("FAIL", "planken-key", f"{spec}: ключи {', '.join(refs)} — нет файла {PLANKEN}")]
    except ValueError:
        return [("FAIL", "planken-key", f"{spec}: ключи {', '.join(refs)} — {PLANKEN} не JSON")]

    def value(key):
        v = data
        for part in key.split("."):
            if not isinstance(v, dict) or part not in v:
                raise KeyError(key)
            v = v[part]
        return v
    lost, vals = [], {}
    for k in refs:
        try:
            vals[k] = value(k)
        except KeyError:
            lost.append(k)
    if lost:
        return [("FAIL", "planken-key", f"{spec}: ключей нет в {PLANKEN} — {', '.join(lost)}")]
    inside = {l for _, ls in blocks(lines) for l in ls}
    scopes = ["\n".join(ls) for _, ls in blocks(lines)] + [l for l in lines if l not in inside]
    inline = []
    for s in scopes:
        flat = re.sub(r"(?<=\d)[  ](?=\d{3}\b)", "", KEYREF.sub("", s))
        for k in KEYREF.findall(s):
            hit = [n for n in numbers(vals[k]) if re.search(rf"(?<![\w.,]){re.escape(str(n))}(?![\d])", flat)]
            inline += [f"{k}: {n}" for n in hit]
    if inline:
        return [("WARN", "planken-inline", f"{spec}: числа коридора в тексте при ключе — {', '.join(sorted(set(inline)))}: логика судьи — в {PLANKEN}")]
    return [("OK", "planken-key", f"{spec}: ключей {len(refs)}, все в {PLANKEN}, чисел коридора в тексте нет")]


def rule_plan(b):
    ph = phase()
    if not ph or not ph[3]:
        return []
    if not os.path.isfile(ph[3]):
        return [("OK", "plan", f"{ph[3]} ещё нет — шаг 0 фазы не сделан")]
    return [check("plan_lines", len(read(ph[3]).splitlines()), b["plan_lines"], f"{ph[3]}, строк")]


def blocking(text):
    n, on = 0, False
    for line in text.splitlines():
        if line.startswith("#"):
            on = bool(re.match(r"#+\s*(Блокирующ|Blocking)", line))
        elif on and re.match(r"(- |\d+\. )", line):
            n += 1
    return n


def rule_review(b):
    out = [check("review_blocking", blocking(read(p)), b["review_blocking"], f"{p}: блокирующих")
           for p in sorted(glob.glob("docs/reviews/*.md"))]
    return out or [("OK", "review", "нет docs/reviews/*.md")]


def rule_intent(b):
    out, intent = [], "intent/INTENT.md"
    if os.path.isfile(intent):
        n = len(MARKER.findall(CODE.sub("", read(intent))))
        out.append(("WARN" if n else "OK", "intent", f"{intent}: маркеров неясности {n}"))
    ph = phase()
    spec = ph[2] if ph else None
    if not spec or not os.path.isfile(spec):
        return out
    s = read(spec)
    n = len(MARKER.findall(CODE.sub("", s)))
    out.append(("FAIL" if n else "OK", "intent", f"{spec}: маркеров неясности {n}"))
    if not os.path.isfile(intent):
        return out + [("FAIL", "intent", f"{spec} есть, а {intent} нет")]
    real = git("hash-object", intent).stdout.strip()[:12]
    m = re.search(r"intent/INTENT\.md @ ([0-9a-f]+)", s)
    out.append(("OK" if m and m.group(1) == real else "FAIL", "pin",
                f"пин SPEC {m.group(1) if m else 'нет'} · git hash-object {intent} {real}"))
    known = sorted(set(re.findall(r"\*\*(S\d+)\*\*", read(intent))), key=lambda x: int(x[1:]))
    bad = []
    for line in s.splitlines():
        f = FEATURE.match(line)
        if f:
            m = re.search(r"служит:\s*([^·\n]*)", line)
            refs = re.findall(r"S\d+", m.group(1)) if m else []
            if not refs or not set(refs) <= set(known):
                bad.append(f"{f.group(1)}→{','.join(refs) or 'нет поля служит'}")
    return out + [("FAIL" if bad else "OK", "signal",
                   f"сигналы intent {','.join(known) or 'нет'}; фич без существующего S — {'; '.join(bad) or 'нет'}")]


def owner_at(rev, fallback):
    """Список владения на ревизии: файл тимлида тот, что был им ДО коммита (v3.1, хвост 3). Нет budgets.json — кит ещё
    не стоял, файлов тимлида нет; не разбирается — список HEAD."""
    r = git("show", f"{rev}:budgets.json")
    if r.returncode:
        return []
    try:
        raw = json.loads(r.stdout)
        return with_prompt(raw["defaults"]["owner"] + ((raw.get("project") or {}).get("owner_add") or []))
    except (ValueError, KeyError, TypeError, AttributeError):
        return fallback


def rule_owner(b):
    # v3.2: проверка END STATE ушла вместе с шаблоном GOAL (SPEC-v3.2 §1; прежняя версия — в истории git); остался lint коммитов
    out, owner = [], b["owner"]
    base = next((r.stdout.strip() for ref in ("main", "origin/main")
                 for r in [git("merge-base", ref, "HEAD")] if r.returncode == 0), None)
    if not base:
        return out + [("OK", "owner", "нет main/origin/main или коммитов — lint коммитов пропущен")]
    # -z: пути как есть — без кавычек и \-escape не-ASCII (core.quotePath), каждый до NUL; \x01 — начало коммита
    log = git("log", "-z", "--no-merges", "--no-renames", "--name-only", "--format=%x01%h %s", f"{base}..HEAD").stdout
    tl = []
    for chunk in log.split("\x01")[1:]:
        head, _, names = chunk.partition("\0")
        sha, _, subj = head.partition(" ")
        own = owner_at(f"{sha}^", owner)
        hit = [p for p in (n.lstrip("\n") for n in names.split("\0")) if p and is_tl(p, own)]
        if subj.startswith("Тимлид:"):
            tl.append(f"{sha} {subj}")
        elif hit:
            out.append(("FAIL", "owner", f"{sha} «{subj}» меняет файлы тимлида без «Тимлид:»: {', '.join(hit)}"))
    return out + [("OK", "owner", f"коммитов «Тимлид:» после merge-base {base[:7]} — {len(tl)}: {'; '.join(tl) or '—'}")]


def rule_abide(b):
    """v3.2, F3: правил в рубрике Abide (файл тимлида) — не больше abide_rules. v3.3, F7.3: нет рубрики — FAIL: хук коммита молча
    пропускал бы суд модели."""
    p = ".abide/rubric.json"
    if not os.path.isfile(p):
        return [("FAIL", "abide_rules", f"нет {p} — abide check в хуке коммита пропускает суд модели: база рубрики — из кита "
                 "(bin/two-tier-init, two-tier-upgrade), коммитом «Тимлид: …»")]
    try:
        rules = json.loads(read(p)).get("rules")
    except (ValueError, AttributeError):
        return [("FAIL", "abide_rules", f"{p}: не JSON-объект")]
    if not isinstance(rules, list) or not rules:  # v3.3, F7.3: пустая рубрика или rules не список — тот же тихий пропуск суда модели
        return [("FAIL", "abide_rules", f"{p}: rules — {'0 правил' if rules == [] else 'не список' if rules is not None else 'нет'} — "
                 "abide check в хуке коммита пропускает суд модели")]
    n = len(rules)
    if "abide_rules" not in b:
        return [("WARN", "abide_rules", f"{p}: правил {n}; в budgets.json нет abide_rules — ключ вносит тимлид")]
    return [check("abide_rules", n, b["abide_rules"], f"{p}, правил")]


RULES = [rule_sizes, rule_dollar, rule_prompt, rule_spec, rule_planka, rule_scope, rule_planken, rule_plan, rule_review, rule_intent, rule_owner, rule_abide]


def run(b):
    out = []
    for fn in RULES:
        out += fn(b)
    return out


def report(out):
    for s, r, m in out:
        print(f"{s:4} {r}: {m}")
    for s, r, m in out:
        if r in LINT_RULES and s != "OK":  # v3.4, F2: строка линта для гейта и тимлида; scope-growth называет фичи
            print(f"BUDGET_{s} {r}" + (" " + m.split(":", 1)[0] if r == "scope-growth" else ""))
    fails = sum(s == "FAIL" for s, _, _ in out)
    print(f"BUDGET_FAIL: {fails}" if fails else "BUDGET_OK")
    return 1 if fails else 0


# ---------- self-test: каждая фикстура — свой временный проект в /tmp/two-tier-v3 ----------
GIT_ENV = dict(os.environ, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_NAME="t",
               GIT_AUTHOR_EMAIL="t@example.invalid", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@example.invalid")


def worst(out):
    ss = {s for s, _, _ in out}
    return "FAIL" if "FAIL" in ss else "WARN" if "WARN" in ss else "OK"


def in_fixture(fs, commits, fn):
    os.makedirs(TMP, exist_ok=True)
    d, here = tempfile.mkdtemp(prefix="check-budget-", dir=TMP), os.getcwd()
    try:
        os.chdir(d)
        for p, c in fs.items():
            write(p, c) if c is not None else None  # None — файла нет и в базе
        if commits is not None:
            g = lambda *a: subprocess.run(["git", *a], env=GIT_ENV, capture_output=True, check=True)
            if "budgets.json" not in fs:  # кит стоит с базы: список владения на родителе коммита — его
                write("budgets.json", json.dumps({"defaults": {"owner": BASE_OWNER}, "project": {}}))
            write("README.md", "base\n")
            write("docs/STATUS.md", "s\n")
            g("init", "-q", "-b", "main")
            g("config", "core.quotePath", "true")  # умолчание git — и при другом глобальном конфиге хоста
            g("add", "-A"); g("commit", "-qm", "base"); g("switch", "-qc", "v")
            for subj, add, rm in commits:
                for p, c in add.items():
                    write(p, c)
                for p in rm:
                    os.remove(p)
                g("add", "-A"); g("commit", "-qm", subj)
        return fn()
    finally:
        os.chdir(here)
        shutil.rmtree(d, ignore_errors=True)


BASE_OWNER = []  # owner кита для базы lint-фикстур; ставит self_test


def pin_of(text):
    data = text.encode("utf-8")
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()[:12]


def fixtures(b, defaults):
    C = []
    add = lambda g, name, expect, fs, fn, commits=None: C.append((g, name, expect, fs, fn, commits))
    at = {"team_lead_copy": "docs/drafts/team-lead-v6.md", "brief_copy": "docs/drafts/team-lead-brief.md",
          "role_copy": "docs/drafts/role-x.md", "grilling_copy": "docs/drafts/grilling.md",
          "skill": ".claude/skills/x/SKILL.md", "claude_md": "CLAUDE.md", "intent": "intent/INTENT.md",
          "progress": "docs/PROGRESS.md"}
    for key, rule, kind in SIZES:
        mk = (lambda n: "x\n" * n) if kind == "lines" else (lambda n: "x" * n)
        add("size", key, "OK", {at[rule]: mk(b[key])}, rule_sizes)
        add("size", key + "+1", "WARN" if key == "intent_chars" else "FAIL", {at[rule]: mk(b[key] + 1)}, rule_sizes)
    add("dollar", "скилл без $ с цифрой", "OK", {at["skill"]: "план для $ARGUMENTS, цена в евро\n"}, rule_dollar)
    add("dollar", "скилл с $0", "FAIL", {at["skill"]: "первым $0-коммитом\n"}, rule_dollar)
    add("dollar", "копия тимлида с $5", "FAIL", {at["team_lead_copy"]: "потолок $5\n"}, rule_dollar)

    def prompt(rf=("docs/SPEC-1.md",), total=None, extra=None, name="docs/PROMPT.txt"):
        fs = {p: "x" for p in rf if p != "docs/nope.md"}
        head = "Read first: " + ", ".join(rf) + "\n"
        fs[name] = head + "y" * ((total or len(head)) - len(head))
        fs.update(extra or {})
        return fs
    pl = b.get("prompt_chars", b.get("goal_chars"))
    kit_form = lambda _b: rule_prompt({k: v for k, v in _b.items() if k != "goal_chars"} | {"prompt_chars": pl})  # ключ кита v3.2
    legacy = lambda _b: rule_prompt({k: v for k, v in _b.items() if k != "prompt_chars"} | {"goal_chars": pl})  # budgets.json проекта v3.1
    add("prompt", "prompt_chars", "OK", prompt(total=pl), kit_form)
    add("prompt", "prompt_chars+1", "FAIL", prompt(total=pl + 1), kit_form)
    add("prompt", "прежний ключ goal_chars проекта v3.1", "OK", prompt(total=pl), legacy)
    add("prompt", "прежний ключ goal_chars+1", "FAIL", prompt(total=pl + 1), legacy)
    add("prompt", "в budgets.json нет ни prompt_chars, ни goal_chars", "FAIL", prompt(),
        lambda _b: rule_prompt({k: v for k, v in _b.items() if k not in ("prompt_chars", "goal_chars")}))
    three = ("docs/SPEC-1.md", "docs/PROGRESS.md", "docs/reviews/r.md")
    add("prompt", "read_first_files", "OK", prompt(rf=three), rule_prompt)
    add("prompt", "read_first_files+1", "FAIL", prompt(rf=three + ("docs/x.md",)), rule_prompt)
    rc = b["read_first_chars"]
    add("prompt", "read_first_chars", "OK", prompt(extra={"docs/SPEC-1.md": "x" * (rc - 100), "CLAUDE.md": "c" * 100}), rule_prompt)
    add("prompt", "read_first_chars+1", "FAIL", prompt(extra={"docs/SPEC-1.md": "x" * (rc - 100), "CLAUDE.md": "c" * 101}), rule_prompt)
    add("prompt", "Read first: нет файла", "FAIL", prompt(rf=("docs/SPEC-1.md", "docs/nope.md")), rule_prompt)
    add("prompt", "прежнее имя docs/GOAL.txt — читается, с WARN", "WARN", prompt(name="docs/GOAL.txt"), rule_prompt)

    def feat(n, fid="F1", serves="S1"):
        s = f"- **{fid} x** · готово · служит: {serves} · after: — "
        return s + "y" * (n - len(s))
    spec1 = lambda body: {"docs/PROMPT.txt": "Read first: docs/SPEC-1.md\n", "docs/SPEC-1.md": body}
    sf = b["spec_feature_chars"]
    add("spec", "spec_feature_chars", "OK", spec1(feat(sf) + "\n"), rule_spec)
    add("spec", "spec_feature_chars+1", "FAIL", spec1(feat(sf + 1) + "\n"), rule_spec)
    add("spec", "первый Read first — не SPEC", "FAIL", {"docs/PROMPT.txt": "Read first: docs/PROGRESS.md\n", "docs/PROGRESS.md": "x"}, rule_spec)
    # v3.3, F1.3: пункты под строкой фичи — у пункта место чтения, у строки §3 судья, блок фичи ≤ spec_block_chars
    def v33(item="  - `F1.1` проба печатает A — `bin/a`", s3="- C1: из репо ничего не удаляется · судья: код\n- Вне объёма: перевод проекта\n"):
        return spec1(f"{feat(80)}\n{item}\n\n## 3. Инварианты\n{s3}\n## 4. Стопы\n")
    sb = b.get("spec_block_chars", 900)
    add("spec", "SPEC v3.3: место чтения, судьи §3, блок в пределе", "OK", v33(), rule_spec)
    add("spec", "SPEC v3.3: блок ровно spec_block_chars", "OK", v33(item="  - `F1.1` отказ " + "y" * (sb - 80 - 1 - len("  - `F1.1` отказ "))), rule_spec)
    add("spec", "SPEC v3.3: пункт без места чтения", "FAIL", v33(item="  - `F1.1` всё работает быстро и надёжно"), rule_spec)
    add("spec", "SPEC v3.3: строка §3 без судьи", "FAIL", v33(s3="- C1: из репо ничего не удаляется\n"), rule_spec)
    add("spec", "SPEC v3.3: блок spec_block_chars+1", "FAIL", v33(item="  - `F1.1` отказ " + "y" * (sb - 80 - len("  - `F1.1` отказ "))), rule_spec)
    add("plan", "plan_lines", "OK", dict(spec1(feat(80)), **{"docs/PLAN-1.md": "x\n" * b["plan_lines"]}), rule_plan)
    add("plan", "plan_lines+1", "FAIL", dict(spec1(feat(80)), **{"docs/PLAN-1.md": "x\n" * (b["plan_lines"] + 1)}), rule_plan)
    rub = lambda n: {".abide/rubric.json": json.dumps({"version": 1, "rules": [{"id": f"r{i}"} for i in range(n)]})}
    if "abide_rules" in b:
        add("rubric", "abide_rules", "OK", rub(b["abide_rules"]), rule_abide)
        add("rubric", "abide_rules+1", "FAIL", rub(b["abide_rules"] + 1), rule_abide)
    else:  # budgets.json проекта до v3.2: правило предупреждает, а не падает
        add("rubric", "нет abide_rules в budgets.json — WARN", "WARN", rub(3), rule_abide)
    add("rubric", "нет рубрики — FAIL с причиной (F7.3)", "FAIL", {}, rule_abide)
    add("rubric", "нет рубрики, в budgets.json нет abide_rules — FAIL (F7.3)", "FAIL", {},
        lambda _b: rule_abide({k: v for k, v in _b.items() if k != "abide_rules"}))
    add("rubric", "рубрика без правил — FAIL (F7.3)", "FAIL", rub(0), rule_abide)
    for bad in ("null", '"abc"', "3"):  # приёмка 4b78d3a: null и число — traceback, строка — «правил 3»
        add("rubric", f"rules: {bad} — FAIL (F7.3)", "FAIL", {".abide/rubric.json": '{"version": 1, "rules": %s}' % bad}, rule_abide)
    add("rubric", "рубрика не JSON", "FAIL", {".abide/rubric.json": "{"}, rule_abide)
    rv = lambda n: {"docs/reviews/r.md": "## Блокирующие\n" + "- f\n" * n + "## Named, not built\n- a\n- b\n- c\n"}
    add("review", "review_blocking", "OK", rv(b["review_blocking"]), rule_review)
    add("review", "review_blocking+1", "FAIL", rv(b["review_blocking"] + 1), rule_review)
    bj = lambda p: {"budgets.json": json.dumps({"defaults": defaults, "project": p})}
    lb = lambda _b: load_budgets()[1]
    add("budgets", "project ужесточает progress_lines", "OK", bj({"progress_lines": defaults["progress_lines"] - 20}), lb)
    add("budgets", "project ослабляет progress_lines", "FAIL", bj({"progress_lines": defaults["progress_lines"] + 40}), lb)
    add("budgets", "project добавляет owner_add", "OK", bj({"owner_add": ["docs/X.md"]}), lb)
    add("budgets", "project подменяет owner", "FAIL", bj({"owner": []}), lb)
    add("budgets", "project с чужим ключом", "FAIL", bj({"bogus": 1}), lb)

    def phase_fs(intent="**S1** — x\n", serves="S1", pin=None, spec_extra=""):
        p = pin_of(intent) if pin is None else pin
        return {"intent/INTENT.md": intent, "docs/PROMPT.txt": "Read first: docs/SPEC-1.md\n",
                "docs/SPEC-1.md": f"**intent:** `intent/INTENT.md @ {p}`\n{feat(80, serves=serves)}\n{spec_extra}"}
    marker = "[NEEDS CLARIFICATION: объём?]"
    add("intent", "пин = hash-object", "OK", phase_fs(), rule_intent)
    add("intent", "пин ≠ hash-object", "FAIL", phase_fs(pin="0123456789ab"), rule_intent)
    add("intent", "пина нет", "FAIL", phase_fs(pin="<hash>"), rule_intent)
    add("intent", "маркер в SPEC", "FAIL", phase_fs(spec_extra=marker + "\n"), rule_intent)
    add("intent", "маркер в SPEC в `кавычках`", "OK", phase_fs(spec_extra=f"`{marker}`\n"), rule_intent)
    add("intent", "маркер в INTENT", "WARN", phase_fs(intent="**S1** — x\n" + marker + "\n"), rule_intent)
    add("intent", "фича служит S1", "OK", phase_fs(serves="S1, S2", intent="**S1** — x\n**S2** — y\n"), rule_intent)
    add("intent", "фича служит несуществующему S9", "FAIL", phase_fs(serves="S9"), rule_intent)
    add("intent", "у фичи нет поля служит", "FAIL", phase_fs(serves="—"), rule_intent)
    add("owner", "файл тимлида коммитом без «Тимлид:»", "FAIL", {}, rule_owner, [("F1: x", {"docs/STATUS.md": "x\n"}, [])])
    add("owner", "файл тимлида коммитом «Тимлид:»", "OK", {}, rule_owner, [("Тимлид: x", {"docs/STATUS.md": "x\n"}, [])])
    add("owner", "коммит без файлов тимлида", "OK", {}, rule_owner, [("F1: x", {"src/x.py": "x\n"}, [])])
    add("owner", "docs/PROMPT.txt коммитом без «Тимлид:» при docs/GOAL.txt в owner родителя", "FAIL",
        {"budgets.json": json.dumps({"defaults": dict(defaults, owner=[e for e in defaults["owner"] if e != "docs/PROMPT.txt"] + ["docs/GOAL.txt"]), "project": {}})},
        rule_owner, [("F1: x", {"docs/PROMPT.txt": "Read first: docs/SPEC-1.md\n"}, [])])
    add("owner", "git mv файла тимлида без «Тимлид:»", "FAIL", {}, rule_owner, [("F1: mv", {"docs/old.md": "s\n"}, ["docs/STATUS.md"])])
    add("owner", "не-ASCII пути тимлида (core.quotePath=true, умолчание git) коммитом без «Тимлид:»", "FAIL", {}, rule_owner,
        [("F1: x", {"intent/Gesprächsleitfaden.md": "x\n", "docs/reviews/ревью-1.md": "x\n"}, [])])
    # v3.1, хвост 3: budgets.json — файл тимлида; список владения — на родителе коммита
    bud = lambda owner: json.dumps({"defaults": dict(defaults, owner=owner), "project": {}})
    old = [e for e in defaults["owner"] if e != "budgets.json"]
    add("owner", "коммит вносит budgets.json в owner (на родителе его нет)", "OK", {"budgets.json": bud(old)}, rule_owner,
        [("F7: owner", {"budgets.json": bud(old + ["budgets.json"])}, [])])
    add("owner", "поздняя правка budgets.json исполнителем", "FAIL", {"budgets.json": bud(old + ["budgets.json"])}, rule_owner,
        [("F1: x", {"budgets.json": bud(old + ["budgets.json"]).replace("60", "59")}, [])])
    add("owner", "снять запись docs/STATUS.md из owner и править файл", "FAIL", {"budgets.json": bud(old + ["budgets.json"])}, rule_owner,
        [("F1: unown", {"budgets.json": bud([e for e in old if e != "docs/STATUS.md"] + ["budgets.json"])}, []),
         ("F1: edit", {"docs/STATUS.md": "y\n"}, [])])
    add("owner", "кит ставится коммитом с budgets.json (на родителе его нет)", "OK", {"budgets.json": None}, rule_owner,
        [("kit install", {"budgets.json": bud(old + ["budgets.json"]), "docs/PROGRESS.md": "x\n"}, [])])
    return C


def self_test(groups):
    b, out = load_budgets()
    if not b:
        return report(out)
    defaults = json.loads(read("budgets.json"))["defaults"]
    BASE_OWNER[:] = b["owner"]
    cases = fixtures(b, defaults)
    known = list(dict.fromkeys(c[0] for c in cases))
    bad_args = [g for g in groups if g not in known]
    if bad_args:
        print(f"неизвестные группы {bad_args}; есть: {' '.join(known)}")
        return 2
    all_ok = True
    for g in groups or known:
        ok = True
        for _, name, expect, fs, fn, commits in (c for c in cases if c[0] == g):
            got = in_fixture(fs, commits, lambda: worst(fn(dict(b))))
            ok &= got == expect
            print(f"{'ok ' if got == expect else 'BAD'} {g} · {name}: ждали {expect}, получили {got}")
        print(f"{g.upper()}_OK" if ok else f"{g.upper()}_FAIL")
        all_ok &= ok
    print("SELFTEST_OK" if all_ok else "SELFTEST_FAIL")
    return 0 if all_ok else 1


# ---------- --lints: линты спеки обеими сторонами (SPEC-v3.4 F2) ----------
def lint_fixture_spec(cell="<ячейка>", extra="", sec0="Контекст.\n", feats=("F1",)):
    fl = "\n".join(f"- **{f} x** · готово: {f}.1 · чек: `bin/x` → `X_OK` · служит: S1 · after: —\n  - `{f}.1` `bin/x` печатает X" for f in feats)
    return (f"# SPEC-1\n\n## 0. Контекст\n{sec0}\n## 2. Фичи\n{fl}\n{extra}\n"
            "| звено | инструмент | нижняя оценка | источник | измерено у нас (`docs/evidence/<файл>`, n, p50/p95) |\n|---|---|---|---|---|\n"
            f"| сборка | Opus | 10 мин | док | {cell} |\n| **сумма** | | 10 мин | | — |\n\n## 3. Инварианты\n")


def lints():
    b, out0 = load_budgets()
    if not b:
        return report(out0)
    ok_all = []

    def run_side(fs, commits, fn):
        res = in_fixture(fs, commits, lambda: fn(dict(b)))
        return worst(res), " ".join((res[0][2] if res else "нет строки").split())[:110]

    def emit(iid, ok, text):
        ok_all.append(bool(ok))
        print(f"{iid} {'' if ok else 'FAIL: '}{text}", flush=True)
    pr = {"docs/PROMPT.txt": "Read first: docs/SPEC-1.md\n"}
    ev = {"docs/evidence/x.txt": "x\n"}
    good = "`docs/evidence/x.txt`, n=12, p50 2100, p95 3300"
    # F2.1
    s = lambda cell: {**pr, **ev, "docs/SPEC-1.md": lint_fixture_spec(cell)}
    g1, g2 = run_side(s(good), None, rule_planka), run_side(s("— ранняя, файла нет"), None, rule_planka)
    r1 = run_side(s("≈ 2 ч"), None, rule_planka)
    r2 = run_side(s("`docs/evidence/nope.txt`, n=12, p50 1, p95 2"), None, rule_planka)
    r3 = run_side(s("`docs/evidence/x.txt`, n=12"), None, rule_planka)
    r4 = run_side(s("`docs/evidence/x.txt`, p50 1, p95 2"), None, rule_planka)
    at = run_side(s("≈ 2 ч"), [], rule_planka)  # HEAD = коммит запроса: ещё выдача
    done = run_side(s("≈ 2 ч"), [("F1.1: работа", {"src/x.py": "x\n"}, [])], rule_planka)  # выдана и идёт
    changed = run_side(s("≈ 2 ч"), [("F1.1: работа", {"src/x.py": "x\n"}, []), ("Тимлид: поправка SPEC", {"docs/SPEC-1.md": lint_fixture_spec("≈ 3 ч")}, [])], rule_planka)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        in_fixture(s("≈ 2 ч"), None, lambda: report(rule_planka(dict(b))))
    fail_line = next((l for l in buf.getvalue().splitlines() if l.startswith("BUDGET_FAIL planka-source")), "нет")
    rot = [x[0] for x in (r1, r2, r3, r4, at)] == ["FAIL"] * 5 and fail_line == "BUDGET_FAIL planka-source"
    gruen = g1[0] == g2[0] == "OK"
    emit("F2.1", rot and gruen and done[0] == "WARN" and changed[0] == "FAIL",
         f"rot={'OK' if rot else 'нет'} gruen={'OK' if gruen else 'нет'} · с файлом — {g1[0]}, «ранняя» — {g2[0]} · без файла — {r1[0]}: «{r1[1]}» → «{fail_line}»; файла нет на диске — {r2[0]}; без p50/p95 — {r3[0]}; без n — {r4[0]}; "
         f"HEAD на коммите запроса — {at[0]} · выдана и идёт — {done[0]}; SPEC правлена после выдачи — {changed[0]}")
    # F2.2
    base = {**pr, "docs/SPEC-1.md": lint_fixture_spec("ранняя")}
    grown = lambda sec0="Контекст.\n", feats=("F1", "F2"): [("Тимлид: новая фича", {"docs/SPEC-1.md": lint_fixture_spec("ранняя", sec0=sec0, feats=feats)}, [])]
    line = "Контекст.\nПоправка 391: слово оператора 06.11.2026 — новая фича.\n"
    same = run_side(base, [("F1.1: работа", {"src/x.py": "x\n"}, [])], rule_scope)
    without = run_side(base, grown(), rule_scope)
    withl = run_side(base, grown(line), rule_scope)
    place = run_side(base, grown("Контекст.\nПоправка <решение>: слово оператора <дата>\n"), rule_scope)
    two = run_side(base, grown(line, ("F1", "F2", "F3")), rule_scope)
    outside = run_side(base, [("Тимлид: x", {"docs/SPEC-1.md": lint_fixture_spec("ранняя", extra="Поправка 391: слово оператора 06.11.2026\n", feats=("F1", "F2"))}, [])], rule_scope)
    emit("F2.2", without[0] == "FAIL" and without[1].startswith("F2:") and withl[0] == "OK" and "поправок: 1" in withl[1] and "поправок: 0" in same[1]
         and place[0] == "FAIL" and two[0] == "FAIL" and two[1].startswith("F3:") and outside[0] == "FAIL",
         f"ohne={without[0]} mit={withl[1].rsplit('поправок: ', 1)[-1] if 'поправок: ' in withl[1] else '?'} · без строки — «{without[1]}»; со строкой — «{withl[1]}»; фичи те же — «{same[1]}»; "
         f"строка-образец из шаблона — {place[0]}; две новые, одна строка — {two[0]}: «{two[1][:20]}»; строка вне §0 — {outside[0]}")
    # F2.3
    pl = {"checks/planken.json": json.dumps({"korridor": {"word": {"p95": 3300, "max": 6500}}, "flaky": {}})}
    sk = lambda body: {**pr, **pl, "docs/SPEC-1.md": lint_fixture_spec("ранняя", feats=()) + body}
    item = lambda txt: f"\n- **F1 x** · готово: F1.1 · чек: `bin/x` → `X_OK` · служит: S1 · after: —\n  - `F1.1` {txt}\n"
    clean = run_side(sk(item("`bin/x` судит `planken:korridor.word`")), None, rule_planken)
    inl = run_side(sk(item("`bin/x` судит `planken:korridor.word`, p95 3300 мс")), None, rule_planken)
    inl_sp = run_side(sk(item("`bin/x` судит `planken:korridor.word`, предел 6 500 мс")), None, rule_planken)
    other = run_side(sk(item("`bin/x` судит `planken:korridor.word`, пункт 33000 и F3300.1")), None, rule_planken)
    nof = run_side({**pr, "docs/SPEC-1.md": lint_fixture_spec("ранняя", feats=()) + item("`bin/x` судит `planken:korridor.word`")}, None, rule_planken)
    nok = run_side(sk(item("`bin/x` судит `planken:korridor.nope`")), None, rule_planken)
    emit("F2.3", clean[0] == "OK" and inl[0] == "WARN" and inl_sp[0] == "WARN" and other[0] == "OK" and nof[0] == "FAIL" and nok[0] == "FAIL",
         f"inline={inl[0]} ohne={nof[0]} · ключ без чисел — {clean[0]}; число рядом — «{inl[1]}»; «6 500» — {inl_sp[0]}; 33000 и F3300.1 — {other[0]}; нет файла — «{nof[1]}»; нет ключа — «{nok[1]}»")
    # F2.4
    gt = os.path.join(os.path.dirname(os.path.realpath(__file__)), "gate-test")

    def test_run(planken, script):
        fs = {"tests/t.sh": script, **({"checks/planken.json": planken} if planken else {})}
        def go(_=None):
            r = subprocess.run([gt, "bash", "tests/t.sh"], capture_output=True, text=True)
            return r.returncode, " ".join((r.stdout + r.stderr).split())[-90:]
        return in_fixture(fs, [], go)
    red, green = "echo x; exit 3\n", "exit 0\n"
    label = json.dumps({"flaky": {"tests/t.sh": "решение 388: настенное время"}})
    fl = test_run(label, red)
    no = test_run(json.dumps({"flaky": {}}), red)
    nof2 = test_run(None, red)
    bad = test_run("{", red)
    gl = test_run(label, green)
    wrong = test_run(json.dumps({"flaky": {"tests/other.sh": "x"}}), red)
    emit("F2.4", fl[0] == 0 and "FLAKY" in fl[1] and no[0] == 1 and "TEST_FAIL" in no[1] and nof2[0] == 1 and bad[0] == 1 and gl[0] == 0 and "TEST_OK" in gl[1] and wrong[0] == 1,
         f"flaky={'OK' if fl[0] == 0 and 'FLAKY' in fl[1] else 'нет'} ohne={'block' if no[0] == 1 else 'нет'} · с меткой, красный — rc {fl[0]} «{fl[1]}»; без метки — rc {no[0]} «{no[1]}»; нет файла — rc {nof2[0]}; "
         f"файл не JSON — rc {bad[0]}; метка другого теста — rc {wrong[0]}; с меткой, зелёный — rc {gl[0]} «{gl[1]}»")
    cur = rule_planka(dict(b)) + rule_scope(dict(b)) + rule_planken(dict(b))
    for s_, r_, m_ in cur:
        print(f"{s_:4} {r_}: {m_}")
    if all(ok_all) and not any(s_ == "FAIL" for s_, _, _ in cur):
        print("BUDGET_LINT_OK")
        return 0
    print("BUDGET_LINT_FAIL")
    return 1


TEMPLATES = {  # шаблон кита → куда его кладёт пример в проекте
    "docs/INTENT.template.md": "intent/INTENT.md", "docs/SPEC.template.md": "docs/SPEC-1.md",
    "docs/PROMPT.template.txt": "docs/PROMPT.txt", "docs/PLAN.template.md": "docs/PLAN-1.md",
    "docs/PROGRESS.template.md": "docs/PROGRESS.md", "docs/STATUS.template.md": "docs/STATUS.md",
    "docs/PROCESS.template.md": "docs/PROCESS.md", "REVIEW.md": "docs/reviews/1-1.md", "CLAUDE.md": "CLAUDE.md",
    ".abide/rubric.json": ".abide/rubric.json",  # v3.3, F7.3: база рубрики кита — как её кладёт bin/two-tier-init
}


CONTRACT = {  # v3.1, F6: фаза под ultracode рождается из шаблонов — фразы, без которых шаблон её не ведёт
    "docs/PROMPT.template.txt": ["bin/verify-phase", "VERDICT: PASS", "its blocking findings fixed in this session",
                                 "Workflow agents edit only inside their own worktrees", "never push to main",
                                 "spec-gate", "`STOP: <id>`", "launch-line argument"],
    "docs/PROCESS.template.md": ["| инструмент | форма | id | вкл | фича или чек | установка | удаление |",
                                 "claude --permission-mode auto --model claude-opus-5-5 --effort ultracode",
                                 "--setting-sources project,local", '-- "$(cat docs/PROMPT.txt)"', "--strict-mcp-config", "% недели"],
    "CLAUDE.md": ["Агенты воркфлоу", "worktree", "главная сессия", "по точным путям", "Push в `main` запрещён", "/verify-phase",
                  "## Rules for every commit", "abide check", ".abide/rubric.json"],
}


def templates():
    """Пример — шаблон как есть, только номер фазы, пин и Read first подставлены; плейсхолдеры <…> остаются."""
    root = "kit" if os.path.isdir("kit/docs") else "."
    missing = [t for t in TEMPLATES if not os.path.isfile(f"{root}/{t}")]
    if missing:
        return report([("FAIL", "templates", f"нет шаблонов {missing}")])
    b, out = load_budgets(f"{root}/budgets.json")
    if not b:
        return report(out)
    for f, words in CONTRACT.items():
        miss = [w for w in words if w not in read(f"{root}/{f}")]
        out.append(("FAIL" if miss else "OK", "contract", f"{root}/{f}: фраз {len(words)}, нет — {'; '.join(miss) or 'ничего'}"))
    slash = re.compile("/" + "goal" + r"\b")  # v3.2: фазу запускает стартовый запрос — команды в ките не остаётся (строка не ловит сама себя)
    hits = []
    kit_paths = [os.path.join(d, f) for top in (".claude", "bin") for d, _, fs in os.walk(f"{root}/{top}") for f in fs]
    kit_paths += [f"{root}/{t}" for t in list(TEMPLATES) + ["docs/LAUNCH.md"] if os.path.isfile(f"{root}/{t}")]
    for path in sorted(set(kit_paths)):  # только файлы кита: архив и история проекта (C1) не в счёт
        try:
            n = len(slash.findall(read(path)))
        except (UnicodeDecodeError, OSError):
            continue
        hits += [f"{os.path.relpath(path, root)}: {n}"] if n else []
    out.append(("FAIL" if hits else "OK", "no-goal", f"упоминаний команды {slash.pattern[:5]} в {root}/ — {'; '.join(hits) or 'нет'}"))
    if root == "kit":  # v3.2, F7: кит, который получает новый проект, — без схемы GOAL (в проекте прежнее имя — WARN, см. rule_prompt)
        kd = json.loads(read("kit/budgets.json"))["defaults"]
        own = kd.get("owner", [])
        old = (["нет prompt_chars"] if "prompt_chars" not in kd else []) + (["goal_chars"] if "goal_chars" in kd else []) \
            + (["нет docs/PROMPT.txt в owner"] if "docs/PROMPT.txt" not in own else []) + (["docs/GOAL.txt в owner"] if "docs/GOAL.txt" in own else []) \
            + [f"kit/CLAUDE.md:{i}" for i, l in enumerate(read("kit/CLAUDE.md").splitlines(), 1) if re.search(r"GOAL|\bgoal\b", l)]
        out.append(("FAIL" if old else "OK", "kit-prompt", f"kit/budgets.json и kit/CLAUDE.md — стартовый запрос v3.2: "
                    + ("; ".join(old) if old else "prompt_chars, docs/PROMPT.txt в owner, схемы GOAL нет")))
    pin = pin_of(read(f"{root}/docs/INTENT.template.md"))
    subs = [("<n>", "1"), ("<current review file or nothing>", "docs/reviews/1-1.md"),
            ("<первые 12 знаков git hash-object>", pin)]
    fs = {}
    for t, dst in TEMPLATES.items():
        text = read(f"{root}/{t}")
        for a, z in subs:
            text = text.replace(a, z)
        fs[dst] = text
        print(f"пример: {root}/{t} → {dst}")
    return report(out + in_fixture(fs, None, lambda: run(b)))


def main(argv):
    if argv[:1] == ["--self-test"]:
        return self_test(argv[1:])
    if argv == ["--templates"]:
        return templates()
    if argv == ["--lints"]:
        return lints()
    if argv:
        print(__doc__)
        return 2
    b, out = load_budgets()
    return report(out + run(b) if b else out)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
