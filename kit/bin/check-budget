        ("строка выдачи не платит за новую фичу", "FAIL", "F2:", sc(grown(line), issued_with_line)),
    ])
    mit, mit_text = judge([
        ("фичи те же", "OK", "поправок: 0", same),
        ("со строкой", "OK", "поправок: 1", withl),
