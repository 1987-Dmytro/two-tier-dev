    # F2.4
    gt = os.path.join(os.path.dirname(me), "gate-test")
    red, green = "echo x; exit 3\n", "exit 0\n"

    def test_run(planken, script=red, argv=("bash", "tests/t.sh"), sub=None, name="tests/t.sh"):
        def go():
            if sub:
                os.chdir(sub)
            r = subprocess.run([gt, *argv], capture_output=True, text=True)
            return r.returncode, " ".join((r.stdout + r.stderr).split())[-90:]
        return in_fixture({name: script, **pfile(planken)}, [], go)
    label = {"flaky": {"tests/t.sh": "решение 388: настенное время"}}
