#!/usr/bin/env python3
"""check-budget — бюджеты two-tier-dev механикой (SPEC-v3 §1).

  bin/check-budget                        правила над корнем проекта: строка OK/WARN/FAIL на правило, BUDGET_OK или exit 1
  bin/check-budget --self-test [группа…]  зелёная и красная фикстура на каждое правило: <ГРУППА>_OK … SELFTEST_OK
  bin/check-budget --templates            шаблоны кита, развёрнутые примером во временный проект: BUDGET_OK
  bin/check-budget --lints                линты спеки (SPEC-v3.4 F2) обеими сторонами на фикстурах и на текущей SPEC: BUDGET_LINT_OK

budgets.json: {"defaults": кит, "project": только ужесточение — число не выше defaults, owner_add}.
Знаки — символы Unicode. Пути правил — от корня проекта; в репо кита те же правила видят kit/.
SPEC и PLAN — файлы текущей фазы: первый `Read first:` стартового запроса docs/PROMPT.txt (v3.2; нет его — прежнее имя
docs/GOAL.txt) и PLAN с тем же суффиксом.
"""
import contextlib, fnmatch, glob, hashlib, io, json, os, re, shutil, subprocess, sys, tempfile

TMP = "/tmp/two-tier-v3"
FEATURE = re.compile(r"- \*\*(F\d+)")
ITEM = re.compile(r"^\s+- `(F\d+\.\d+)`(.*)$")  # пункт фичи SPEC-v3.3
# место чтения пункта (F1.3): команда, файл или маркер в обратных кавычках — или слово места
PLACE = re.compile(r"`[^`]+`|(?i:блок|отказ|вердикт|отч[её]т|\bчек|печата|CHANGELOG|README|шаблон|строк[аиу] запуска)")
JUDGE = re.compile(r"судья:\s*\S")
SCOPE_NOTE = "- Вне объёма"  # строка объёма в §3 — не запрет, судьи не требует
DOLLAR_DIGIT = re.compile(r"\$\d")
MARKER = re.compile(r"\[NEEDS CLARIFICATION:[^\]]+\]")
CODE = re.compile(r"```.*?```|`[^`\n]*`", re.S)  # маркер в обратных кавычках не считается
FILES = {
    "team_lead_copy": ["docs/drafts/team-lead-v6.md"],
    "brief_copy": ["docs/drafts/team-lead-brief.md"],
    "role_copy": ["docs/drafts/role-*.md"],
    "grilling_copy": ["docs/drafts/grilling*.md", "kit/.claude/skills/grilling/SKILL.md", ".claude/skills/grilling/SKILL.md"],
    "skill": ["kit/.claude/skills/*/SKILL.md", ".claude/skills/*/SKILL.md"],
    "claude_md": ["kit/CLAUDE.md", "CLAUDE.md"],
    "intent": ["intent/INTENT.md"],
    "progress": ["docs/PROGRESS.md"],
}
SIZES = [  # ключ budgets.json · файлы · мера
    ("team_lead_copy_lines", "team_lead_copy", "lines"), ("team_lead_copy_chars", "team_lead_copy", "chars"),
    ("brief_copy_lines", "brief_copy", "lines"), ("brief_copy_chars", "brief_copy", "chars"),
    ("role_copy_chars", "role_copy", "chars"), ("grilling_copy_chars", "grilling_copy", "chars"),
    ("skill_chars", "skill", "chars"), ("claude_md_lines", "claude_md", "lines"),
    ("intent_chars", "intent", "chars"), ("progress_lines", "progress", "lines"),
]
REQUIRED = [k for k, _, _ in SIZES] + ["dollar_digit", "spec_feature_chars", "plan_lines",
                                       "read_first_files", "read_first_chars", "review_blocking", "owner"]
PROMPTS = ["docs/PROMPT.txt", "docs/GOAL.txt"]  # v3.2: стартовый запрос; прежнее имя — до переноса тимлидом или апгрейдом
PLANKEN = "checks/planken.json"  # v3.4, F2.3: параметры судей — файл тимлида; SPEC ссылается ключом `planken:<ключ>`
KEYREF = re.compile(r"planken:(\w(?:[\w.-]*\w)?)")  # буквы Unicode: звенья в SPEC пишут по-русски
DAY, MONTH = r"(?:0[1-9]|[12]\d|3[01])", r"(?:0[1-9]|1[0-2])"
# v3.4, F2.2: строка поправки объёма в §0 SPEC — одной строкой, решение непустое, дата — 06.11.2026, 06.11 или 2026-11-06
AMEND = re.compile(rf"Поправка[ \t]+[^\s:<>][^:\n<>]*:[ \t]*слово оператора[ \t]+(?:{DAY}\.{MONTH}(?:\.\d{{4}})?|\d{{4}}-{MONTH}-{DAY})(?!\.?\d)")
EVIDENCE = re.compile(r"(?<![\w./-])docs/evidence/[^\s`,;()]+")  # v3.4, F2.1: путь в ячейке «измерено у нас»; ../docs/evidence/ — уже не он
PAIR_LINE = re.compile(r"^PAIR_(?:OK|FAIL) diff_p50=-?\d+ diff_p95=-?\d+", re.M)  # v3.4, F5.2: итог checks/paired_stand.sh в файле звена вендора
DEPLOY_LINE = re.compile(r"\b(?:DEPLOY_LINIE=1|linie=1)\b")  # v3.4, F7.1: токены шаблона деплоя судят всегда; слова — список deploy_words файла тимлида (решение 398)
LINT_RULES = ("planka-source", "scope-growth", "planken-inline", "planken-key", "risk-tier", "planka-early", "basis-judge", "spec-paths", "spec-review", "owner")  # строка BUDGET_<статус> <правило> — для гейта и тимлида


def read(p):
    with open(p, encoding="utf-8") as f:
        return f.read()


def write(p, text):
    os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        f.write(text)


def files(patterns):
    return sorted({p for pat in patterns for p in glob.glob(pat)})


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, encoding="utf-8", errors="replace")


def check(rule, value, limit, what, weight="FAIL"):
    return ("OK" if value <= limit else weight, rule, f"{what} {value}/{limit}")


def is_tl(path, owner):
    return any(path.startswith(e) if e.endswith("/") else fnmatch.fnmatchcase(path, e) for e in owner)


def with_prompt(owner):
    """v3.2: стартовый запрос наследует владение прежнего имени — docs/GOAL.txt в списке тимлида значит и docs/PROMPT.txt."""
    return owner + ["docs/PROMPT.txt"] if "docs/GOAL.txt" in owner and "docs/PROMPT.txt" not in owner else owner


def load_budgets(path="budgets.json"):
    try:
        raw = json.loads(read(path))
    except (OSError, ValueError) as e:
        return None, [("FAIL", "budgets", f"{path}: {e.__class__.__name__}")]
    d, p = raw.get("defaults", {}), raw.get("project") or {}
    out = [("FAIL", "budgets", f"defaults без ключа {k}") for k in REQUIRED if k not in d]
    if out:
        return None, out
    b = dict(d)
    b["owner"] = with_prompt(d["owner"])
    for k, v in p.items():
        if k == "owner_add" and isinstance(v, list) and all(isinstance(x, str) for x in v):
            b["owner"] = b["owner"] + v
        elif k in d and k != "owner" and type(v) is int and v <= d[k]:
            b[k] = v
        else:
            out.append(("FAIL", "budgets", f"project.{k}={v!r}: проект только ужесточает (defaults: {d.get(k)!r})"))
    out.append(("OK", "budgets", f"defaults кита — {len(d)} ключей, ключей проекта — {len(p)}"))
    kit = "kit/budgets.json"
    if path == "budgets.json" and os.path.isfile(kit):  # репо кита: ключ, нового в ките, тимлид вносит в свой budgets.json сам
        try:
            new = {k: v for k, v in json.loads(read(kit))["defaults"].items() if k not in d and k != "owner"}
        except (OSError, ValueError, KeyError):
            new = {}
        if new:
            b.update(new)
            KIT_NEW.update(new)
            out.append(("WARN", "budgets", f"ключей кита нет в budgets.json — {', '.join(sorted(new))}: взяты из {kit}; вносит тимлид"))
    return b, out


KIT_NEW = set()  # ключи кита, взятые load_budgets из kit/budgets.json: их нет в budgets.json корня


def rule_spec_copy(b):
    """SPEC-v3.5 F9.1: копия скилла team-lead-spec у тимлида (docs/drafts/team-lead-spec.md) — не длиннее team_lead_spec_copy_chars.
    Нет ключа или файла — строки нет; ключ взят из кита, а не из budgets.json корня, — WARN: ключ и ужатую копию вносит тимлид."""
    f, key = "docs/drafts/team-lead-spec.md", "team_lead_spec_copy_chars"
    if key not in b or not os.path.isfile(f):
        return []
    return [check(key, len(read(f)), b[key], f"{f}{', ключ кита — вносит тимлид' if key in KIT_NEW else ''}", "WARN" if key in KIT_NEW else "FAIL")]


def phase():
    """(текст стартового запроса, Read first, SPEC, PLAN, путь запроса) или None, если запроса нет."""
    path = next((p for p in PROMPTS if os.path.isfile(p)), None)
    if not path:
        return None
    g = read(path)
    m = re.search(r"^Read first:(.*)$", g, re.M)
    rf = [x.strip() for x in m.group(1).split(",") if x.strip()] if m else []
    spec = rf[0] if rf and re.fullmatch(r"(.*/)?SPEC-[^/]+\.md", rf[0]) else None
    plan = re.sub(r"SPEC-([^/]+)$", r"PLAN-\1", spec) if spec else None
    return g, rf, spec, plan, path


def rule_sizes(b):
    out = []
    for key, rule, kind in SIZES:
        for f in files(FILES[rule]):  # «если есть»: нет файла — нет строки
            t = read(f)
            out.append(check(key, len(t.splitlines()) if kind == "lines" else len(t), b[key], f,
                             "WARN" if key == "intent_chars" else "FAIL"))
    return out


def rule_dollar(b):
    fs = files(FILES["skill"] + FILES["team_lead_copy"] + FILES["brief_copy"])
    bad = [f"{f}: {n}" for f in fs for n in [len(DOLLAR_DIGIT.findall(read(f)))] if n > b["dollar_digit"]]
    return [("FAIL" if bad else "OK", "dollar_digit", "`$` с цифрой — " + ("; ".join(bad) if bad else f"0 в {len(fs)} файлах"))]


def rule_prompt(b):
    ph = phase()
    if not ph:
        return [("OK", "prompt", "нет docs/PROMPT.txt — фаза не открыта, правила фазы пропущены")]
    g, rf, _, _, path = ph
    key = "prompt_chars" if "prompt_chars" in b else "goal_chars"  # прежний budgets.json проекта — прежнее имя ключа
    if key not in b:
        return [("FAIL", "prompt", "в budgets.json нет prompt_chars")]
    out = [check(key, len(g), b[key], f"{path}, знаков")]
    if path != PROMPTS[0]:
        out.append(("WARN", "prompt", f"стартовый запрос — прежнее имя {path}; переносит тимлид (git mv в {PROMPTS[0]}) или two-tier-upgrade"))
    if not rf:
        return out + [("FAIL", "prompt", f"в {path} нет строки Read first:")]
    out.append(check("read_first_files", len(rf), b["read_first_files"], "Read first, файлов"))
    missing = [p for p in rf if not os.path.isfile(p)]
    if missing:
        out.append(("FAIL", "goal", f"Read first: нет файлов {missing}"))
    total = sum(len(read(p)) for p in rf + ["CLAUDE.md"] if os.path.isfile(p))
    return out + [check("read_first_chars", total, b["read_first_chars"], "Read first + CLAUDE.md, знаков")]


def blocks(lines):
    """[(F<n>, строки блока)]: строка фичи и под ней её пункты «  - `F<n>.<k>` …» (SPEC-v3.3)."""
    out = []
    for l in lines:
        f, it = FEATURE.match(l), ITEM.match(l)
        if f:
            out.append((f.group(1), [l]))
        elif out and out[-1][0] and not l.strip():
            continue  # пустая строка внутри списка пунктов блок не кончает
        elif it and out and len(out[-1][1]) and it.group(1).startswith(out[-1][0] + "."):
            out[-1][1].append(l)
        elif out:
            out.append((None, []))  # блок кончился
    return [(f, ls) for f, ls in out if f]


def rule_spec(b):
    ph = phase()
    if not ph:
        return []
    spec = ph[2]
    if not spec or not os.path.isfile(spec):
        return [("FAIL", "spec", f"первый файл Read first — не существующий docs/SPEC-*.md: {(ph[1] or ['нет'])[0]}")]
    text = read(spec)
    feats = [l for l in text.splitlines() if FEATURE.match(l)]
    long = [f"{FEATURE.match(l).group(1)}: {len(l)}" for l in feats if len(l) > b["spec_feature_chars"]]
    if not feats:
        return [("FAIL", "spec", f"{spec}: нет строк фич «- **F<n> …»")]
    out = [("FAIL" if long else "OK", "spec_feature_chars",
            f"{spec}: фич {len(feats)}, длиннее {b['spec_feature_chars']} знаков — {', '.join(long) or 'нет'}")]
    bl = blocks(text.splitlines())
    items = [ITEM.match(l) for _, ls in bl for l in ls[1:]]
    if not items:  # SPEC до v3.3 — без пунктов: правила пунктов и судей не про него
        return out
    lim = b.get("spec_block_chars", 900)  # ключ кита v3.3; в budgets.json проекта до v3.3 его нет — предел кита
    big = [f"{f}: {len(chr(10).join(ls))}" for f, ls in bl if len(chr(10).join(ls)) > lim]
    out.append(("FAIL" if big else "OK", "spec_block_chars", f"{spec}: блоков фич {len(bl)}, длиннее {lim} знаков — {', '.join(big) or 'нет'}"))
    blind = [m.group(1) for m in items if not PLACE.search(m.group(2))]
    have = {m.group(1) for m in items}
    rng = [re.search(r"готово:\s*(F\d+)\.(\d+)\s*[–-]\s*\1\.(\d+)\s*·", ls[0]) for _, ls in bl]
    lost = [f"{r.group(1)}.{k}" for r in rng if r for k in range(int(r.group(2)), int(r.group(3)) + 1) if f"{r.group(1)}.{k}" not in have]
    out.append(("FAIL" if blind or lost else "OK", "spec_items", f"{spec}: пунктов {len(items)}, без места чтения — {', '.join(blind) or 'нет'}"
                + (f"; в «готово:» без строки пункта — {', '.join(lost)}" if lost else "")))
    sec = re.search(r"^## 3\.[^\n]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    rows = [l for l in (sec.group(1).splitlines() if sec else []) if l.startswith("- ") and not l.startswith(SCOPE_NOTE)]
    nojudge = [f"«{l[2:40]}…»" for l in rows if not JUDGE.search(l)]
    out.append(("FAIL" if nojudge or not sec else "OK", "spec_judges",
                f"{spec}: строк §3 {len(rows)}, без «судья:» — {', '.join(nojudge) or ('нет' if sec else 'нет раздела «## 3.»')}"))
    return out


def issued(spec, prompt):
    """SPEC выдана: HEAD впереди последнего коммита стартового запроса, после него SPEC не менялась, на диске запрос и SPEC чисты."""
    at = git("log", "-1", "--format=%H", "--", prompt).stdout.strip()
    if not at or at == git("rev-parse", "HEAD").stdout.strip():
        return False
    return not git("log", "-1", "--format=%H", f"{at}..HEAD", "--", spec).stdout.strip() and not git("status", "--porcelain", "--", spec, prompt).stdout.strip()


def in_flight(spec, prompt):
    """Фаза идёт: после выдачи (первый коммит, где запрос называет эту SPEC, как в scope-growth: поздняя правка запроса её не двигает) на первой родительской линии есть коммит пункта
    `F<n>.<k>: …` — так начинает сообщение только исполнитель; слияние, коммит оператора и F-коммиты влитой ветки — не работа этой фазы; на диске запрос и SPEC чисты.
    Поправка тимлида на ходу такую SPEC в черновик не возвращает."""
    at = git("log", "--reverse", "--format=%H", f"-S{spec}", "--", prompt).stdout.split()[:1]
    subjects = git("log", "--first-parent", "--no-merges", "--format=%s", f"{at[0]}..HEAD").stdout.splitlines() if at else []
    return any(re.match(r"F\d+\.\d+\b", s) for s in subjects) and not git("status", "--porcelain", "--", spec, prompt).stdout.strip()


def planken_words(key):
    """v3.4, решение 398: список слов checks/planken.json как регулярка — слово целиком, без регистра. Нет файла, не JSON, нет ключа, пустой список — None:
    судят встроенные маркер и токен (проект после апгрейда держит свой файл, IF_ABSENT ключи не дописывает)."""
    try:
        data = json.loads(read(PLANKEN))
    except (OSError, ValueError):
        return None
    words = data.get(key) if isinstance(data, dict) else None
    words = [w.strip() for w in words if isinstance(w, str) and w.strip()] if isinstance(words, list) else []
    return re.compile(r"(?<!\w)(?:" + "|".join(map(re.escape, words)) + r")(?!\w)", re.I) if words else None


def landing_rows(text):
    """Планки таблиц посадки: [(звено, ячейка «измерено у нас», ячейка «инструмент»)]. Не планки: разделитель (во всех ячейках только тире и двоеточия), итог (первая ячейка
    жирная и вторая пустая), таблица в блоке кода ```; экранированный \\| ячейку не делит. Жирное имя планки и пустая первая ячейка — планки."""
    rows, col, tool, fence = [], None, None, False
    for l in text.splitlines():
        if re.match(r"\s*```[^`]*$", l):
            fence = not fence
        if fence or not l.lstrip().startswith("|"):
            col = None
            continue
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", re.sub(r"^\||(?<!\\)\|$", "", l.strip()))]
        if col is None:
            col = next((i for i, c in enumerate(cells) if "измерено у нас" in c.lower()), None)
            tool = next((i for i, c in enumerate(cells) if "инструмент" in c.lower() and i != col), None)
        elif not all(c and not c.strip("-:") for c in cells) and not (re.fullmatch(r"\*\*.+\*\*", cells[0]) and not "".join(cells[1:2])):
            rows.append((cells[0], cells[col] if col < len(cells) else "", cells[tool] if tool is not None and tool < len(cells) else ""))
    return rows


def evidence_text(p):  # текст файла распределения — с буквой или цифрой; BOM, пробелы, NUL и знаки нулевой ширины — не текст, битые байты lint не роняют
    with open(p, encoding="utf-8", errors="replace") as f:
        t = f.read().replace("\ufeff", "").strip()
    return t if re.search(r"\w", t) else ""


def rule_planka(b):
    """v3.4, F2.1: планка без файла распределения — красная до выдачи SPEC (SPEC-v3.4 §1); выданная SPEC — файл тимлида, у неё WARN; на обрезанной истории
    выдачу не определить — тоже WARN. Ячейка годна: «ранняя» своим первым словом или файл в docs/evidence/ (путь, glob; непустой по тексту, симлинк наружу каталога — нет), а вне пути — n=<число ≥ 1>
    и числа p50/p95: «p50 1180, p95 2300» или «p50/p95 1180/2300», между именем и числом может стоять =, : или ≈.
    F5.2: звено вендора — слово «вендор» в ячейке звена или слово vendor_words в ячейках звена и инструмента (решение 398; имена вендоров у telefon стоят в инструменте); судится парой:
    «ранняя» или слово pair вне пути и файл со строкой итога checks/paired_stand.sh; n и p50/p95 её не заменяют."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    rows, bad, home = landing_rows(read(spec)), [], os.path.join(os.path.realpath("."), "docs", "evidence") + os.sep  # от корня: сам docs/evidence бывает симлинком
    vendor = planken_words("vendor_words")
    for name, cell, tool in rows:
        if re.match(r"[^\w<]*ранняя\b", cell, re.I):  # своё первое слово: «<файл … или «ранняя»>» и «не ранняя» — не пометка
            continue
        f = EVIDENCE.search(cell)
        path = f.group(0).rstrip(".:!…»”\"'") if f else ""  # * и ? в конце — glob
        found = [p for p in glob.glob(path) if os.path.isfile(p)]
        inside = [p for p in found if os.path.realpath(p).startswith(home)]  # симлинк наружу docs/evidence/ — не файл распределения
        texts = [evidence_text(p) for p in inside]
        rest = EVIDENCE.sub(" ", cell)
        n = re.search(r"\bn\s*=\s*(\d+)\b", rest)
        pct = re.search(r"\bp50\s*[=:≈]?\s*\d", rest, re.I) and re.search(r"\bp95\s*[=:≈]?\s*\d", rest, re.I) or re.search(r"\bp50\s*/\s*p95\s*[=:≈]?\s*[\d.,]+\s*/\s*\d", rest, re.I)
        source = "нет docs/evidence/<файл>" if not os.path.normpath(path).startswith("docs/evidence/") else f"нет файла {path}" if not found \
            else f"симлинк наружу docs/evidence/ — {path}" if not inside else f"пустой файл {path}" if not any(texts) else None
        if "вендор" in name.lower() or vendor and vendor.search(f"{name}\n{tool}"):  # F5.2: абсолютный перцентиль стенда звено вендора не судит — нужен результат пары
            why = "звено вендора: нет pair и нет «ранняя»" if not re.search(r"\bpair\b", rest) else source or (None if any(map(PAIR_LINE.search, texts)) else f"звено вендора: нет строки PAIR_OK|PAIR_FAIL в {path}")
        else:
            why = source or ("нет n=" if not (n and int(n.group(1))) else "нет p50/p95" if not pct else None)
        if why:
            bad.append(f"«{name[:40]}»: {why}")
    if not rows:
        return []
    if not bad:
        return [("OK", "planka-source", f"{spec}: планок {len(rows)}, у всех файл распределения или «ранняя»")]
    shallow = git("rev-parse", "--is-shallow-repository").stdout.strip() == "true"
    weight, note = ("WARN", " (история git обрезана: выдана ли SPEC — не определить)") if shallow \
        else ("WARN", " (SPEC уже выдана: правит тимлид)") if issued(spec, prompt) else ("FAIL", "")
    return [(weight, "planka-source", f"{spec}: планок {len(rows)}, без файла распределения и без «ранняя» — {'; '.join(bad)}{note}")]


def amendments(t):  # строки «Поправка …» в §0 SPEC (F2.2); их же считает bin/phase-report (F5.4)
    sec0 = re.search(r"^## 0\.[^\n]*\n(.*?)(?=^## |\Z)", t, re.S | re.M)
    return len(AMEND.findall(sec0.group(1))) if sec0 else 0


def rule_risk(b):
    """v3.4, F7.1: фича с деплоем на линию (токен или слово deploy_words в её строке или пунктах, решение 398) — только с `risk: high` в строке фичи: иначе красная до выдачи SPEC;
    выданная SPEC, идущая фаза (слова списка меняются на ходу, построенную фичу красным не вернуть) или обрезанная история — WARN.
    Решение 400: явная метка сильнее слов — `risk: low` в строке фичи, у которой только слова списка, — OK с пометкой «low: слова деплоя»; токен шаблона деплоя — выкатка, ему нужна `high`."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    words = planken_words("deploy_words")
    deployed = [(f, ls) for f, ls in blocks(read(spec).splitlines()) if any(DEPLOY_LINE.search(l) or words and words.search(l) for l in ls)]
    label = lambda ls: (re.search(r"·\s*risk:\s*(high|low)\b", ls[0]) or [None, None])[1]
    low = [f for f, ls in deployed if label(ls) == "low" and not any(DEPLOY_LINE.search(l) for l in ls)]
    bad = [f for f, ls in deployed if label(ls) != "high" and f not in low]
    if not bad:
        return [("OK", "risk-tier", f"{spec}: фич с деплоем на линию (токен или deploy_words): {len(deployed)}, "
                                    + (f"risk: high — {len(deployed) - len(low)}; low: слова деплоя — {' '.join(low)}" if low else "у всех risk: high"))]
    shallow = git("rev-parse", "--is-shallow-repository").stdout.strip() == "true"
    weight, note = ("WARN", " (история git обрезана: выдана ли SPEC — не определить)") if shallow \
        else ("WARN", " (SPEC уже выдана: правит тимлид)") if issued(spec, prompt) or in_flight(spec, prompt) else ("FAIL", "")
    return [(weight, "risk-tier", f"{' '.join(bad)}: деплой на линию без risk: high в строке фичи {spec}{note}")]


def rule_scope(b):
    """v3.4, F2.2: новая фича против SPEC на выдаче — только строкой «Поправка» в §0; поправки считаются. Выдача — первый коммит, где стартовый запрос называет эту
    SPEC: поздняя правка запроса базу не двигает; SPEC там ещё нет — её первый коммит; в истории её нет вовсе — база она сама. Повтор id — тоже новая фича: сравниваются счета."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    first = lambda *a: git("log", "--reverse", "--format=%H", *a).stdout.split()[:1]
    base = next((r.stdout for c in first(f"-S{spec}", "--", prompt) + first("--", spec) for r in [git("show", f"{c}:{spec}")] if r.returncode == 0), None)
    ids = lambda text: [m.group(1) for l in text.splitlines() for m in [FEATURE.match(l)] if m]
    text = read(spec)
    was, now = ids(text if base is None else base), ids(text)
    new = [f for i, f in enumerate(now) if now[:i + 1].count(f) > was.count(f)]

    k = amendments(text)
    paid = max(k - amendments(text if base is None else base), 0)  # строка, что была на выдаче, за новую фичу не платит
    if len(new) > paid:
        return [("FAIL", "scope-growth", f"{' '.join(new[paid:])}: новая фича без строки «Поправка <решение>: слово оператора <дата>» в §0 {spec}; фич на выдаче {len(was)}, сейчас {len(now)}, поправок: {k}")]
    return [("OK", "scope-growth", f"{spec}: фич на выдаче {len(was)}, сейчас {len(now)}, поправок: {k}")]


def numbers(v):
    if isinstance(v, dict):
        return [n for x in v.values() for n in numbers(x)]
    if isinstance(v, list):
        return [n for x in v for n in numbers(x)]
    if type(v) is float and v.is_integer():
        return [int(v)]  # JSON 3300.0 — в тексте 3300
    return [v] if type(v) in (int, float) else []


def rule_planken(b):
    """v3.4, F2.3: `planken:<ключ>` — ключ есть в checks/planken.json, а чисел его коридора нет во всём тексте SPEC; сами токены `planken:` не в счёт. Число — и с десятичной
    запятой, и с пробелом, U+00A0 или U+202F между тысячами."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec = ph[2]
    text = read(spec)
    refs = sorted(set(KEYREF.findall(text)))
    if not refs:
        return []
    try:
        data = json.loads(read(PLANKEN))
    except OSError:
        return [("FAIL", "planken-key", f"{spec}: ключи {', '.join(refs)} — нет файла {PLANKEN}")]
    except ValueError:
        return [("FAIL", "planken-key", f"{spec}: ключи {', '.join(refs)} — {PLANKEN} не JSON")]

    def value(key):
        v = data
        for part in key.split("."):
            if not isinstance(v, dict) or part not in v:
                raise KeyError(key)
            v = v[part]
        return v
    lost, vals = [], {}
    for k in refs:
        try:
            vals[k] = value(k)
        except KeyError:
            lost.append(k)
    if lost:
        return [("FAIL", "planken-key", f"{spec}: ключей нет в {PLANKEN} — {', '.join(lost)}")]
    flat = re.sub(r"(?<=\d)[ \u00a0\u202f](?=\d{3}(?!\d))", "", KEYREF.sub("", text))
    inline = [f"{k}: {n}" for k in refs for n in numbers(vals[k]) if re.search(rf"(?<![\w.,]){str(n).replace('.', '[.,]')}(?!\d)", flat)]
    if inline:
        return [("WARN", "planken-inline", f"{spec}: числа коридора в тексте при ключе — {', '.join(sorted(set(inline)))}: логика судьи — в {PLANKEN}")]
    return [("OK", "planken-key", f"{spec}: ключей {len(refs)}, все в {PLANKEN}, чисел коридора в тексте нет")]


def rule_plan(b):
    ph = phase()
    if not ph or not ph[3]:
        return []
    if not os.path.isfile(ph[3]):
        return [("OK", "plan", f"{ph[3]} ещё нет — шаг 0 фазы не сделан")]
    return [check("plan_lines", len(read(ph[3]).splitlines()), b["plan_lines"], f"{ph[3]}, строк")]


def blocking(text):
    n, on = 0, False
    for line in text.splitlines():
        if line.startswith("#"):
            on = bool(re.match(r"#+\s*(Блокирующ|Blocking)", line))
        elif on and re.match(r"(- |\d+\. )", line):
            n += 1
    return n


def rule_review(b):
    out = [check("review_blocking", blocking(read(p)), b["review_blocking"], f"{p}: блокирующих")
           for p in sorted(glob.glob("docs/reviews/*.md"))]
    return out or [("OK", "review", "нет docs/reviews/*.md")]


def rule_intent(b):
    out, intent = [], "intent/INTENT.md"
    if os.path.isfile(intent):
        n = len(MARKER.findall(CODE.sub("", read(intent))))
        out.append(("WARN" if n else "OK", "intent", f"{intent}: маркеров неясности {n}"))
    ph = phase()
    spec = ph[2] if ph else None
    if not spec or not os.path.isfile(spec):
        return out
    s = read(spec)
    n = len(MARKER.findall(CODE.sub("", s)))
    out.append(("FAIL" if n else "OK", "intent", f"{spec}: маркеров неясности {n}"))
    if not os.path.isfile(intent):
        return out + [("FAIL", "intent", f"{spec} есть, а {intent} нет")]
    real = git("hash-object", intent).stdout.strip()[:12]
    m = re.search(r"intent/INTENT\.md @ ([0-9a-f]+)", s)
    out.append(("OK" if m and m.group(1) == real else "FAIL", "pin",
                f"пин SPEC {m.group(1) if m else 'нет'} · git hash-object {intent} {real}"))
    known = sorted(set(re.findall(r"\*\*(S\d+)\*\*", read(intent))), key=lambda x: int(x[1:]))
    bad = []
    for line in s.splitlines():
        f = FEATURE.match(line)
        if f:
            m = re.search(r"служит:\s*([^·\n]*)", line)
            refs = re.findall(r"S\d+", m.group(1)) if m else []
            if not refs or not set(refs) <= set(known):
                bad.append(f"{f.group(1)}→{','.join(refs) or 'нет поля служит'}")
    return out + [("FAIL" if bad else "OK", "signal",
                   f"сигналы intent {','.join(known) or 'нет'}; фич без существующего S — {'; '.join(bad) or 'нет'}")]


def owner_at(rev, fallback):
    """Список владения на ревизии: файл тимлида тот, что был им ДО коммита (v3.1, хвост 3). Нет budgets.json — кит ещё
    не стоял, файлов тимлида нет; не разбирается — список HEAD."""
    r = git("show", f"{rev}:budgets.json")
    if r.returncode:
        return []
    try:
        raw = json.loads(r.stdout)
        return with_prompt(raw["defaults"]["owner"] + ((raw.get("project") or {}).get("owner_add") or []))
    except (ValueError, KeyError, TypeError, AttributeError):
        return fallback


def rule_owner(b):
    # v3.2: проверка END STATE ушла вместе с шаблоном GOAL (SPEC-v3.2 §1; прежняя версия — в истории git); остался lint коммитов
    out, owner = [], b["owner"]
    base = next((r.stdout.strip() for ref in ("main", "origin/main")
                 for r in [git("merge-base", ref, "HEAD")] if r.returncode == 0), None)
    if not base:
        return out + [("OK", "owner", "нет main/origin/main или коммитов — lint коммитов пропущен")]
    # -z: пути как есть — без кавычек и \-escape не-ASCII (core.quotePath), каждый до NUL; \x01 — начало коммита
    log = git("log", "-z", "--no-merges", "--no-renames", "--name-only", "--format=%x01%h %s", f"{base}..HEAD").stdout
    tl, op = [], []
    for chunk in log.split("\x01")[1:]:
        head, _, names = chunk.partition("\0")
        sha, _, subj = head.partition(" ")
        own = owner_at(f"{sha}^", owner)
        paths = [p for p in (n.lstrip("\n") for n in names.split("\0")) if p]
        hit = [p for p in paths if is_tl(p, own)]
        if subj.startswith("Тимлид:"):
            tl.append(f"{sha} {subj}")
        elif subj.startswith("Оператор:"):  # SPEC-v3.5 F6: слово оператора — только пути окна доводки SPEC на родителе коммита
            win = window_at(f"{sha}^")
            out_ = [p for p in paths if not (win and any(p == w or (w.endswith("/") and p.startswith(w)) for w in win[0]))]
            if out_:
                out.append(("FAIL", "owner", f"{sha} «{subj}» — вне окна доводки SPEC §3{'' if win else ' (окна нет)'}: {', '.join(out_)}"))
            else:
                op.append(f"{sha} {subj}")
        elif hit:
            out.append(("FAIL", "owner", f"{sha} «{subj}» меняет файлы тимлида без «Тимлид:»: {', '.join(hit)}"))
    ops = f"; «Оператор:» в окне — {len(op)}: {'; '.join(op)}" if op else ""
    return out + [("OK", "owner", f"коммитов «Тимлид:» после merge-base {base[:7]} — {len(tl)}: {'; '.join(tl) or '—'}{ops}")]


WINDOW = re.compile(r"Окно доводки:\s*открыто\s+(.*?)\s*·\s*запас диффа\s+(\d+)")  # SPEC-v3.5 F6: строка §3 — её же читают bin/operator-word и хук коммита


def window_at(rev):
    """([пути], запас) окна доводки §3 SPEC фазы в rev или None."""
    m = re.search(r"^Read first:\s*([^,\s]+)", git("show", f"{rev}:docs/PROMPT.txt").stdout, re.M)
    text = git("show", f"{rev}:{m.group(1)}").stdout if m and re.fullmatch(r"(.*/)?SPEC-[^/]+\.md", m.group(1)) else ""
    sec3 = re.search(r"^## 3\.[^\n]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    w = WINDOW.search(sec3.group(1)) if sec3 else None
    paths = re.findall(r"`([^`\s]+)`", w.group(1)) if w else []
    return (paths, int(w.group(2))) if paths else None


def rule_abide(b):
    """v3.2, F3: правил в рубрике Abide (файл тимлида) — не больше abide_rules. v3.3, F7.3: нет рубрики — FAIL: хук коммита молча
    пропускал бы суд модели."""
    p = ".abide/rubric.json"
    if not os.path.isfile(p):
        return [("FAIL", "abide_rules", f"нет {p} — abide check в хуке коммита пропускает суд модели: база рубрики — из кита "
                 "(bin/two-tier-init, two-tier-upgrade), коммитом «Тимлид: …»")]
    try:
        rules = json.loads(read(p)).get("rules")
    except (ValueError, AttributeError):
        return [("FAIL", "abide_rules", f"{p}: не JSON-объект")]
    if not isinstance(rules, list) or not rules:  # v3.3, F7.3: пустая рубрика или rules не список — тот же тихий пропуск суда модели
        return [("FAIL", "abide_rules", f"{p}: rules — {'0 правил' if rules == [] else 'не список' if rules is not None else 'нет'} — "
                 "abide check в хуке коммита пропускает суд модели")]
    n = len(rules)
    if "abide_rules" not in b:
        return [("WARN", "abide_rules", f"{p}: правил {n}; в budgets.json нет abide_rules — ключ вносит тимлид")]
    return [check("abide_rules", n, b["abide_rules"], f"{p}, правил")]


def rule_frozen(b):
    """v3.4, F3.1: CI судит и коммит мимо хука — судья замка, если есть он и frozen.json в HEAD; проект без замка правила не имеет."""
    if not os.path.isfile("bin/check-frozen-diff") or git("cat-file", "-e", "HEAD:frozen.json").returncode:
        return []
    r = subprocess.run([sys.executable, "bin/check-frozen-diff"], capture_output=True, encoding="utf-8", errors="replace")
    return [("FAIL" if r.returncode else "OK", "frozen-paths", ((r.stdout + r.stderr).strip().splitlines() or ["судья без вывода"])[-1])]


# ---------- SPEC-v3.5 F4, F5, F7: линты выдачи ----------
REPORT_ITEM = re.compile(r"\s*отч[её]т:", re.I)  # F4: пункт ранней планки — отчёт: текст пункта начинается словом «отчёт:»
BASIS = re.compile(r"Судьи деплоя и регрессии, изменённые фазой, на базе:\s*(?:\d+\s+из\s+\d+|нет)(?![\w<])")  # F5.1: строка §5 SPEC
NEW_PATHS = re.compile(r"^[ \t]*-?[ \t]*\**Новые пути:\**(.*)$", re.M)  # F5.2: строка §1 SPEC — пути, которых ещё нет в HEAD
BRANCH_FORM = re.compile(r"\bbranch\s+`?([\w./-]+)`?\s+(?:only|from)\b", re.I)  # форма, которую читает /phase (mods/phase-start, branchOf)
VERDICT_PIN = re.compile(r"^spec:\s*(\S+)\s*@\s*([0-9a-f]{12})\s*$")  # F7: третья строка вердикта свежего проверяющего


def issue_weight(spec, prompt):
    """FAIL до выдачи; выданная SPEC, идущая фаза или evidence этой SPEC в HEAD (фаза была: так её видно и после слияния и правки тимлида — копия
    клона telefon, SPEC-11) — WARN (правит тимлид); обрезанная история — WARN. Линты выдачи SPEC-v3.5: planka-early, basis-judge, spec-paths."""
    if git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        return "WARN", " (история git обрезана: выдана ли SPEC — не определить)"
    if issued(spec, prompt) or in_flight(spec, prompt):
        return "WARN", " (SPEC уже выдана: правит тимлид)"
    ev = spec_evidence_in_head(spec)
    return ("WARN", f" (фаза была: evidence этой SPEC в HEAD — {ev}; правит тимлид)") if ev else ("FAIL", "")


def landing_tables(text):
    """Таблицы посадки — [(заголовок, [(строка, ячейка «измерено у нас»)])]: заголовок — непустые строки над шапкой до пустой и сама шапка; разделитель и таблица в ``` — не строки."""
    out, lines, fence, i = [], text.splitlines(), False, 0
    split = lambda l: [c.strip() for c in re.split(r"(?<!\\)\|", re.sub(r"^\||(?<!\\)\|$", "", l.strip()))]
    while i < len(lines):
        l = lines[i]
        if re.match(r"\s*```", l):
            fence = not fence
        if fence or not l.lstrip().startswith("|") or "измерено у нас" not in l.lower():
            i += 1
            continue
        col = next(k for k, c in enumerate(split(l)) if "измерено у нас" in c.lower())
        j, head = i - 1, [l]
        while j >= 0 and lines[j].strip() and not lines[j].lstrip().startswith("|") and not lines[j].startswith("#"):
            head.insert(0, lines[j])
            j -= 1
        rows, i = [], i + 1
        while i < len(lines) and lines[i].lstrip().startswith("|"):
            cs = split(lines[i])
            if not all(c and not c.strip("-:") for c in cs):
                rows.append((lines[i], cs[col] if col < len(cs) else ""))
            i += 1
        out.append(("\n".join(head), rows))
    return out


def rule_planka_early(b):
    """SPEC-v3.5 F4: пункт, связанный с ранней планкой (его id или ключ `planken:` в заголовке или строке её таблицы посадки, ячейка — «ранняя»), — отчёт:
    начинается словом «отчёт:» и маркер фичи от него не зависит. Иначе FAIL до выдачи, WARN после."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    text = read(spec)
    items = {m.group(1): m.group(2) for l in text.splitlines() for m in [ITEM.match(l)] if m}
    keys = {i: set(KEYREF.findall(t)) for i, t in items.items()}
    early, bad = 0, []
    for head, rows in landing_tables(text):
        for raw, cell in rows:
            if not re.match(r"[^\w<]*ранняя\b", cell, re.I):
                continue
            early += 1
            where = f"{head}\n{raw}"
            refs = set(KEYREF.findall(where))
            bad += [i for i in items if (re.search(rf"(?<![\w.]){re.escape(i)}(?!\d)", where) or keys[i] & refs) and not REPORT_ITEM.match(items[i]) and i not in bad]
    if not bad:
        return [("OK", "planka-early", f"{spec}: ранних планок {early}, связанных пунктов без «отчёт:» — нет")]
    weight, note = issue_weight(spec, prompt)
    return [(weight, "planka-early", f"{' '.join(bad)}: пункт ранней планки судит маркер фичи — текст не начинается словом «отчёт:» ({spec}){note}")]


def rule_basis(b):
    """SPEC-v3.5 F5.1: §5 SPEC называет судей деплоя и регрессии, изменённых фазой и прогнанных на базе: «… на базе: <n из m | нет>»."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    sec5 = re.search(r"^## 5\.[^\n]*\n(.*?)(?=^## |\Z)", read(spec), re.S | re.M)
    if sec5 and BASIS.search(sec5.group(1)):
        return [("OK", "basis-judge", f"{spec}: строка «Судьи деплоя и регрессии, изменённые фазой, на базе:» в §5 — есть")]
    weight, note = issue_weight(spec, prompt)
    return [(weight, "basis-judge", f"{spec}: в §5 нет строки «Судьи деплоя и регрессии, изменённые фазой, на базе: <n из m | нет>»{note}")]


def path_tokens(text):
    """Пути и цели make в обратных кавычках: первое слово токена; `make <цель>` — с остатком (флаг после цели — ошибка)."""
    for tok in re.findall(r"`([^`\n]+)`", text):
        words = tok.split()
        if words and words[0] == "make" and len(words) > 1:
            yield ("make", words[1], words[2:])
        elif words:
            yield ("path", re.sub(r"[:#]\d[\w,.-]*$", "", words[0]).rstrip(".,;:»)"), [])


def rule_spec_paths(b):
    """SPEC-v3.5 F5.2–F5.4: путь или `make <цель>` в обратных кавычках SPEC и стартового запроса существует в HEAD или назван в строке «Новые пути:» §1. Путь — первое
    слово токена, если оно начинается с каталога верхнего уровня HEAD; слэш-команды, голые имена, пути вне репо, шаблоны с <…> и *, игнорируемое git — не судятся.
    Запрос называет ветку формой /phase: `branch <b> only` или `branch <b> from <c>`."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec, prompt = ph[2], ph[4]
    stext, ptext = read(spec), read(prompt)
    tops = {n for n in git("ls-tree", "--name-only", "-d", "HEAD").stdout.split("\n") if n}
    new = {w for line in NEW_PATHS.findall(stext) for kind, w, _ in path_tokens(line) if kind == "path"}
    makefile = git("show", "HEAD:Makefile").stdout
    targets = set(re.findall(r"^([A-Za-z0-9_.-]+):", makefile, re.M))
    in_head = lambda p: git("cat-file", "-e", f"HEAD:{p.rstrip('/')}").returncode == 0
    ignored = lambda p: git("check-ignore", "-q", "--no-index", p).returncode == 0
    has_head = git("rev-parse", "-q", "--verify", "HEAD").returncode == 0  # без HEAD (пример шаблонов вне git) пути и цели не судятся
    bad, seen = [], 0  # (что, почему)
    for src, text in ((spec, stext), (prompt, ptext)):
        for kind, w, rest in path_tokens(text):
            if kind == "make":
                if "<" in w or not has_head:
                    continue
                seen += 1
                if w not in targets:
                    bad.append((f"make {w}", f"{src}: цели нет в Makefile HEAD"))
                elif rest and rest[0].startswith("-"):
                    bad.append((f"make {w} {rest[0]}", f"{src}: make не принимает флаг после цели"))
                continue
            if "/" not in w or w.split("/", 1)[0] not in tops or re.search(r"[<*?]", w):
                continue
            seen += 1
            if not (in_head(w) or w in new or w.rstrip("/") in new or ignored(w)):
                bad.append((w, f"{src}: нет в HEAD и в строке «Новые пути:»"))
    if not BRANCH_FORM.search(ptext):
        bad.append(("ветка", f"{prompt}: не названа формой /phase — «branch <b> only» или «branch <b> from <c>»"))
    if not bad:
        return [("OK", "spec-paths", f"{spec}, {prompt}: путей и целей make {seen}, все в HEAD, в «Новые пути:» или вне суда; ветка — формой /phase")]
    weight, note = issue_weight(spec, prompt)
    what = list(dict.fromkeys(w for w, _ in bad))
    why = list(dict.fromkeys(f"{w} ({r})" for w, r in bad))
    return [(weight, "spec-paths", f"{', '.join(what)}: {'; '.join(why)}{note}")]


def spec_evidence_in_head(spec):
    """В HEAD есть evidence этой SPEC — файл docs/evidence/*-result.txt с первой строкой `spec: SPEC-<n>`: фаза начата (F7.3)."""
    want = "spec: " + re.sub(r"\.md$", "", os.path.basename(spec))
    for n in git("ls-tree", "--name-only", "HEAD", "docs/evidence/").stdout.split("\n"):
        if n.endswith("-result.txt") and git("show", f"HEAD:{n}").stdout.lstrip("﻿").split("\n", 1)[0].strip() == want:
            return n
    return None


def rule_spec_review(b):
    """SPEC-v3.5 F7: SPEC из запроса прочитана свежим проверяющим до «принято» — в docs/reviews/ вердикт PASS с её пином (первые три строки файла: вердикт, счёт,
    `spec: <путь> @ <12 знаков git hash-object>`). Нет PASS с этим пином (NEEDS_WORK, пин другой версии, коммит после запроса — не замена) → FAIL; evidence этой SPEC в HEAD → WARN."""
    ph = phase()
    if not ph or not ph[2] or not os.path.isfile(ph[2]):
        return []
    spec = ph[2]
    pin = pin_of(read(spec))
    found = []
    for p in sorted(glob.glob("docs/reviews/*.md")):
        head = read(p).lstrip("﻿").split("\n")[:3]
        m = VERDICT_PIN.match(head[2].strip()) if len(head) == 3 else None
        verdict = head[0].split()[0] if head and head[0].split() else ""
        if m and verdict in ("PASS", "NEEDS_WORK") and os.path.normpath(m.group(1)) == os.path.normpath(spec):
            found.append((p, verdict, m.group(2)))
    if any(v == "PASS" and pn == pin for _, v, pn in found):
        return [("OK", "spec-review", f"{spec} @ {pin}: PASS свежего проверяющего — {next(p for p, v, pn in found if v == 'PASS' and pn == pin)}")]
    why = ("; ".join(f"{p}: {v} @ {pn}" + ("" if pn == pin else " — пин другой версии") for p, v, pn in found) or "вердикта с её пином в docs/reviews/ нет")
    ev = spec_evidence_in_head(spec)
    weight, note = ("WARN", f" (фаза начата: evidence этой SPEC в HEAD — {ev})") if ev else ("FAIL", "")
    return [(weight, "spec-review", f"{spec} @ {pin}: нет PASS свежего проверяющего с этим пином — {why}{note}")]


RULES = [rule_sizes, rule_spec_copy, rule_dollar, rule_prompt, rule_spec, rule_planka, rule_risk, rule_scope, rule_planken, rule_plan, rule_review, rule_intent, rule_owner, rule_abide, rule_frozen,
         rule_planka_early, rule_basis, rule_spec_paths, rule_spec_review]


def run(b):
    out = []
    for fn in RULES:
        out += fn(b)
    return out


def report(out):
    for s, r, m in out:
        print(f"{s:4} {r}: {m}")
    for s, r, m in out:
        if r in LINT_RULES and s != "OK":  # v3.4, F2: строка линта для гейта и тимлида; scope-growth называет фичи
            print(f"BUDGET_{s} {r}" + (" " + m.split(":", 1)[0] if r in ("scope-growth", "risk-tier", "planka-early", "spec-paths") else ""))
    fails = sum(s == "FAIL" for s, _, _ in out)
    print(f"BUDGET_FAIL: {fails}" if fails else "BUDGET_OK")
    return 1 if fails else 0


# ---------- self-test: каждая фикстура — свой временный проект в /tmp/two-tier-v3 ----------
# SPEC-v3.5 F6.4: фикстуры, играющие тимлида, зовут git в окружении своей роли — без CLAUDECODE сессии Claude Code
GIT_ENV = dict({k: v for k, v in os.environ.items() if k != "CLAUDECODE"}, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_NAME="t",
               GIT_AUTHOR_EMAIL="t@example.invalid", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@example.invalid")


def worst(out):
    ss = {s for s, _, _ in out}
    return "FAIL" if "FAIL" in ss else "WARN" if "WARN" in ss else "OK"


def in_fixture(fs, commits, fn):
    os.makedirs(TMP, exist_ok=True)
    d, here = tempfile.mkdtemp(prefix="check-budget-", dir=TMP), os.getcwd()
    try:
        os.chdir(d)
        for p, c in fs.items():
            write(p, c) if c is not None else None  # None — файла нет и в базе
        if commits is not None:
            g = lambda *a: subprocess.run(["git", *a], env=GIT_ENV, capture_output=True, check=True)
            if "budgets.json" not in fs:  # кит стоит с базы: список владения на родителе коммита — его
                write("budgets.json", json.dumps({"defaults": {"owner": BASE_OWNER}, "project": {}}))
            write("README.md", "base\n")
            write("docs/STATUS.md", "s\n")
            g("init", "-q", "-b", "main")
            g("config", "core.quotePath", "true")  # умолчание git — и при другом глобальном конфиге хоста
            g("add", "-A"); g("commit", "-qm", "base"); g("switch", "-qc", "v")
            for subj, add, rm in commits:
                for p, c in add.items():
                    write(p, c)
                for p in rm:
                    os.remove(p)
                g("add", "-A"); g("commit", "-qm", subj)
        return fn()
    finally:
        os.chdir(here)
        shutil.rmtree(d, ignore_errors=True)


BASE_OWNER = []  # owner кита для базы lint-фикстур; ставит self_test


def pin_of(text):
    data = text.encode("utf-8")
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()[:12]


