    add("owner", "не-ASCII пути тимлида (core.quotePath=true, умолчание git) коммитом без «Тимлид:»", "FAIL", {}, rule_owner,
        [("F1: x", {"intent/Gesprächsleitfaden.md": "x\n", "docs/reviews/ревью-1.md": "x\n"}, [])])
    # v3.1, хвост 3: budgets.json — файл тимлида; список владения — на родителе коммита
    bud = lambda owner: json.dumps({"defaults": dict(defaults, owner=owner), "project": {}})
    old = [e for e in defaults["owner"] if e != "budgets.json"]
    add("owner", "коммит вносит budgets.json в owner (на родителе его нет)", "OK", {"budgets.json": bud(old)}, rule_owner,
        [("F7: owner", {"budgets.json": bud(old + ["budgets.json"])}, [])])
    add("owner", "поздняя правка budgets.json исполнителем", "FAIL", {"budgets.json": bud(old + ["budgets.json"])}, rule_owner,
        [("F1: x", {"budgets.json": bud(old + ["budgets.json"]).replace("60", "59")}, [])])
    add("owner", "снять запись docs/STATUS.md из owner и править файл", "FAIL", {"budgets.json": bud(old + ["budgets.json"])}, rule_owner,
        [("F1: unown", {"budgets.json": bud([e for e in old if e != "docs/STATUS.md"] + ["budgets.json"])}, []),
         ("F1: edit", {"docs/STATUS.md": "y\n"}, [])])
    add("owner", "кит ставится коммитом с budgets.json (на родителе его нет)", "OK", {"budgets.json": None}, rule_owner,
        [("kit install", {"budgets.json": bud(old + ["budgets.json"]), "docs/PROGRESS.md": "x\n"}, [])])
    return C


def self_test(groups):
    b, out = load_budgets()
    if not b:
        return report(out)
    defaults = json.loads(read("budgets.json"))["defaults"]
    BASE_OWNER[:] = b["owner"]
    cases = fixtures(b, defaults)
    known = list(dict.fromkeys(c[0] for c in cases))
    bad_args = [g for g in groups if g not in known]
    if bad_args:
        print(f"неизвестные группы {bad_args}; есть: {' '.join(known)}")
        return 2
    all_ok = True
    for g in groups or known:
        ok = True
        for _, name, expect, fs, fn, commits in (c for c in cases if c[0] == g):
            got = in_fixture(fs, commits, lambda: worst(fn(dict(b))))
            ok &= got == expect
            print(f"{'ok ' if got == expect else 'BAD'} {g} · {name}: ждали {expect}, получили {got}")
        print(f"{g.upper()}_OK" if ok else f"{g.upper()}_FAIL")
        all_ok &= ok
    print("SELFTEST_OK" if all_ok else "SELFTEST_FAIL")
    return 0 if all_ok else 1


# ---------- --lints: линты спеки обеими сторонами (SPEC-v3.4 F2) ----------
def lint_fixture_spec(cell="<ячейка>", extra="", sec0="Контекст.\n", feats=("F1",)):
    fl = "\n".join(f"- **{f} x** · готово: {f}.1 · чек: `bin/x` → `X_OK` · служит: S1 · after: —\n  - `{f}.1` `bin/x` печатает X" for f in feats)
    return (f"# SPEC-1\n\n## 0. Контекст\n{sec0}\n## 2. Фичи\n{fl}\n{extra}\n"
            "| звено | инструмент | нижняя оценка | источник | измерено у нас (`docs/evidence/<файл>`, n, p50/p95) |\n|---|---|---|---|---|\n"
            f"| сборка | Opus | 10 мин | док | {cell} |\n| **сумма** | | 10 мин | | — |\n\n## 3. Инварианты\n")


def lints():
    b, out0 = load_budgets()
    if not b:
        return report(out0)
    ok_all = []
    me, budgets = os.path.realpath(__file__), read("budgets.json")

    def run_side(fs, commits, fn):
        res = in_fixture(fs, commits, lambda: fn(dict(b)))
        return worst(res), " ".join((res[0][2] if res else "нет строки").split())[:200]

    def plain(fs, commits=None):  # настоящий скрипт, не правило: правила стоят в RULES, строки BUDGET_ печатает report
        def go():
            r = subprocess.run([sys.executable, me], capture_output=True, text=True)
            return r.returncode, r.stdout.splitlines()
        return in_fixture({"budgets.json": budgets, **fs}, commits, go)

    def judge(rows):
        """[(сторона, статус, кусок сообщения, результат)] → (все совпали, сырой вывод): у красной стороны один дефект и своя причина."""
        hit = [r[0] == st and piece in r[1] for _, st, piece, r in rows]
        return all(hit), "; ".join(f"{n} — {r[0]}" + ("" if h else f" «{r[1]}», ждали {st} «{piece}»") for (n, st, piece, r), h in zip(rows, hit))

    def emit(iid, ok, text):
        ok_all.append(bool(ok))
        print(f"{iid} {'' if ok else 'FAIL: '}{text}", flush=True)
    pr = {"docs/PROMPT.txt": "Read first: docs/SPEC-1.md\n"}
    ev = {"docs/evidence/x.txt": "x\n"}
    work = [("F1.1: работа", {"src/x.py": "x\n"}, [])]
    good = "`docs/evidence/x.txt`, n=12, p50 2100, p95 3300"
    # F2.1
    s = lambda cell: {**pr, **ev, "docs/SPEC-1.md": lint_fixture_spec(cell)}
    pk = lambda cell, extra={}, commits=None: run_side({**s(cell), **extra}, commits, rule_planka)
    tb = lambda *lines: run_side({**pr, **ev, "docs/SPEC-1.md": "# SPEC-1\n\n" + "\n".join(lines) + "\n"}, None, rule_planka)
    head, sep = "| звено | измерено у нас |", "|---|---|"
    no_file, no_n, no_pct = "нет docs/evidence/<файл>", "нет n=", "нет p50/p95"

    def dirty(path, text):  # правка на диске, без коммита
        def go(_b):
            write(path, text)
            return rule_planka(_b)
        return go

    def cut(_b):  # клон глубины 1: коммит запроса выглядит как HEAD
        subprocess.run(["git", "clone", "-q", "--depth", "1", "file://" + os.getcwd(), "cut"], env=GIT_ENV, capture_output=True, check=True)
        os.chdir("cut")
        return rule_planka(_b)

    def linked(target, rel="docs/evidence/l.txt", extra={}):  # симлинк в фикстуре, как его оставил бы проект: цель — от каталога ссылки
        def go(_b):
            os.symlink(target, rel)
            return rule_planka(_b)
        return run_side({**s(f"`{rel}`, n=12, p50 1, p95 2"), "docs/PROGRESS.md": "x\n", **extra}, None, go)
    r1 = pk("≈ 2 ч")
    changed = pk("≈ 2 ч", commits=work + [("Тимлид: поправка SPEC", {"docs/SPEC-1.md": lint_fixture_spec("≈ 3 ч")}, [])])
    rot, rot_text = judge([
        ("без файла", "FAIL", no_file, r1),
        ("файла нет на диске", "FAIL", "нет файла docs/evidence/nope.txt", pk("`docs/evidence/nope.txt`, n=12, p50 1, p95 2")),
        ("каталог вместо файла", "FAIL", "нет файла docs/evidence/sub", pk("`docs/evidence/sub`, n=1, p50 1, p95 2", {"docs/evidence/sub/a.txt": "x\n"})),
        ("glob без совпадений", "FAIL", "нет файла docs/evidence/verify-*", pk("`docs/evidence/verify-*`, n=2, p50 1, p95 2")),
        ("пустой файл", "FAIL", "пустой файл docs/evidence/e.txt", pk("`docs/evidence/e.txt`, n=12, p50 1, p95 2", {"docs/evidence/e.txt": ""})),
        ("файл из пробелов", "FAIL", "пустой файл docs/evidence/w.txt", pk("`docs/evidence/w.txt`, n=12, p50 1, p95 2", {"docs/evidence/w.txt": " \n\t\n"})),
        ("файл из BOM и пробелов", "FAIL", "пустой файл docs/evidence/w.txt", pk("`docs/evidence/w.txt`, n=12, p50 1, p95 2", {"docs/evidence/w.txt": "\ufeff \n"})),
        ("файл из NUL", "FAIL", "пустой файл docs/evidence/w.txt", pk("`docs/evidence/w.txt`, n=12, p50 1, p95 2", {"docs/evidence/w.txt": "\0\0\0\n"})),
        ("файл из пробела нулевой ширины", "FAIL", "пустой файл docs/evidence/w.txt", pk("`docs/evidence/w.txt`, n=12, p50 1, p95 2", {"docs/evidence/w.txt": "\u200b\n"})),
        ("симлинк наружу docs/evidence/", "FAIL", "симлинк наружу docs/evidence/ — docs/evidence/l.txt", linked("../PROGRESS.md")),
        ("симлинк с абсолютной целью", "FAIL", "симлинк наружу", linked("/etc/hosts")),
        ("симлинк каталога наружу", "FAIL", "симлинк наружу", run_side({**s("`docs/evidence/d/a.txt`, n=12, p50 1, p95 2"), "docs/other/a.txt": "x\n"}, None, lambda _b: (os.symlink("../other", "docs/evidence/d"), rule_planka(_b))[1])),
