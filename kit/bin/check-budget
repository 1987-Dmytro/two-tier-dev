    g53, r53 = judge(f53_green), judge(f53_red)
    n53 = sum(r[3][0] == "OK" for r in f53_green)
    emit("F5.3", g53[0] and r53[0], f"ok={n53}/5 · {g53[1]} · красные без условия: {r53[1]}")
    s11 = [  # kit-fixes §3, К F5: ошибки SPEC-11 v2
        ("путь профиля", "profiles/tab-code-v2.json", ps(item("`profiles/tab-code-v2.json`"), files={**bx, "profiles/tab-code.json": "{}\n"})),
        ("файл ревью", "docs/reviews/2026-11-09-spec11.md", ps(item("`docs/reviews/2026-11-09-spec11.md`"), files={**bx, "docs/reviews/2026-11-10-spec11.md": "x\n"})),
        ("make <цель> --флаг", "make check-live --ab", ps(item("`make check-live --ab`"))),
        ("запрос без branch <b> only|from", "ветка", ps(item("`bin/x`"), prompt="Read first: docs/SPEC-1.md\nWork on branch phase-1.\n")),
    ]
    named = [(n, w, r) for n, w, r in s11 if r[0] == "FAIL" and r[1].startswith(w)]
    emit("F5.4", len(named) == 4, f"spec11={len(named)}/4 · " + "; ".join(f"{n} — {r[0]} «{r[1][:110]}»" for n, _, r in s11))
    if all(ok_all[-4:]):
        print("SPEC_PATHS_OK")

    # F7 — свежий проверяющий спеки до подписи
    r71 = tred(tmpl([("REVIEW.md", "## Спека до подписи", "## Спека")]), "REVIEW.md", "## Спека до подписи")
    v71 = contract_ok("REVIEW.md")
    emit("F7.1", v71 and r71[0], f"abschnitt={'OK' if v71 else 'нет'} rot={'OK' if r71[0] else 'нет'} · {vor} · без раздела — «{r71[1][:160]}»")
    spec7 = spec5(basis.format("нет"))
    pin7 = pin_of(spec7)
    verdict = lambda v, pin, path="docs/SPEC-1.md": {"docs/reviews/1-spec.md": f"{v}\nблокирующих 0, named 2\nspec: {path} @ {pin}\n\nсчёт прежних прогонов: 1\n"}
    sr = lambda files={}, commits=(): lr(rule_spec_review, spec7, files, commits)
    other = pin_of(spec7 + "правка\n")
    work7 = [("F1.1: работа", {"src/x.py": "x\n"}, [])]
    ev7 = [("F1.1: evidence", {"docs/evidence/F1-x-result.txt": "spec: SPEC-1\nF1.1 x\n"}, [])]
    f72 = judge([
        ("PASS нет", "FAIL", "вердикта с её пином в docs/reviews/ нет", sr()),
        ("PASS с её пином", "OK", "PASS свежего проверяющего", sr(verdict("PASS", pin7))),
    ])
    rc72, line72 = plain_line(spec7, "spec-review")
    ok72 = f72[0] and rc72 == 1 and line72 == "BUDGET_FAIL spec-review"
    emit("F7.2", ok72, f"ohne={'FAIL' if ok72 else 'нет'} mit={'OK' if f72[0] else 'нет'} · bin/check-budget на фикстуре — rc {rc72} «{line72}» · {f72[1]}")
    f73 = [
        ("NEEDS_WORK с её пином", "FAIL", f"NEEDS_WORK @ {pin7}", sr(verdict("NEEDS_WORK", pin7))),
        ("PASS с пином другой версии", "FAIL", "пин другой версии", sr(verdict("PASS", other))),
        ("коммит после запроса без PASS", "FAIL", "вердикта с её пином в docs/reviews/ нет", sr(commits=work7)),
    ]
    ok73, t73 = judge(f73)
    w73 = judge([("evidence этой SPEC в HEAD", "WARN", "фаза начата: evidence этой SPEC в HEAD — docs/evidence/F1-x-result.txt", sr(commits=work7 + ev7))])
    n73 = sum(r[3][0] == "FAIL" for r in f73)
    emit("F7.3", ok73 and w73[0], f"fail={n73}/3 evidence={'WARN' if w73[0] else 'нет'} · {t73} · {w73[1]}")
    r74 = tred(tmpl([("docs/PROCESS.template.md", "claude -p --model claude-opus-5-5", "claude -p")]), "PROCESS.template.md", "claude -p --model claude-opus-5-5")
    v74 = contract_ok("PROCESS.template.md")
    emit("F7.4", v74 and r74[0], f"zeile={'OK' if v74 else 'нет'} rot={'OK' if r74[0] else 'нет'} · {vor} · без строки проверяющего — «{r74[1][:160]}»")
    if all(ok_all[-4:]):
        print("SPEC_REVIEW_OK")

    # F9.1 — копия team-lead-spec у тимлида не длиннее team_lead_spec_copy_chars: знаки, не байты; ключ из кита, а не из budgets.json корня, — WARN
    key91 = "team_lead_spec_copy_chars"
    lim91 = json.loads(read(f"{kroot}/budgets.json"))["defaults"].get(key91) or 8000

    def copy_side(n, kit_key=False):
        own = json.loads(budgets)
        own["defaults"].pop(key91, None) if kit_key else own["defaults"].update({key91: lim91})
        fs = {"budgets.json": json.dumps(own, ensure_ascii=False), "docs/drafts/team-lead-spec.md": "я" * n, ".abide/rubric.json": read(f"{kroot}/.abide/rubric.json")}
        if kit_key:
            fs["kit/budgets.json"] = json.dumps({"defaults": {**own["defaults"], key91: lim91}}, ensure_ascii=False)
        rc_, lines = plain(fs)
        return rc_, next((" ".join(l.split()) for l in lines if re.match(rf"(OK|WARN|FAIL) +{key91}:", l)), "нет строки")
    over, at, kitw = copy_side(lim91 + 1), copy_side(lim91), copy_side(lim91 + 1, kit_key=True)
    ok91 = over[0] == 1 and over[1].startswith(f"FAIL {key91}") and at[0] == 0 and at[1].startswith(f"OK {key91}") and kitw[1].startswith(f"WARN {key91}") and kitw[0] == 0
    emit("F9.1", ok91, f"spec={over[1].split()[0]},{at[1].split()[0]} · ключ {key91} {lim91} в budgets.json: копия {lim91 + 1} знаков (кириллица — знаки, не байты) — rc {over[0]} «{over[1]}»; "
                       f"{lim91} — rc {at[0]} «{at[1]}» · ключ только в kit/budgets.json — rc {kitw[0]} «{kitw[1]}»")

    cur = rule_planka(dict(b)) + rule_scope(dict(b)) + rule_planken(dict(b)) + rule_planka_early(dict(b)) + rule_basis(dict(b)) + rule_spec_paths(dict(b)) + rule_spec_review(dict(b))
    for s_, r_, m_ in cur:
        print(f"{s_:4} {r_}: {m_}")
    if all(ok_all) and not any(s_ == "FAIL" for s_, _, _ in cur):
        print("BUDGET_LINT_OK")
        return 0
    print("BUDGET_LINT_FAIL")
    return 1


TEMPLATES = {  # шаблон кита → куда его кладёт пример в проекте
    "docs/INTENT.template.md": "intent/INTENT.md", "docs/SPEC.template.md": "docs/SPEC-1.md",
    "docs/PROMPT.template.txt": "docs/PROMPT.txt", "docs/PLAN.template.md": "docs/PLAN-1.md",
    "docs/PROGRESS.template.md": "docs/PROGRESS.md", "docs/STATUS.template.md": "docs/STATUS.md",
    "docs/PROCESS.template.md": "docs/PROCESS.md", "REVIEW.md": "docs/reviews/1-1.md", "CLAUDE.md": "CLAUDE.md",
    ".abide/rubric.json": ".abide/rubric.json",  # v3.3, F7.3: база рубрики кита — как её кладёт bin/two-tier-init
}


CONTRACT = {  # v3.1, F6: фаза под ultracode рождается из шаблонов — фразы, без которых шаблон её не ведёт
    "docs/SPEC.template.md": ["Регрессия модуля при закрытии", "`DEPLOY_OK` только после `REGRESS_OK`", "Правило закрытия", "гейт не закрывается с красным", "Окно деплоя", "`LIVE_OK`", "Паспорт модуля", "`DEPLOY_FAIL step=passport`"],  # v3.4, F4.4: живой текст §5
    "docs/GATE.template.md": ["| 0 |", "контрольный прогон", "гейт не закрывается с красным", "`bin/check-fenster`", "`FENSTER_GRUEN"],  # v3.4, F4.4: строка 0 таблицы
    "docs/PROMPT.template.txt": ["bin/verify-phase", "VERDICT: PASS", "its blocking findings fixed in this session",
                                 "Workflow agents edit only inside their own worktrees", "never push to main",
                                 "spec-gate", "`STOP: <id>`", "launch-line argument"],
    "docs/PROCESS.template.md": ["| инструмент | форма | id | вкл | фича или чек | установка | удаление |",
                                 "claude --permission-mode auto --model claude-opus-5-5 --effort ultracode",
                                 "--setting-sources project,local", '-- "$(cat docs/PROMPT.txt)"', "--strict-mcp-config", "% недели",
                                 # v3.4, F8.2: развилки ретро telefon, строки модов, запуск во вкладке Code
                                 "**(ae)", "**(af)", "**(ag)", "**(ah)", "| `window-guard@two-tier-mods` | да |", "| `phase-start@two-tier-mods` | да |",
                                 "`.claude/settings.local.json`", "`/phase`"],
    "CLAUDE.md": ["Агенты воркфлоу", "worktree", "главная сессия", "по точным путям", "Push в `main` запрещён", "/verify-phase",
                  "## Rules for every commit", "abide check", ".abide/rubric.json"],
    "docs/PLAN.template.md": ["Пункт ранней планки — отчёт", "`F<n>.<k> <число>`"],  # v3.5, F4.3
    "REVIEW.md": ["## Спека до подписи", "`spec: <путь> @ <пин>`"],  # v3.5, F7.1
}
CONTRACT["docs/SPEC.template.md"] += ["Судьи деплоя и регрессии, изменённые фазой, на базе:"]  # v3.5, F5.1: живой текст §5
CONTRACT["docs/PROCESS.template.md"] += ["## Свежий проверяющий спеки", "claude -p --model claude-opus-5-5", "свежий клон", "не субагент"]  # v3.5, F7.4


CONTRACT_S1 = ["**Новые пути:**"]  # v3.5, F5.2: строка §1 шаблона SPEC
CONTRACT_S2 = ["пара одного часа", "<звено вендора",  # v3.4, F5.2: строка звена вендора — живой текст §2 шаблона SPEC
               "Пункт ранней планки — отчёт", "`F<i>.<k> <число>`"]  # v3.5, F4.3
CONTRACT_S3 = ["Фаза доводки", "`bin/check-frozen-diff`",  # v3.4, F8.2: строка доводки закрытого модуля — живой текст §3 шаблона SPEC
               "Окно доводки: открыто", "запас диффа", "`bin/operator-word"]  # v3.5, F6.1


def contract_text(f, text, sec=5):
    """Где читаются фразы договора (v3.4, F4.4, F5.2): SPEC — живой текст раздела sec, GATE — строка таблицы «| 0 |»; HTML-комментарий — не текст. Прочие шаблоны — весь файл."""
    live = re.sub(r"<!--.*?(?:-->|\Z)", "", text, flags=re.S)
    if f == "docs/SPEC.template.md":
        return next(iter(re.findall(rf"^## {sec}\b.*?(?=^## |\Z)", live, re.M | re.S)), "")
    if f == "docs/GATE.template.md":
        return next((l for l in live.splitlines() if l.startswith("| 0 |")), "")
    return text


def templates():
    """Пример — шаблон как есть, только номер фазы, пин и Read first подставлены; плейсхолдеры <…> остаются, кроме ячеек планки и звена вендора: незаполненная — FAIL planka-source (F2.1, F5.2),
    в примере — «ранняя»."""
    root = "kit" if os.path.isdir("kit/docs") else "."
    missing = [t for t in list(TEMPLATES) + list(CONTRACT) if not os.path.isfile(f"{root}/{t}")]
    if missing:
        return report([("FAIL", "templates", f"нет шаблонов {missing}")])
    b, out = load_budgets(f"{root}/budgets.json")
    if not b:
        return report(out)
    for f, words in CONTRACT.items():
        text = contract_text(f, read(f"{root}/{f}"))
        miss = [w for w in words if w not in text]
        by_sec = {1: CONTRACT_S1, 2: CONTRACT_S2, 3: CONTRACT_S3} if f == "docs/SPEC.template.md" else {}
        miss += [w for sec, ws in by_sec.items() for w in ws if w not in contract_text(f, read(f"{root}/{f}"), sec)]
        out.append(("FAIL" if miss else "OK", "contract", f"{root}/{f}: фраз {len(words) + sum(map(len, by_sec.values()))}, нет — {'; '.join(miss) or 'ничего'}"))
    slash = re.compile("/" + "goal" + r"\b")  # v3.2: фазу запускает стартовый запрос — команды в ките не остаётся (строка не ловит сама себя)
    hits = []
    kit_paths = [os.path.join(d, f) for top in (".claude", "bin") for d, _, fs in os.walk(f"{root}/{top}") for f in fs]
    kit_paths += [f"{root}/{t}" for t in list(TEMPLATES) + ["docs/LAUNCH.md"] if os.path.isfile(f"{root}/{t}")]
    for path in sorted(set(kit_paths)):  # только файлы кита: архив и история проекта (C1) не в счёт
        try:
            n = len(slash.findall(read(path)))
        except (UnicodeDecodeError, OSError):
            continue
        hits += [f"{os.path.relpath(path, root)}: {n}"] if n else []
    out.append(("FAIL" if hits else "OK", "no-goal", f"упоминаний команды {slash.pattern[:5]} в {root}/ — {'; '.join(hits) or 'нет'}"))
    if root == "kit":  # v3.2, F7: кит, который получает новый проект, — без схемы GOAL (в проекте прежнее имя — WARN, см. rule_prompt)
        kd = json.loads(read("kit/budgets.json"))["defaults"]
        own = kd.get("owner", [])
        old = (["нет prompt_chars"] if "prompt_chars" not in kd else []) + (["goal_chars"] if "goal_chars" in kd else []) \
            + (["нет docs/PROMPT.txt в owner"] if "docs/PROMPT.txt" not in own else []) + (["docs/GOAL.txt в owner"] if "docs/GOAL.txt" in own else []) \
            + [f"kit/CLAUDE.md:{i}" for i, l in enumerate(read("kit/CLAUDE.md").splitlines(), 1) if re.search(r"GOAL|\bgoal\b", l)]
        out.append(("FAIL" if old else "OK", "kit-prompt", f"kit/budgets.json и kit/CLAUDE.md — стартовый запрос v3.2: "
                    + ("; ".join(old) if old else "prompt_chars, docs/PROMPT.txt в owner, схемы GOAL нет")))
    pin = pin_of(read(f"{root}/docs/INTENT.template.md"))
    subs = [("<n>", "1"), ("<current review file or nothing>", "docs/reviews/1-1.md"),
            ("<первые 12 знаков git hash-object>", pin), ("<файл, n, p50/p95 — или «ранняя»>", "ранняя"),
            ("<pair — пара одного часа: docs/evidence/<файл со строкой PAIR_…> — или «ранняя»>", "ранняя"),
            ("<n из m | нет>", "нет"), ("<b>", "phase-1")]  # v3.5: строка судей на базе (F5.1), ветка формой /phase (F5.4)
    fs = {}
    for t, dst in TEMPLATES.items():
        text = read(f"{root}/{t}")
        for a, z in subs:
            text = text.replace(a, z)
        fs[dst] = text
        print(f"пример: {root}/{t} → {dst}")
    # v3.5, F7: фаза на выдаче прочитана свежим проверяющим — вердикт формой раздела «Спека до подписи» REVIEW.md, пин — примерной SPEC
    fs["docs/reviews/1-spec.md"] = f"PASS\nблокирующих 0, named 0\nspec: docs/SPEC-1.md @ {pin_of(fs['docs/SPEC-1.md'])}\n"
    print("пример: вердикт свежего проверяющего → docs/reviews/1-spec.md")
    return report(out + in_fixture(fs, None, lambda: run(b)))


def main(argv):
    if argv[:1] == ["--self-test"]:
        return self_test(argv[1:])
    if argv == ["--templates"]:
        return templates()
    if argv == ["--lints"]:
        return lints()
    if argv:
        print(__doc__)
        return 2
    b, out = load_budgets()
    return report(out + run(b) if b else out)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
