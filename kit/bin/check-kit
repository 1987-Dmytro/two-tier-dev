    put(d, "docs/texte.md", "текст\n")
    sh(["git", "mv", "src/demo/a.py", "src/demo/b.py"], d)
    ps.append(fz_rc(1, "переименование в модуле, байты те же", check(d), "was=src"))
    sh(["git", "mv", "src/demo/b.py", "src/demo/a.py"], d)
    put(d, "src/demo/a.py", "a = 3\n")
    write(d)
