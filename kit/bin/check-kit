    ci.append(fz_rc(1, "base не коммит", judge(d), "FROZEN_DIFF_FAIL нет коммита base"))
    d = project({"basis": nowhere, "module": {"demo": demo({"SPEC-2": ["*"]})}})
    cp.append(fz_rc(1, "basis не коммит: хук", commit(d, "F1.1: x", "src/demo/x.py", "x\n"), "нет коммита basis"))
    ci.append(fz_rc(1, "basis не коммит", judge(d), "FROZEN_DIFF_FAIL нет коммита basis"))
    cp += [fz_rc(0, "«Тимлид:» чинит замок", set_lock(d, {"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]})}})),
           fz_rc(0, "после починки", commit(d, "F1.1: x", "src/demo/x.py", "x\n"))]
    (vb_ok, vb_raw), (of_ok, of_raw), (cp_ok, cp_raw), (ci_ok, ci_raw) = fz_join(vb), fz_join(of), fz_join(cp), fz_join(ci)
    probe("F3.1", vb_ok and of_ok and cp_ok and ci_ok, f"verboten={'OK' if vb_ok else 'нет'} offen={'OK' if of_ok else 'нет'} cap={'OK' if cp_ok else 'нет'} · запрет: {vb_raw} · открыто: {of_raw} · предел: {cp_raw} · CI: {ci_raw}")
    # F3.2 — «Тимлид:» замок кода не обходит (K79)
    lock = {"basis": None, "module": {"demo": demo(pfade=["src/demo/", "docs/DEMO.md"])}}
    opened = {"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]}, pfade=["src/demo/", "docs/DEMO.md"])}}
    d = project(lock)
    tl = [fz_rc(1, "«Тимлид:» в код", commit(d, "Тимлид: правка кода модуля", "src/demo/t.py", "t = 1\n"), "src/demo/t.py"),
          fz_rc(0, "в docs/STATUS.md", commit(d, "Тимлид: статус", "docs/STATUS.md", "s2\n")),
          fz_rc(0, "в docs/ модуля", commit(d, "Тимлид: паспорт модуля", "docs/DEMO.md", "p\n")),
          fz_rc(1, "исполнитель туда же", commit(d, "F1.1: паспорт модуля исполнителем", "docs/DEMO.md", "p2\n"))]
    put(d, "frozen.json", json.dumps(opened))  # один коммит открывает замок и правит код: судит замок из HEAD
    sh(["git", "add", "--", "frozen.json"], d)
    tl.append(fz_rc(1, "открыл замок и правит код одним коммитом", commit(d, "Тимлид: открыл и правит", "src/demo/t1.py", "t = 1\n"), "src/demo/t1.py"))
    sh(["git", "checkout", "-q", "HEAD", "--", "frozen.json"], d)
    tl += [fz_rc(0, "замок правит «Тимлид:»", set_lock(d, opened)), fz_rc(0, "код при offen *", commit(d, "Тимлид: код модуля, SPEC открыла всем", "src/demo/t2.py", "t = 2\n"))]
    raw = json.load(open(f"{root}/budgets.json", encoding="utf-8"))
    raw["defaults"]["owner"] = [e for e in raw["defaults"]["owner"] if e not in ("intent/", "claude/")]  # intent/ и claude/ свободны и вне списка owner
    owners = json.dumps(raw, ensure_ascii=False)
    d = project({"basis": None, "module": {"demo": demo(pfade=["intent/INTENT.md", "claude/x.md", "budgets.json"])}}, extra={"budgets.json": owners})
    tl += [fz_rc(0, "intent/ модуля, не в owner", commit(d, "Тимлид: intent", "intent/INTENT.md", "i\n")),
           fz_rc(0, "claude/ модуля, не в owner", commit(d, "Тимлид: claude", "claude/x.md", "c\n")),
           fz_rc(0, "файл из owner в модуле", commit(d, "Тимлид: owner", "budgets.json", owners + "\n")),
           fz_rc(1, "исполнитель в intent/ модуля", commit(d, "F1.1: intent", "intent/INTENT.md", "i2\n"), "frozen-paths: intent/INTENT.md")]
    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]}, pfade=["src/demo/", "docs/DEMO.md"], diff_cap=1)}})
    fz_past_hook(d, "F1.1: сверх предела", "src/demo/x.py", "1\n2\n3\n")
    tl += [fz_rc(0, "модуль сверх предела: «Тимлид:» в его docs/", commit(d, "Тимлид: паспорт", "docs/DEMO.md", "p\n")),
           fz_rc(1, "исполнитель туда же", commit(d, "F1.1: паспорт", "docs/DEMO.md", "p2\n"), "diff_cap 1"),
           fz_rc(1, "«Тимлид:» в его код", commit(d, "Тимлид: код", "src/demo/y.py", "y\n"), "diff_cap 1")]
    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]}, pfade=["src/demo/", "docs/DEMO.md"], diff_cap=1)}})
    tl += [fz_rc(0, "«Тимлид:» в docs/ модуля сверх предела", commit(d, "Тимлид: паспорт", "docs/DEMO.md", "p\n" * 10)),
           fz_rc(0, "и CI: docs/ не в счёт", judge(d), "diff=demo 0/1"),
           fz_rc(0, "исполнитель после него — в пределах", commit(d, "F1.1: код", "src/demo/x.py", "1\n")),
           fz_rc(1, "вторая строка кода — сверх", commit(d, "F1.1: код", "src/demo/x2.py", "2\n"), "дифф 2 строк > diff_cap 1")]
    # файлы тимлида и без строки в owner: апгрейд budgets.json проекта не пишет
    no_own = json.loads(owners)
