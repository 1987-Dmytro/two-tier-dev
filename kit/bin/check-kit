    nowhere = "0" * 40
    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]}, diff_cap=3, base=nowhere)}})
    cp += [fz_rc(1, "base не коммит: хук", commit(d, "F1.1: x", "src/demo/x.py", body), "нет коммита base"),
