    put(d, "src/demo/a.py", "a = 2\n")
    op += [fz_rc(0, "SPEC — первая запись SPEC-*.md, DEMO_OFFEN=SPEC-2", check(d, DEMO_OFFEN="SPEC-2"), "PASSPORT_OFFEN"), fz_rc(1, "DEMO_OFFEN=SPEC-1 из чужого имени", check(d, DEMO_OFFEN="SPEC-1"), "PASSPORT_FAIL")]
    (ps_ok, ps_raw), (op_ok, op_raw) = fz_join(ps), fz_join(op)
    probe("F3.3", ps_ok and op_ok, f"pass={'OK' if ps_ok else 'нет'} offen={'OK' if op_ok else 'нет'} · паспорт: {ps_raw} · открыто: {op_raw}")
    # F3.4 — шаг regress: DEPLOY_OK только после REGRESS_OK; судится stdout, stderr идёт мимо
    d = project({"basis": None, "module": {}})
    red = lambda label, got, step="regress": (got[0] == 1 and f"DEPLOY_FAIL step={step}" in got[1] and "DEPLOY_OK" not in got[1], f"{label} — rc {got[0]} «{tail(got[1])}»")
    a = deploy(d)
    b = deploy(d, regress="echo REGRESS_FAIL grund=x; exit 1")
    two = sum([a[0] == 0 and "DEPLOY_OK" in a[1] and "REGRESS_OK" in a[1], b[0] == 1 and "DEPLOY_FAIL step=regress" in b[1] and "DEPLOY_OK" not in b[1]])
    no_regress = {k: v for k, v in GIT_ENV.items() if k not in ("REGRESS_CMD", "DEPLOY_CMD")}
    note = deploy(d, regress="echo REGRESS_OK; echo note >&2")
    rg_ok, rg_raw = fz_join([red("код 1 при маркере", deploy(d, regress="echo REGRESS_OK; exit 1")), red("код 0 без маркера", deploy(d, regress="echo всё прошло")),
                             fz_rc(0, "REGRESS_OK с полями", deploy(d, regress="echo REGRESS_OK stimme=ok bo=ok cc=ok"), "DEPLOY_OK"),
                             fz_rc(0, "заметка в stderr", note, "DEPLOY_OK"), ("note" in note[1], f"заметка {'прошла' if 'note' in note[1] else 'пропала'}"),
                             fz_rc(0, "CR на конце", deploy(d, regress="printf 'REGRESS_OK\\r\\n'"), "DEPLOY_OK"), fz_rc(0, "пробел на конце", deploy(d, regress="echo 'REGRESS_OK '"), "DEPLOY_OK"),
                             red("REGRESS_OKAY", deploy(d, regress="echo REGRESS_OKAY")), red("REGRESS_OK только в stderr", deploy(d, regress="echo итог; echo REGRESS_OK >&2")),
                             red("REGRESS_OK, затем REGRESS_FAIL", deploy(d, regress="echo REGRESS_OK; echo REGRESS_FAIL x")),
                             red("нет REGRESS_CMD и Makefile", sh(["bash", "scripts/deploy.sh"], d, env=no_regress)),
                             red("DEPLOY_CMD=false", sh(["bash", "scripts/deploy.sh"], d, env=dict(GIT_ENV, REGRESS_CMD="echo REGRESS_OK", DEPLOY_CMD="false")), "rollout")])
    probe("F3.4", two == 2 and rg_ok, f"regress={two}/2 · REGRESS_OK — rc {a[0]} «{tail(a[1], 2)}» · REGRESS_FAIL — rc {b[0]} «{tail(b[1], 2)}» · {rg_raw}")
    # F3.5 — апгрейд копии клона telefon: замок и хук работают, bin/check-budget проекта зелёный; нет клона или не репо кита — offen и без маркера
    clone = os.environ.get("TELEFON_CLONE", f"{TMP}/telefon-src")
    up = os.path.abspath(f"{root}/bin/two-tier-upgrade")
    upgrade = lambda *a: sh([up, *a], os.getcwd(), env=dict(os.environ))
    skipped = root != "kit" or not os.path.isdir(f"{clone}/.git")
    if skipped:
        probe("F3.5", True, f"telefon=offen · {'не репо кита' if root != 'kit' else 'клона нет: TELEFON_CLONE или /tmp/two-tier-v3/telefon-src (ветка linie-1)'}")
    else:
        d = fz_copy(clone)
        head0 = head(d)
        dash = upgrade("--branch", "-x", d)
        same_branch = upgrade(d)
        rc_up, text_up = upgrade("--branch", "kit-v3.4", d)
        lock_ok = json.load(open(f"{d}/frozen.json", encoding="utf-8"))
        src_file = next(p for p in sh(["git", "ls-files", "src/"], d)[1].splitlines() if p.endswith(".py") and "/bo/" not in p and "/cc/" not in p)
        original = open(f"{d}/{src_file}", encoding="utf-8").read()
        c1 = commit(d, "F9.9: проба замка", src_file, original + "# проба\n")
        c2 = commit(d, "Тимлид: проба замка", src_file, original + "# проба\n")
        c3 = commit(d, "F53.9: пункт фичи из offen", src_file, original + "# проба\n")
        c4 = commit(d, "F9.9: проба docs", "docs/zz-probe.md", "x\n")
        rc_b, text_b = sh(["bin/check-budget"], d, env=dict(os.environ))
        frozen_line = fz_budget_line(text_b)
        fz_past_hook(d, "F9.9: мимо хука", src_file, original + "# мимо хука\n")
        rc_ph, text_ph = sh(["bin/check-budget"], d, env=dict(os.environ))
        past_line = fz_budget_line(text_ph)
        spec_now = re.search(r"Read first:.*?(SPEC-[^\s,/]+)\.md", open(f"{d}/docs/PROMPT.txt", encoding="utf-8").read())
        shutil.rmtree(d, ignore_errors=True)
        d = fz_copy(clone)  # замка нет — апгрейд ставит пустой коммитом тимлида
        sh(["git", "rm", "-q", "frozen.json"], d)
        fz_past_hook(d, "проба: замка нет")
        rc_abs, text_abs = upgrade("--branch", "kit-v3.4", d)
        installed = os.path.isfile(f"{d}/frozen.json") and sh(["git", "ls-files", "frozen.json"], d)[1] == "frozen.json"
        subject = sh(["git", "log", "-1", "--format=%s", "--", "frozen.json"], d)[1]
        shutil.rmtree(d, ignore_errors=True)
        ok = (dash[0] == 2 and "--branch" in dash[1] and same_branch[0] == 1 and "--branch" in same_branch[1] and rc_up == 0 and c1[0] == 1 and src_file in c1[1] and c2[0] == 1 and c3[0] == 0 and c4[0] == 0
              and rc_b == 0 and text_b.splitlines()[-1] == "BUDGET_OK" and frozen_line.startswith("OK") and "FROZEN_DIFF_OK" in frozen_line and list(lock_ok["module"]) == ["telefon", "backoffice", "command-center"]
              and rc_ph == 1 and past_line.startswith("FAIL") and "FROZEN_DIFF_FAIL" in past_line and src_file in past_line and rc_abs == 0 and installed and subject.startswith("Тимлид: frozen.json"))
        probe("F3.5", ok, f"telefon={'OK' if ok else 'нет'} · копия клона, {spec_now.group(1) if spec_now else '?'}; --branch -x — rc {dash[0]}; без --branch при разошедшейся kit-v3 — rc {same_branch[0]}; --branch kit-v3.4 — rc {rc_up} «{tail(text_up)[:90]}»; модули {', '.join(lock_ok['module'])} — замок проекта цел; "
              f"коммит в код модуля без offen — rc {c1[0]} «{c1[1][:110]}»; «Тимлид:» туда же — rc {c2[0]}; пункт фичи из offen — rc {c3[0]}; в docs/ — rc {c4[0]}; bin/check-budget проекта — rc {rc_b} «{frozen_line[:100]}» {tail(text_b)}; коммит мимо хука: rc {rc_ph} «{past_line[:110]}»; "
              f"копия без frozen.json: апгрейд — rc {rc_abs}, замок {'поставлен' if installed else 'не поставлен'}, коммит «{subject[:70]}»")
    green = all(sec) and len(sec) == 5
    print(("--   frozen: F3.5 не гонялся, маркера FROZEN нет" if skipped else "FROZEN_OK") if green else "FROZEN_FAIL", flush=True)
    return green


LIVE_CFG = {"live": {"word_max_ms": 3500, "word_max_sicher_ms": 5000, "warten_ms": 1000, "channel": "linie", "felder_ganz": ["name"], "stoppwoerter": ["und", "ich"],
                     "felder": {"nummer": "rueckruf", "heiss|\\bname\\b": "name", "\\bort\\b": "ort", "worum geht": "anliegen"},
                     "fertige_saetze": ["Gerne."], "nummer_feld": "rueckruf", "nummer_frage": "nummer.*\\?"}}


def live_call(cid, turns, summary=None, caller="…98"):
    """Синтетический звонок (без людей и номеров): строки журнала и запись. Ход: said, bot, ms, fc, way, llm, hirn, flags (HIRN), chain (KETTE), no_hirn, abbruch, fl."""
    lines, tr = [f"12:00:00 | INFO | CALL_START call={cid} channel=linie caller={caller}"], [{"role": "bot", "text": "Guten Tag."}]
    for n, x in enumerate(turns, 1):
        tr.append({"role": "caller", "text": x.get("said", "Ja.")})
        if x.get("fl"):
            lines += [f"12:00:0{n} | INFO | BACKCHANNEL fl:FL{i}" for i in range(x["fl"])]
        if not x.get("no_hirn"):
            lines.append(f"12:00:0{n} | INFO | HIRN call={cid} n={n} first_clause_ms={x.get('fc', 500)} anfragen=1 weg={x.get('way', 'strom')} ttft_ms=300{x.get('flags', '')}" + (" abbruch=1" if x.get("abbruch") else ""))
        if x.get("bot") is not None:
            ms = x.get("ms", 2000)
            tr.append({"role": "bot", "text": x["bot"], "latency_ms": ms})
            lines.append(f"12:00:0{n} | INFO | KETTE call={cid} hirn={x.get('hirn', 400)} stt=100 sum={ms} llm={x.get('llm', 300)} text=ok{x.get('chain', '')}")
    lines.append(f"12:00:59 | INFO | CALL_END call={cid}")
    return lines, {"call_id": cid, "transcript": tr, "summary": summary or {}}


def live_run(d, calls, args=("--n", "1")):
    j, r = [], []
    for c in calls:
        lines, rec = live_call(**c)
        j += lines
        r.append(json.dumps(rec, ensure_ascii=False))
    put(d, "live/journal.txt", "\n".join(j) + "\n")
    put(d, "live/records.jsonl", "\n".join(r) + "\n")
    return sh(["bin/check-live", "live/journal.txt", "live/records.jsonl", *args, "--planken", "live/planken.json"], d)


class FakeSmtp:
    """Локальный SMTP пробы: темы писем — в self.subjects."""
    def __init__(self):
        import socketserver, threading
        subjects = self.subjects = []

        class H(socketserver.StreamRequestHandler):
            def handle(self):
                self.wfile.write(b"220 fixture\r\n")
                data = False
                for raw in self.rfile:
                    line = raw.decode("utf-8", "replace").rstrip("\r\n")
                    if data:
                        if line == ".":
                            data = False
                            self.wfile.write(b"250 ok\r\n")
                        elif line.startswith("Subject: "):
                            subjects.append(line[9:])
                    elif line.upper().startswith("DATA"):
                        data = True
                        self.wfile.write(b"354 go\r\n")
                    elif line.upper().startswith("QUIT"):
                        self.wfile.write(b"221 bye\r\n")
                        return
                    else:
                        self.wfile.write(b"250 ok\r\n")
        self.srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), H)
        self.port = self.srv.server_address[1]
        threading.Thread(target=self.srv.serve_forever, daemon=True).start()

    def close(self):
        self.srv.shutdown()


