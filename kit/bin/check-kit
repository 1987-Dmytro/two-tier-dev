                 ("E7 timeout_s строкой", mess(), "planken", plank(timeout_s="30")), ("timeout_s true", mess(), "planken", plank(timeout_s=True)), ("timeout_s пустой строкой", mess(), "planken", plank(timeout_s="")), ("порог p95 строкой", mess(), "planken", plank(p95_gelb_ms="3200")),
