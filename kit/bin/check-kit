    ps.append(fz_rc(1, "код разошёлся", check(d), "was=src"))
    os.path.exists(f"{d}/rolled-out") and os.remove(f"{d}/rolled-out")
    ps.append(fz_rc(1, "деплой", deploy(d), "DEPLOY_FAIL step=passport"))
    ps.append((not os.path.exists(f"{d}/rolled-out"), f"выкатка {'была' if os.path.exists(f'{d}/rolled-out') else 'не шла'}"))
    op = [fz_rc(0, "DEMO_OFFEN=SPEC-2", check(d, DEMO_OFFEN="SPEC-2"), "PASSPORT_OFFEN"), fz_rc(0, "деплой", deploy(d, env={"DEMO_OFFEN": "SPEC-2"}), "DEPLOY_OK"), fz_rc(1, "DEMO_OFFEN=SPEC-9", check(d, DEMO_OFFEN="SPEC-9"))]
    put(d, "docs/PROMPT.txt", "Read first: docs/SPEC-9.md\n")  # запрос правлен только на диске: открывает только запрос из HEAD
    op += [fz_rc(1, "запрос на диске SPEC-9, DEMO_OFFEN=SPEC-9", check(d, DEMO_OFFEN="SPEC-9"), "PASSPORT_FAIL"), fz_rc(1, "деплой", deploy(d, env={"DEMO_OFFEN": "SPEC-9"}), "DEPLOY_FAIL step=passport")]
    put(d, "docs/PROMPT.txt", "Read first: docs/SPEC-2.md\n")
    put(d, "frozen.json", "{")  # замок сломан или удалён только на диске: судит замок из HEAD
    ps.append(fz_rc(1, "замок битый на диске", check(d), "was=src"))
    os.remove(f"{d}/frozen.json")
    ps.append(fz_rc(1, "замок удалён с диска", check(d), "was=src"))
    put(d, "frozen.json", json.dumps(lock, ensure_ascii=False))
    put(d, "src/demo/a.py", "a = 1\n")
