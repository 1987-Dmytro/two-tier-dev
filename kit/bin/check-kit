f = wrun("bin/check-window", events(None))
o = wrun(run_line.replace("bin/check-window && ", "bin/check-window --override && ", 1), events(90))
wsay(a[0] == 1 and "окна не сняты: нет события rate_limit_event" in a[1] and b[0] == 1 and "окна не сняты: нет поля unifiedWindows" in b[1]
     and c[0] == 1 and "окна не сняты: ошибка claude (rc 1): Not logged in" in c[1] and f[0] == 1 and "окна не сняты: нет окна seven_day" in f[1] and o[0] == 0 and o[2]
     and "WINDOW: обход флагом --override — был бы отказ: неделя 90 % > 85 %" in o[1], "v3.3-F5.3",
     f"без события: rc {a[0]} «{a[1].split(' | ')[-1]}» · без unifiedWindows: rc {b[0]} «{b[1].split(' | ')[-1]}» · без seven_day: rc {f[0]} «{f[1].split(' | ')[-1]}» · "
     f"вход: rc {c[0]} «{c[1].split(' | ')[-1]}» · " + side("строка с --override, 90 %", o))
gone = [x for x in V34_RETIRED if x in kd]
a = wrun("bin/check-window", events(64), n=3)
b = wrun("bin/check-window", events(64), {"window_seven_day_pct": 60}, n=3)
c = wrun("bin/check-window", events(86), {"window_seven_day_pct": 90}, n=3)
wsay(kd.get("window_seven_day_pct") == 85 and not gone and a[0] == 0 and "85 % (window_seven_day_pct, budgets.json defaults)" in a[1]
     and b[0] == 1 and "60 % (window_seven_day_pct, budgets.json project)" in b[1] and "неделя 64 % > 60 %" in b[1]
     and c[0] == 1 and "project.window_seven_day_pct=90 ослабляет — взят 85" in c[1] and "неделя 86 % > 85 %" in c[1], "v3.3-F5.4",
     f"defaults {root}/budgets.json: window_seven_day_pct {kd.get('window_seven_day_pct')}, ключей окна 5 ч — {len(gone)} · 64 %, project {{}}: rc {a[0]} «{a[1]}» · "
     f"64 %, project 60: rc {b[0]} «{b[1]}» · 86 %, project 90: rc {c[0]} «{c[1]}»")
shutil.rmtree(fx, ignore_errors=True)
if shutil.which("claude"):
    env = {k: v for k, v in os.environ.items() if not k.startswith("CHECK_WINDOW_")}
    r = subprocess.run([f"{root}/bin/check-window"], env=env, capture_output=True, text=True, timeout=180)
    live = " | ".join((r.stdout + r.stderr).strip().splitlines()[-2:])
    if "окна не сняты: нет " in live:  # claude ответил, а поле не разобрано — сломан сам предохранитель
        win.append(False)
        print(f"FAIL window: живой ход — событие не разобрано: rc {r.returncode} «{live}»")
    else:
        print(f"--   window: живой ход, справка: rc {r.returncode} «{live}»")
else:
    print("--   window: claude нет в PATH (CI) — живого хода нет")
print("WINDOW_OK" if all(win) else "WINDOW_FAIL")
sections_ok = run_sections(SECTIONS)
sys.exit(0 if kit_ok and all(hand) and all(win) and sections_ok else 1)
