    tl_ok, tl_raw = fz_join(tl)
    probe("F3.2", tl_ok, f"tl={'OK' if tl_ok else 'нет'} · {tl_raw}")
    # F3.3 — паспорт: расхождение без <МОДУЛЬ>_OFFEN → DEPLOY_FAIL step=passport
    passport = {"file": "docs/DEMO.md", "fingerprints": {"src": ["src/demo/"]}}
