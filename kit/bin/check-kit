    relock(d, fingerprints={"src": ["src/demo/"]})
    ps.append(fz_rc(1, "нет file", check(d), "PASSPORT_FAIL модуль=demo нет file"))
    relock(d)
    ps.append(fz_rc(1, "паспорт {}", check(d), "PASSPORT_FAIL модуль=demo нет file"))
    for label, prints in (("fingerprints пуст", {}), ("пустой список путей", {"src": []}), ("путь без файлов", {"src": ["src/demo-typo/"]})):
        relock(d, file="docs/HOLLOW.md", fingerprints=prints)
        ps += [fz_rc(1, label, check(d), "PASSPORT_FAIL модуль=demo"), fz_rc(1, f"--write: {label}", write(d), "PASSPORT_FAIL модуль=demo")]
    ps.append((not os.path.exists(f"{d}/docs/HOLLOW.md"), f"пустой паспорт {'записан' if os.path.exists(f'{d}/docs/HOLLOW.md') else 'не записан'}"))
    for shape in ("{", "[]", '{"module": []}', '{"module": {"demo": []}}', '{"module": {"demo": {"pfade": "src/"}}}', '{"module": {"demo": {"pfade": [1]}}}', '{"module": {"demo": {"pfade": [], "diff_cap": -1}}}', '{"module": {"demo": {"pfade": [], "offen": "x"}}}'):
        fz_past_hook(d, "Тимлид: замок не той формы", "frozen.json", shape)
        ps.append(fz_rc(1, f"замок {shape} в HEAD", check(d), "PASSPORT_FAIL frozen.json"))
    ps.append(fz_rc(1, "деплой на нём", deploy(d), "DEPLOY_FAIL step=passport"))
    sh(["git", "rm", "-q", "frozen.json"], d)
    fz_past_hook(d, "Тимлид: замка нет")
    put(d, "frozen.json", json.dumps(lock, ensure_ascii=False))  # только на диске
    ps.append(fz_rc(0, "замка нет в HEAD, на диске есть", check(d), "PASSPORT_OK нет паспортов"))
    d = project({"basis": None, "module": {"demo": demo(passport=passport)}})
    write(d)
    put(d, "src/demo/a.py", "a = 2\n")
    sh(["git", "rm", "-q", "docs/PROMPT.txt"], d)
    fz_past_hook(d, "запроса нет")
    op.append(fz_rc(1, "нет запроса в HEAD и нет переменной", check(d), "PASSPORT_FAIL модуль=demo was=src"))
