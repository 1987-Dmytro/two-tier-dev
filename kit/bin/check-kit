os.chmod(f"{fx}/stub/claude", 0o755)
kd = json.loads(read(f"{root}/budgets.json"))["defaults"]
now = int(time.time())


def events(p7=0, p5=None, event=True, windows=True, error=None):  # p5 — окно 5 ч старого тарифа: если и придёт, не судится
    ls = [{"type": "system", "subtype": "init"}]
    if not error:
        info = {"status": "allowed", "rateLimitType": "seven_day"}
        if windows:
            info["unifiedWindows"] = {"seven_day": {"utilization": p7 / 100, "resetsAt": now + 3 * 86400}} if p7 is not None else {"other": {"utilization": 0.1}}
            if p5 is not None:
                info["unifiedWindows"]["five_hour"] = {"utilization": p5 / 100, "resetsAt": now + 7200}
        ls += [{"type": "assistant", "message": {"content": [{"type": "text", "text": "ok"}]}}] + ([{"type": "rate_limit_event", "rate_limit_info": info}] if event else [])
    ls.append({"type": "result", "subtype": "success", "is_error": bool(error), "result": error or "ok"})
    return "\n".join(map(json.dumps, ls)) + "\n"


def wrun(cmd, ev, project=None, rc=0, n=2, defaults=None):  # → (rc, сырой вывод: последние n строк через « | », заглушка вызвана). Порог кита 100 % (решение 398) не отказывает: механизм — на подставленном 85
    json.dump({"defaults": defaults or {**kd, "window_seven_day_pct": 85}, "project": project or {}}, open(f"{fx}/budgets.json", "w"))
    open(f"{fx}/events.jsonl", "w").write(ev)
    if os.path.exists(f"{fx}/claude-called"):
        os.remove(f"{fx}/claude-called")
    env = {k: v for k, v in os.environ.items() if not k.startswith("CHECK_WINDOW_")}
    env.update(CHECK_WINDOW_EVENTS=f"{fx}/events.jsonl", CHECK_WINDOW_RC=str(rc), PATH=f"{fx}/stub:{env.get('PATH', '')}")
    r = subprocess.run(["bash", "-c", cmd], cwd=fx, env=env, capture_output=True, text=True, timeout=60)
    return r.returncode, " | ".join((r.stdout + r.stderr).strip().splitlines()[-n:]), os.path.exists(f"{fx}/claude-called")


side = lambda name, r: f"{name}: rc {r[0]}, claude {'вызван' if r[2] else 'не вызван'} «{r[1]}»"
tpl = f"{root}/docs/PROCESS.template.md"
m = re.search(r"^```sh\n(.+)$", read(tpl), re.M) if os.path.isfile(tpl) else None
line = m.group(1) if m else ""
pre = line.startswith("bin/check-window && ")
run_line = line if pre else "bin/check-window && " + line  # без префикса — F5.1 красный, механизм всё равно меряется
b, c = wrun(run_line, events(86)), wrun(run_line, events(84))
e = wrun(run_line, events(85))  # ровно на пороге — «выше» не наступило: старт
a = wrun(run_line, events(84, p5=99))  # окно 5 ч старого тарифа не судится
wsay(pre and b[0] != 0 and not b[2] and "86 %" in b[1] and re.search(r"сброс \d", b[1]) and "WINDOW: refuse" in b[1] and "неделя 86 % > 85 %" in b[1]
     and c[0] == 0 and c[2] and "WINDOW: start" in c[1] and a[0] == 0 and a[2] and "WINDOW: start" in a[1] and "99" not in a[1]
     and e[0] == 0 and e[2] and "WINDOW: start" in e[1], "v3.3-F5.1",
     ("" if pre else f"строка запуска {tpl} не начинается с «bin/check-window && » — проба на копии с префиксом · ")
     + " · ".join([side("86 %", b), side("84 %", c), side("85 % (ровно порог)", e), side("84 %, окно 5 ч 99 %", a)]))
a, b = wrun("bin/check-window --repair", events(84)), wrun("bin/check-window --repair", events(86))  # прежний флаг строки запуска: без действия
shutil.copy2(f"{root}/bin/verify-phase", f"{fx}/bin/verify-phase")  # приёмка: check-window рядом с лаунчером — до клона
va, vb = wrun("bin/verify-phase", events(84), n=3), wrun("bin/verify-phase", events(86), n=3)
wsay(a[0] == 0 and "WINDOW: start" in a[1] and b[0] == 1 and "неделя 86 % > 85 %" in b[1]
     and "WINDOW: start" in va[1] and "отказ до клона" not in va[1] and vb[0] == 1 and "отказ до клона" in vb[1] and "свежий клон" not in vb[1], "v3.3-F5.2",
     f"--repair 84 %: rc {a[0]} «{a[1]}» · --repair 86 %: rc {b[0]} «{b[1]}» · bin/verify-phase 84 %: «{va[1]}» · bin/verify-phase 86 %: rc {vb[0]} «{vb[1]}»")
a, b = wrun("bin/check-window", events(event=False)), wrun("bin/check-window", events(windows=False))
c = wrun("bin/check-window", events(error="Not logged in · Please run /login"), rc=1)
f = wrun("bin/check-window", events(None))
o = wrun(run_line.replace("bin/check-window && ", "bin/check-window --override && ", 1), events(90))
wsay(a[0] == 1 and "окна не сняты: нет события rate_limit_event" in a[1] and b[0] == 1 and "окна не сняты: нет поля unifiedWindows" in b[1]
     and c[0] == 1 and "окна не сняты: ошибка claude (rc 1): Not logged in" in c[1] and f[0] == 0 and "WINDOW_WARN seven_day=fehlt" in f[1] and "WINDOW: start" in f[1] and o[0] == 0 and o[2]
     and "WINDOW: обход флагом --override — был бы отказ: неделя 90 % > 85 %" in o[1], "v3.3-F5.3",
     f"без события: rc {a[0]} «{a[1].split(' | ')[-1]}» · без unifiedWindows: rc {b[0]} «{b[1].split(' | ')[-1]}» · без seven_day (396, F5.5): rc {f[0]} «{f[1]}» · "
     f"вход: rc {c[0]} «{c[1].split(' | ')[-1]}» · " + side("строка с --override, 90 %", o))
gone = [x for x in V34_RETIRED if x in kd]
a = wrun("bin/check-window", events(64), n=3)
b = wrun("bin/check-window", events(64), {"window_seven_day_pct": 60}, n=3)
c = wrun("bin/check-window", events(86), {"window_seven_day_pct": 90}, n=3)
own_pct = kd.get("window_seven_day_pct", 100)
k = wrun("bin/check-window", events(own_pct), defaults=kd, n=3)  # свой порог: неделя ровно на нём — старт; порог кита — 100 %, решение 398; проект после апгрейда держит свой
wsay((root != "kit" or own_pct == 100) and k[0] == 0 and f"порог: неделя {own_pct} %" in k[1] and "WINDOW: start" in k[1]
     and not gone and a[0] == 0 and "85 % (window_seven_day_pct, budgets.json defaults)" in a[1]
     and b[0] == 1 and "60 % (window_seven_day_pct, budgets.json project)" in b[1] and "неделя 64 % > 60 %" in b[1]
     and c[0] == 1 and "project.window_seven_day_pct=90 ослабляет — взят 85" in c[1] and "неделя 86 % > 85 %" in c[1], "v3.3-F5.4",
     f"defaults {root}/budgets.json: window_seven_day_pct {kd.get('window_seven_day_pct')}, ключей окна 5 ч — {len(gone)} · свой порог {own_pct} %, ровно на нём: rc {k[0]} «{k[1]}» · подставлен 85, 64 %, project {{}}: rc {a[0]} «{a[1]}» · "
     f"64 %, project 60: rc {b[0]} «{b[1]}» · 86 %, project 90: rc {c[0]} «{c[1]}»")
shutil.rmtree(fx, ignore_errors=True)
if shutil.which("claude"):
    env = {k: v for k, v in os.environ.items() if not k.startswith("CHECK_WINDOW_")}
    r = subprocess.run([f"{root}/bin/check-window"], env=env, capture_output=True, text=True, timeout=180)
    live = " | ".join((r.stdout + r.stderr).strip().splitlines()[-2:])
    if "окна не сняты: нет " in live:  # claude ответил, а поле не разобрано — сломан сам предохранитель
        win.append(False)
        print(f"FAIL window: живой ход — событие не разобрано: rc {r.returncode} «{live}»")
    else:
        print(f"--   window: живой ход, справка: rc {r.returncode} «{live}»")
