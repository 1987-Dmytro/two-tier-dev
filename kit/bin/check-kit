    green_runs = [(n, canary(cmd), s) for n, cmd, s in green_cases]
    hang = canary("sleep 20")
    dead = canary(mess(), port=1)
    smtp.close()
    import socket
    mute = socket.socket()
    mute.bind(("127.0.0.1", 0))
    mute.listen(5)  # соединение принято ядром, сервер молчит
    silent = canary("sleep 20", port=mute.getsockname()[1])
    mute.close()
    show_cap = "import importlib.util as u; s = u.spec_from_file_location('c', 'canary.py'); m = u.module_from_spec(s); s.loader.exec_module(m); print(m.MAX_S, m.SMTP_S, m.thresholds()[2])"
    caps = [sh(["python3", "-c", show_cap], cn, env=dict(GIT_ENV, CANARY_PLANKEN=p))[1] for p in (plank(timeout_s=300), plank(timeout_s=None))]
    timer, service = read(f"{root}/deploy/canary.timer"), read(f"{root}/deploy/canary.service")
    limit = re.search(r"^TimeoutStartSec=(\d+)\s*$", service, re.M)
    units = bool(re.search(r"^OnCalendar=(?:daily|\*-\*-\* \d\d:\d\d)", timer, re.M)) and "Persistent=true" in timer and "Type=oneshot" in service and "scripts/canary.py" in service and bool(limit) and int(limit[1]) > 60
    is_rot = lambda x, grund: x[0] == 1 and x[2] == ["Fixtur Kontrolle: ROT"] and f"CANARY_ROT grund={grund}" in x[1] and "Traceback" not in x[1]
    is_green = lambda x, state: x[0] == 0 and x[2] == [f"Fixtur Kontrolle: {state}"] and "CANARY_OK" in x[1] and ("GELB p95>3200" in x[1]) == (state == "GELB")
    brief = lambda x: f"rc {x[0]} «{tail(x[1], 1, 70)}» {x[2]}"
    sides_line("F4.3", [*[("rot", n, is_rot(x, g), brief(x)) for n, x, g in red_runs],
                        ("rot", "повис", is_rot(hang, "timeout") and hang[3] < 10, f"{brief(hang)} за {hang[3]:.0f} с"),
                        *[("gruen", n, is_green(x, s), brief(x)) for n, x, s in green_runs],
                        ("gruen", "письмо не ушло", dead[0] == 0 and "CANARY_BRIEF_FEHLER" in dead[1], raw(dead, 1, 40)),
                        ("gruen", "S24 E9 прогон повис, SMTP молчит", silent[0] == 1 and "grund=timeout" in silent[1] and "CANARY_BRIEF_FEHLER" in silent[1] and silent[3] < 20, f"{raw(silent, 2, 110)} за {silent[3]:.0f} с"),
                        ("gruen", "E9 потолок: прогон + письмо", caps == ["60 10 49", "60 10 49"], f"MAX_S SMTP_S прогон при timeout_s 300 — {caps[0]}, при пустом — {caps[1]}"),
                        ("gruen", "E13 таймер раз в день, служба дольше потолка", units, f"TimeoutStartSec={limit[1] if limit else 'нет'}")])
    # F4.4 — шаблоны SPEC §5 и GATE п. 0: без строки --templates красный
    green_t = sh([os.path.abspath(f"{root}/bin/check-budget"), "--templates"], root if root != "kit" else ".", env=dict(os.environ))
    copies, reds = tempfile.mkdtemp(prefix="check-kit-tpl-", dir=TMP), {}
    for name, rel, needle in (("регрессия", "docs/SPEC.template.md", "Регрессия модуля при закрытии"), ("закрытие", "docs/SPEC.template.md", "Правило закрытия"), ("окно", "docs/SPEC.template.md", "Окно деплоя"),
                              ("паспорт", "docs/SPEC.template.md", "Паспорт модуля"), ("GATE п. 0", "docs/GATE.template.md", "| 0 |")):
        c_ = f"{copies}/{len(reds)}"
        template_copy(c_)
        text = read(f"{c_}/{rel}")
        put(c_, rel, "\n".join(l for l in text.split("\n") if needle not in l))
        reds[name] = sh(["bin/check-budget", "--templates"], c_, env=dict(os.environ))
    no_gate = f"{copies}/no-gate"
    template_copy(no_gate)
    os.remove(f"{no_gate}/docs/GATE.template.md")
    reds["нет GATE"] = sh(["bin/check-budget", "--templates"], no_gate, env=dict(os.environ))

    sample = f"{copies}/sample"
    template_copy(sample)
    control = sh(["bin/check-budget", "--templates"], sample, env=dict(os.environ))  # без правки копия зелёная: красное ниже — от правки

    def edited(name, rel, edit):  # правка одного шаблона → прогон --templates → шаблон на месте
        text = read(f"{sample}/{rel}")
        put(sample, rel, edit(text))
        reds[name] = sh(["bin/check-budget", "--templates"], sample, env=dict(os.environ))
        put(sample, rel, text)
        return reds[name]
    spec_t, gate_t = "docs/SPEC.template.md", "docs/GATE.template.md"
    # S25–S27: каждая фраза договора снята отдельно, строка остаётся; список — здесь, не из CONTRACT
    phrases = [(spec_t, p) for p in ("Регрессия модуля при закрытии", "`DEPLOY_OK` только после `REGRESS_OK`", "Правило закрытия", "гейт не закрывается с красным", "Окно деплоя", "`LIVE_OK`", "Паспорт модуля", "`DEPLOY_FAIL step=passport`")] \
        + [(gate_t, p) for p in ("контрольный прогон", "гейт не закрывается с красным", "`bin/check-fenster`", "`FENSTER_GRUEN")]
    no_phrase = [(p, edited(f"{rel[5:9]}: {p}", rel, lambda t, p=p: t.replace(p, ""))) for rel, p in phrases]
    named_ok = all(any(l.startswith("FAIL contract") and p in l for l in r[1].splitlines()) for p, r in no_phrase)
    # E12: фраза жива только в §5 вне комментария, строка 0 — в таблице вне комментария
    five = ("- Регрессия модуля", "- Правило закрытия", "- Окно деплоя", "- Паспорт модуля")

    def in_comment(t):
        ls = t.split("\n")
        at = [k for k, l in enumerate(ls) if l.startswith(five)]
        return "\n".join(ls[:at[0]] + ["<!--"] + ls[at[0]:at[-1] + 1] + ["-->"] + ls[at[-1] + 1:])

    def to_section6(t):
        ls = t.split("\n")
        rest = [l for l in ls if not l.startswith(five)]
        at = next(k for k, l in enumerate(rest) if l.startswith("## 6"))
        return "\n".join(rest[:at + 1] + [l for l in ls if l.startswith(five)] + rest[at + 1:])
    edited("E12 строки §5 в комментарии", spec_t, in_comment)
    edited("E12 строки §5 в §6", spec_t, to_section6)
    edited("E12 незакрытый комментарий в §5", spec_t, lambda t: re.sub(r"^(## 5\b.*)$", r"\1\n<!--", t, flags=re.M))
    edited("T5 правило закрытия обращено", spec_t, lambda t: t.replace("гейт не закрывается с красным", "гейт закрывается с красным"))
    edited("E12 строка 0 в комментарии", gate_t, lambda t: re.sub(r"^(\| 0 \|.*)$", r"<!-- \1 -->", t, flags=re.M))
    edited("E12 строка 0 вне таблицы", gate_t, lambda t: re.sub(r"^\| 0 \|", "- | 0 |", t, flags=re.M))
    edited("S25 строка 0 без команды", gate_t, lambda t: t.replace("`bin/check-fenster`", "`<команда>`"))
    edited("S28 строка 0 ждёт FENSTER_ROT", gate_t, lambda t: t.replace("`FENSTER_GRUEN …`", "`FENSTER_ROT …`"))
    ok_t = green_t[0] == 0 and green_t[1].splitlines()[-1] == "BUDGET_OK" and control[0] == 0
    ok_r = all(r[0] == 1 and "BUDGET_FAIL" in r[1] and ("FAIL contract" in r[1] or "FAIL templates" in r[1]) for r in reds.values()) and named_ok
    probe("F4.4", ok_t and ok_r, f"templates={'OK' if ok_t else 'нет'} rot={'OK' if ok_r else 'нет'} · кит — {tail(green_t[1])}, копия без правки — {tail(control[1])} · красных {sum(r[0] == 1 for r in reds.values())}/{len(reds)}, без красной стороны: {', '.join(k for k, r in reds.items() if r[0] != 1) or 'нет'}, снятая фраза названа в FAIL — {named_ok} · без строки: " + ", ".join(f"{k} — rc {r[0]}" for k, r in reds.items())
          + f"; «{next((l for l in reds['окно'][1].splitlines() if l.startswith('FAIL')), '')[:110]}»")
    print("FENSTER_OK" if all(sec) and len(sec) == 4 else "FENSTER_FAIL", flush=True)
    return all(sec) and len(sec) == 4


def section_graph():
    """Граф кода в ките: хук после коммита на заглушке CLI (и отметка сборки), строка харнеса, первая сборка, отчёт апгрейда, живой CLI при наличии. Итог — GRAPH_OK."""
    os.makedirs(TMP, exist_ok=True)
    stub_dir = tempfile.mkdtemp(prefix="graph-stub-", dir=TMP)
    put(stub_dir, "graphify", '#!/bin/sh\necho "$*" >> graphify-called\nsleep "${STUB_SLEEP:-0}"\n[ "${STUB_RC:-0}" = 0 ] || exit "$STUB_RC"\nmkdir -p graphify-out && echo "{}" > graphify-out/graph.json\n')
    os.chmod(f"{stub_dir}/graphify", 0o755)
    bare_path = ":".join(p for p in os.environ.get("PATH", "").split(":") if not os.path.exists(f"{p}/graphify"))
    stub = dict(GIT_ENV, PATH=f"{stub_dir}:{bare_path}")
    no_cli = dict(GIT_ENV, PATH=bare_path)
    harness = os.path.abspath(f"{root}/bin/check-harness")

    def waited(path, seconds):
        end = time.monotonic() + seconds
        while time.monotonic() < end and not os.path.exists(path):
            time.sleep(0.1)
        return os.path.exists(path)

    def fixture(graph=True):
        d = project({"basis": None, "module": {}})
        if graph:
            put(d, "graphify-out/graph.json", "{}\n")
        return d

    def after_commit(d, env, name="src/g.py"):
        put(d, name, "g = 1\n")
        sh(["git", "add", "--", name], d, env=env)
        t0 = time.monotonic()
        rc, text = sh(["git", "commit", "-qm", "F1.1: проба графа"], d, env=env)
        return rc, text, time.monotonic() - t0
    direct = lambda d, env: sh(["sh", ".githooks/post-commit"], d, env=env)[0]  # git не смотрит на код post-commit: код хука — отдельно
    rows = []
    hook = f"{root}/.githooks/post-commit"
    rows.append((os.access(hook, os.X_OK), f"{hook} исполняемый — {'да' if os.access(hook, os.X_OK) else 'нет'}"))
    # есть граф и CLI — update в фоне, отметка сборки = HEAD, graphify-out вне git; строка харнеса — граф для HEAD
    d = fixture()
    rc, _, _ = after_commit(d, stub)
    called = waited(f"{d}/graphify-called", 15)
    stamped = waited(f"{d}/graphify-out/.built-head", 15)
    head = sh(["git", "rev-parse", "HEAD"], d)[1]
    stamp = read(f"{d}/graphify-out/.built-head").strip() if stamped else ""
    args_seen = read(f"{d}/graphify-called").strip().splitlines()[0] if called else ""
    ignored = read(f"{d}/graphify-out/.gitignore").strip() if os.path.exists(f"{d}/graphify-out/.gitignore") else ""
    dirty = sh(["git", "status", "--short", "--", "graphify-out"], d)[1]
    rows.append((rc == 0 and direct(d, stub) == 0 and args_seen == "update ." and stamp == head and ignored == "*" and not dirty,
                 f"граф и CLI — rc {rc}, CLI «{args_seen}», отметка = HEAD — {'да' if stamp == head else 'нет'}, graphify-out вне git — {'да' if ignored == '*' and not dirty else 'нет'}"))
    fresh_line = sh([sys.executable, harness, "graph"], d)[1]
    rows.append(("OK   graph: граф собран для HEAD" in fresh_line and "HARNESS_WARN graph-age" not in fresh_line, f"bin/check-harness graph, отметка = HEAD — «{tail(fresh_line)}»"))
    put(d, "graphify-out/.built-head", "0" * 40 + "\n")
    stale_line = sh([sys.executable, harness, "graph"], d)[1]
    rows.append(("HARNESS_WARN graph-age" in stale_line, f"отметка другого коммита — «{tail(stale_line)}»"))
    # нет графа (и каталог без graph.json), нет CLI, CLI упал, CLI думает — коммит проходит, хук rc 0, CLI не зовётся или не держит
    for name, prep in (("графа нет", lambda d: None), ("graphify-out без graph.json", lambda d: put(d, "graphify-out/.gitignore", "*\n"))):
        d = fixture(graph=False)
        prep(d)
        rc, _, _ = after_commit(d, stub)
        absent = not waited(f"{d}/graphify-called", 2)
        rows.append((rc == 0 and direct(d, stub) == 0 and absent and not os.path.exists(f"{d}/graphify-out/graph.json"), f"{name} — rc {rc}, CLI не звали — {'да' if absent else 'нет'}"))
    d = fixture()
    rc, _, _ = after_commit(d, no_cli)
    rows.append((rc == 0 and direct(d, no_cli) == 0 and not os.path.exists(f"{d}/graphify-out/.gitignore"), f"CLI нет — rc {rc}"))
    d = fixture()
    rc, _, _ = after_commit(d, dict(stub, STUB_RC="3"))
    called = waited(f"{d}/graphify-called", 15)
    rows.append((rc == 0 and direct(d, dict(stub, STUB_RC="3")) == 0 and called and not waited(f"{d}/graphify-out/.built-head", 2), f"CLI упал — rc {rc}, коммит прошёл, отметки нет"))
    d = fixture()
    rc, _, spent = after_commit(d, dict(stub, STUB_SLEEP="20"))  # под нагрузкой сам коммит (commit-msg, abide) — до 4–6 с: порог с запасом, сон дольше порога
    rows.append((rc == 0 and spent < 12, f"CLI думает 20 с — коммит не ждёт: {spent:.1f} с"))
    if root == "kit":
        init = os.path.abspath("bin/two-tier-init")

        def fresh_target():
            t = tempfile.mkdtemp(prefix="graph-init-", dir=TMP)
            sh(["git", "init", "-q", "-b", "main"], t)
            return t
        t = fresh_target()
        rc, text = sh([init, t], os.getcwd(), env=stub)
        called = os.path.exists(f"{t}/graphify-called") and read(f"{t}/graphify-called").strip() == "update ."
        ig = os.path.exists(f"{t}/graphify-out/.gitignore") and read(f"{t}/graphify-out/.gitignore").strip() == "*"
        built = "graphify-out/ собран" in text and called and ig
        rows.append((rc == 0 and built and not sh(["git", "status", "--short", "--", "graphify-out"], t)[1], f"init с CLI — rc {rc}, собран и вне git — {'да' if built else 'нет'}"))
        rows.append((os.access(f"{t}/.githooks/post-commit", os.X_OK), f"init кладёт исполняемый post-commit — {'да' if os.access(f'{t}/.githooks/post-commit', os.X_OK) else 'нет'}"))
        t = fresh_target()
        rc, text = sh([init, t], os.getcwd(), env=no_cli)
        rows.append((rc == 0 and "CLI graphify нет" in text and not os.path.exists(f"{t}/graphify-out"), f"init без CLI — rc {rc}, строка установки — {'да' if 'CLI graphify нет' in text else 'нет'}"))
        t = fresh_target()
        rc, text = sh([init, t], os.getcwd(), env=dict(stub, STUB_RC="3"))
        rows.append((rc == 0 and "не прошёл" in text, f"init, CLI упал — rc {rc}, сказано — {'да' if 'не прошёл' in text else 'нет'}"))
        up = os.path.abspath(f"{root}/bin/two-tier-upgrade")

        def upgraded(silent_hook=False, graph=False, hooks_path=False, worktree=False, tracked=False):
            u = tempfile.mkdtemp(prefix="graph-up-", dir=TMP)
            sh(["git", "init", "-q", "-b", "main"], u)
            put(u, "src/a.py", "a = 1\n")
            if hooks_path:  # проект уже на ките: судьи в .githooks, core.hooksPath стоит
                for h in ("commit-msg", "pre-push"):
                    put(u, f".githooks/{h}", read(f"{root}/.githooks/{h}"))
                    os.chmod(f"{u}/.githooks/{h}", 0o755)
            if tracked:
                put(u, "graphify-out/graph.json", "{}\n")
            sh(["git", "add", "-A"], u)
            sh(["git", "-c", "core.hooksPath=/dev/null", "commit", "-qm", "base"], u)
            if hooks_path:
                sh(["git", "config", "core.hooksPath", ".githooks"], u)
            if silent_hook:
                put(u, ".git/hooks/post-commit", "#!/bin/sh\ngraphify hook-rebuild\n")
            if graph:
                put(u, "graphify-out/graph.json", "{}\n")
            target = u
            if worktree:  # связанное дерево: .git — файл, хуки — в общем каталоге git
                target = f"{u}-wt"
                sh(["git", "worktree", "add", "-q", "-b", "wt", target], u)
            rc_up, _ = sh([up, target], os.getcwd(), env=dict(GIT_ENV))
            return rc_up, read(f"{target}/docs/upgrade-v3.md") if os.path.isfile(f"{target}/docs/upgrade-v3.md") else "", os.access(f"{target}/.githooks/post-commit", os.X_OK)
        silent_line = lambda rep: next((l for l in rep.splitlines() if "молчат" in l), "")
        rc, report, hooked = upgraded(silent_hook=True)
        rows.append((rc == 0 and hooked and "`post-commit`" in silent_line(report) and "`graphify update .`" in report, f"апгрейд: хук .git/hooks и нет графа — rc {rc}, названы — {'да' if silent_line(report) and 'graphify update' in report else 'нет'}; post-commit кита — {'да' if hooked else 'нет'}"))
        rc, report, hooked = upgraded(graph=True)
        rows.append((rc == 0 and hooked and not silent_line(report) and "`graphify update .`" not in report and "в git:" not in report, f"апгрейд: своих хуков нет, граф есть — rc {rc}, лишних строк нет — {'да' if not silent_line(report) and 'graphify update' not in report else 'нет'}"))
        rc, report, _ = upgraded(silent_hook=True, graph=True, hooks_path=True)
        line = silent_line(report)
        rows.append((rc == 0 and "`post-commit`" in line and "`commit-msg`" not in line and "`pre-push`" not in line, f"апгрейд проекта на ките (core.hooksPath .githooks) — rc {rc}, названы только хуки .git/hooks — {'да' if line and 'commit-msg' not in line else 'нет'}"))
        rc, report, _ = upgraded(silent_hook=True, graph=True, worktree=True)
        rows.append((rc == 0 and "`post-commit`" in silent_line(report), f"апгрейд связанного дерева — rc {rc}, хук общего .git/hooks назван — {'да' if silent_line(report) else 'нет'}"))
        rc, report, _ = upgraded(tracked=True)
        rows.append((rc == 0 and "`graphify-out/` в git" in report, f"апгрейд: graphify-out в git — rc {rc}, сказано — {'да' if 'graphify-out/` в git' in report else 'нет'}"))
    else:
        print("--   graph: не репо кита — init и апгрейд не гоняются", flush=True)
    # живой CLI: граф растёт после коммита, отметка = HEAD, вне репо не пишет; на машине без CLI (CI) — строка
    if shutil.which("graphify"):
        home = tempfile.mkdtemp(prefix="graph-home-", dir=TMP)
        live = dict(GIT_ENV, HOME=home, PATH=os.environ["PATH"])
        d = project({"basis": None, "module": {}})
        first = sh(["graphify", "update", "."], d, env=live)
        put(d, "src/g2.py", "def graph_probe_fn():\n    return 1\n")
        sh(["git", "add", "--", "src/g2.py"], d, env=live)
        rc, _ = sh(["git", "commit", "-qm", "F1.1: живая проба графа"], d, env=live)
        head = sh(["git", "rev-parse", "HEAD"], d)[1]
        end, found = time.monotonic() + 30, False
        while time.monotonic() < end and not found:
            found = "graph_probe_fn" in read(f"{d}/graphify-out/graph.json") and os.path.exists(f"{d}/graphify-out/.built-head") and read(f"{d}/graphify-out/.built-head").strip() == head
            time.sleep(0.3)
        outside = [f for _, _, fs in os.walk(home) for f in fs]
        rows.append((first[0] == 0 and rc == 0 and found and not outside and not sh(["git", "status", "--short", "--", "graphify-out"], d)[1], f"живой CLI: новая функция в графе и отметка = HEAD — {'да' if found else 'нет'}, файлов вне репо — {len(outside)}"))
    else:
        print("--   graph: CLI graphify нет в PATH (CI) — живого прогона нет", flush=True)
    ok, raw_rows = all(r[0] for r in rows), "; ".join(("" if r[0] else "FAIL ") + r[1] for r in rows)
    print(f"graph {'' if ok else 'FAIL: '}{raw_rows}", flush=True)
    print("GRAPH_OK" if ok else "GRAPH_FAIL", flush=True)
    shutil.rmtree(stub_dir, ignore_errors=True)
    return ok


# ---------- раздел paar (SPEC-v3.4 F5): заглушки и фикстуры — свои, claude, клона telefon и настоящего времени стенда не нужно ----------
VERIFY_RUNS = "docs/evidence/verify-runs.jsonl"
CLI_BEFORE, CLI_AFTER = (2, 1, 316), (2, 1, 318)  # K78: changelog 2.1.318 — шелл-команды фоновых подагентов уходят в фон через 3 мин
FAKE_CLAUDE = """#!/usr/bin/env python3
import json, os, sys, time
if sys.argv[1:] == ["--version"]:  # check-versions зовёт его до прогона: настоящий CLI отвечает сразу, даже когда прогон повиснет
    print("2.1.316 (Claude Code)")
    sys.exit(0)
d = os.environ["FAKE_DIR"]
json.dump({"result": {"report": "VERDICT: PASS\\nFEATURES: F1\\n"}, "workflowProgress": []}, open(f"{d}/out.json", "w"))
for l in open(f"{d}/stream.jsonl"):
    sys.stdout.write(l.replace("OUT_FILE", f"{d}/out.json"))
    sys.stdout.flush()
if os.path.exists(f"{d}/hang"):
    time.sleep(120)
"""


def runs_read(path, limit):
    """Журнал bin/verify-phase (F5.3, K78) → (состояние, k, m, сырой вывод). Замер — только прогон со status completed. Состояние: rot — замер дольше своего лимита (limit строки; в старой строке его нет — limit аргумента), offen — n < 2 хоть на одной стороне пары ≤2.1.316 и ≥2.1.318 или журнала нет, done — иначе.
    k — меньшее n двух сторон, m — команд в фоне по всему журналу; по каждой версии — n, p50 и max секунд замеров, команды в фоне; упёршиеся в лимит — счётчиком timeout=<k>. Битая строка — не прогон."""
    runs = []
    for l in read(path).splitlines() if os.path.isfile(path) else []:
        try:
            r = json.loads(l)
        except ValueError:
            continue
        if isinstance(r, dict) and isinstance(r.get("sec"), (int, float)):
            runs.append(r)
    if not runs:
        return "offen", 0, 0, f"журнала {path} нет или в нём нет прогонов"
    cli = lambda r: str(r.get("cli") or "?")
    ver = lambda v: tuple(map(int, v.split("."))) if re.fullmatch(r"\d+(\.\d+)+", v) else None
    done = [r for r in runs if r.get("status") == "completed"]
    before = sum(1 for r in done if ver(cli(r)) and ver(cli(r)) <= CLI_BEFORE)
    after = sum(1 for r in done if ver(cli(r)) and ver(cli(r)) >= CLI_AFTER)
    rows = []
    for v in sorted({cli(r) for r in done}, key=lambda v: ver(v) or ()):
        secs = sorted(r["sec"] for r in done if cli(r) == v)
        rows.append(f"{v}: n={len(secs)} p50={secs[(len(secs) + 1) // 2 - 1]:g} max={secs[-1]:g} fon={sum(int(r.get('fon') or 0) for r in runs if cli(r) == v)}")
    over = [r for r in done if r["sec"] > r.get("limit", limit)]
    top = max((r["sec"] for r in done), default=0)
    timeouts = sum(1 for r in runs if r.get("status") == "timeout")
    longer = sum(1 for r in done if r["sec"] > limit)  # по своему --limit: limit аргумента они не держат
    state = "rot" if over else "offen" if min(before, after) < 2 else "done"
    raw = f"{'; '.join(rows)} · пара: ≤2.1.316 n={before}, ≥2.1.318 n={after} · timeout={timeouts} · лимит {limit} с: " + (f"прогонов дольше своего лимита — {len(over)}, max {top:g}" if over else f"max {top:g}, дольше него по своему --limit — {longer}" if longer else f"max {top:g} — держит")
    return state, min(before, after), sum(int(r.get("fon") or 0) for r in runs), raw


def runs_word(state, k, m):  # начало строки F5.3 (SPEC-v3.4 §4: без замера — offen)
    return f"offen n={k} fon={m}" if state == "offen" else f"n={k} fon={m}"


def section_paar():
    sec.clear()
    made = []

    def fresh(**kw):  # проект-фикстура; каталог снимается в конце раздела
        d = project({"basis": None, "module": {}}, **kw)
        made.append(d)
        return d

    def row(item, words, sides):  # строка пробы: слова SPEC, сырой вывод сторон; сторона (ключ, имя, сошлось, вывод), не сошлось — ключ «нет» и имена
        text = " ".join(f"{k}={v if all(s[2] for s in sides if s[0] == k) else 'нет'}" for k, v in words)
        missed = [s[1] for s in sides if not s[2]]
        probe(item, not missed, f"{text} · " + "; ".join(f"{s[1]} — {s[3]}" for s in sides) + (f" · НЕ СОШЛОСЬ: {', '.join(missed)}" if missed else ""))
    last = lambda text: (text.strip().splitlines() or [""])[-1]
    # F5.1 — база и новый попеременно, разница p50/p95 против правила до прогона; стенд — заглушка с готовой выборкой, настоящего времени нет
    script = os.path.abspath(f"{root}/checks/paired_stand.sh")
    base_vals = "ms=1000\nms=1100\nms=1200\nms=1300\nms=1400\n"
    stand = 'pwd >> "$PAIR_LOG"\ngrep -c "^PAIR_RULE" "$PAIR_OUT" >> "$PAIR_LOG.rule"\ncat values.txt\n'
    limits = lambda p50=300, p95=500: json.dumps({"pair": {"max_diff_p50_ms": p50, "max_diff_p95_ms": p95}})
    d = fresh(extra={"checks/planken.json": limits(), "stand.sh": stand, "values.txt": base_vals})
    base_sha = sh(["git", "rev-parse", "HEAD"], d)[1]
    real = os.path.realpath(d)

    def pair(vals=base_vals, plan=None, body=stand, sha=base_sha):  # новый код — рабочее дерево: (rc, вывод, стороны прогонов, каталоги базы, правило до первого прогона)
        put(d, "values.txt", vals)
        put(d, "stand.sh", body)
        put(d, "checks/planken.json", limits() if plan is None else plan)
        if plan == "":  # файла правила нет
            os.remove(f"{d}/checks/planken.json")
        log, out_f = f"{d}/.pair-runs", f"{d}/.pair-out"
        for f in (log, log + ".rule"):
            os.path.exists(f) and os.remove(f)
        with open(out_f, "w") as fh:  # вывод — в файл: заглушка читает его при первом прогоне
            rc = subprocess.run(["/bin/bash", script, sha, "--", "sh", "stand.sh"], cwd=d, env=dict(GIT_ENV, PAIR_LOG=log, PAIR_OUT=out_f), stdin=subprocess.DEVNULL, stdout=fh, stderr=subprocess.STDOUT, timeout=120).returncode
        dirs = read(log).split() if os.path.isfile(log) else []
        sides = ["neu" if x == real else "basis" if "/paired-stand-" in x else "?" for x in dirs]
        rule_seen = read(log + ".rule").split()[0] if os.path.isfile(log + ".rule") else ""
        return rc, read(out_f), sides, [x for x in dirs if x != real], rule_seen
    alternating = ["basis", "neu", "basis", "neu"]
    same = pair()
    order = [l.split()[1] for l in same[1].splitlines() if l.startswith("PAIR_RUN ")]
    plus600 = "".join(f"ms={v + 600}\n" for v in (1000, 1100, 1200, 1300, 1400))
    minus600 = "".join(f"ms={v - 600}\n" for v in (1000, 1100, 1200, 1300, 1400))
    plus300 = "".join(f"ms={v + 300}\n" for v in (1000, 1100, 1200, 1300, 1400))
    red600, faster, edge = pair(plus600), pair(minus600), pair(plus300)
    only95 = pair("ms=1000\nms=1100\nms=1200\nms=1300\nms=2000\n")  # p50 тот же, хвост +600
    only50 = pair("ms=1000\nms=1100\nms=1600\nms=1600\nms=1600\n")  # p50 +400, p95 +200
    rank = pair("ms=100\nms=300\n")  # 100 100 300 300: ранг p50 — 2-й, p95 — 4-й
    no_rule, no_keys, bad_rule = pair(plan=limits(None, None)), pair(plan="{}"), pair(plan=limits("300", True))
    no_file = pair(plan="")
    no_sha = pair(sha="0" * 40)
    stand_red = pair(body=stand + "exit 7\n")
    d_ign = fresh(extra={"checks/planken.json": limits(), "stand.sh": 'test -f .env && test -f dep/lib || exit 9\ncat values.txt\n', "values.txt": base_vals, ".gitignore": ".env\ndep/\n"})
    put(d_ign, ".env", "x\n"), put(d_ign, "dep/lib", "x\n")
    ignored = subprocess.run(["/bin/bash", script, sh(["git", "rev-parse", "HEAD"], d_ign)[1], "--", "sh", "stand.sh"], cwd=d_ign, env=GIT_ENV, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
    tokens = pair("rms=9000\nms=1000.5\nms=abc\nxms=7\n")
    empty = pair("")
    vfy = subprocess.run(["/bin/bash", "-c", "echo $BASH_VERSION"], capture_output=True, text=True).stdout.strip()
    clean_gone = not any(os.path.exists(x) for r in (same, red600, stand_red) for x in r[3])
    brief = lambda r: f"rc {r[0]} «{last(r[1])[:90]}»"
    is_pair = lambda r, rc, head: r[0] == rc and last(r[1]).startswith(head) and r[2] == alternating
    no_run = lambda r: r[0] == 1 and last(r[1]).startswith("PAIR_FAIL") and not r[2] and "PAIR_RULE" not in r[1]
    row("F5.1", (("gleich", "OK"), ("rot", "FAIL")), [
        ("gleich", "один код", is_pair(same, 0, "PAIR_OK diff_p50=0 diff_p95=0 ") and order == alternating, f"{brief(same)}, прогоны {' '.join(same[2])}, bash {vfy.split('(')[0]}"),
        ("gleich", "правило до первого прогона", same[4] == "1" and "PAIR_RULE diff_p50 ≤ 300 мс, diff_p95 ≤ 500 мс" in same[1], f"PAIR_RULE в выводе при первом прогоне: {same[4] or 'нет'}"),
        ("gleich", "ровно порог", is_pair(edge, 0, "PAIR_OK diff_p50=300 diff_p95=300 "), brief(edge)),
        ("gleich", "игнорируемое git видят обе стороны", ignored.returncode == 0 and last(ignored.stdout).startswith("PAIR_OK diff_p50=0 diff_p95=0 ") and os.path.isfile(f"{d_ign}/dep/lib"), f"rc {ignored.returncode} «{last(ignored.stdout)[:90]}»"),
        ("gleich", "новый быстрее", is_pair(faster, 0, "PAIR_OK diff_p50=-600 diff_p95=-600 "), brief(faster)),
        ("gleich", "nearest rank", is_pair(rank, 0, "PAIR_OK ") and "neu_p50=100 " in last(rank[1]) and "neu_p95=300 " in last(rank[1]) and "n=10/4" in last(rank[1]), last(rank[1])[:110]),
        ("gleich", "каталог базы снят", clean_gone and bool(same[3]), f"каталогов базы осталось {sum(os.path.exists(x) for x in same[3])}"),
        ("gleich", "скрипт исполняемый", os.access(script, os.X_OK), "x"),
        ("rot", "+600 мс", is_pair(red600, 1, "PAIR_FAIL diff_p50=600 diff_p95=600 "), brief(red600)),
        ("rot", "хвост +600, p50 тот же", is_pair(only95, 1, "PAIR_FAIL diff_p50=0 diff_p95=600 "), brief(only95)),
        ("rot", "p50 +400, хвост +200", is_pair(only50, 1, "PAIR_FAIL diff_p50=400 diff_p95=200 "), brief(only50)),
        ("rot", "порогов нет", no_run(no_rule) and "правило не задано" in no_rule[1], f"{brief(no_rule)}, прогонов {len(no_rule[2])}"),
        ("rot", "нет ключей pair", no_run(no_keys) and "правило не задано" in no_keys[1], f"прогонов {len(no_keys[2])}"),
        ("rot", "пороги не числа", no_run(bad_rule) and "правило не задано" in bad_rule[1], f"прогонов {len(bad_rule[2])}"),
        ("rot", "нет checks/planken.json", no_run(no_file) and "правило не задано" in no_file[1], f"прогонов {len(no_file[2])}"),
        ("rot", "нет коммита базы", no_run(no_sha) and "нет коммита базы" in no_sha[1], f"прогонов {len(no_sha[2])}"),
        ("rot", "стенд упал", stand_red[0] == 1 and "PAIR_FAIL стенд упал: neu, прогон 1, rc=7" in stand_red[1] and "PAIR_OK" not in stand_red[1], brief(stand_red)),
        ("rot", "чужие токены — не выборка", tokens[0] == 1 and "PAIR_FAIL нет выборки: neu, прогон 1" in tokens[1], brief(tokens)),
        ("rot", "пустой прогон", empty[0] == 1 and "PAIR_FAIL нет выборки: neu, прогон 1" in empty[1], brief(empty)),
    ])
    # F5.2 — строка пары в шаблоне §2; planka-source: звено вендора только с pair (файл со строкой итога) или «ранняя»
    budget_tool = os.path.abspath(f"{root}/bin/check-budget")

    def planka(cell, name="звено вендора: STT", files=None, tool="t", table=None):  # строка правила planka-source настоящего bin/check-budget на проекте-фикстуре, до выдачи
        spec = "# SPEC\n\n## 2. Фичи\n\n" + (table or "| звено | инструмент | нижняя оценка | источник | измерено у нас (`docs/evidence/<файл>`, n, p50/p95) |\n|---|---|---|---|---|\n" + f"| {name} | {tool} | 1 мс | док | {cell} |\n")
        p = fresh(spec="SPEC-1", extra={"docs/SPEC-1.md": spec, **(files or {})})
        return next((l for l in sh([budget_tool], p)[1].splitlines() if re.match(r"(OK|WARN|FAIL) +planka-source:", l)), "нет строки planka-source")
    result_ok, result_red = "PAIR_OK diff_p50=0 diff_p95=0 n=10/10\n", "spec: SPEC-1\nPAIR_FAIL diff_p50=600 diff_p95=600 n=10/10\n"
    pair_cell = "pair `docs/evidence/pair.txt`"
    numbers = "`docs/evidence/x.txt`, n=12, p50 1, p95 2"
    good = [("«ранняя»", planka("ранняя")), ("pair и файл с PAIR_OK", planka(pair_cell, files={"docs/evidence/pair.txt": result_ok})), ("pair и файл с PAIR_FAIL", planka(pair_cell, files={"docs/evidence/pair.txt": result_red})),
            ("не вендор: файл, n, p50/p95", planka(numbers, name="сборка", files={"docs/evidence/x.txt": "x\n"}))]
    # решение 398: звено вендора — и слово vendor_words файла тимлида в ячейках звена и инструмента; без ключа или файла судит только слово «вендор»
    vendor_words = {"checks/planken.json": json.dumps({"vendor_words": ["Google", "Gemini", "STT", "Jev", "API"]})}
    x_file = {"docs/evidence/x.txt": "x\n"}
    good += [("слово списка в инструменте, «ранняя»", planka("ранняя", name="распознавание", tool="Google Speech", files=vendor_words)),
             ("слово списка в инструменте, pair и файл", planka(pair_cell, name="распознавание", tool="Google Speech", files={**vendor_words, "docs/evidence/pair.txt": result_ok})),
             ("часть слова — не вендор", planka(numbers, name="rapid-сборка", tool="Jevons", files={**vendor_words, **x_file})),
             ("нет ключа: слово не судит", planka(numbers, name="распознавание", tool="Google Speech", files={"checks/planken.json": "{}", **x_file})),
             ("файл не JSON: слово не судит", planka(numbers, name="распознавание", tool="Google Speech", files={"checks/planken.json": "{", **x_file})),
             ("колонка инструмента только в первой таблице", planka(numbers, files={**vendor_words, **x_file}, table="| звено | инструмент | измерено у нас |\n|---|---|---|\n| сборка | t | ранняя |\n\n"
                                                                     f"| звено | заметка | измерено у нас |\n|---|---|---|\n| сборка | Google | {numbers} |\n"))]
    bad = [("слово списка в звене", "нет pair", planka(numbers, name="STT сервера", files={**vendor_words, **x_file})),
           ("слово списка в инструменте", "нет pair", planka(numbers, name="распознавание", tool="Google Speech", files={**vendor_words, **x_file})),
           ("слово списка другим регистром, через дефис", "нет pair", planka(numbers, name="мозг", tool="gemini-3.5-flash", files={**vendor_words, **x_file})),
           ("слово списка, pair без файла", "нет docs/evidence/<файл>", planka("pair", name="распознавание", tool="Google Speech", files=vendor_words)),
           ("инструмент не вторым столбцом", "нет pair", planka(numbers, files={**vendor_words, **x_file}, table=f"| звено | оценка | инструмент | измерено у нас |\n|---|---|---|---|\n| распознавание | 1 мс | Google Speech | {numbers} |\n")),
           ("нет ключа: слово «вендор» судит", "нет pair", planka(numbers, files={"checks/planken.json": "{}", **x_file})),
           ("файл, n, p50/p95 без pair", "нет pair", planka(numbers, files={"docs/evidence/x.txt": "x\n"})), ("абсолют без файла", "нет pair", planka("≈ 2 с")),
           ("Вендор с большой буквы", "нет pair", planka(numbers, name="Вендор STT", files={"docs/evidence/x.txt": "x\n"})),
           ("pair только в имени файла", "нет pair", planka("`docs/evidence/pair.txt`", files={"docs/evidence/pair.txt": result_ok})), ("PAIR_OK вместо слова pair", "нет pair", planka("PAIR_OK `docs/evidence/pair.txt`", files={"docs/evidence/pair.txt": result_ok})),
           ("pair без файла", "нет docs/evidence/<файл>", planka("pair")), ("pair, файла нет", "нет файла docs/evidence/pair.txt", planka(pair_cell)),
           ("pair, файл из пробелов", "пустой файл", planka(pair_cell, files={"docs/evidence/pair.txt": " \n"})), ("pair, файл без итога", "нет строки PAIR_", planka(pair_cell, files={"docs/evidence/pair.txt": "x\n"})),
           ("pair, только PAIR_RULE", "нет строки PAIR_", planka(pair_cell, files={"docs/evidence/pair.txt": "PAIR_RULE diff_p50 ≤ 1 мс\n"})), ("pair, итог не с начала строки", "нет строки PAIR_", planka(pair_cell, files={"docs/evidence/pair.txt": "см. PAIR_OK diff_p50=0 diff_p95=0\n"}))]
    copies = tempfile.mkdtemp(prefix="check-kit-paar-tpl-", dir=TMP)
    made.append(copies)
    green_t = sh([budget_tool, "--templates"], root if root != "kit" else ".", env=dict(os.environ))

    def tpl(name, edit):  # копия кита с правкой шаблона SPEC: --templates самой копии
        c_ = f"{copies}/{name}"
        template_copy(c_)
        put(c_, "docs/SPEC.template.md", edit(read(f"{c_}/docs/SPEC.template.md")))
        return sh(["bin/check-budget", "--templates"], c_, env=dict(os.environ))
    needle = "пара одного часа"
    no_row = tpl("no-row", lambda x: "\n".join(l for l in x.split("\n") if needle not in l))
    in_comment = tpl("comment", lambda x: "\n".join(f"<!-- {l} -->" if needle in l else l for l in x.split("\n")))
    moved_s5 = tpl("s5", lambda x: "\n".join(l for l in x.split("\n") if needle not in l).replace("## 5", f"## 5\n{next((l for l in x.split(chr(10)) if needle in l), '')}\n", 1))
    contract_line = lambda r: next((l for l in r[1].splitlines() if "docs/SPEC.template.md" in l and "contract" in l), "нет строки contract")[:110]
    t_red = lambda r: r[0] == 1 and needle in contract_line(r) and "FAIL" in contract_line(r)
    row("F5.2", (("vorlage", "OK"),), [
        *[("vorlage", f"звено вендора, {n}", l.startswith("OK"), l[:60]) for n, l in good],
        *[("vorlage", f"звено вендора, {n}", l.startswith("FAIL") and w in l, l[l.find("—") + 2:][:90]) for n, w, l in bad],
        ("vorlage", "--templates на ките", green_t[0] == 0 and "BUDGET_OK" in green_t[1], f"rc {green_t[0]} «{last(green_t[1])[:40]}»"),
        ("vorlage", "шаблон без строки пары", t_red(no_row), f"rc {no_row[0]} «{contract_line(no_row)}»"),
        ("vorlage", "строка пары в комментарии", t_red(in_comment), f"rc {in_comment[0]}"),
        ("vorlage", "строка пары не в §2", t_red(moved_s5), f"rc {moved_s5[0]}"),
    ])
    # F5.3 — K78: журнал verify-phase; заглушка claude — поток с известным счётом, лимит судят числа журнала
    vp = os.path.abspath(f"{root}/bin/verify-phase")
    lim_m = re.search(r"^    limit = (\d+)$", read(vp), re.M)
    limit = int(lim_m.group(1)) if lim_m else 0
    fk = tempfile.mkdtemp(prefix="verify-fake-paar-", dir=TMP)
    made.append(fk)
    put(fk, "claude", FAKE_CLAUDE)
    os.chmod(f"{fk}/claude", 0o755)
    put(fk, "events.jsonl", json.dumps({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "unifiedWindows": {"seven_day": {"utilization": 0.05, "resetsAt": int(time.time()) + 86400}}}}) + "\n")
    event = lambda **kw: json.dumps({"type": "system", **kw})
    started = lambda tid, kind="local_bash", **kw: event(subtype="task_started", task_id=tid, task_type=kind, **kw)
    moved_ev = lambda tid, v=True: event(subtype="task_updated", task_id=tid, patch={"is_backgrounded": v})
    head_ev = [event(subtype="init", apiKeySource="none", claude_code_version="2.1.316"), started("w1", "local_workflow", workflow_name="verify-phase")]
    bash_ev = [started("b1", is_backgrounded=False), started("b2"), started("b3", is_backgrounded=True), started("a1", "local_agent", is_backgrounded=True)]
    patch_ev = [moved_ev("b1"), moved_ev("b1"), moved_ev("b2", False), moved_ev("a1")]  # b1 в фон дважды — одна команда; агент — не команда
    done_ev = [event(subtype="task_notification", task_id="w1", status="completed", output_file="OUT_FILE", usage={"duration_ms": 12000, "total_tokens": 1, "tool_uses": 1})]
    v = fresh(extra={"docs/SPEC-2.md": "- **F1 x** · готово: F1.1 · чек: `bin/x` → `X_OK` · служит: S1 · after: —\n"})
    env_v = dict(GIT_ENV, FAKE_DIR=fk, PATH=f"{fk}:{os.environ['PATH']}", CHECK_WINDOW_EVENTS=f"{fk}/events.jsonl")

    def launch(lines, *argv):  # прогон лаунчера с заглушкой: (rc, вывод, строка K78, строки журнала)
        put(fk, "stream.jsonl", "\n".join(lines) + "\n")
        r = sh([vp, "F1", *argv], v, env=env_v)
        clone = re.search(r"→ (/\S+)/repo;", r[1])
        made.append(clone.group(1)) if clone else None
        k78 = next((l for l in r[1].splitlines() if "K78" in l), "нет строки K78")
        rows = [json.loads(l) for l in read(f"{v}/{VERIFY_RUNS}").splitlines()] if os.path.isfile(f"{v}/{VERIFY_RUNS}") else []
        return r[0], r[1], k78, rows
    full = launch(head_ev + bash_ev + patch_ev + done_ev)
    no_patch = launch(head_ev + bash_ev + done_ev)
    no_task = launch(head_ev[:1])  # воркфлоу не запустился: прогон всё равно в журнале
    put(fk, "hang", "")
    hang = launch(head_ev + bash_ev[:1] + ['{"type":"system","subtype":"task_st'], "--limit", "5")
    os.remove(f"{fk}/hang")
    put(fk, "bad.json", '{"result": {"report": "VERDICT')
    cut_out = launch(head_ev + [event(subtype="task_notification", task_id="w1", status="completed", output_file=f"{fk}/bad.json", usage={"duration_ms": 1000})])  # файл итога обрезан
    want = {"cli": "2.1.316", "features": ["F1"], "limit": limit, "wf_sec": 12, "bash": 3, "fon": 2, "moved": 1, "status": "completed"}
    got = {k: x for k, x in (full[3][0] if full[3] else {}).items() if k != "sec"}
    secret_free = all(not re.search(r"/tmp|/Users|/home", json.dumps(r)) for r in hang[3])
    jr = f"{fk}/j.jsonl"

    def journal_of(*rows, raw_lines=()):  # журнал-фикстура: строки (версия, секунды, команд в фоне)
        put(fk, "j.jsonl", "".join(json.dumps({"cli": c, "features": ["F1"], "sec": s, "bash": 1, "fon": f, "status": "completed"}) + "\n" for c, s, f in rows) + "".join(raw_lines))
        return runs_read(jr, limit)
    pair_ok = [("2.1.316", 100, 1), ("2.1.316", 300, 2), ("2.1.319", 200, 4), ("2.1.320", 400, 0)]
    closed = journal_of(*pair_ok)
    edge_j = journal_of(*pair_ok, ("2.1.319", limit, 0))
    over_after = journal_of(*pair_ok, ("2.1.319", limit + 1, 0))
    over_before = journal_of(*pair_ok, ("2.1.316", limit + 100, 0))
    short = journal_of(*pair_ok[:3])
    near = journal_of(*pair_ok[:2], ("2.1.317", 200, 0), ("2.1.317", 200, 0))
    broken = journal_of(*pair_ok, raw_lines=("{битая\n", '{"cli": "2.1.319"}\n'))
    absent = runs_read(f"{fk}/нет.jsonl", limit)
    extra = lambda c, s, **kw: json.dumps({"cli": c, "features": ["F1"], "sec": s, "bash": 1, "fon": 0, "status": "completed", **kw}) + "\n"
    timed = journal_of(*pair_ok, raw_lines=(extra("2.1.319", limit + 6, status="timeout"), extra("2.1.319", limit + 6, status="timeout", limit=limit)))
    only_timed = journal_of(raw_lines=(extra("2.1.319", limit + 6, status="timeout"),))
    override = journal_of(*pair_ok, raw_lines=(extra("2.1.319", 2009, limit=3600),))
    own_over = journal_of(*pair_ok, raw_lines=(extra("2.1.319", 3601, limit=3600),))
    own_short = journal_of(*pair_ok, raw_lines=(extra("2.1.319", 601, limit=600),))
    failed = journal_of(*pair_ok[:3], raw_lines=(extra("2.1.319", 6, status="failed"),))
    failed_none = journal_of(*pair_ok[:3], raw_lines=(extra("2.1.319", 5, status="none"),))
    launcher_rows = runs_read(f"{v}/{VERIFY_RUNS}", limit)
    live_state, live_k, live_m, live_raw = runs_read(VERIFY_RUNS, limit)
    ok_sides = [("поток", full[0] == 0 and got == want and isinstance(full[3][0].get("sec"), int), f"rc {full[0]} «{full[2][len('verify-phase: '):]}»"),
                ("поток без task_updated — другое число", no_patch[0] == 0 and "bash=3 fon=1 moved=0 status=completed" in no_patch[2] and len(no_patch[3]) == 2, no_patch[2][len("verify-phase: "):]),
                ("воркфлоу не стартовал", "status=none" in no_task[2] and len(no_task[3]) == 3, f"rc {no_task[0]} «{no_task[2][len('verify-phase: '):]}»"),
                ("лимит истёк, поток обрезан", hang[0] == 3 and "VERIFY_TIMEOUT" in hang[1] and "cli=2.1.316" in hang[2] and "bash=1 fon=0 moved=0 status=timeout" in hang[2] and len(hang[3]) == 4 and hang[3][-1]["sec"] >= 5 and hang[3][-1].get("limit") == 5 and secret_free, f"rc {hang[0]} «{hang[2][len('verify-phase: '):]}»"),
                ("файл итога обрезан: строка журнала есть, вердикта нет", cut_out[0] == 1 and "воркфлоу не вернул отчёт" in cut_out[1] and "Traceback" not in cut_out[1] and len(cut_out[3]) == 5, f"rc {cut_out[0]} «{cut_out[2][len('verify-phase: '):]}», строк журнала {len(cut_out[3])}"),
                ("журнал этих прогонов лаунчера: timeout не красит", launcher_rows[0] != "rot" and "timeout=1" in launcher_rows[3], f"{launcher_rows[0]} · {launcher_rows[3]}"),
                ("лимит лаунчера", limit == 1800, f"{limit} с"),
                ("журнал n ≥ 2 с обеих сторон", closed[:3] == ("done", 2, 7) and runs_word(*closed[:3]) == "n=2 fon=7", f"{runs_word(*closed[:3])} · {closed[3]}"),
                ("прогон ровно на лимите", edge_j[0] == "done", edge_j[0]),
                ("прогон дольше лимита, новая сторона", over_after[0] == "rot", f"{over_after[0]} · {over_after[3].split(' · ')[-1]}"),
                ("прогон дольше лимита, старая сторона", over_before[0] == "rot", over_before[0]),
                ("VERIFY_TIMEOUT — счётчик, не красный и не замер", timed[:3] == ("done", 2, 7) and "timeout=2" in timed[3] and "max 400 — держит" in timed[3], f"{timed[0]} · {timed[3]}"),
                ("только VERIFY_TIMEOUT", only_timed[:2] == ("offen", 0) and "timeout=1" in only_timed[3], f"{only_timed[0]} · {only_timed[3]}"),
                ("--limit 3600, прогон 2009 с", override[0] == "done" and "max 2009, дольше него по своему --limit — 1" in override[3], f"{override[0]} · {override[3].split(' · ')[-1]}"),
                ("--limit 3600, прогон 3601 с", own_over[0] == "rot", f"{own_over[0]} · {own_over[3].split(' · ')[-1]}"),
                ("--limit 600, прогон 601 с", own_short[0] == "rot", own_short[0]),
                ("упавший запуск — не замер: n и p50 те же", failed[:2] == ("offen", 1) and "2.1.319: n=1 p50=200 " in failed[3], f"{runs_word(*failed[:3])} · {failed[3]}"),
                ("запуск без воркфлоу — не замер", failed_none[:2] == ("offen", 1), runs_word(*failed_none[:3])),
                ("≥2.1.318 n=1", short[:3] == ("offen", 1, 7) and runs_word(*short[:3]) == "offen n=1 fon=7", runs_word(*short[:3])),
                ("2.1.317 — ни одна сторона", near[:2] == ("offen", 0), f"{near[0]} n={near[1]}"),
                ("битые строки журнала — не прогоны", broken[:3] == ("done", 2, 7), f"{broken[0]} n={broken[1]}"),
                ("журнала нет", absent[:3] == ("offen", 0, 0) and runs_word(*absent[:3]) == "offen n=0 fon=0", runs_word(*absent[:3]))]
    missed = [s[0] for s in ok_sides if not s[1]]
    probe("F5.3", live_state != "rot" and not missed, f"{runs_word(live_state, live_k, live_m)} · {live_raw} · " + "; ".join(f"{s[0]} — {s[2]}" for s in ok_sides) + (f" · НЕ СОШЛОСЬ: {', '.join(missed)}" if missed else ""))
    # F5.4 — три числа ретро в отчёте; данных нет — нули; разница чисел ловит мутацию счёта
    spec_tpl = lambda *lines: "# SPEC\n\n## 0. Контекст\n" + "".join(l + "\n" for l in lines) + "\n## 2. Фичи\n- **F1 x** · готово: F1.1\n  - `F1.1` проба\n\n## 3. Инварианты\nПоправка 9: слово оператора 01.01.2026 — вне §0.\n"
    verdict = lambda v_, feats, block=(), spec="docs/SPEC-2.md": f"VERDICT: {v_}\nFEATURES: {feats}\n/verify-phase · {spec} · HEAD x\n\n## Блокирующие\n" + "".join(f"- **{b}: дефект**\n" for b in block) + "\n## Named, not built\n- **F9: не блокирует**\n"
    tools_r = ("check-frozen-diff", "check-passport", "phase-report", "check-budget")
    r_p = fresh(tools=tools_r, extra={"docs/SPEC-2.md": spec_tpl("Поправка 1: слово оператора 06.11.2026 — x.", "Поправка 2: слово оператора 07.11 — y.", "Поправка <решение>: слово оператора <дата> — образец.")})
    tick = lambda: (sh(["git", "-c", "core.hooksPath=/dev/null", "commit", "--allow-empty", "-qm", "x"], r_p), sh(["git", "rev-parse", "--short", "HEAD"], r_p)[1])[1]
    s0, s1, s2 = tick(), tick(), tick()  # одна секунда на всех: порядок — по истории, не по часам
    while s2 > s1:  # имя файла нового круга — раньше старого: сортировка по имени даст другой счёт
        s2 = tick()

    def rep(p=r_p):  # (rc, строка кругов, строка откатов, строка поправок, stdout)
        rc, text = sh(["bin/phase-report", "--no-jev"], p)
        md = read(f"{p}/docs/evidence/phase-report.md") if os.path.isfile(f"{p}/docs/evidence/phase-report.md") else ""
        get = lambda name: next((l[2:] for l in md.splitlines() if l.startswith(f"- {name}")), "нет")
        return rc, get("Кругов до PASS"), get("Откатов деплоя"), get("Поправок объёма"), last(text)
    show = lambda r: f"rc {r[0]} «{r[1]}» «{r[2]}» «{r[3]}»"
    put(r_p, f"docs/evidence/verify-{s1}.txt", verdict("NEEDS_WORK", "F1, F2", ("F1",)))  # F2 без своих блокирующих — прошла
    put(r_p, f"docs/evidence/verify-{s2}-F1.txt", verdict("PASS", "F1"))
    put(r_p, "docs/evidence/verify-runs.jsonl", '{"cli": "2.1.316", "sec": 1}\n')
    put(r_p, f"docs/evidence/verify-{s0}-F3.txt", verdict("NEEDS_WORK", "F3"))  # NEEDS_WORK без списка блокирующих не проходит никого
    put(r_p, "docs/evidence/verify-0000000-F1.txt", verdict("NEEDS_WORK", "F1", ("F1",), spec="docs/SPEC-9.md"))  # другая SPEC — не круг
    put(r_p, "docs/evidence/deploy-window.log", "DEPLOY_OK sha=a linie=1 rollback=none\nLIVE_OK x\nDEPLOY_OK sha=b linie=1 rollback=a\nROLLBACK_OK sha=a sekunden=9\nDEPLOY_OK sha=c linie=0 rollback=a\nDEPLOY_FAIL step=regress sha=d linie=1\n")
    base_r = rep()
    put(r_p, f"docs/evidence/verify-{s0}-F1.txt", verdict("NEEDS_WORK", "F1", ("F1",)))
    more_round = rep()
    put(r_p, f"docs/evidence/verify-{s2}.txt", verdict("NEEDS_WORK", "F1", ("F1",)))  # полный круг на том же sha, что точечный PASS: сначала полный, имя файла порядок не решает
    same_sha = rep()
    with open(f"{r_p}/docs/evidence/deploy-window.log", "a", encoding="utf-8") as fh:
        fh.write("ROLLBACK_OK sha=a sekunden=9\n")
    more_back = rep()
    put(r_p, "docs/SPEC-2.md", spec_tpl("Поправка 1: слово оператора 06.11.2026 — x.", "Поправка 2: слово оператора 07.11 — y.", "Поправка 3: слово оператора 07.11.2026 — z."))
    more_amend = rep()
    empty_p = fresh(tools=tools_r)
    empty_r = rep(empty_p)
    os.remove(f"{empty_p}/docs/PROMPT.txt")
    no_prompt = rep(empty_p)
    back_p = fresh(tools=tools_r)
    put(back_p, "docs/evidence/deploy-window.log", "DEPLOY_OK sha=a linie=0 rollback=none\nDEPLOY_OK sha=b linie=0 rollback=a\nROLLBACK_OK sha=a sekunden=0\n")
    off_line = rep(back_p)  # шаблон по умолчанию: DEPLOY_LINIE=0
    with open(f"{back_p}/docs/evidence/deploy-window.log", "a", encoding="utf-8") as fh:
        fh.write("DEPLOY_FAIL step=rollout sha=c rc=1 linie=1\nROLLBACK_OK sha=a sekunden=0\nROLLBACK_OK sha=a sekunden=0\n")
    twice = rep(back_p)
    with open(f"{back_p}/docs/evidence/deploy-window.log", "a", encoding="utf-8") as fh:
        fh.write("DEPLOY_OK sha=d linie=1 rollback=a\nDEPLOY_FAIL step=args sha=e\nROLLBACK_OK sha=a sekunden=0\n")
    no_linie = rep(back_p)
    row("F5.4", (("metriken", "3"),), [
        ("metriken", "фикстура", base_r[0] == 0 and base_r[1].startswith("Кругов до PASS: 2 (F1 2, F2 1; без PASS: F3 — 1)") and base_r[2] == "Откатов деплоя: 1 из 3" and base_r[3] == "Поправок объёма: 2"
         and "кругов до PASS 2, откатов 1 из 3, поправок 2" in base_r[4], show(base_r)),
        ("metriken", "ещё один NEEDS_WORK", more_round[1].startswith("Кругов до PASS: 3 (F1 3,"), more_round[1]),
        ("metriken", "полный круг раньше точечного на одном sha", same_sha[1].startswith("Кругов до PASS: 4 (F1 4,"), same_sha[1]),
        ("metriken", "ещё один откат", more_back[2] == "Откатов деплоя: 2 из 3", more_back[2]),
        ("metriken", "ещё одна поправка", more_amend[3] == "Поправок объёма: 3", more_amend[3]),
        ("metriken", "откат выкатки linie=0 — не откат с линии", off_line[2] == "Откатов деплоя: 0 из 0", off_line[2]),
        ("metriken", "два отката одной выкатки — один", twice[2] == "Откатов деплоя: 1 из 1", twice[2]),
        ("metriken", "DEPLOY_FAIL без linie= выкатку не сменил", no_linie[2] == "Откатов деплоя: 2 из 2", no_linie[2]),
        ("metriken", "без данных — нули", empty_r[0] == 0 and (empty_r[1], empty_r[2], empty_r[3]) == ("Кругов до PASS: 0", "Откатов деплоя: 0 из 0", "Поправок объёма: 0"), show(empty_r)),
        ("metriken", "нет и запроса фазы", no_prompt[0] == 0 and (no_prompt[1], no_prompt[3]) == ("Кругов до PASS: 0", "Поправок объёма: 0"), show(no_prompt)),
    ])
    # F5.5 — только неделя (решение 396): ключа нет — WARN и старт; ключ есть — судится; числа не сняты — отказ, как было. Порог кита 100 % (решение 398) не отказывает — механизм отказа на подставленном 85
    win_tool = os.path.abspath(f"{root}/bin/check-window")
    kit_budgets = json.loads(read(f"{root}/budgets.json"))
    w_kit, w_d = fresh(), fresh(extra={"budgets.json": json.dumps({**kit_budgets, "defaults": {**kit_budgets["defaults"], "window_seven_day_pct": 85}})})

    def wnd(info=None, *argv, error=None):  # событие rate_limit_event с полем unifiedWindows = info; info None — поля нет; False — события нет
        ls = [{"type": "system", "subtype": "init"}]
        if info is not False and not error:
            ls.append({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", **({} if info is None else {"unifiedWindows": info})}})
        ls.append({"type": "result", "is_error": bool(error), "result": error or "ok"})
        put(fk, "w.jsonl", "".join(json.dumps(x) + "\n" for x in ls))
        return sh([win_tool, *argv], w_d, env=dict(GIT_ENV, CHECK_WINDOW_EVENTS=f"{fk}/w.jsonl", CHECK_WINDOW_RC="1" if error else "0"))
    week = lambda pct: {"seven_day": {"utilization": pct / 100, "resetsAt": int(time.time()) + 86400}}
    warn = "WINDOW_WARN seven_day=fehlt"
    fehlt_a, fehlt_b, fehlt_o = wnd({"other": {"utilization": 0.1}}), wnd({"five_hour": {"utilization": 0.99}}), wnd({"other": {"utilization": 0.1}}, "--override")
    g84, g86 = wnd(week(84)), wnd(week(86))

    def wnd_stream(*windows, cwd=None):  # несколько событий rate_limit_event подряд
        put(fk, "w.jsonl", "".join(json.dumps({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "unifiedWindows": w}}) + "\n" for w in windows) + json.dumps({"type": "result", "is_error": False, "result": "ok"}) + "\n")
        return sh([win_tool], cwd or w_d, env=dict(GIT_ENV, CHECK_WINDOW_EVENTS=f"{fk}/w.jsonl", CHECK_WINDOW_RC="0"))
    own_pct = kit_budgets["defaults"].get("window_seven_day_pct", 100)  # порог проекта после апгрейда свой: budgets.json апгрейд не правит
    at_own = wnd_stream(week(own_pct), cwd=w_kit)
    no_key = wnd_stream(week(99), cwd=fresh(extra={"budgets.json": json.dumps({**kit_budgets, "defaults": {k_: v_ for k_, v_ in kit_budgets["defaults"].items() if k_ != "window_seven_day_pct"}})}))
    hidden = wnd_stream(week(99), {"seven_day_opus": {"utilization": 0.1}})
    keyless_first = wnd_stream({"seven_day_opus": {"utilization": 0.1}}, week(99))
    last_week = wnd_stream(week(99), week(5))
    no_num, no_ev, no_field, no_empty, no_login = wnd({"seven_day": {}}), wnd(False), wnd(None), wnd({}), wnd(error="Not logged in")
    w_brief = lambda r: f"rc {r[0]} «{tail(r[1], 2, 110)}»"
    refused = lambda r, why: r[0] == 1 and "WINDOW: refuse" in r[1] and why in r[1] and warn not in r[1]
    row("F5.5", (("fehlt", "WARN"),), [
        ("fehlt", "ключа нет", fehlt_a[0] == 0 and warn in fehlt_a[1] and last(fehlt_a[1]) == "WINDOW: start", w_brief(fehlt_a)),
        ("fehlt", "только окно 5 ч, 99 %", fehlt_b[0] == 0 and warn in fehlt_b[1] and last(fehlt_b[1]) == "WINDOW: start", w_brief(fehlt_b)),
        ("fehlt", "ключа нет, --override", fehlt_o[0] == 0 and warn in fehlt_o[1] and "был бы старт" in fehlt_o[1], w_brief(fehlt_o)),
        ("fehlt", "ключ есть, 84 %", g84[0] == 0 and warn not in g84[1] and last(g84[1]) == "WINDOW: start", w_brief(g84)),
        ("fehlt", "свой порог, неделя ровно на нём", at_own[0] == 0 and f"порог: неделя {own_pct} %" in at_own[1] and warn not in at_own[1] and last(at_own[1]) == "WINDOW: start", w_brief(at_own)),
        ("fehlt", "ключа порога нет, неделя 99 %", no_key[0] == 0 and "порог: неделя 100 % (window_seven_day_pct, встроенный)" in no_key[1] and last(no_key[1]) == "WINDOW: start", w_brief(no_key)),
        ("fehlt", "ключ есть, 86 %", refused(g86, "неделя 86 % > 85 %"), w_brief(g86)),
        ("fehlt", "неделя 99 %, за ней событие без ключа", refused(hidden, "неделя 99 % > 85 %"), w_brief(hidden)),
        ("fehlt", "событие без ключа, за ним неделя 99 %", refused(keyless_first, "неделя 99 % > 85 %"), w_brief(keyless_first)),
        ("fehlt", "две недели: судит последняя", last_week[0] == 0 and warn not in last_week[1] and last(last_week[1]) == "WINDOW: start", w_brief(last_week)),
        ("fehlt", "ключ без числа", refused(no_num, "seven_day без числа"), w_brief(no_num)),
        ("fehlt", "нет события", refused(no_ev, "нет события rate_limit_event"), w_brief(no_ev)),
        ("fehlt", "нет поля unifiedWindows", refused(no_field, "нет поля unifiedWindows"), w_brief(no_field)),
        ("fehlt", "поле пусто", refused(no_empty, "нет поля unifiedWindows"), w_brief(no_empty)),
        ("fehlt", "ошибка claude", refused(no_login, "ошибка claude"), w_brief(no_login)),
    ])
    for x in made:
        shutil.rmtree(x, ignore_errors=True)
    green = all(sec) and len(sec) == 5
    print("PAAR_OK" if green else "PAAR_FAIL", flush=True)
    return green



def run_sections(names):
    return all([{"frozen": section_frozen, "fenster": section_fenster, "graph": section_graph, "paar": section_paar}[n]() for n in names])


if want:
    sys.exit(0 if run_sections(want) else 1)
sk = f"{root}/.claude/skills"
names = sorted(d for d in os.listdir(sk) if os.path.isfile(f"{sk}/{d}/SKILL.md"))
say(names == ["accept", "plan-phase"], "skills", f"{sk}: {', '.join(names)} (ждём accept, plan-phase)")
limit = json.loads(read(f"{root}/budgets.json"))["defaults"]["skill_chars"]
CONTRACT = {"accept": ["bin/verify-phase", "Workflow(verify-phase)", "свеж", "30 мин", "docs/evidence/verify-", "VERDICT: PASS",
                      "VERIFY_TIMEOUT", "REVIEW.md", "Named, not built"],
            "plan-phase": ["docs/PLAN-", "PLAN.template.md", "Environment", "платн", "необратим", "bin/check-budget"]}
for n in names:
    t = read(f"{sk}/{n}/SKILL.md")
    fm = dict(re.findall(r"^([\w-]+):\s*(.*)$", t.split("---")[1], re.M)) if t.startswith("---") else {}
    say(fm.get("name", "").strip('"') == n and fm.get("description") and fm.get("disable-model-invocation") == "true",
        n, f"frontmatter: name {fm.get('name')}, description {'есть' if fm.get('description') else 'нет'}, disable-model-invocation {fm.get('disable-model-invocation')}")
    say(len(t) <= limit and not re.search(r"\$\d", t), n, f"знаков {len(t)}/{limit}, `$` с цифрой — {len(re.findall(r'[$][0-9]', t))}")
    miss = [w for w in CONTRACT.get(n, []) if w not in t]
    say(not miss, n, f"контракт ({len(CONTRACT.get(n, []))} слов): нет — {', '.join(miss) or 'ничего'}")
if "accept" in names:
    say("docs/STATUS.md" not in read(f"{sk}/accept/SKILL.md"), "accept", "STATUS не пишет: пути docs/STATUS.md в скилле нет")
ev = read(f"{root}/.claude/agents/evaluator.md")
tools = re.search(r"^tools:(.*)$", ev, re.M).group(1).strip()
say("Write" not in tools and "Edit" not in tools and "REVIEW.md" in ev, "evaluator", f"tools {tools}; формат REVIEW.md {'есть' if 'REVIEW.md' in ev else 'нет'}")
