    # F3.4 — шаг regress: DEPLOY_OK только после REGRESS_OK; судится stdout, stderr идёт мимо
    d = project({"basis": None, "module": {}})
    red = lambda label, got, step="regress": (got[0] == 1 and f"DEPLOY_FAIL step={step}" in got[1] and "DEPLOY_OK" not in got[1], f"{label} — rc {got[0]} «{tail(got[1])}»")
    a = deploy(d)
    b = deploy(d, regress="echo REGRESS_FAIL grund=x; exit 1")
    two = sum([a[0] == 0 and "DEPLOY_OK" in a[1] and "REGRESS_OK" in a[1], b[0] == 1 and "DEPLOY_FAIL step=regress" in b[1] and "DEPLOY_OK" not in b[1]])
    no_regress = {k: v for k, v in GIT_ENV.items() if k not in ("REGRESS_CMD", "DEPLOY_CMD")}
    note = deploy(d, regress="echo REGRESS_OK; echo note >&2")
    rg_ok, rg_raw = fz_join([red("код 1 при маркере", deploy(d, regress="echo REGRESS_OK; exit 1")), red("код 0 без маркера", deploy(d, regress="echo всё прошло")),
                             fz_rc(0, "REGRESS_OK с полями", deploy(d, regress="echo REGRESS_OK stimme=ok bo=ok cc=ok"), "DEPLOY_OK"),
                             fz_rc(0, "заметка в stderr", note, "DEPLOY_OK"), ("note" in note[1], f"заметка {'прошла' if 'note' in note[1] else 'пропала'}"),
                             fz_rc(0, "CR на конце", deploy(d, regress="printf 'REGRESS_OK\\r\\n'"), "DEPLOY_OK"), fz_rc(0, "пробел на конце", deploy(d, regress="echo 'REGRESS_OK '"), "DEPLOY_OK"),
                             red("REGRESS_OKAY", deploy(d, regress="echo REGRESS_OKAY")), red("REGRESS_OK только в stderr", deploy(d, regress="echo итог; echo REGRESS_OK >&2")),
                             red("REGRESS_OK, затем REGRESS_FAIL", deploy(d, regress="echo REGRESS_OK; echo REGRESS_FAIL x")),
                             red("нет REGRESS_CMD и Makefile", sh(["bash", "scripts/deploy.sh"], d, env=no_regress)),
                             red("DEPLOY_CMD=false", sh(["bash", "scripts/deploy.sh"], d, env=dict(GIT_ENV, REGRESS_CMD="echo REGRESS_OK", DEPLOY_CMD="false")), "rollout")])
    probe("F3.4", two == 2 and rg_ok, f"regress={two}/2 · REGRESS_OK — rc {a[0]} «{tail(a[1], 2)}» · REGRESS_FAIL — rc {b[0]} «{tail(b[1], 2)}» · {rg_raw}")
    # F3.5 — апгрейд копии клона telefon: замок и хук работают, bin/check-budget проекта зелёный; нет клона или не репо кита — offen и без маркера
    clone = os.environ.get("TELEFON_CLONE", f"{TMP}/telefon-src")
    up = os.path.abspath(f"{root}/bin/two-tier-upgrade")
    upgrade = lambda *a: sh([up, *a], os.getcwd(), env=dict(os.environ))
    skipped = root != "kit" or not os.path.isdir(f"{clone}/.git")
    if skipped:
        probe("F3.5", True, f"telefon=offen · {'не репо кита' if root != 'kit' else 'клона нет: TELEFON_CLONE или /tmp/two-tier-v3/telefon-src (ветка linie-1)'}")
    else:
        d = fz_copy(clone)
        head0 = head(d)
        dash = upgrade("--branch", "-x", d)
        same_branch = upgrade(d)
        rc_up, text_up = upgrade("--branch", "kit-v3.4", d)
        lock_ok = json.load(open(f"{d}/frozen.json", encoding="utf-8"))
        src_file = next(p for p in sh(["git", "ls-files", "src/"], d)[1].splitlines() if p.endswith(".py") and "/bo/" not in p and "/cc/" not in p)
        original = open(f"{d}/{src_file}", encoding="utf-8").read()
        c1 = commit(d, "F9.9: проба замка", src_file, original + "# проба\n")
        c2 = commit(d, "Тимлид: проба замка", src_file, original + "# проба\n")
        c3 = commit(d, "F53.9: пункт фичи из offen", src_file, original + "# проба\n")
        c4 = commit(d, "F9.9: проба docs", "docs/zz-probe.md", "x\n")
        c5 = commit(d, "F53.9: открыть замок", "frozen.json", open(f"{d}/frozen.json", encoding="utf-8").read() + "\n")
        c6 = commit(d, "F53.9: планки", "checks/planken.json", open(f"{d}/checks/planken.json", encoding="utf-8").read() + "\n")
        rc_b, text_b = sh(["bin/check-budget"], d, env=dict(os.environ))
        frozen_line = fz_budget_line(text_b)
        fz_past_hook(d, "F9.9: мимо хука", src_file, original + "# мимо хука\n")
        rc_ph, text_ph = sh(["bin/check-budget"], d, env=dict(os.environ))
        past_line = fz_budget_line(text_ph)
        spec_now = re.search(r"Read first:.*?(SPEC-[^\s,/]+)\.md", open(f"{d}/docs/PROMPT.txt", encoding="utf-8").read())
        shutil.rmtree(d, ignore_errors=True)
        d = fz_copy(clone)  # замка нет — апгрейд ставит пустой коммитом тимлида
        sh(["git", "rm", "-q", "frozen.json"], d)
        fz_past_hook(d, "проба: замка нет")
        rc_abs, text_abs = upgrade("--branch", "kit-v3.4", d)
        installed = os.path.isfile(f"{d}/frozen.json") and sh(["git", "ls-files", "frozen.json"], d)[1] == "frozen.json"
        subject = sh(["git", "log", "-1", "--format=%s", "--", "frozen.json"], d)[1]
        shutil.rmtree(d, ignore_errors=True)
        ok = (dash[0] == 2 and "--branch" in dash[1] and same_branch[0] == 1 and "--branch" in same_branch[1] and rc_up == 0 and c1[0] == 1 and src_file in c1[1] and c2[0] == 1 and c3[0] == 0 and c4[0] == 0 and c5[0] == 1 and "frozen.json" in c5[1] and c6[0] == 1 and "checks/planken.json" in c6[1]
              and rc_b == 0 and text_b.splitlines()[-1] == "BUDGET_OK" and frozen_line.startswith("OK") and "FROZEN_DIFF_OK" in frozen_line and list(lock_ok["module"]) == ["telefon", "backoffice", "command-center"]
              and rc_ph == 1 and past_line.startswith("FAIL") and "FROZEN_DIFF_FAIL" in past_line and src_file in past_line and rc_abs == 0 and installed and subject.startswith("Тимлид: frozen.json"))
        probe("F3.5", ok, f"telefon={'OK' if ok else 'нет'} · копия клона, {spec_now.group(1) if spec_now else '?'}; --branch -x — rc {dash[0]}; без --branch при разошедшейся kit-v3 — rc {same_branch[0]}; --branch kit-v3.4 — rc {rc_up} «{tail(text_up)[:90]}»; модули {', '.join(lock_ok['module'])} — замок проекта цел; "
              f"коммит в код модуля без offen — rc {c1[0]} «{c1[1][:110]}»; «Тимлид:» туда же — rc {c2[0]}; пункт фичи из offen — rc {c3[0]}; в docs/ — rc {c4[0]}; без «Тимлид:» в замок — rc {c5[0]}, в планки — rc {c6[0]}; bin/check-budget проекта — rc {rc_b} «{frozen_line[:100]}» {tail(text_b)}; коммит мимо хука: rc {rc_ph} «{past_line[:110]}»; "
              f"копия без frozen.json: апгрейд — rc {rc_abs}, замок {'поставлен' if installed else 'не поставлен'}, коммит «{subject[:70]}»")
    green = all(sec) and len(sec) == 5
    print(("--   frozen: F3.5 не гонялся, маркера FROZEN нет" if skipped else "FROZEN_OK") if green else "FROZEN_FAIL", flush=True)
    return green


LIVE_CFG = {"live": {"word_max_ms": 3500, "word_max_sicher_ms": 5000, "warten_ms": 1000, "channel": "linie", "felder_ganz": ["name"], "stoppwoerter": ["und", "ich"],
                     "felder": {"nummer": "rueckruf", "heiss|\\bname\\b": "name", "\\bort\\b": "ort", "worum geht": "anliegen"},
                     "fertige_saetze": ["Gerne."], "nummer_feld": "rueckruf", "nummer_frage": "nummer.*\\?"}}


def live_call(cid, turns, summary=None, caller="…98", channel="linie"):
    """Синтетический звонок (без людей и номеров): строки журнала и запись. Ход: said, bot, ms, fc, way, llm, hirn, flags (HIRN), chain (KETTE), no_hirn, abbruch, fl."""
    lines, tr = [f"12:00:00 | INFO | CALL_START call={cid} channel={channel} caller={caller}"], [{"role": "bot", "text": "Guten Tag."}]
    for n, x in enumerate(turns, 1):
        tr.append({"role": "caller", "text": x.get("said", "Ja.")})
        if x.get("fl"):
            lines += [f"12:00:0{n} | INFO | BACKCHANNEL fl:FL{i}" for i in range(x["fl"])]
        if not x.get("no_hirn"):
            lines.append(f"12:00:0{n} | INFO | HIRN call={cid} n={n} first_clause_ms={x.get('fc', 500)} anfragen=1 weg={x.get('way', 'strom')} ttft_ms=300{x.get('flags', '')}" + (" abbruch=1" if x.get("abbruch") else ""))
        if x.get("bot") is not None:
            ms = x.get("ms", 2000)
            tr.append({"role": "bot", "text": x["bot"], "latency_ms": ms})
            lines.append(f"12:00:0{n} | INFO | KETTE call={cid} hirn={x.get('hirn', 400)} stt=100 sum={ms} llm={x.get('llm', 300)} text=ok{x.get('chain', '')}")
    lines.append(f"12:00:59 | INFO | CALL_END call={cid}")
    return lines, {"call_id": cid, "transcript": tr, "summary": summary or {}}


def live_run(d, calls, args=("--n", "1"), cwd=None):
    """Звонки в live/ и прогон check-live из cwd (по умолчанию корень фикстуры): no_record — звонок без записи, --planken в args перекрывает планку фикстуры."""
    j, r = [], []
    for c in calls:
        lines, rec = live_call(**{k: v for k, v in c.items() if k != "no_record"})
        j += lines
        r += [] if c.get("no_record") else [json.dumps(rec, ensure_ascii=False)]
    put(d, "live/journal.txt", "\n".join(j) + "\n")
    put(d, "live/records.jsonl", "\n".join(r) + "\n")
    return sh([f"{d}/bin/check-live", f"{d}/live/journal.txt", f"{d}/live/records.jsonl", "--planken", f"{d}/live/planken.json", *args], cwd or d)


class FakeSmtp:
    """Локальный SMTP пробы: темы писем — в self.subjects."""
    def __init__(self):
        import socketserver, threading
        subjects = self.subjects = []

        class H(socketserver.StreamRequestHandler):
            def handle(self):
                self.wfile.write(b"220 fixture\r\n")
                data = False
                for raw in self.rfile:
                    line = raw.decode("utf-8", "replace").rstrip("\r\n")
                    if data:
                        if line == ".":
                            data = False
                            self.wfile.write(b"250 ok\r\n")
                        elif line.startswith("Subject: "):
                            subjects.append(line[9:])
                    elif line.upper().startswith("DATA"):
                        data = True
                        self.wfile.write(b"354 go\r\n")
                    elif line.upper().startswith("QUIT"):
                        self.wfile.write(b"221 bye\r\n")
                        return
                    else:
                        self.wfile.write(b"250 ok\r\n")
        self.srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), H)
        self.port = self.srv.server_address[1]
        threading.Thread(target=self.srv.serve_forever, daemon=True).start()

    def close(self):
        self.srv.shutdown()


def section_fenster():
    sec.clear()
    tools = ("check-frozen-diff", "check-passport", "check-fenster", "check-live")

    def fresh():  # свой проект на сценарий: своя история деплоев, своё окно
        p = project({"basis": None, "module": {}}, tools=tools, extra={"live/planken.json": json.dumps(LIVE_CFG)})
        shutil.copy2(f"{root}/scripts/rollback.template.sh", f"{p}/scripts/rollback.sh")
        return p

    def step(p):  # следующий коммит мимо хуков → его короткий sha
        sh(["git", "-c", "core.hooksPath=/dev/null", "commit", "--allow-empty", "-qm", "x"], p)
        return sh(["git", "rev-parse", "--short", "HEAD"], p)[1]

    def sides_line(item, sides):  # строка пробы: ключи SPEC (все стороны ключа прошли — OK), сырой вывод сторон; не сошлось — их имена
        words = " ".join(f"{k}={'OK' if all(s[2] for s in sides if s[0] == k) else 'нет'}" for k in dict.fromkeys(s[0] for s in sides))
        missed = [s[1] for s in sides if not s[2]]
        probe(item, not missed, f"{words} · " + "; ".join(f"{s[1]} — {s[3]}" for s in sides) + (f" · НЕ СОШЛОСЬ: {', '.join(missed)}" if missed else ""))
    raw = lambda r, n=1, width=100: f"rc {r[0]} «{tail(r[1], n, width)}»"
    window = lambda p, *a: sh(["bin/check-fenster", *a], p)
    undo = lambda p, sha, **kw: sh(["bash", "scripts/rollback.sh"], p, env=dict(GIT_ENV, SHA=sha, **kw))
    prints = lambda r: next((l[len("rollback: "):] for l in r[1].splitlines() if l.startswith("rollback: ")), "")  # команда из строки отката
    says = lambda r, sha: prints(r) == f"make rollback SHA={sha}"
    # F4.1 — строка отката; окно: DEPLOY_OK на линию без LIVE_OK/ROLLBACK_OK — красное
    d = fresh()
    fen = lambda: window(d)
    empty = fen()
    a1 = deploy(d, DEPLOY_LINIE=1)
    r1 = fen()
    green_call = [{"cid": "ok-1", "turns": [{"said": "Hallo.", "bot": "Worum geht es?", "ms": 1800}]}]
    live_ok = live_run(d, green_call)
    g1 = fen()
    commit(d, "F1.1: следующий коммит", "src/n.py", "n = 1\n")
    sha1 = re.search(r"sha=(\w+)", a1[1]).group(1)
    a2 = deploy(d, DEPLOY_LINIE=1)
    r2 = fen()
    bad = sh(["bash", "scripts/rollback.sh"], d, env=dict(GIT_ENV, SHA="zzz"))
    gone = sh(["bash", "scripts/rollback.sh"], d, env=dict(GIT_ENV, SHA="0000000"))
    back = sh(["bash", "scripts/rollback.sh"], d, env=dict(GIT_ENV, SHA=sha1, ROLLBACK_CMD="touch rolled-back"))
    g2 = fen()
    a0 = deploy(d, DEPLOY_LINIE=0)
    g3 = fen()
    deploy(d, DEPLOY_LINIE=1)
    deploy(d, DEPLOY_LINIE=1)
    live_run(d, green_call)
    twice = fen()
    fail_line = deploy(d, regress="exit 1")
    zeile = ("rollback: none" in a1[1] and f"rollback: make rollback SHA={sha1}" in a2[1] and "DEPLOY_OK" in a2[1] and "rollback: make rollback" in fail_line[1] and "DEPLOY_FAIL step=regress" in fail_line[1])
    rot = r1[0] == 1 and r1[1].startswith("FENSTER_ROT") and r2[0] == 1 and twice[0] == 1
    gruen = empty[0] == 0 and g1[0] == 0 and g2[0] == 0 and g3[0] == 0 and "linie=0" in a0[1] and live_ok[1].splitlines()[-1] == "LIVE_OK" and "ROLLBACK_OK" in back[1] and os.path.exists(f"{d}/rolled-back") and bad[0] == 1 and gone[0] == 1
    # история отката: повтор деплоя (E6), красный деплой (S8), откат (S9)
    h = fresh()
    s0 = step(h)
    deploy(h)
    h_only = deploy(h)
    s1 = step(h)
    h_next, h_same = deploy(h), deploy(h)
    step(h)
    h_red = deploy(h, regress="exit 1")
    step(h)
    h_after_red = deploy(h)
    undo(h, s1)
    s4 = step(h)
    h_after_undo = deploy(h)
    undo(h, s1)
    sh(["git", "checkout", "-q", s1], h)
    h_same_undone = deploy(h)
    undo(h, sh(["git", "rev-parse", s4], h)[1])  # полный SHA: в истории тот же короткий, что у деплоя
    sh(["git", "checkout", "-q", s4], h)
    h_full = deploy(h)
    # окно: без DEPLOY_LINIE (S10), значение не 0 и не 1 (E10), красная выкатка (S7), упавший откат (S0), короткий SHA (S12), строка дословно (E17, S11), каталог запуска и явный путь (E4), метки в строке (E16, S4)
    w = fresh()
    w0 = sh(["git", "rev-parse", "--short", "HEAD"], w)[1]
    plain = deploy(w)
    plain_win = window(w)
    os.remove(f"{w}/rolled-out")
    refused = [deploy(w, regress="touch arg-regress; echo REGRESS_OK", PASSPORT_CMD="touch arg-passport", DEPLOY_LINIE=v) for v in ("true", "01", " 1", "2")]
    no_step = not any(os.path.exists(f"{w}/{f}") for f in ("arg-passport", "rolled-out", "arg-regress"))
    refused_win = window(w)
    step(w)
    rollout = sh(["bash", "scripts/deploy.sh"], w, env=dict(GIT_ENV, REGRESS_CMD="echo REGRESS_OK", DEPLOY_CMD="false"))
    opened = deploy(w, DEPLOY_LINIE=1)
    open_root, open_sub = window(w), sh([f"{w}/bin/check-fenster"], f"{w}/src")
    no_file, is_dir = window(w, "нет.log"), window(w, "docs")
    with open(f"{w}/bytes.log", "wb") as f:
        f.write(b"\xff\xfe\n")
    junk = window(w, "bytes.log")
    outside = sh([f"{w}/bin/check-fenster"], tempfile.mkdtemp(prefix="check-kit-nogit-", dir=TMP))
    stand = read(f"{w}/.git/deploy-stand")
    failed = undo(w, w0, ROLLBACK_CMD="false")
    failed_win, stand_after = window(w), read(f"{w}/.git/deploy-stand")
    too_short = undo(w, w0[:4])
    rollback_text = read(f"{root}/scripts/rollback.template.sh")
    target = re.search(r"Цель Makefile проекта:\s*(rollback:.*)", rollback_text)
    put(w, "Makefile", (target[1] if target else "rollback: ; @false") + "\n")
    via_make = sh(["bash", "-c", prints(opened)], w, env=dict(GIT_ENV, ROLLBACK_CMD='echo "$ROLLBACK_SHA" > rolled-to'))
    rolled_to = read(f"{w}/rolled-to").strip() if os.path.exists(f"{w}/rolled-to") else ""
    closed = window(w)

    def by_log(text):
        put(w, "l.log", text)
        return window(w, "l.log")
    one = "DEPLOY_OK sha=abc1234 linie=1 rollback=none\n"
    logs = [("BOM", "\ufeff" + one, 1), ("префикс времени", "05:30:00 " + one, 1), ("префикс без пробела", "[05:30:00]" + one, 1), ("LIVE_OK с префиксом", "05:30:00 " + one + "05:40:00 LIVE_OK sha=abc1234\n", 0),
            ("ROLLBACK_OK с префиксом", one + "05:40:00 ROLLBACK_OK sha=abc1233\n", 0), ("S4 ROLLBACK_FAIL", one + "ROLLBACK_FAIL sha=abc1233 rc=1\n", 1), ("LIVE_FAIL", one + "LIVE_FAIL x\n", 1), ("linie=0 с префиксом", "05:30:00 DEPLOY_OK sha=abc1234 linie=0 rollback=none\n", 0)]
    red_regress = "DEPLOY_FAIL step=regress sha=abc1234 rc=1 linie=1\n"
    logs += [("красная регрессия на линии", red_regress, 1), ("её закрывает откат", red_regress + "ROLLBACK_OK sha=abc1233 sekunden=1\n", 0), ("красная выкатка на линии", "DEPLOY_FAIL step=rollout sha=abc1234 rc=1 linie=1\n", 1),
             ("красная выкатка не на линию", "DEPLOY_FAIL step=rollout sha=abc1234 rc=1 linie=0\n", 0), ("паспорт окна не открывает", "DEPLOY_FAIL step=passport sha=abc1234 модуль=x\n", 0),
             ("паспорт открытое окно не красит", one + "DEPLOY_FAIL step=passport sha=abc1234 модуль=x\nLIVE_OK sha=abc1234\n", 0), ("красный деплой поверх открытого окна", one + red_regress + "LIVE_OK sha=abc1234\n", 1)]
    log_runs = [(n, by_log(text), want) for n, text, want in logs]
    hx = fresh()
    hx0 = sh(["git", "rev-parse", "--short", "HEAD"], hx)[1]
    step(hx)
    undo(hx, hx0)
    step(hx)
    hx_after = deploy(hx)
    rr = fresh()
    rr_sha = sh(["git", "rev-parse", "--short", "HEAD"], rr)[1]
    rr_red = deploy(rr, regress="exit 1", DEPLOY_LINIE=1)
    rr_win = window(rr)
    rr_back = undo(rr, rr_sha)
    rr_closed = window(rr)
    ro = fresh()
    ro_red = sh(["bash", "scripts/deploy.sh"], ro, env=dict(GIT_ENV, REGRESS_CMD="echo REGRESS_OK", DEPLOY_CMD="false", DEPLOY_LINIE="1"))
    ro_win = window(ro)
    sides_line("F4.1", [("zeile", "строка отката", zeile, f"первый деплой «{tail(a1[1], 2)}», второй «{tail(a2[1], 2)}», красный исход тоже несёт её «{tail(fail_line[1], 2)}»"),
                        ("zeile", "S7 красная выкатка", rollout[0] == 1 and says(rollout, w0) and "DEPLOY_FAIL step=rollout" in rollout[1], raw(rollout, 2)),
                        ("zeile", "E6 единственный sha второй раз", prints(h_only) == "none" and "rollback=none" in h_only[1], raw(h_only, 2)),
                        ("zeile", "следующий деплой", says(h_next, s0) and f"rollback={s0}" in h_next[1], raw(h_next, 2)),
                        ("zeile", "E6 тот же sha второй раз", says(h_same, s0) and f"DEPLOY_OK sha={s1} linie=0 rollback={s0}" in h_same[1], raw(h_same, 2)),
                        ("zeile", "S8 красный деплой не цель отката", h_red[0] == 1 and says(h_red, s1) and says(h_after_red, s1), f"{raw(h_red, 2)} → {raw(h_after_red, 2)}"),
                        ("zeile", "S9 откат двигает историю", says(h_after_undo, s1), raw(h_after_undo, 2)),
                        ("zeile", "откат снимает отозванное: повтор того же sha в него не целит", says(h_same_undone, s0), raw(h_same_undone, 2)),
                        ("zeile", "откат на sha не из истории становится целью", says(hx_after, hx0), raw(hx_after, 2)),
                        ("zeile", "откат полным SHA, деплой того же коммита", says(h_full, s1), raw(h_full, 2)),
                        ("zeile", "E17 S11 строка дословно через Makefile шапки", via_make[0] == 0 and f"ROLLBACK_OK sha={w0}" in via_make[1] and rolled_to == w0 and closed[0] == 0, f"{raw(via_make)}, ROLLBACK_SHA совпал — {rolled_to == w0}, окно — {raw(closed)}"),
