        put(cn, name, json.dumps({"canary": {"p95_gelb_ms": 3200, "word_max_rot_ms": 6000, "timeout_s": 2, **over}}))
        return name

    def canary(cmd, planken="planken.json", port=None):
        before = len(smtp.subjects)
        t0 = time.monotonic()
        env = dict(GIT_ENV, CANARY_CMD=cmd, CANARY_PLANKEN=planken, CANARY_SMTP=f"127.0.0.1:{port or smtp.port}", CANARY_PROJEKT="Fixtur")
        rc, text = sh(["python3", "canary.py"], cn, env=env)
        return rc, text, smtp.subjects[before:], time.monotonic() - t0
    ml = lambda p95=2000, wm=3000, rot=0: f"CANARY_MESS p95={p95} word_max={wm} rot={rot}"
    mess = lambda **k: f"bash -c 'echo {ml(**k)}'"
    two = lambda a, b: f"bash -c 'echo {a}; echo {b}'"
    put(cn, "empty.json", open(f"{root}/checks/planken.json", encoding="utf-8").read())
    red_cases = [("rot>0", mess(rot=2), "rot", None), ("S1 rot=1", mess(rot=1), "rot", None), ("word_max выше", mess(wm=7000), "word_max", None), ("word_max на мс выше", mess(wm=6001), "word_max", None),
