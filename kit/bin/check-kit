    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]}, pfade=["src/demo/", "docs/DEMO.md"], diff_cap=1)}})
    tl += [fz_rc(0, "«Тимлид:» в docs/ модуля сверх предела", commit(d, "Тимлид: паспорт", "docs/DEMO.md", "p\n" * 10)),
