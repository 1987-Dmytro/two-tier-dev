#!/usr/bin/env python3
"""check-kit [<корень>] [frozen|fenster] — скиллы и воркфлоу кита (SPEC-v3 F6, SPEC-v3.1 F5): набор, frontmatter, контракт accept
(вердикт — /verify-phase из свежего клона, лимит 30 мин) и plan-phase, evaluator без правок, воркфлоу verify-phase и его лаунчер.

Корень: аргумент, иначе kit/ репо кита, иначе корень проекта. В репо кита ещё: скиллы v2 в архиве,
копии workflow CI и verify-phase совпадают, defaults бюджета в kit/budgets.json и budgets.json совпадают. KIT_OK или exit 1.
Мод handoff (SPEC-v3.2 F6, только репо кита): строка шаблона Environment (70 %, /clear), включение и режим в launch settings кита
(pluginConfigs, иначе userConfig мода по умолчанию), handoffs/ в .gitignore, команда установки в выводе bin/two-tier-init,
`claude plugin validate` и `claude plugin test` мода — HANDOFF_OK; без claude в PATH (CI) validate и test не гоняются, маркера нет.
Окна (SPEC-v3.3 F5, кит и проект): bin/check-window на подставленных событиях и строка запуска шаблона с заглушкой claude —
строки v3.3-F5.1…F5.4 и WINDOW_OK; при claude в PATH ещё живой ход справкой.
Разделы v3.4: frozen (F3: замок, паспорт, регрессия в деплое, апгрейд клона telefon — FROZEN_OK), fenster (F4: окно деплоя, живой канал, канарейка,
шаблоны — FENSTER_OK); с именем раздела идёт только он, без имени — всё.
Нет клона telefon (CI на GitHub: клона там нет) или не репо кита — F3.5 не гонялся: строка `F3.5 telefon=offen`, маркера FROZEN_OK нет, код 0, как у HANDOFF без claude.
"""
import json, os, re, shutil, subprocess, sys, tempfile, time

out = []
TMP = "/tmp/two-tier-v3"
SECTIONS = ("frozen", "fenster")
GIT_ENV = dict(os.environ, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@example.invalid",
               GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@example.invalid")
for k in ("TYPESAFE_API_KEY", "TYPESAFE_AI_API_KEY"):  # суд abide фикстурам не нужен: без ключа он — пропуск
    GIT_ENV.pop(k, None)
V32_KEYS, V32_OWNER = {"prompt_chars", "abide_rules"}, {"docs/PROMPT.txt", ".abide/rubric.json", ".claude/spec-gate.json"}
V32_RETIRED = {"goal_chars", "docs/GOAL.txt"}
# v3.3: новые ключи кита (блок фичи F1.3, пороги окна F5.4) и планка рубрики 8 (D7, F2.5) — тимлид вносит в budgets.json на приёмке
V33_KEYS, V33_CHANGED = {"spec_block_chars", "window_seven_day_pct"}, {"abide_rules"}
V34_RETIRED = {"window_five_hour_pct", "window_repair_pct"}  # окно 5 ч снято словом оператора 06.11: в корневом budgets.json ключи снимает тимлид, чек их терпит
V34_OWNER = {"checks/planken.json", "frozen.json"}  # v3.4: файлы тимлида новых механизмов (F2.3, F3.1) — тимлид вносит в budgets.json на приёмке


def say(ok, item, msg):
    out.append(bool(ok))
    print(f"{'OK  ' if ok else 'FAIL'} {item}: {msg}")


def read(p):
    with open(p, encoding="utf-8") as f:
        return f.read()


args = sys.argv[1:]
want = [a for a in args if a in SECTIONS]
rest = [a for a in args if a not in SECTIONS]
root = rest[0] if rest else ("kit" if os.path.isdir("kit/.claude") else ".")


# ---------- разделы v3.4: фикстуры — свои каталоги во /tmp/two-tier-v3 из файлов кита ----------
def sh(cmd, cwd, env=None, timeout=300, stdin=None):
    r = subprocess.run(cmd, cwd=cwd, env=env or GIT_ENV, capture_output=True, text=True, errors="replace", timeout=timeout, input=stdin, stdin=None if stdin is not None else subprocess.DEVNULL)
    return r.returncode, (r.stdout + r.stderr).strip()


def tail(text, n=1, width=150):
    return " | ".join(text.splitlines()[-n:])[:width]


def put(d, rel, text):
    os.makedirs(os.path.dirname(f"{d}/{rel}") or d, exist_ok=True)
    with open(f"{d}/{rel}", "w", encoding="utf-8") as f:
        f.write(text)


def project(fr, spec="SPEC-2", tools=("check-frozen-diff", "check-passport"), extra=None):
    """Проект-фикстура из файлов кита: хуки git, чеки, budgets.json, frozen.json, текущая SPEC; базовый коммит мимо хуков."""
    os.makedirs(TMP, exist_ok=True)
    d = tempfile.mkdtemp(prefix="check-kit-lock-", dir=TMP)
    shutil.copytree(f"{root}/.githooks", f"{d}/.githooks", ignore=shutil.ignore_patterns("__pycache__"))
    for t_ in tools:
        os.makedirs(f"{d}/bin", exist_ok=True)
        shutil.copy2(f"{root}/bin/{t_}", f"{d}/bin/{t_}")
    os.makedirs(f"{d}/scripts", exist_ok=True)
    shutil.copy2(f"{root}/scripts/deploy.template.sh", f"{d}/scripts/deploy.sh")
    shutil.copy2(f"{root}/budgets.json", f"{d}/budgets.json")
    files = {"docs/PROMPT.txt": f"Read first: docs/{spec}.md\n", f"docs/{spec}.md": "# SPEC\n", "docs/STATUS.md": "s\n", "src/demo/a.py": "a = 1\n", "src/other.py": "b = 1\n",
             "frozen.json": json.dumps(fr, ensure_ascii=False), **(extra or {})}
    for rel, text in files.items():
        put(d, rel, text)
    sh(["git", "init", "-q", "-b", "main"], d)
    sh(["git", "config", "core.hooksPath", ".githooks"], d)
    sh(["git", "add", "-A"], d)
    sh(["git", "-c", "core.hooksPath=/dev/null", "commit", "-qm", "fixture"], d)
    return d


def commit(d, msg, rel, text, keep_on_refusal=False):
    """Коммит одного файла хуками кита: (rc, строка хука); отказан — файл снят, дерево как до него."""
    existed = os.path.isfile(f"{d}/{rel}")
    before = open(f"{d}/{rel}", encoding="utf-8").read() if existed else None
    put(d, rel, text)
    sh(["git", "add", "--", rel], d)
    rc, text_out = sh(["git", "commit", "-qm", msg], d)
    line = next((l for l in text_out.splitlines() if l.startswith("commit refused")), "")
    if rc and not keep_on_refusal:
        sh(["git", "reset", "-q", "--", rel], d)
        if existed:
            put(d, rel, before)
        else:
            os.remove(f"{d}/{rel}")
    return rc, line


def set_lock(d, fr):  # замок — файл тимлида: коммит «Тимлид:»
    return commit(d, "Тимлид: замок фикстуры", "frozen.json", json.dumps(fr, ensure_ascii=False))


sec = []


def probe(item, ok, text):  # строка пробы: id и сырой вывод обеих сторон; провал — FAIL сразу за id
    sec.append(bool(ok))
    print(f"{item} {'' if ok else 'FAIL: '}{' '.join(str(text).split())}", flush=True)


def deploy(d, regress="echo REGRESS_OK", env=None, **kw):
    e = dict(GIT_ENV, REGRESS_CMD=regress, DEPLOY_CMD="touch rolled-out", **{k: str(v) for k, v in kw.items()}, **(env or {}))
    return sh(["bash", "scripts/deploy.sh"], d, env=e)


def fz_rc(want, label, got, needle=""):  # сторона пробы: (код want и needle в выводе, «подпись — rc N «строка вывода»»)
    line = next((l for l in got[1].splitlines() if needle and needle in l), tail(got[1]))
    return got[0] == want and needle in got[1], f"{label} — rc {got[0]}" + (f" «{line[:130]}»" if line else "")


def fz_join(rows):  # стороны пункта: (все зелёные, сырой вывод); красная сторона помечена FAIL
    return all(r[0] for r in rows), "; ".join(("" if r[0] else "FAIL ") + r[1] for r in rows)


def fz_past_hook(d, msg, rel=None, text=None):  # коммит мимо хука (индекс как есть или ещё файл): так CI видит то, чего хук не видел
    if rel:
        put(d, rel, text)
        sh(["git", "add", "--", rel], d)
    return sh(["git", "-c", "core.hooksPath=/dev/null", "commit", "-qm", msg], d)


def fz_staged(d, msg):  # коммит готового индекса хуками кита: (rc, строка отказа или вывод хука)
    rc, text = sh(["git", "commit", "-qm", msg], d)
    return rc, next((l for l in text.splitlines() if l.startswith("commit refused")), text)


def fz_side(d, branch, msg, rel):  # ветка с одним коммитом хуками кита; назад на main
    sh(["git", "switch", "-qc", branch], d)
    commit(d, msg, rel, "x\n")
    sh(["git", "switch", "-q", "main"], d)


def fz_merge_own(d, branch, rel):  # слияние без коммита и своя правка в индексе
    sh(["git", "merge", "-q", "--no-ff", "--no-commit", branch], d)
    put(d, rel, "own\n")
    sh(["git", "add", "--", rel], d)


def fz_budget_line(text):  # строка правила frozen-paths в выводе bin/check-budget; нет правила — пусто
    return next((l for l in text.splitlines() if re.match(r"(OK|FAIL) +frozen-paths:", l)), "")


def fz_budget(label, d, needle):  # сторона: строка правила в выводе bin/check-budget; needle пуст — строки быть не должно
    line = fz_budget_line(sh(["bin/check-budget"], d)[1])
    return (needle in line if needle else not line), f"check-budget, {label} — «{line[:120] or 'строки frozen-paths нет'}»"


def fz_copy(clone):  # копия клона telefon: сам клон только читается
    d = tempfile.mkdtemp(prefix="telefon-up-", dir=TMP)
    shutil.rmtree(d)
    shutil.copytree(clone, d, symlinks=True)
    return d


def section_frozen():
    sec.clear()
    demo = lambda offen=None, **kw: {"phase": "SPEC-1", "pfade": ["src/demo/"], "offen": offen or {}, **kw}
    head = lambda d: sh(["git", "rev-parse", "HEAD"], d)[1]
    judge = lambda d: sh(["bin/check-frozen-diff"], d)
    body = "".join(f"{i}\n" for i in range(50))
    # F3.1 — запрет с файлом, offen, предел диффа; судья CI и правило frozen-paths bin/check-budget
    vb, of, cp, ci = [], [], [], []
    lock = {"basis": None, "module": {"demo": demo()}}
    d = project(lock)
    vb += [fz_rc(1, "без SPEC", commit(d, "F1.1: правка закрытого модуля", "src/demo/x.py", "x = 1\n"), "frozen-paths: src/demo/x.py"),
           fz_rc(0, "вне модулей", commit(d, "F1.1: файл вне модулей", "src/free.py", "x = 1\n"))]
    lock["module"]["demo"]["offen"] = {"SPEC-9": ["*"]}
    set_lock(d, lock)
    vb.append(fz_rc(1, "чужая SPEC", commit(d, "F1.1: чужая SPEC открыла", "src/demo/x2.py", "x = 1\n")))
    put(d, "docs/PROMPT.txt", "Read first: docs/SPEC-9.md\n")  # запрос правлен только на диске: судья читает его из HEAD
    vb.append(fz_rc(1, "запрос правлен на диске", commit(d, "F1.1: запрос на диске", "src/demo/x2.py", "x = 1\n")))
    put(d, "docs/PROMPT.txt", "Read first: docs/SPEC-2.md\n")
    lock["module"]["demo"]["offen"] = {"SPEC-2": ["F1"]}
    set_lock(d, lock)
    of += [fz_rc(0, "фича из offen", commit(d, "F1.1: фича из offen", "src/demo/x3.py", "x = 1\n")),
           fz_rc(0, "id через «;» и пробел", commit(d, "F1; F1.2 F1.3: все из offen", "src/demo/x3b.py", "x = 1\n"))]
    vb += [fz_rc(1, f"«{m}»", commit(d, m, "src/demo/x4.py", "x = 1\n"), "frozen-paths: src/demo/x4.py")
           for m in ("F2.1: фича не из offen", "правка без id пункта", "F1.1, F2.1: один id не из offen", "F10.1: F10 — не F1", "XF1.1: приклеено", "F1.1.2: три уровня",
                     'Revert "F1.1: x"', "F1.1 fix: of F2.9", "F1.1 без двоеточия", "F1.1\nF1.2: двоеточие на второй строке")]
    lock["module"]["demo"].update(diff_cap=3, base=head(d))
    set_lock(d, lock)
    cp += [fz_rc(0, "три строки — в пределе", commit(d, "F1.2: три строки — в пределе", "src/demo/y.py", "1\n2\n3\n")),
           fz_rc(1, "четвёртая сверх", commit(d, "F1.2: четвёртая строка — сверх", "src/demo/y2.py", "4\n"), "дифф 4 строк > diff_cap 3")]
    lock["module"]["inner"] = {"phase": "SPEC-1", "pfade": ["src/demo/inner/"], "offen": {"SPEC-2": ["*"]}}
    set_lock(d, lock)
    of.append(fz_rc(0, "длинный префикс", commit(d, "F7.1: длинный префикс — свой модуль открыт", "src/demo/inner/z.py", "z = 1\n")))
    ci.append(fz_rc(0, "зелёный", judge(d), "FROZEN_DIFF_OK"))
    d = project({"basis": None, "module": {"demo": demo()}})
    closed_lock = {"basis": head(d), "module": {"demo": demo()}}
    set_lock(d, closed_lock)
    put(d, "frozen.json", json.dumps({**closed_lock, "module": {"demo": demo({"SPEC-2": ["*"]})}}))  # замок открыт только на диске
    vb.append(fz_rc(1, "замок открыт только на диске", commit(d, "F1.1: замок открыт на диске", "src/demo/disk.py", "x = 1\n")))
    put(d, "frozen.json", json.dumps(closed_lock))
    sh(["git", "mv", "src/demo/a.py", "src/moved.py"], d)
    vb.append(fz_rc(1, "git mv из модуля", fz_staged(d, "F9.9: вынос из модуля"), "frozen-paths: src/demo/a.py"))
    sh(["git", "mv", "src/moved.py", "src/demo/a.py"], d)
    fz_past_hook(d, "F1.1: мимо хука", "src/demo/bypass.py", "x = 1\n")
    ci.append(fz_rc(1, "коммит мимо хука", judge(d), "src/demo/bypass.py"))
    # замка или судьи нет — правила нет; basis null — CI судит от коммита замка, check-budget несёт его итог
    d = project({"basis": None, "module": {"demo": demo()}}, tools=("check-frozen-diff", "check-budget"))
    ci.append(fz_budget("замок цел", d, "OK   frozen-paths: FROZEN_DIFF_OK commits=0"))
    fz_past_hook(d, "F9.9: мимо хука, basis null", "src/demo/x.py", "x\n")
    ci += [fz_rc(1, "мимо хука, basis null", judge(d), "src/demo/x.py"), fz_budget("коммит мимо хука", d, "FAIL frozen-paths: FROZEN_DIFF_FAIL")]
    sh(["git", "rm", "-q", "frozen.json"], d)
    fz_past_hook(d, "Тимлид: замка нет")
    ci += [fz_budget("без замка", d, ""), fz_rc(0, "без замка", judge(d), "FROZEN_DIFF_OK замка нет")]
    vb.append(fz_rc(0, "нет замка — правила нет", commit(d, "F9.9: x", "src/demo/y.py", "y\n")))
    d = project({"basis": None, "module": {"demo": demo()}}, tools=("check-budget",))
    ci.append(fz_budget("без судьи", d, ""))
    vb.append(fz_rc(0, "нет файла судьи — правила нет", commit(d, "F9.9: x", "src/demo/y.py", "y\n")))
    # замок не той формы: CI — красный с причиной, хук — заметка и пропуск
    d = project({"basis": None, "module": {}})
    fz_past_hook(d, "битый замок", "frozen.json", "{")
    put(d, "src/demo/b.py", "x = 1\n")
    sh(["git", "add", "--", "src/demo/b.py"], d)
    ci += [fz_rc(0, "битый frozen.json: хук", fz_staged(d, "F1.1: битый замок"), "judge error"), fz_rc(1, "битый frozen.json", judge(d), "FROZEN_DIFF_FAIL frozen.json не JSON")]
    caps = [json.dumps({"module": {"demo": {"pfade": ["src/demo/"], "diff_cap": c}}}) for c in (-1, "3", True, 1.5, None)]
    for shape in ("[]", '{"module": []}', '{"module": {"demo": []}}', '{"module": {"demo": {"offen": {}}}}', '{"module": {"demo": {"pfade": "src/demo/"}}}', '{"module": {"demo": {"pfade": [1]}}}', '{"module": {"demo": {"pfade": ["src/demo/"], "offen": "x"}}}',
                  '{"module": {"demo": {"pfade": ["src/demo/"], "offen": {"SPEC-2": "*"}}}}', '{"module": {"demo": {"pfade": ["src/demo/"], "offen": {"SPEC-2": [1]}}}}', *caps):
        fz_past_hook(d, "замок не той формы", "frozen.json", shape)
        ci.append(fz_rc(1, f"замок {shape}", judge(d), "FROZEN_DIFF_FAIL frozen.json"))
    put(d, "src/demo/c.py", "x = 1\n")
    sh(["git", "add", "--", "src/demo/c.py"], d)
    ci.append(fz_rc(0, "замок не той формы: хук", fz_staged(d, "F1.1: замок не той формы"), "judge error"))
    # CI судит коммиты своей фазы: смена запроса не красит прошлые, новая фаза судится
    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]})}})
    ci.append(fz_rc(0, "работа фазы SPEC-2", commit(d, "F1.1: работа фазы", "src/demo/p.py", "1\n")))
    ci.append(fz_rc(0, "смена фазы коммитом запроса", commit(d, "Тимлид: новая фаза", "docs/PROMPT.txt", "Read first: docs/SPEC-3.md\n")))
    ci.append(fz_rc(0, "прошлая фаза не судится", judge(d), "FROZEN_DIFF_OK"))
    fz_past_hook(d, "F2.1: код мимо хука в новой фазе", "src/demo/q.py", "2\n")
    ci.append(fz_rc(1, "новая фаза мимо хука", judge(d), "SPEC-3 его не открывает"))
    d = project({"basis": None, "module": {"demo": demo({"SPEC-20": ["*"]})}}, spec="SPEC-20")  # начало фазы SPEC-2 — не коммит запроса с SPEC-20
    ci.append(fz_rc(0, "работа фазы SPEC-20", commit(d, "F1.1: работа фазы", "src/demo/p.py", "1\n")))
    ci.append(fz_rc(0, "смена на SPEC-2", commit(d, "Тимлид: новая фаза", "docs/PROMPT.txt", "Read first: docs/SPEC-2.md\n")))
    ci.append(fz_rc(0, "SPEC-20 — прошлая фаза для SPEC-2", judge(d), "FROZEN_DIFF_OK"))
    # pfade: префикс без «/» — тоже каталог, файл — точно; равные длины без «/» — первый модуль
    d = project({"basis": None, "module": {"demo": demo(pfade=["src/demo", "src/other.py"]), "tie-open": demo({"SPEC-2": ["*"]}, pfade=["src/tie"]), "tie-closed": demo(pfade=["src/tie/"])}})
    vb += [fz_rc(1, "pfade без «/»: каталог", commit(d, "F9.9: x", "src/demo/x.py", "x\n"), "frozen-paths: src/demo/x.py"),
           fz_rc(1, "pfade: файл", commit(d, "F9.9: x", "src/other.py", "b = 2\n"), "frozen-paths: src/other.py"),
           fz_rc(0, "соседний каталог src/demox/", commit(d, "F9.9: x", "src/demox/y.py", "x\n")),
           fz_rc(0, "соседний файл src/other.py.bak", commit(d, "F9.9: x", "src/other.py.bak", "x\n"))]
    of.append(fz_rc(0, "равные длины без «/» — первый модуль", commit(d, "F9.9: x", "src/tie/z.py", "x\n")))
    # текущая SPEC — первая запись с именем SPEC-*.md
    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["*"]})}}, extra={"docs/PROMPT.txt": "Read first: docs/PROCESS-SPEC-1.md, docs/SPEC-1/notes.md, docs/SPEC-2.md, docs/SPEC-3.md\n"})
    of.append(fz_rc(0, "SPEC — первая запись SPEC-*.md", commit(d, "F9.9: x", "src/demo/x.py", "x\n")))
    # слияния: путь со второй стороны не судится, своя правка судится; CI — своими путями слияния
    d = project({"basis": None, "module": {"demo": demo({"SPEC-2": ["F1"]})}})
    fz_side(d, "s1", "F1.1: на стороне", "src/demo/side.py")
    of.append(fz_rc(0, "слияние со второй стороны, сообщение без id", sh(["git", "merge", "-q", "--no-ff", "-m", "слияние стороны", "s1"], d)))
    ci.append(fz_rc(0, "слияние со второй стороны", judge(d), "commits=2"))
    fz_side(d, "s2", "F1.1: вторая сторона", "src/free2.py")
    fz_merge_own(d, "s2", "src/demo/mine.py")
    of.append(fz_rc(0, "своя правка в слиянии с id из offen", fz_staged(d, "F1.2: слияние со своей правкой")))
    fz_side(d, "s3", "F1.1: третья сторона", "src/free3.py")
