    d = project({"basis": None, "module": {"demo": demo(passport=passport)}}, extra={"docs/PROMPT.txt": "Read first: docs/PROCESS-SPEC-1.md, docs/SPEC-1/notes.md, docs/SPEC-2.md, docs/SPEC-3.md\n"})
