#!/usr/bin/env python3
"""gate-test <команда теста…> — тест в гейте фазы (SPEC-v3.4 F2.4). Зелёный — `TEST_OK <команда>`, rc 0. Красный без метки — хвост вывода и
`TEST_FAIL <команда> rc=<k>`, rc 1: блок. Красный с меткой `flaky` — `FLAKY <команда> rc=<k> · <решение>`, rc 0: гейт зелёный, строка видна.
Метка — ключ `flaky` в checks/planken.json (файл тимлида): подстрока команды → решение, почему тест не судья (настенное время, sleep);
исполнитель её не ставит. Нет файла, не JSON — меток нет.
"""
import json, os, subprocess, sys


def labels():
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or "."
    try:
        with open(os.path.join(top, "checks/planken.json"), encoding="utf-8") as f:
            flaky = json.load(f).get("flaky")
    except (OSError, ValueError, AttributeError):
        return {}
    return flaky if isinstance(flaky, dict) else {}


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd = " ".join(argv)
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        rc, text = r.returncode, r.stdout + r.stderr
    except OSError as e:
        rc, text = 127, e.__class__.__name__
    if rc == 0:
        print(f"TEST_OK {cmd}")
        return 0
    why = next((v for k, v in labels().items() if k and k in cmd), None)
    if why is not None:
        print(f"FLAKY {cmd} rc={rc} · {why}")
        return 0
    print("\n".join(text.splitlines()[-5:]))
    print(f"TEST_FAIL {cmd} rc={rc}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
