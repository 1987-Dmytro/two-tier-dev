#!/usr/bin/env python3
"""verify-phase [--limit SEC] [--override-window] [F<n> …] — вердикт фазы сохранённым воркфлоу /verify-phase из свежего клона
(SPEC-v3.1 F4, F5; SPEC-v3.3 F4.1, F5.2).

0. Фичи (F4.1): id — строки `- **F<n>` SPEC (первый файл `Read first:` docs/PROMPT.txt, нет его — docs/GOAL.txt) в HEAD; неизвестный —
   exit 2. Без списка — все фичи. Окно подписки (F5.2): рядом есть check-window — до клона `check-window` (с
   --override-window — и --override); отказ — exit 1, клона нет. Нет check-window — строка, прогон идёт.
1. HEAD запушен: есть origin — origin/<ветка> = HEAD и клон с origin; нет origin — клон этого репо (фикстуры).
2. Свежий клон — свой каталог во /tmp/two-tier-v3. Гейт фазы — первая `bin/gate…` стартового запроса docs/PROMPT.txt (нет его —
   прежнего docs/GOAL.txt) — идёт
   в клоне, его лог агенты читают по $VERIFY_GATE_LOG: долгие чеки они не перезапускают. Сменил файлы под docs/evidence клона — сразу за строкой гейта `evidence geändert <файл>` на каждый (F7.4, K80).
3. `claude -p` в клоне: только подписка (env -u ANTHROPIC_API_KEY; apiKeySource не none — стоп), SPEC_GATE=off, --permission-mode auto,
   allow Workflow(verify-phase) и чеки кита (в -p правила allow из .claude/settings.json не действуют), --setting-sources
   project,local (настройки и хуки пользователя приёмку не трогают), --settings
   .claude/launch.settings.json клона (worktree.baseRef: head — агенты в worktree видят HEAD, а не ветку по умолчанию).
   Список фич и прошлые вердикты этих фич (SPEC-v3.4 F7.2) уходят воркфлоу в args JSON-объектом {features, prior}; нечего передать — без args.
4. Итог воркфлоу — из task_notification.output_file → docs/evidence/verify-<sha>.txt этого репо, точечный — verify-<sha>-F2-F4.txt;
   первая строка — VERDICT: PASS или VERDICT: NEEDS_WORK, вторая — классы дефектов и счёт, строка FEATURES: — фичи вердикта: не те, что просили, — вердикта нет,
   exit 1. Лимит на всё, клон и гейт включительно, — 1800 с: истёк — VERIFY_TIMEOUT,
   вердикта нет, exit 3. В вывод — счётчики, модели, коды выхода и пути от /tmp/two-tier-v3.
5. Замер (K78, SPEC-v3.4 F5.3): прогон, дошедший до гейта или воркфлоу, и прогон, упёршийся в лимит, — строка `verify-phase: K78 …` и строка JSON в docs/evidence/verify-runs.jsonl: версия CLI (system/init
   claude_code_version), фичи, лимит этого прогона, секунды лаунчера и воркфлоу (task_notification usage.duration_ms), шелл-команды и команды в фоне (task_started: task_type local_bash, is_backgrounded; task_updated:
   patch.is_backgrounded — agent-sdk/typescript), итог. Только счётчики; читает `bin/check-kit paar`.
"""
import json, os, re, signal, subprocess, sys, tempfile, time

TMP = "/tmp/two-tier-v3"
JOURNAL = "docs/evidence/verify-runs.jsonl"
ALLOW = ["Workflow(verify-phase)", "Bash(bin/check-*)", "Bash(bin/gate-*)", "Bash(make ci)"]
PROMPT = ("Launch the saved workflow verify-phase with the Workflow tool, {args}. When it completes, reply with "
          "the single word done and use no tools.")
T0 = time.monotonic()


def git(*a, cwd="."):
    return subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True)


def spec_feats():
    """(путь SPEC, [F<n>…]) из HEAD: первый файл `Read first:` стартового запроса, строки `- **F<n>`; нет — (None, [])."""
    start = next((r.stdout for p in ("docs/PROMPT.txt", "docs/GOAL.txt") if (r := git("show", f"HEAD:{p}")).returncode == 0), "")
    m = re.search(r"Read first:\s*`?([^\s,`]+)", start)
    s = git("show", f"HEAD:{m.group(1)}") if m else None
    return (m.group(1), re.findall(r"^- \*\*(F\d+)\b", s.stdout, re.M)) if s and s.returncode == 0 else (None, [])


def prior(spec, feats):
    """Прошлый вердикт фич из HEAD (F7.2): {F<n>: {file, verdict, blocking[, more]}} — новейший круг по истории docs/evidence/verify-*.txt этой SPEC, что называет F<n>;
    файлы одного sha — один круг, внутри коммита их порядок — порядок имён: file — первый из них, строки вместе и без повторов, NEEDS_WORK — если так сказал хоть один файл.
    blocking — строки этой фичи под `## Блокирующие`, не больше 5 по 160 знаков: args идут текстом в запросе claude -p; more — остальные, по 100 знаков: только ключи пометки «повтор», проверяющему не идут."""
    out, found = {}, {}
    sha = lambda name: re.split(r"[-.]", os.path.basename(name))[1]
    names = git("log", "--format=", "--name-only", "--diff-filter=AM", "HEAD", "--", "docs/evidence/verify-*.txt").stdout.split()
    for name in dict.fromkeys(names):
        text = git("show", f"HEAD:{name}").stdout  # файла уже нет в HEAD — пусто
        verdict = text.split("\n", 1)[0]
        of = re.search(r"^/verify-phase · (\S+) · ", text, re.M)
        if verdict not in ("VERDICT: PASS", "VERDICT: NEEDS_WORK") or not of or os.path.basename(of.group(1)) != os.path.basename(spec or ""):
            continue
        named = re.findall(r"F\d+", (re.search(r"^FEATURES:[ \t]*(.*)$", text, re.M) or [None, ""])[1])
        sec = re.search(r"^## Блокирующие[^\n]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
        for f in [f for f in feats if f in named and (f not in out or sha(out[f]["file"]) == sha(name))]:
            lines = [l for l in (sec.group(1).splitlines() if sec else []) if re.match(rf"- \*\*{f}\b", l)]
            found[f] = list(dict.fromkeys(found.get(f, []) + lines))
            was = out.get(f, {"file": os.path.basename(name), "verdict": "PASS"})
            out[f] = {**was, "verdict": "NEEDS_WORK" if verdict.endswith("NEEDS_WORK") else was["verdict"]}
    for f, p in out.items():
        p["blocking"] = [l[:160] for l in found[f][:5]]
        if found[f][5:]:
            p["more"] = [l[:100] for l in found[f][5:]]
    return out


def run(cmd, cwd, env, limit, log, init_check=False):
    """Процесс в своей группе; лимит истёк — группа убита, None. init_check: apiKeySource не none — стоп (C3)."""
    with open(log, "w") as out:
        p = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        while p.poll() is None:
            if time.monotonic() - T0 > limit:
                os.killpg(p.pid, signal.SIGTERM)
                time.sleep(5)
                os.killpg(p.pid, signal.SIGKILL) if p.poll() is None else None
                return None
            init = init_check and next((json.loads(l) for l in open(log) if '"subtype":"init"' in l.replace(" ", "")), None)
            if init:
                init_check = False
                if init.get("apiKeySource") != "none":
                    os.killpg(p.pid, signal.SIGKILL)
                    sys.exit(f"verify-phase: apiKeySource {init.get('apiKeySource')} — не подписка, прогон остановлен")
            time.sleep(1)
        return p.returncode


def stream(log):
    """События stream-json; строка, обрезанная убитым процессом, — пропуск."""
    out = []
    with open(log, encoding="utf-8", errors="replace") as f:
        for l in f:
            try:
                out.append(json.loads(l)) if l.startswith("{") else None
            except ValueError:
                pass
    return out


def journal(features, limit, ev=(), note=None):
    """K78: строка прогона в журнал и в вывод, с лимитом этого прогона (--limit). note None — лимит истёк (итог timeout), иначе итог — status уведомления воркфлоу, его нет — none."""
    cli = next((e.get("claude_code_version") for e in ev if e.get("subtype") == "init"), None)
    bash = {e.get("task_id"): bool(e.get("is_backgrounded")) for e in ev if e.get("subtype") == "task_started" and e.get("task_type") == "local_bash"}
    moved = {e.get("task_id") for e in ev if e.get("subtype") == "task_updated" and (e.get("patch") or {}).get("is_backgrounded") is True and bash.get(e.get("task_id")) is False}
    ms = ((note or {}).get("usage") or {}).get("duration_ms")
    rec = {"cli": cli, "features": features, "limit": limit, "sec": round(time.monotonic() - T0), "wf_sec": round(ms / 1000) if isinstance(ms, (int, float)) else None,
           "bash": len(bash), "fon": sum(bash.values()) + len(moved), "moved": len(moved), "status": "timeout" if note is None else note.get("status") or "none"}
    os.makedirs(os.path.dirname(JOURNAL), exist_ok=True)
    with open(JOURNAL, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print("verify-phase: K78 " + " ".join(f"{k}={rec[k]}" for k in ("cli", "sec", "wf_sec", "bash", "fon", "moved", "status")))


def timeout(stage):
    print(f"verify-phase: лимит истёк на шаге «{stage}» через {time.monotonic() - T0:.0f} с")
    print("VERIFY_TIMEOUT")
    sys.exit(3)


def main(argv):
    limit = 1800
    override, ids, it = False, [], iter(argv)
    for a in it:
        if a == "--limit" and (v := next(it, "")).isdigit():
            limit = int(v)
        elif a == "--override-window":
            override = True
        elif re.fullmatch(r"F\d+", a):
            ids.append(a)
        else:
            print(__doc__)
            print(f"verify-phase: аргумент «{a}» — не --limit SEC, не --override-window и не id фичи F<n>")
            return 2
    ids = sorted(set(ids), key=lambda x: int(x[1:]))
    spec, known = spec_feats()
    if [i for i in ids if i not in known]:
        print(f"verify-phase: нет фич {', '.join(i for i in ids if i not in known)} в {spec or 'SPEC (нет Read first: в docs/PROMPT.txt)'}"
              f" — в нём: {', '.join(known) or 'нет'}")
        return 2
    sha = git("rev-parse", "HEAD").stdout.strip()
    branch = git("branch", "--show-current").stdout.strip()
    url = git("remote", "get-url", "origin").stdout.strip()
    if url:
        remote = git("ls-remote", "origin", f"refs/heads/{branch}").stdout.split("\t")[0]
        if remote != sha:
            print(f"verify-phase: origin/{branch} = {remote[:7] or 'нет'} ≠ HEAD {sha[:7]} — сначала push")
            return 1
    env = {k: v for k, v in os.environ.items() if k != "ANTHROPIC_API_KEY"}
    env.update(ENABLE_CLAUDEAI_MCP_SERVERS="false", CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS="0", CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS="16",
               SPEC_GATE="off")  # v3.2: приёмочная сессия не держится spec-gate (SPEC-v3.2 §1)
    cw = os.path.join(os.path.dirname(os.path.realpath(__file__)), "check-window")
    if os.path.isfile(cw):  # v3.3 F5.2: окно подписки — до клона
        try:
            w = subprocess.run([cw, *(["--override"] if override else [])], env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=180)
            text, wrc = (w.stdout + w.stderr).strip(), w.returncode
        except subprocess.TimeoutExpired:
            text, wrc = "check-window: нет ответа за 180 с", 1
        print(text)
        if wrc:
            print("verify-phase: окно подписки — отказ до клона")
            return 1
    else:
        print("verify-phase: check-window рядом нет — окно подписки не проверено")
        cv = os.path.join(os.path.dirname(cw), "check-versions")  # F6.1: версии печатает check-window, без него — лаунчер
        if os.path.isfile(cv):
            try:
                print(subprocess.run([sys.executable, cv, "--offline"], capture_output=True, text=True, timeout=30).stdout.strip())
            except (OSError, subprocess.SubprocessError):
                pass
    path = f"docs/evidence/verify-{sha[:7]}{''.join('-' + i for i in ids)}.txt"
    if os.path.exists(path):  # вердикт прошлого прогона того же HEAD и того же списка не остаётся рядом с VERIFY_TIMEOUT
        os.remove(path)
    os.makedirs(TMP, exist_ok=True)
    d = tempfile.mkdtemp(prefix=f"verify-{sha[:7]}-", dir=TMP)
    clone = f"{d}/repo"
    r = git("clone", "-q", "--branch", branch, url or os.getcwd(), clone, cwd=d)
    if r.returncode or git("rev-parse", "HEAD", cwd=clone).stdout.strip() != sha:
        print(f"verify-phase: клон не на HEAD {sha[:7]}: {r.stderr.strip()[:200]}")
        return 1
    print(f"verify-phase: HEAD {sha[:7]} ветки {branch}; свежий клон {'origin' if url else 'локального репо'} → {clone}; лимит {limit} с; "
          f"фичи {', '.join(ids) if ids else 'все'}")
    start = next((p for p in ("docs/PROMPT.txt", "docs/GOAL.txt") if os.path.isfile(f"{clone}/{p}")), None)  # v3.2: стартовый запрос
    text = open(f"{clone}/{start}", encoding="utf-8").read() if start else ""
    done = re.split(r"END STATE|Done means", text, maxsplit=1)  # гейт — из «сделано» запроса (у прежнего GOAL — из END STATE)
    gate = (re.findall(r"(?<![\w/])(bin/gate[\w.-]*)", done[-1]) or [None])[0]
    if gate and not os.path.isfile(f"{clone}/{gate}"):
        print(f"verify-phase: гейт {gate} из стартового запроса не найден в клоне — чеки гоняют проверяющие")
        gate = None
    if gate:
        rc = run([gate], clone, env, limit, f"{d}/gate.log")
        if rc is None:
            journal(ids or known, limit)
            timeout(f"гейт {gate}")
        markers = [l for l in open(f"{d}/gate.log", encoding="utf-8", errors="replace").read().splitlines() if re.fullmatch(r"(F\d+ )?[A-Z0-9_]+_OK", l)]
        print(f"verify-phase: гейт {gate} — rc {rc}, маркеров {len(markers)}: {' · '.join(markers) or 'нет'} ({time.monotonic() - T0:.0f} с)")
        for changed in git("status", "--porcelain", "--untracked-files=all", "--", "docs/evidence", cwd=clone).stdout.splitlines():  # K80: чек, сменивший evidence, виден и без bin/evidence
            print(f"evidence geändert {changed[3:]}")
        env["VERIFY_GATE_LOG"] = f"{d}/gate.log"
    else:
        print(f"verify-phase: в стартовом запросе {start or 'docs/PROMPT.txt'} нет bin/gate… — чеки гоняют проверяющие")
    settings = ["--settings", ".claude/launch.settings.json"] if os.path.isfile(f"{clone}/.claude/launch.settings.json") else []
    last = prior(spec, ids or known)
    wf_args = {**({"features": ids} if ids else {}), **({"prior": last} if last else {})}
    prompt = PROMPT.format(args=f"with args set to the JSON object {json.dumps(wf_args, ensure_ascii=False, separators=(',', ':'))} (an object value, not a string)"
                           if wf_args else "without args")
    # v3.2: --setting-sources project,local — хуки и плагины пользователя (его Toolgate спрашивает, а в -p вопрос — отказ) приёмку не трогают
    cmd = ["claude", "-p", prompt, "--permission-mode", "auto", "--model", "claude-opus-5-5", "--setting-sources", "project,local", *settings,
           "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}', "--add-dir", d, "--allowedTools", *ALLOW,
           "--max-turns", "3", "--output-format", "stream-json", "--verbose"]
    rc = run(cmd, clone, env, limit, f"{d}/run.jsonl", init_check=True)
    ev = stream(f"{d}/run.jsonl")
    if rc is None:
        journal(ids or known, limit, ev)
        timeout("воркфлоу /verify-phase")
    wid = next((e.get("task_id") for e in ev if e.get("subtype") == "task_started" and e.get("workflow_name") == "verify-phase"), None)
    note = next((e for e in ev if e.get("subtype") == "task_notification" and e.get("task_id") == wid), {})  # у агентов свои фоновые задачи
    f = note.get("output_file", "")
    try:
        out = json.load(open(f, encoding="utf-8")) if f and os.path.isfile(f) else {}
    except ValueError:  # файл итога обрезан: строка журнала важнее, вердикта нет
        out = {}
    res = out.get("result") if isinstance(out.get("result"), dict) else {}
    agents = [a for a in out.get("workflowProgress", []) if a.get("type") == "workflow_agent"]
    models = {}
    for a in agents:
        models[a.get("model")] = models.get(a.get("model"), 0) + 1
    checkers = [str(a.get("label")) for a in agents if str(a.get("label")).startswith("verify:")]
    print(f"verify-phase: claude -p rc {rc}; воркфлоу {note.get('status') or 'не запущен'}; агентов {len(agents)}: "
          f"{', '.join(f'{m} ×{n}' for m, n in models.items()) or 'нет'}; проверяющие {', '.join(checkers) or 'нет'}; "
          f"токенов {out.get('totalTokens')}; {time.monotonic() - T0:.0f} с")
    journal(ids or known, limit, ev, note)
    report = res.get("report", "")
    if report.split("\n", 1)[0] not in ("VERDICT: PASS", "VERDICT: NEEDS_WORK"):
        print("verify-phase: воркфлоу не вернул отчёт — вердикта нет")
        return 1
    m = re.search(r"^FEATURES:[ \t]*(.*)$", report, re.M)
    got, want = re.findall(r"F\d+", m.group(1) if m else ""), ids or known
    if want and set(got) != set(want):  # F4.1: вердикт называет ровно те фичи, что просили (без списка — все)
        print(f"verify-phase: вердикт по фичам {', '.join(got) or 'нет'} ≠ {', '.join(want)} — вердикта нет")
        return 1
    os.makedirs("docs/evidence", exist_ok=True)
    open(path, "w", encoding="utf-8").write(report)
    print(f"verify-phase: {path}")
    print(report.splitlines()[0])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
