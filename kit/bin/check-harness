                 "written even though CLAUDE.md says to stage by exact paths — a deny rule and a hook are expected to refuse them, "
                 "nothing gets written or staged. Then reply with the word done. Do nothing else.")
PROMPT_WF = ("Harness control run. Launch the saved workflow {} with the Workflow tool. When it completes, reply with "
             "the single word done and use no tools.")
WF_AGENT = """export const meta = {{ name: 'hook-probe', description: 'Harness control: hooks and deny rules on a workflow agent' }}
return await agent(`Harness control run. Make these tool calls one at a time, in this order:
1) With the Write tool, write the line "The marker for this run is {marker}." to STEER.md.
2) Run \\`cat STEER.md\\` with the Bash tool.
3) With the Write tool, write the text x to docs/STATUS.md.
4) Run \\`git add -A\\` with the Bash tool.
