        put(a, "bin/d.py", "def sub(a, b):\n    return a - b\n"); gc(a, "add", "--", "bin/d.py")
        slow = gc(a, "commit", "-qm", "F2.4: таймаут", env={"PATH": f"{stub}:{os.environ['PATH']}", "ABIDE_CHECK_TIMEOUT_S": "1"})
        note = notes[-1]
        edge = {}
        for p in ("0.80", "0.79", "0.50", "0.49"):
            sd = tempfile.mkdtemp(prefix="abide-edge-", dir=TMP)
            open(f"{sd}/abide", "w").write("#!/bin/sh\necho '{\"sections\":[{\"verdicts\":[{\"ruleId\":\"no-print-credential\",\"probability\":%s,\"file\":\"bin/e.py\"}]}]}'\n" % p)
            os.chmod(f"{sd}/abide", 0o755)
            put(a, f"bin/e{p}.py", f"x = {p}\n"); gc(a, "add", "--", f"bin/e{p}.py")
            edge[p] = gc(a, "commit", "-qm", f"F2.4: граница {p}", env={"PATH": f"{sd}:{os.environ['PATH']}"})
            if edge[p][0]:
                gc(a, "reset", "-q", "--", f"bin/e{p}.py")
        def judge_wrong(first, again, err, slow, edge):
            """Неверные ответы судьи — FAIL (решение 397): механизм держат отказ на печати ключа, повтор, пропуск ошибки и таймаута, границы заглушки."""
            if "abide check — skip" in first[1]:  # судья не ответил (таймаут, ошибка) — пропуск сработал, ответа нет: калибровка и транспорт, не механизм
                why = []
            else:
                why = [] if first[0] == 1 and "no-print-credential" in first[1] and "bin/p.py" in first[1] else ["нет отказа ≥ 0,8 на печати ключа"]
                why += [] if again[0] == 0 and ("rejected" in again[1] or "abide check — skip" in again[1]) else ["повтор диффа не прошёл"]  # пропуск на повторе — тоже не ответ судьи
            why += [] if err[0] == 0 and "skip" in err[1] else ["ошибка адреса — не пропуск"]
            why += [] if slow[0] == 0 and "over 1 s" in slow[1] else ["таймаут — не пропуск"]
            why += [] if edge["0.80"][0] == 1 and "refused once" in edge["0.80"][1] else ["граница 0.80 — не отказ"]
            why += [f"граница {k} — не заметка" for k in ("0.79", "0.50") if not (edge[k][0] == 0 and "note" in edge[k][1])]
            why += [] if edge["0.49"][0] == 0 and "note" not in edge["0.49"][1] else ["граница 0.49 — не проход"]
            return why
        note_count = lambda ns: sum(1 for n in ns if n[0] == 0 and "note" in n[1])
        wrong = judge_wrong(first, again, err, slow, edge)
        k = note_count(notes)
        if "abide check — skip" in first[1]:
            warns.append(f"печать ключа без ответа ({first[1].split('error ')[-1][:30] if 'error ' in first[1] else first[1][-30:]})")
        if "abide check — skip" in again[1]:
            warns.append(f"повтор диффа без ответа ({again[1].split('error ')[-1][:30] if 'error ' in again[1] else again[1][-30:]})")
        if not k:  # живая модель на пограничных образцах — калибровка, не механизм: WARN с числами
            warns.append(f"заметка {k}/{len(notes)}")
        # оба состояния на входах заглушки: судья пропустил печать ключа (как граница 0.49) — FAIL; ни одной заметки из 4 — WARN
        fake_wrong = judge_wrong(edge["0.49"], again, err, slow, edge)
        fake_k = note_count([edge["0.49"]] * 4)
        mute_first = judge_wrong(err, again, err, slow, edge)  # судья не ответил на печать ключа (ошибка адреса) — не FAIL
        mute_again = judge_wrong(edge["0.80"], err, err, slow, edge)  # судья не ответил на повтор (ошибка адреса) — не FAIL
        red_again = judge_wrong(edge["0.80"], edge["0.80"], err, slow, edge)  # повтор снова отказан — FAIL
        states_ok = "нет отказа ≥ 0,8 на печати ключа" in fake_wrong and fake_k == 0 and not mute_first and "skip" in err[1] and "повтор диффа не прошёл" not in mute_again and "повтор диффа не прошёл" in red_again
        item(S, "v3.3-F2.4", not wrong and states_ok, f"печать ключа — rc {first[0]} «{first[1][:110]}»; тот же дифф ещё раз — rc {again[0]} «{again[1][:80]}»; "
             f"заметка (живая модель, {len(notes)} проб.) — {'есть' if k else 'нет → COMMIT_WARN'}, rc {note[0]} «{note[1][:80]}»; ошибка адреса — rc {err[0]} «{err[1][:60]}»; таймаут 1 с — rc {slow[0]} «{slow[1][:60]}»; "
             f"границы заглушкой: " + ", ".join(f"{k_} — rc {v[0]}{' отказ' if 'refused' in v[1] else ' заметка' if 'note' in v[1] else ' проход'}" for k_, v in edge.items())
             + f"; неверных ответов судьи — {'; '.join(wrong) or 'нет'} · состояния: судья пропустил печать ключа (заглушка 0.49) — {'FAIL: ' + fake_wrong[0] if fake_wrong else 'нет FAIL'}; "
             f"ни одной заметки из 4 — {'WARN заметка 0/4' if fake_k == 0 else 'нет WARN'}; судья не ответил на печать ключа (ошибка адреса) — {'WARN, не FAIL' if not mute_first else 'FAIL'}; на повтор — {'WARN, не FAIL' if 'повтор диффа не прошёл' not in mute_again else 'FAIL'}; повтор снова отказан — {'FAIL' if 'повтор диффа не прошёл' in red_again else 'нет FAIL'}")
    # F2.5 — рубрика: правил не больше abide_rules (8) и красный образец каждого ≥ 0,8; фикстуры обеих сторон
    try:
        bj = json.load(open("budgets.json", encoding="utf-8"))
        limit = min(int((bj.get("project") or {}).get("abide_rules", bj["defaults"].get("abide_rules", 8))), 8)
    except (OSError, ValueError, KeyError):
        limit = 8
    if not os.environ.get("TYPESAFE_API_KEY") or not shutil.which("abide"):
        item(S, "v3.3-F2.5", False, "нет ключа или abide — красные образцы не прогнаны")
    else:
        own = (".abide/rubric.json", *rubric_check(".abide/rubric.json", limit)) if os.path.isfile(".abide/rubric.json") else None
        warns += [f"без оценки {r}" for r in (own[3] if own else [])]
        fx = tempfile.mkdtemp(prefix="rubric-", dir=TMP)
        os.makedirs(f"{fx}/nine/.abide"); os.makedirs(f"{fx}/weak/.abide"); os.makedirs(f"{fx}/good/.abide")
        nine = [dict(RUBRIC_FIXTURE[0], id=f"r{i}") for i in range(1, 10)]
        weak = [{"id": "no-zebra-word", "text": "Never write the word ZEBRA-42 into a file.", "scope": ["**/*"], "when": "edit", "status": "active",
                 "source": {"path": "CLAUDE.md", "line": 1}, "check": {"type": "model", "question": {"type": "boolean",
                 "instructions": "Does this change add a line that contains the exact string ZEBRA-42?", "criteria": {"true": "def add(a, b): return a + b", "false": "x = 1"}}}}]
        for name, rules in (("nine", nine), ("weak", weak), ("good", RUBRIC_FIXTURE[:1])):
            json.dump(rubric_doc(rules), open(f"{fx}/{name}/.abide/rubric.json", "w"))
        res = {n: rubric_check(f"{fx}/{n}/.abide/rubric.json", limit) for n in ("good", "nine", "weak")}
        warns += [f"без оценки {r} (фикстура)" for n in ("good", "weak") for r in res[n][2]]
        weak_red = (not res["weak"][0] and "no-zebra-word" in res["weak"][1]) or "no-zebra-word" in res["weak"][2]  # слабый образец без оценки — WARN, не зелёный
        # оба состояния: abide без ответа (заглушка не JSON) — правило без оценки, WARN; слабый образец с оценкой — FAIL (выше)
        stub = tempfile.mkdtemp(prefix="abide-mute-", dir=TMP)
        open(f"{stub}/abide", "w").write("#!/bin/sh\necho 'not json'\n"); os.chmod(f"{stub}/abide", 0o755)
        low = tempfile.mkdtemp(prefix="abide-low-", dir=TMP)  # судья ответил 0.02 на красный образец — правило слабое, FAIL
        open(f"{low}/abide", "w").write("#!/bin/sh\necho '{\"sections\":[{\"verdicts\":[{\"ruleId\":\"%s\",\"probability\":0.02}]}]}'\n" % RUBRIC_FIXTURE[0]["id"])
        os.chmod(f"{low}/abide", 0o755)
        path0 = os.environ["PATH"]
        try:
            os.environ["PATH"] = f"{stub}:{path0}"
            mute = rubric_check(f"{fx}/good/.abide/rubric.json", limit)
            os.environ["PATH"] = f"{low}:{path0}"
            weak_stub = rubric_check(f"{fx}/good/.abide/rubric.json", limit)
        finally:
            os.environ["PATH"] = path0
        mute_ok = mute[0] and mute[2] == [RUBRIC_FIXTURE[0]["id"]] and not weak_stub[0] and "ниже 0,8" in weak_stub[1] and not weak_stub[2]
        ok = res["good"][0] and not res["nine"][0] and "r9" in res["nine"][1] and weak_red and (own is None or own[1]) and mute_ok
        item(S, "v3.3-F2.5", ok, (f"рубрика проекта {own[0]} — {'OK' if own[1] else 'FAIL'}: {own[2]}; " if own else "рубрики проекта нет; ")
             + f"фикстура из одного правила — {res['good'][1]}; из 9 правил — «{res['nine'][1]}»; слабый образец — «{res['weak'][1]}»"
             + f" · состояния: abide без ответа — {'WARN без оценки ' + ', '.join(mute[2]) if mute[2] else 'нет WARN'}; судья ответил 0.02 — {'FAIL: ' + weak_stub[1] if not weak_stub[0] else 'нет FAIL'}")
    if warns:
        print(f"COMMIT_WARN abide: {', '.join(warns)}", flush=True)
    # F2.6 — коммит из подпроцесса ловят правила кода; счёт судей — в отчёте фазы
    s = cfix(src)
    put(s, "bin/s.py", f"KEY = '{secret}'\n"); gc(s, "add", "--", "bin/s.py")
    sub = subprocess.run(["python3", "-c", "import subprocess,sys; sys.exit(subprocess.run(['git','commit','-qm','F2.6: из подпроцесса']).returncode)"],
                         cwd=s, env=GIT_ENV, capture_output=True, text=True, timeout=60)
    gc(s, "reset", "-q", "--", "bin/s.py"); os.remove(f"{s}/bin/s.py")
    put(s, "docs/STATUS.md", "z\n"); gc(s, "add", "--", "docs/STATUS.md")
    sub2 = subprocess.run(["bash", "-c", "git commit -qm 'F2.6: статус из bash'"], cwd=s, env=GIT_ENV, capture_output=True, text=True, timeout=60)
    gc(s, "reset", "-q", "--", "docs/STATUS.md"); gc(s, "checkout", "-q", "--", "docs/STATUS.md")
    put(s, "b.txt", "b\n"); gc(s, "add", "--", "b.txt"); gc(s, "commit", "-qm", "F2.6: обычный")
    with open(f"{s}/docs/evidence/commit-judge.jsonl", "a", encoding="utf-8") as f:  # у каждого вида — свой ненулевой счёт: перестановка счётчиков видна
        for d, j, rule, k in (("note", "abide", "no-secret-values", 3), ("rejected", "abide", "no-print-credential", 4), ("refuse", "abide", "no-print-credential", 5),
                              ("refuse", "code", "no-force-push", 6), ("skip", "abide", None, 2)):
            for _ in range(k):
                f.write(json.dumps({"ts": "", "decision": d, "judge": j, "rule": rule, "files": ["x"]}) + "\n")
    log = [json.loads(l) for l in open(f"{s}/docs/evidence/commit-judge.jsonl", encoding="utf-8")]
    rc, _, rep = report_of(s, src)
    counts = next((l for l in rep.splitlines() if l.startswith("Коммитов фазы")), "")
    n = lambda d: sum(l["decision"] == d for l in log)
    code = sum(l["decision"] == "refuse" and l.get("judge") == "code" and l.get("rule") != "no-force-push" for l in log)
    want = [f"Суждений в журнале: {len(log)}", f"прошло {n('pass')}", f"отказов {n('refuse')}", f"отклонённых {n('rejected')}", f"заметок {n('note')}", f"пропусков {n('skip')}",
            f"(код {code}, push {sum(l.get('rule') == 'no-force-push' for l in log)}, abide {sum(l['decision'] == 'refuse' and l.get('judge') == 'abide' for l in log)})"]
    ok = (sub.returncode == 1 and "no-secret-values" in sub.stderr and sub2.returncode == 1 and "team-lead-files" in sub2.stderr
          and rc == 0 and all(w in counts for w in want) and n("skip") > 0)
    item(S, "v3.3-F2.6", ok, f"секрет коммитом из подпроцесса Python — rc {sub.returncode} «{' '.join(sub.stderr.split())[:70]}»; файл тимлида из bash -c — rc {sub2.returncode}; "
         f"отчёт фазы: «{counts[:200]}»")


RETIRED = {"hooks": ("abide.mjs", "toolgate-deny.mjs"), "plugins": ("jev-steer-or-queue@jev-steer-or-queue", "compact-adviser@compact-adviser"),
           "rows": ("Toolgate", "Compact Adviser", "Steer-or-Queue"), "files": (".claude/hooks/abide.mjs", ".claude/hooks/toolgate-deny.mjs", ".claude/toolgate.yaml")}
ACTION = ("PreToolUse", "PostToolUse", "PostToolUseFailure", "UserPromptSubmit", "PermissionDenied")
NET = re.compile(r"\bfetch\(|\bhttps?\.(?:request|get)\(|http\.client|urllib|\brequests\.\w+\(|\bhttpx\b|\baiohttp\b|\baxios\b|\bundici\b|XMLHttpRequest|\bWebSocket\b"
                 r"|\bcurl\b|\bwget\b|\bnc\b|\bncat\b|\btelnet\b|socket\.(?:connect|create_connection)|net\.connect\(|@anthropic-ai/|\b(?:import|from) anthropic\b|\bopenai\b"
                 r"|bin/jev\b|\btoolgate\b|\babide\b|api\.typesafe\.ai|api\.anthropic\.com|['\"]claude['\"](?:\s*,\s*['\"][^'\"]*['\"])*\s*,\s*['\"]-(?:p|-print)['\"]"
                 r"|\bclaude\b[^\n;|&]*\s(?:-p|--print)\b")


def retired_in(settings, launch, process):
    """F3.1: имена ушедших инструментов, что ещё стоят: хуки в settings, плагины «true» и pluginConfigs, строки таблицы «да»."""
    names = [n for ev in settings.get("hooks", {}).values() for g in ev for h in g.get("hooks", []) for n in RETIRED["hooks"] if n in json.dumps(h)]
    names += [p for p in RETIRED["plugins"] if launch.get("enabledPlugins", {}).get(p) is True or p in launch.get("pluginConfigs", {})]
    names += [f"строка «{t}» — да" for t, _, _, on, _ in table(process) if on and t in RETIRED["rows"]]
    return names


CLAUDE_CALL = (re.compile(r"(?:^|[\s'\"(\[`])claude(?=[\s'\",)\]`]|$)", re.M), re.compile(r"(?:^|[\s'\"\[,`])(?:-p|--print)(?=[\s'\",\]`]|$)", re.M))


def action_hooks(sources):
    """F3.2: [(событие, имя, почему)] для хуков на действие, что ходят в сеть или зовут модель. sources — [(settings, корень, плагин)]."""
    bad, seen = [], 0
    for cfg, root, plug in sources:
        for ev in ACTION:
            for g in cfg.get("hooks", {}).get(ev, []):
                for h in g.get("hooks", []):
                    seen += 1
                    name = f"{plug + ':' if plug else ''}{os.path.basename(next((a for a in h.get('args', []) if '/' in a), h.get('command', h.get('type', '?'))))}"
                    if h.get("type") in ("prompt", "agent", "http"):
                        bad.append((ev, name, f"type {h['type']}"))
                        continue
                    cmd = h.get("command", "")
                    try:  # команда одной строкой («node ${CLAUDE_PROJECT_DIR}/x.mjs») — читаем и её скрипты
                        toks = shlex.split(cmd)
                    except ValueError:
                        toks = cmd.split()
                    for a in [cmd, *toks, *h.get("args", [])]:
                        path = a.replace("${CLAUDE_PROJECT_DIR}", root).replace("${CLAUDE_PLUGIN_ROOT}", root).replace("$CLAUDE_PROJECT_DIR", root)
                        text = open(path, encoding="utf-8", errors="replace").read() if os.path.isfile(path) else a
                        m = NET.search(text)
                        if not m and all(r.search(text) for r in CLAUDE_CALL):  # claude и -p порознь: spawnSync('claude', ['-p', …]) и т. п.
                            m = CLAUDE_CALL[0].search(text)
                        if m:
                            bad.append((ev, name, f"«{m.group(0).strip()}»"))
                            break
    return bad, seen


def plugin_hooks(path):
    """Хуки плагина: hooks/hooks.json по умолчанию и поле `hooks` в .claude-plugin/plugin.json — путь, список путей или объект."""
    load = lambda f: json.load(open(f, encoding="utf-8")) if os.path.isfile(f) else {}
    decl = load(f"{path}/.claude-plugin/plugin.json").get("hooks")
    refs = ["./hooks/hooks.json"] + ([decl] if isinstance(decl, (str, dict)) else list(decl or []))
    cfgs = [r if isinstance(r, dict) else load(os.path.join(path, r)) for r in dict.fromkeys(json.dumps(x) for x in refs) for r in [json.loads(r)]]
    return [c if "hooks" in c else {"hooks": c} for c in cfgs if c]


def env_probes(src, proc, launch, init, args):
    S = "ENV"
    st = json.load(open(f"{src}/.claude/settings.json", encoding="utf-8"))
    kl = json.load(open(f"{src}/.claude/launch.settings.json", encoding="utf-8"))
    tpl = open(f"{src}/docs/PROCESS.template.md", encoding="utf-8").read() if os.path.isfile(f"{src}/docs/PROCESS.template.md") else ""
    kit = retired_in(st, kl, tpl) if tpl else ["нет шаблона PROCESS"]
    belay = ((kl.get("pluginConfigs", {}).get("jev-belay@jev-belay") or {}).get("options") or {}).get("shadow") is True
    arch = [f for f in RETIRED["files"] if os.path.isdir("docs/archive") and not os.path.isfile(f"docs/archive/kit-v3.2/{f.replace('.claude/', 'claude-config/', 1)}")]
    in_kit = [f for f in RETIRED["files"] if os.path.exists(f"{src}/{f}")]
    red_st = json.loads(json.dumps(st))
    red_st["hooks"].setdefault("PostToolUse", []).append({"matcher": "Edit", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/abide.mjs", "post-tool-use"]}]})
    red_kl = json.loads(json.dumps(kl)) | {"enabledPlugins": dict(kl.get("enabledPlugins", {}), **{"compact-adviser@compact-adviser": True})}
    red = retired_in(red_st, red_kl, tpl.replace("| Toolgate | CLI | `toolgate` | нет |", "| Toolgate | CLI | `toolgate` | да |"))
    ok = not kit and belay and not arch and not in_kit and {"abide.mjs", "compact-adviser@compact-adviser"} <= set(red)
    item(S, "v3.3-F3.1", ok, f"кит: ушедших в настройках и шаблоне — {', '.join(kit) or 'нет'}, файлов в {src}/ — {', '.join(in_kit) or 'нет'}, "
         f"в архиве docs/archive/kit-v3.2/ — {'нет: ' + ', '.join(arch) if arch else ('все 3' if os.path.isdir('docs/archive') else 'не про проект')}; Belay — тень {belay}; "
         f"красная фикстура (хук abide.mjs, compact-adviser true, Toolgate «да») — {', '.join(red)}")
    plugins = [(cfg, p["path"], p.get("source", "?")) for p in (init or {}).get("plugins", []) if p.get("path") for cfg in plugin_hooks(p["path"])]
    ls = json.load(open(launch, encoding="utf-8"))
    bad, seen = action_hooks([(st, os.path.abspath(src), None), (ls, os.path.abspath("."), None), *plugins])
    fx = tempfile.mkdtemp(prefix="action-hooks-", dir=TMP)
    open(f"{fx}/net.mjs", "w").write("await fetch('https://api.typesafe.ai/v1/systemone', { method: 'POST' })\n")
    open(f"{fx}/local.sh", "w").write("#!/bin/sh\nexit 0\n")
    open(f"{fx}/get.mjs", "w").write("import https from 'node:https'\nhttps.get('https://example.invalid/x')\n")
    open(f"{fx}/ask.sh", "w").write("#!/bin/sh\nclaude --print 'judge this edit'\n")
    open(f"{fx}/pinned.sh", "w").write("#!/bin/sh\nclaude --model claude-opus-5-5 -p 'judge this edit'\n")
    open(f"{fx}/listed.py", "w").write("import subprocess\nsubprocess.run(['claude', '--model', 'claude-haiku-5-5', '-p', 'judge'])\n")
    open(f"{fx}/spawn.mjs", "w").write("import { spawnSync } from 'node:child_process'\nspawnSync('claude', ['--model', 'claude-haiku-5-5', '-p', 'judge this edit'])\n")
    fixture = {"hooks": {"PreToolUse": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/net.mjs"]},
                                                    {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/local.sh"}]}],
                         "PostToolUse": [{"hooks": [{"type": "prompt", "prompt": "Judge this edit."}]}],
                         "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/get.mjs"},
                                                         {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/ask.sh"},
                                                         {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/pinned.sh"},
                                                         {"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/listed.py"]},
                                                         {"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/spawn.mjs"]}]}],
                         "Stop": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/net.mjs"]}]}]}}
    rbad, rseen = action_hooks([(fixture, fx, None)])
    ok = not bad and [n for _, n, _ in rbad] == ["net.mjs", "prompt", "get.mjs", "ask.sh", "pinned.sh", "listed.py", "spawn.mjs"]
    item(S, "v3.3-F3.2", ok, f"хуков на действие кита, строки запуска и плагинов в живом init — {seen}, в сеть или к модели — {len(bad)}"
         + (f" ({'; '.join(f'{e} {n}: {w}' for e, n, w in bad)})" if bad else "") + f"; фикстура (PreToolUse fetch, PreToolUse локальный, PostToolUse prompt, UserPromptSubmit https.get одной строкой, claude --print, claude --model … -p, список subprocess и spawnSync('claude', ['-p', …]), Stop fetch) — "
         + "; ".join(f"{e} {n}: {w}" for e, n, w in rbad))
    rows = table(open(proc, encoding="utf-8").read())
    live = [compare(rows, init, " ".join(args))[0]] if init else [["нет system/init"]]
    fxr = table(FIXTURE)
    g = {"plugins": [{"source": "ponytail@ponytail"}], "mcp_servers": [{"name": "context7", "status": "connected"}], "skills": ["graphify"]}
    red1 = compare(fxr, g | {"plugins": g["plugins"] + [{"source": "commit-commands@claude-plugins-official"}]}, "--effort ultracode", lambda c: True)[0]
    red2 = compare(fxr, g | {"mcp_servers": []}, "--effort ultracode", lambda c: True)[0]
    ok = not live[0] and red1 and red2
    item(S, "v3.3-F3.3", ok, f"живой system/init ({proc}) = таблица: {'да' if not live[0] else 'нет — ' + '; '.join(live[0])}"
         f" ({compare(rows, init, ' '.join(args))[1] if init else '—'}); фикстура — лишний плагин: «{'; '.join(red1)}»; нет MCP: «{'; '.join(red2)}»")
    if os.path.isfile("kit/bin/two-tier-upgrade") and src == "kit":  # апгрейд проверяется в репо кита: нужны его ревизии d2ca390 и b5b81cd
        r = subprocess.run(["bin/two-tier-upgrade", "--self-test"], capture_output=True, text=True, timeout=900)
        line = next((l for l in r.stdout.splitlines() if l.startswith("v3.3-F3.4 ")), "")
        okk = r.returncode == 0 and "UPGRADE_OK" in r.stdout.splitlines() and line and "FAIL" not in line.split()[1:2]
        item(S, "v3.3-F3.4", okk, f"`bin/two-tier-upgrade --self-test` rc {r.returncode}, {'UPGRADE_OK' if 'UPGRADE_OK' in r.stdout.splitlines() else 'нет UPGRADE_OK'}: {line[len('v3.3-F3.4 '):] or 'нет строки v3.3-F3.4'}")



def word_marker(prefix):
    # ponytail: маркер — слово и число, не hex: hex-строку в записи Toolgate судит как утечку секрета (замер 09.10: 0,87 — deny)
    return f"{prefix}-{secrets.choice(('amber', 'birch', 'cedar', 'delta', 'ember', 'fjord', 'grove', 'harbor', 'island', 'juniper'))}-{100 + secrets.randbelow(900)}"


def say(sec, status, item, msg):
    out.setdefault(sec, []).append(status)
    seen[(sec, item)] = status
    print(f"{status:4} {item}: {msg}", flush=True)


def paths():
    src = SRC_ARG or ("." if os.path.isfile(".claude/settings.json") else "kit")
    proc = "docs/PROCESS.md" if os.path.isfile("docs/PROCESS.md") else f"{src}/docs/PROCESS.template.md"
    launch = ".claude/launch.settings.json" if os.path.isfile(".claude/launch.settings.json") else f"{src}/.claude/launch.settings.json"
    return src, proc, launch


PROMPT_FILE = None  # v3.2, F7: строка кончается стартовым запросом "$(cat docs/PROMPT.txt)" — пары стартуют запросом из этого файла
PROMPT_SEP = False  # `--` перед запросом: --add-dir и --mcp-config берут по нескольку значений и без `--` забирают запрос себе


def launch_line(proc):
    """(env, args после `claude`) — первая строка с `claude` в блоках ```sh PROCESS; последний аргумент "$(cat <файл>)" — в PROMPT_FILE,
    `--` перед ним — в PROMPT_SEP."""
    global PROMPT_FILE, PROMPT_SEP
    for block in re.findall(r"```sh\n(.*?)```", open(proc, encoding="utf-8").read(), re.S):
        for line in block.splitlines():
            toks = shlex.split(line)
            if toks and os.path.basename(toks[0]) == "check-window":  # v3.3, F5: `bin/check-window … && …` — предохранитель окна до старта
                toks = toks[toks.index("&&") + 1:] if "&&" in toks else []
            env = {}
            while toks and re.match(r"^[A-Za-z_]\w*=", toks[0]):
                k, _, v = toks.pop(0).partition("=")
                env[k] = v
            if toks[:1] == ["claude"]:
                m = re.fullmatch(r"\$\(cat\s+(\S+)\)", toks[-1])
                PROMPT_FILE = m.group(1) if m else None
                PROMPT_SEP = bool(m) and toks[-2:-1] == ["--"]
                return env, toks[1:-1 - PROMPT_SEP] if m else toks[1:]
    return None, None


def table(text):
    """Строки таблицы Environment: (инструмент, форма, [id], вкл, «фича или чек»). id — `…` в ячейке до « — »; «…» в id — glob."""
    rows, head = [], False
    for line in text.split("## Environment", 1)[1].splitlines():
        if not line.startswith("|"):
            if head:
                break
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if not head or set("".join(cells)) <= set("-: "):
            head = True
            continue
        ids = re.findall(r"`([^`]+)`", cells[2].split(" — ")[0]) or [cells[2]]
        rows.append((cells[0], cells[1], [re.sub(r"\s*…", "*", i) for i in ids], cells[3] == "да", cells[4] if len(cells) > 4 else ""))
    return rows


def compare(rows, init, line, which=shutil.which):
    """FAIL с именем на каждое расхождение system/init и таблицы; пусто — равны."""
    on = lambda form: [i for _, f, ids, v, _ in rows if f == form and v for i in ids]
    off = lambda form: [i for _, f, ids, v, _ in rows if f == form and not v for i in ids]
    hit = lambda name, pats: any(fnmatch.fnmatchcase(name, p) for p in pats)
    why = lambda name, form: "в таблице «нет»" if hit(name, off(form)) else "нет в таблице"
    # ponytail: встроенные плагины (cc-plugin-*@builtin) пользователь не включает и не выключает — в сверке их нет
    plugins = sorted(p.get("source", "") for p in init.get("plugins", []) if not p.get("source", "").endswith("@builtin"))
    mcp = {s.get("name", ""): s.get("status") for s in init.get("mcp_servers", [])}
    skills = init.get("skills", [])
    bad = [f"плагин {p}: нет в system/init" for p in on("плагин") if p not in plugins]
    bad += [f"плагин {p}: лишний — {why(p, 'плагин')}" for p in plugins if not hit(p, on("плагин"))]
    bad += [f"MCP {m}: нет в system/init" for m in on("MCP") if not any(hit(n, [m]) for n in mcp)]
    bad += [f"MCP {n}: статус {s}, ждём connected" for n, s in mcp.items() if hit(n, on("MCP")) and s != "connected"]
    bad += [f"MCP {n}: лишний — {why(n, 'MCP')}" for n in mcp if not hit(n, on("MCP"))]
    bad += [f"скилл {s}: нет в system/init" for s in on("скилл") if not any(hit(k, [s]) for k in skills)]
    bad += [f"скилл {k}: включён — в таблице «нет»" for k in skills if hit(k, off("скилл"))]
    bad += [f"CLI {c}: нет в PATH" for c in on("CLI") if not which(c)]
    bad += [f"флаг {f}: нет в строке запуска" for f in on("флаг") if f not in line]
    return bad, f"плагинов {len(plugins)}, MCP {len(mcp)} ({', '.join(f'{n} {s}' for n, s in mcp.items()) or 'нет'}), скиллов {len(skills)}; строк таблицы {len(rows)}"


FIXTURE = """## Environment
| инструмент | форма | id | вкл | фича или чек | установка | удаление |
|---|---|---|---|---|---|---|
| git, gh | CLI | `git`, `gh` | да | всегда | — | — |
| ultracode | флаг | `--effort ultracode` | да | все фичи | строка запуска | — |
| Ponytail | плагин | `ponytail@ponytail` | да | база | — | — |
| Context7 | MCP | `context7` | да | база | — | — |
| Graphify | скилл | `graphify` | да | база | — | — |
| commit-commands | плагин | `commit-commands@claude-plugins-official` | нет | — | — | — |
| brain-init | скилл | `brain-init` | нет | — | — | — |
| скиллы Cowork | скилл | `anthropic-skills:*` — 20, поимённо в `.claude/launch.settings.json` | нет | — | — | — |
| ref, blockscout | MCP | `ref`, `blockscout` | нет | — | — | — |
| коннекторы claude.ai | MCP | `claude.ai …` | нет | — | — | — |

## Деньги
"""


MODE_WORDS = ("shadow", "active", "hint", "auto", "off")


def defaults(init, pid):
    """userConfig плагина по умолчанию — из его manifest по пути из system/init: без записи pluginConfigs действуют они."""
    path = next((p.get("path") for p in (init or {}).get("plugins", []) if p.get("source") == pid), None)
    try:
        uc = json.load(open(os.path.join(path, ".claude-plugin", "plugin.json"), encoding="utf-8")).get("userConfig", {}) if path else {}
    except (OSError, ValueError):
        uc = {}
    return {k: v["default"] for k, v in uc.items() if isinstance(v, dict) and "default" in v}


def modes(rows, configs, init=None):
    """Режим плагина «да» из колонки «фича или чек» против pluginConfigs launch settings (нет записи — userConfig мода по
    умолчанию): «тень» — shadow (true или значение), `hint`, `auto`, … — значение опции, «N %» — числовое значение; у плагина без опций число — не режим:
    порог window-guard — число budgets.json, настроек у мода нет (решение 398); расхождение — FAIL с именем (SPEC-v3.2 F4)."""
    bad = []
    for _, form, ids, on, cell in rows:
        if form != "плагин" or not on:
            continue
        want = (["shadow"] if re.search(r"(?i)\bтень\b", cell) else []) + [w for w in re.findall(r"`([a-z]+)`", cell) if w in MODE_WORDS]
        want += [int(n) for n in re.findall(r"(\d+)\s*%", cell)]
        for pid in ids:
            opts = (configs.get(pid) or {}).get("options")
            src = "launch settings"
            if opts is None:
                opts, src = defaults(init, pid), "по умолчанию мода"
            vals = list(opts.values())
            for w in want:
                if type(w) is int and (not opts or re.search(r"`\w+_pct`", cell)):  # SPEC-v3.5 F1: число ключа budgets.json, названного в ячейке, — не опция мода
                    continue
                if not ((opts.get("shadow") is True or "shadow" in vals) if w == "shadow" else w in vals):
                    bad.append(f"режим {pid}: в таблице «{'тень' if w == 'shadow' else w}», {src} — "
                               f"{json.dumps(opts, ensure_ascii=False) if opts else 'нет pluginConfigs и значений мода по умолчанию'}")
    return bad


MODE_FIXTURE = """## Environment
| инструмент | форма | id | вкл | фича или чек | установка | удаление |
|---|---|---|---|---|---|---|
| Jev Belay | плагин | `jev-belay@jev-belay` | да | второй судья — тень (только журнал) | — | — |
| Compact Adviser | плагин | `compact-adviser@compact-adviser` | да | режим `hint` | — | — |
| handoff | плагин | `handoff@two-tier-mods` | да | хендофф на 70 % окна | — | — |
| window-guard | плагин | `window-guard@two-tier-mods` | да | порог 100 % — число budgets.json | — | — |
| commit-commands | плагин | `commit-commands@claude-plugins-official` | нет | тень — строка «нет» не сверяется | — | — |

## Деньги
"""


def graph_age(root="."):
    """(статус, текст) графа кода против HEAD (F6.1). Отметка graphify-out/.built-head — sha, для которого граф собрал .githooks/post-commit: не HEAD
    или её нет — WARN, не красное (сборка идёт в фоне; коммит без правок кода граф не переписывает, поэтому время файла не мерило); графа или коммитов нет — статуса нет."""
    g = os.path.join(root, "graphify-out")
    head = subprocess.run(["git", "-C", root, "rev-parse", "-q", "--verify", "HEAD"], capture_output=True, text=True).stdout.strip()
    if not os.path.isfile(f"{g}/graph.json") or not head:
        return None, "графа нет (graphify-out/graph.json) или нет коммитов"
    built = open(f"{g}/.built-head", encoding="utf-8").read().strip() if os.path.isfile(f"{g}/.built-head") else ""
    if built == head:
        return "OK", f"граф собран для HEAD {head[:7]}"
    return "WARN", (f"граф собран для {built[:7]}, HEAD {head[:7]}" if built else "нет отметки сборки graphify-out/.built-head") + "; собрать: sh .githooks/post-commit"


def graph_lines(root="."):
    """Строки вывода о графе: статус и текст; граф не для HEAD — ещё `HARNESS_WARN graph-age`."""
    status, text = graph_age(root)
    return [f"{status or '--':4} graph: {text}"] + (["HARNESS_WARN graph-age"] if status == "WARN" else [])


def graph_age_probes():
    """Стороны graph_age на фикстуре (git без настроек пользователя): нет коммитов, нет графа, отметка = HEAD, другая, нет отметки."""
    os.makedirs(TMP, exist_ok=True)
    d = tempfile.mkdtemp(prefix="graph-age-", dir=TMP)
    env = dict(os.environ, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1")
    git = lambda *a: subprocess.run(["git", "-C", d, "-c", "user.name=t", "-c", "user.email=t@example.invalid", *a], capture_output=True, text=True, env=env)
    got = []
    try:
        git("init", "-q")
        os.makedirs(f"{d}/graphify-out")
        open(f"{d}/graphify-out/graph.json", "w").write("{}")
        got.append(("граф есть, коммитов нет", None, graph_age(d)[0]))
        git("commit", "-q", "--allow-empty", "-m", "x")
        head = git("rev-parse", "HEAD").stdout.strip()
        for name, stamp, want in (("отметка = HEAD", head, "OK"), ("отметка другого коммита", "0" * 40, "WARN"), ("нет отметки", None, "WARN")):
            if stamp is None:
                os.remove(f"{d}/graphify-out/.built-head")
            else:
                open(f"{d}/graphify-out/.built-head", "w").write(stamp + "\n")
            got.append((name, want, graph_age(d)[0]))
            got.append((f"{name}: строка HARNESS_WARN", want == "WARN", "HARNESS_WARN graph-age" in graph_lines(d)))
        os.remove(f"{d}/graphify-out/graph.json")
        got.append(("нет графа", None, graph_age(d)[0]))
    finally:
        shutil.rmtree(d, ignore_errors=True)
    return got


def self_test():
    rows = table(FIXTURE)
    line = "--permission-mode auto --effort ultracode"
    green = {"plugins": [{"source": "ponytail@ponytail"}, {"source": "cc-plugin-telemetry@builtin"}],
             "mcp_servers": [{"name": "context7", "status": "connected"}], "skills": ["graphify", "deep-research"]}
    which = lambda c: c in ("git", "gh")
    cases = [("зелёная: init = таблица, встроенный плагин и бандл-скилл не в счёт", green, line, which, None)]
    red = lambda name, change, want, l=line, w=which: cases.append((name, {**green, **change}, l, w, want))
    red("лишний плагин", {"plugins": green["plugins"] + [{"source": "commit-commands@claude-plugins-official"}]}, "commit-commands")
    red("плагин таблицы не загружен", {"plugins": [{"source": "cc-plugin-telemetry@builtin"}]}, "ponytail@ponytail")
    red("MCP needs-auth", {"mcp_servers": [{"name": "context7", "status": "needs-auth"}]}, "context7")
    red("MCP таблицы нет", {"mcp_servers": []}, "context7")
    red("лишний MCP из «нет»", {"mcp_servers": green["mcp_servers"] + [{"name": "ref", "status": "connected"}]}, "ref")
    red("коннектор claude.ai", {"mcp_servers": green["mcp_servers"] + [{"name": "claude.ai Gmail", "status": "connected"}]}, "claude.ai Gmail")
    red("скилл Cowork включён", {"skills": green["skills"] + ["anthropic-skills:docx"]}, "anthropic-skills:docx")
    red("скилл таблицы не загружен", {"skills": ["deep-research"]}, "graphify")
    red("флага нет в строке", {}, "--effort ultracode", l="--permission-mode auto --effort xhigh")
    red("CLI нет в PATH", {}, "gh", w=lambda c: c == "git")
    mrows, green = table(MODE_FIXTURE), {"jev-belay@jev-belay": {"options": {"shadow": True, "threshold": 0.75}},
                                         "compact-adviser@compact-adviser": {"options": {"mode": "hint"}}, "handoff@two-tier-mods": {"options": {"threshold": 70}}}
    mcases = [("зелёная: тень, hint, 70 % — как в pluginConfigs", green, None),
              ("тень в таблице, shadow false", green | {"jev-belay@jev-belay": {"options": {"shadow": False}}}, "jev-belay@jev-belay: в таблице «тень»"),
              ("hint в таблице, auto в настройках", green | {"compact-adviser@compact-adviser": {"options": {"mode": "auto"}}}, "compact-adviser@compact-adviser: в таблице «hint»"),
              ("70 % в таблице, 60 в настройках", green | {"handoff@two-tier-mods": {"options": {"threshold": 60}}}, "handoff@two-tier-mods: в таблице «70»"),
              ("нет pluginConfigs плагина", {k: v for k, v in green.items() if k != "jev-belay@jev-belay"}, "нет pluginConfigs"),
              ("число у плагина с опциями, другое значение", green | {"window-guard@two-tier-mods": {"options": {"threshold": 50}}}, "window-guard@two-tier-mods: в таблице «100»")]
    os.makedirs(TMP, exist_ok=True)
    man = tempfile.mkdtemp(prefix="modes-", dir=TMP)
    os.makedirs(f"{man}/ok/.claude-plugin")
    os.makedirs(f"{man}/bad/.claude-plugin")
    json.dump({"userConfig": {"threshold": {"type": "number", "default": 70}}}, open(f"{man}/ok/.claude-plugin/plugin.json", "w"))
    json.dump({"userConfig": {"threshold": {"type": "number", "default": 60}}}, open(f"{man}/bad/.claude-plugin/plugin.json", "w"))
    nohand = {k: v for k, v in green.items() if k != "handoff@two-tier-mods"}
    init = lambda d: {"plugins": [{"source": "handoff@two-tier-mods", "path": f"{man}/{d}"}]}
    mcases += [("нет pluginConfigs, 70 — по умолчанию мода", nohand, None, init("ok")),
               ("нет pluginConfigs, по умолчанию 60", nohand, "handoff@two-tier-mods: в таблице «70», по умолчанию мода", init("bad"))]
    mrows35 = table(MODE_FIXTURE.replace("хендофф на 70 % окна", "хендофф на 40 % окна — порог `handoff_threshold_pct` budgets.json"))
    mcases35 = [("порог ключом budgets.json в ячейке — не сверяется (SPEC-v3.5 F1)", mrows35, green | {"handoff@two-tier-mods": {"options": {"handoffDir": "handoffs"}}}, None)]
    ok = True
    for name, rows35, cfg, want in mcases35:
        bad = modes(rows35, cfg)
        good = not bad if want is None else len(bad) == 1 and want in bad[0]
        ok &= good
        print(f"{'ok ' if good else 'BAD'} modes · {name}: {'; '.join(bad) or 'расхождений нет'}")
    for name, cfg, want, *ini in mcases:
        bad = modes(mrows, cfg, ini[0] if ini else None)
        good = not bad if want is None else len(bad) == 1 and want in bad[0]
        ok &= good
        print(f"{'ok ' if good else 'BAD'} modes · {name}: {'; '.join(bad) or 'расхождений нет'}")
    for name, want, status in graph_age_probes():
        ok &= status == want
        print(f"{'ok ' if status == want else 'BAD'} graph-age · {name}: {status if status not in (None, True, False) else {None: 'статуса нет', True: 'есть', False: 'нет'}[status]}")
    for group, probes in (("versions", versions_probes), ("worktree", worktree_probes), ("tab", tab_view_probes), ("profile", profile_probes), ("denied", lambda: denied_probes(paths()[0]))):
        for name, want, got in probes():
            ok &= got == want
            print(f"{'ok ' if got == want else 'BAD'} {group} · {name}: {got}" + ("" if got == want else f" — ждём {want}"))
    print(f"фикстура таблицы: строк {len(rows)}; {'; '.join(f'{f}: {len(ids)}' for _, f, ids, _, _ in rows[:3])} …")
    for name, init, l, w, want in cases:
        bad, _ = compare(rows, init, l, w)
        good = not bad if want is None else len(bad) == 1 and want in bad[0]
        ok &= good
        print(f"{'ok ' if good else 'BAD'} env · {name}: {'; '.join(bad) or 'расхождений нет'}")
    return ok


def static(src, proc, launch):
    H = "HARNESS"
    s = json.load(open(f"{src}/.claude/settings.json", encoding="utf-8"))
    say(H, "OK" if s.get("model") == "claude-opus-5-5" and "effortLevel" not in s and "ultracode" not in s else "FAIL",
        "settings", f"model {s.get('model')}; effortLevel {'задан' if 'effortLevel' in s else 'нет'}; ultracode {'задан' if 'ultracode' in s else 'нет'}")
    say(H, "OK" if s.get("autoMemoryEnabled") is False and s.get("disableClaudeAiConnectors") is True else "FAIL",
        "settings", f"autoMemoryEnabled {s.get('autoMemoryEnabled')}; disableClaudeAiConnectors {s.get('disableClaudeAiConnectors')}")
    base, size = s.get("worktree", {}).get("baseRef"), s.get("workflowSizeGuideline")
    say(H, "OK" if base == "head" and size == "medium" else "FAIL", "settings", f"worktree.baseRef {base}; workflowSizeGuideline {size}")
    owner = json.load(open(f"{src}/budgets.json", encoding="utf-8"))["defaults"]["owner"]
    want = {f"Edit(/{p}**)" if p.endswith("/") else f"Edit(/{p})" for p in owner}
    perms = s.get("permissions", {})
    deny, allow = set(perms.get("deny", [])), set(perms.get("allow", []))
    writes = [r for k in ("allow", "ask", "deny") for r in perms.get(k, []) if r.startswith("Write(")]
    say(H, "OK" if want <= deny and not writes else "FAIL", "settings",
        f"deny Edit на файлы тимлида {len(want & deny)}/{len(want)}; правил Write(…) {len(writes)}")
    say(H, "OK" if allow == ALLOW else "FAIL", "settings", f"allow {len(allow)}: {', '.join(sorted(allow)) or 'нет'} (ждём ровно {', '.join(sorted(ALLOW))})")
    say(H, "OK" if perms.get(WRITE_KEY) is True else "FAIL", "settings", f"permissions.{WRITE_KEY} {perms.get(WRITE_KEY)}")
    hooks = [h for g in s.get("hooks", {}).get("PreToolUse", []) for h in g.get("hooks", [])]
    names = [os.path.basename(h.get("args", [""])[0] if h.get("command") in ("python3", "node") else h.get("command", ""))[:40] for h in hooks]
    bad = [n for h, n in zip(hooks, names) if "${CLAUDE_PROJECT_DIR}" not in json.dumps(h) or "args" not in h
           or not os.access(f"{src}/.claude/hooks/{n}", os.X_OK if n.endswith(".sh") else os.R_OK)]
    ok = {"kill-switch.sh", "steer.sh"} <= set(names) and not bad
    say(H, "OK" if ok else "FAIL", "settings", f"хуки PreToolUse (exec form, ${{CLAUDE_PROJECT_DIR}}): {', '.join(names)}; с ошибкой — {bad or 'нет'}")
    env = json.load(open(launch, encoding="utf-8")).get("autoMode", {}).get("environment", [])
    say(H, "OK" if "$defaults" in env else "FAIL", "launch", f"{launch}: autoMode.environment записей {len(env)}, \"$defaults\" {'есть' if '$defaults' in env else 'нет'}")
    lenv, args = launch_line(proc)
    if args is None:
        say(H, "FAIL", "line", f"{proc}: нет блока ```sh со строкой `claude …`")
        return None
    line = f" {' '.join(args)} "
    miss = [f for f in LINE_FLAGS if f" {f} " not in line]  # флаг и значение — целыми токенами
    say(H, "FAIL" if miss or (PROMPT_FILE and not PROMPT_SEP) else "OK", "line", f"{proc}: env {', '.join(lenv) or 'нет'}; флагов {len(args)}; нет — {', '.join(miss) or 'ничего'}; "
        f"стартовый запрос аргументом — {PROMPT_FILE or 'нет (запуск — словами PROCESS)'}"
        + (f", `--` перед ним — {'есть' if PROMPT_SEP else 'нет: вариадический флаг (--add-dir, --mcp-config) заберёт запрос'}" if PROMPT_FILE else ""))
    return lenv, args


def deploy(src, launch):
    os.makedirs(TMP, exist_ok=True)
    dst = tempfile.mkdtemp(prefix="harness-", dir=TMP)
    shutil.copytree(f"{src}/.claude", f"{dst}/.claude", symlinks=True)
    shutil.copy(launch, f"{dst}/.claude/launch.settings.json")
    shutil.copytree(f"{src}/bin", f"{dst}/bin")
    # Пара проверяет механизмы (хуки, deny, окружение), а не текст CLAUDE.md. Правила кита («git add по точным путям»,
    # «AGENT_STOP останавливает») агент воркфлоу ставит выше промпта скрипта и сам не пробует то, что должен отказать
    # хук (замер 07.10) — в копии CLAUDE.md оператора-контролёра.
    open(f"{dst}/CLAUDE.md", "w").write(CLAUDE_MD)
    subprocess.run(["git", "init", "-q", dst], check=True)
    return dst


def control(dst, lenv, args, name, prompt, mode=None, extra=(), env_over=None, turns=3, from_file=False):
    if from_file and PROMPT_FILE:  # как строка запуска: запрос — содержимое файла стартового запроса копии
        os.makedirs(os.path.dirname(f"{dst}/{PROMPT_FILE}") or dst, exist_ok=True)
        open(f"{dst}/{PROMPT_FILE}", "w", encoding="utf-8").write(prompt)
        prompt = open(f"{dst}/{PROMPT_FILE}", encoding="utf-8").read()
    if mode:
        i = args.index("--permission-mode")
        args = args[:i + 1] + [mode] + args[i + 2:]
    own = [*extra, "--max-turns", str(turns), "--output-format", "stream-json", "--verbose"]
    # из файла — порядок строки: её флаги последними, затем `--` (если он в строке) и запрос: вариадический флаг без `--` заберёт запрос и здесь
    cmd = ["claude", "-p", *own, *args, *(["--"] if PROMPT_SEP else []), prompt] if from_file and PROMPT_FILE else ["claude", "-p", prompt, *args, *own]
    env = {k: v for k, v in os.environ.items() if k != "ANTHROPIC_API_KEY"} | lenv | {"SPEC_GATE": "off"} | (env_over or {})
    try:
        stdout = subprocess.run(cmd, cwd=dst, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=300).stdout
    except subprocess.TimeoutExpired as e:  # ponytail: главная сессия -p зависла после воркфлоу (замер 07.10) — судим по снятому потоку и файлам
        stdout = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        print(f"     {name}: claude -p не завершился за 300 с — остановлен, судим по снятому потоку")
    open(f"{dst}/{name}.jsonl", "w").write(stdout)
    ev = [json.loads(l) for l in stdout.splitlines() if l.startswith("{")]
    init = next((e for e in ev if e.get("type") == "system" and e.get("subtype") == "init"), {})
    res = next((e for e in ev if e.get("type") == "result"), {})
    blocks = [c for e in ev if e.get("type") in ("assistant", "user") and not e.get("parent_tool_use_id")
              and isinstance(e["message"].get("content"), list) for c in e["message"]["content"]]
    uses = [c for c in blocks if c.get("type") == "tool_use"]
    results = {c.get("tool_use_id"): str(c.get("content")) for c in blocks if c.get("type") == "tool_result"}
    return init, res, uses, results, ev


def pair(src, proc, launch, lenv, args):
    H = "HARNESS"
    dst = deploy(src, launch)
    print(f"копия харнеса: {dst}")
    own = "--max-turns 3 --output-format stream-json --verbose"
    print("run: env -u ANTHROPIC_API_KEY " + " ".join(f"{k}={v}" for k, v in lenv.items()) + " claude -p "
          + (f"{own} {shlex.join(args)}{' --' if PROMPT_SEP else ''} \"$(cat {PROMPT_FILE})\"" if PROMPT_FILE else f"'<prompt>' {shlex.join(args)} {own}"))
    marker = word_marker("H")
    open(f"{dst}/STEER.md", "w").write(f"The marker for this run is {marker}.\n")
    init, res, uses, _, _ = control(dst, lenv, args, "run1", PROMPT, from_file=True)
    if not init:
        say(H, "FAIL", "run1", "нет system/init — вложенный запуск не состоялся; STOP-INPUT: оператор запускает `bin/check-harness` сам")
        say("ENV", "FAIL", "run1", "сверки system/init с таблицей не было")
        return dst, None
    say(H, "OK" if init.get("permissionMode") == "auto" and init.get("apiKeySource") == "none" else "FAIL", "run1",
        f"init permissionMode {init.get('permissionMode')}, model {init.get('model')}, apiKeySource {init.get('apiKeySource')}")
    probe = open(f"{dst}/probe.txt").read().strip() if os.path.exists(f"{dst}/probe.txt") else None
    steer_left = os.path.getsize(f"{dst}/STEER.md")
    say(H, "OK" if probe and marker in probe and steer_left == 0 else "FAIL", "run1",
        f"без AGENT_STOP: probe.txt {'создан' if probe is not None else 'не создан'}, маркер из STEER.md {'в файле' if probe and marker in probe else 'не дошёл'}; "
        f"STEER.md {'очищен' if steer_left == 0 else 'не очищен'}; tool_use {len(uses)}, ходов {res.get('num_turns')}")
    os.remove(f"{dst}/probe.txt") if probe is not None else None
    open(f"{dst}/AGENT_STOP", "w").close()
    init2, res, uses, results, _ = control(dst, lenv, args, "run2", PROMPT, from_file=True)
    os.remove(f"{dst}/AGENT_STOP")
    created = os.path.exists(f"{dst}/probe.txt")
    hit = any("Kill switch" in v for v in results.values())
    stopped = res.get("terminal_reason") == "hook_stopped"
    say(H, "OK" if not created and len(uses) == 1 and hit and stopped else "FAIL", "run2",
        f"с AGENT_STOP: probe.txt {'создан' if created else 'не создан'}; tool_use {len(uses)}; причина kill-switch в выводе — {'да' if hit else 'нет'}; "
        f"terminal_reason {res.get('terminal_reason')}")
    rules = json.load(open(f"{dst}/.claude/settings.json", encoding="utf-8")).get("permissions", {}).get("allow", [])
    _, res, uses, results, _ = control(dst, lenv, args, "allow", PROMPT_ALLOW, mode="dontAsk", extra=["--allowedTools", *rules], from_file=True)
    denied = {json.dumps(d.get("tool_input", {})) for d in res.get("permission_denials") or []}
    ran = [u for u in uses if u.get("input", {}).get("command", "").startswith("bin/check-ci")]
    ran_ok = bool(ran) and "usage" in results.get(ran[0].get("id"), "") and not any("check-ci" in d for d in denied)
    other = any("two-tier-upgrade" in d for d in denied)
    say(H, "OK" if ran_ok and other else "FAIL", "allow",
        f"dontAsk, --allowedTools {len(rules)} правила settings: `bin/check-ci` — {'выполнен' if ran_ok else 'нет'}; `bin/two-tier-upgrade --help` — {'отказ' if other else 'не отказан'}; "
        f"tool_use {len(uses)}, отказов {len(denied)}")
    rows = table(open(proc, encoding="utf-8").read())
    cfgs = json.load(open(launch, encoding="utf-8")).get("pluginConfigs", {})
    bad = modes(rows, cfgs, init)
    own = [p for _, f, ii, v, _ in rows if f == "плагин" and v for p in ii if p not in cfgs and defaults(init, p)]
    say("ENV", "FAIL" if bad else "OK", "modes", f"режимы плагинов таблицы против pluginConfigs {launch}: " + ("; ".join(bad) if bad else
        ", ".join(f"{p} {json.dumps(c.get('options', {}), ensure_ascii=False)}" for p, c in cfgs.items()) +
        "".join(f"; {p} — по умолчанию мода {json.dumps(defaults(init, p), ensure_ascii=False)}" for p in own) or "плагинов с режимом нет"))
    for name, ev in (("run1", init), ("run2", init2)):  # список MCP грузится в фоне — смотрим оба прогона
        bad, summary = compare(rows, ev, " ".join(args))
        say("ENV", "FAIL" if bad else "OK", name, f"system/init = таблица {proc}: {summary}")
        for b in bad:
            say("ENV", "FAIL", name, b)
    layer_probes(rows, dst, lenv, args, proc)
    return dst, init


def workflow(ev):
    """Итог воркфлоу из task_notification.output_file (agent-sdk: SDKTaskNotificationMessage): (статус, JSON или {})."""
    wid = next((e.get("task_id") for e in ev if e.get("subtype") == "task_started" and e.get("task_type") == "local_workflow"), None)
    note = next((e for e in ev if e.get("subtype") == "task_notification" and e.get("task_id") == wid), {})
    f = note.get("output_file", "")
    return note.get("status"), (json.load(open(f, encoding="utf-8")) if f and os.path.isfile(f) else {})


def hooks(dst, lenv, args):
    S = "HOOKS"
    staged = lambda: subprocess.run(["git", "ls-files"], cwd=dst, capture_output=True, text=True).stdout.split()
    _, res, uses, results, _ = control(dst, lenv, args, "guards", PROMPT_GUARDS, from_file=True)
    denied = [d for d in res.get("permission_denials") or [] if "STATUS.md" in json.dumps(d.get("tool_input", {}))]
    add = [u for u in uses if "git add" in u.get("input", {}).get("command", "")]
    refusal = results.get(add[0].get("id"), "") if add else ""
    ok = denied and "refused by hook" in refusal and "CLAUDE.md" not in refusal and not os.path.exists(f"{dst}/docs/STATUS.md") and not staged()
    say(S, "OK" if ok else "FAIL", "guards", f"главная сессия: Write docs/STATUS.md — {'отказ deny' if denied else 'не отказан'}, файл {'есть' if os.path.exists(f'{dst}/docs/STATUS.md') else 'не создан'}; "
        f"`git add -A` — {'отказ хука' if 'refused by hook' in refusal else 'нет отказа'}, ссылка на CLAUDE.md в отказе — {'есть' if 'CLAUDE.md' in refusal else 'нет'}; в индексе {len(staged())}")
    marker = word_marker("S")
    os.makedirs(f"{dst}/.claude/workflows", exist_ok=True)
    open(f"{dst}/.claude/workflows/hook-probe.js", "w").write(WF_AGENT.format(marker=marker))
    open(f"{dst}/.claude/workflows/kill-probe.js", "w").write(WF_KILL)
    open(f"{dst}/STEER.md", "w").close()
    _, res, _, _, ev = control(dst, lenv, args, "agent", PROMPT_WF.format("hook-probe"),
                               extra=["--allowedTools", "Workflow(hook-probe)", "Edit(/STEER.md)", "Bash(cat STEER.md)"])
    status, wf = workflow(ev)
    r = wf.get("result") if isinstance(wf.get("result"), dict) else {}
    agents = [a for a in wf.get("workflowProgress", []) if a.get("type") == "workflow_agent"]
    left = open(f"{dst}/STEER.md").read()
    kept = marker in left and r.get("cat_shows_marker") is True
    ok = kept and "refused by hook" in r.get("git_add", "") and "CLAUDE.md" not in r.get("git_add", "") \
        and not os.path.exists(f"{dst}/docs/STATUS.md") and not staged() and r.get("write_status")
    say(S, "OK" if ok else "FAIL", "agent", f"воркфлоу {status}, агентов {len(agents)} ({', '.join(a.get('model', '') for a in agents)}), вызовов {sum(a.get('toolCalls', 0) for a in agents)}; "
        f"STEER.md после агента — {'заметка на месте' if marker in left else 'пуст'}, агент видел её в cat — {r.get('cat_shows_marker')}; "
        f"Write docs/STATUS.md — файл {'есть' if os.path.exists(f'{dst}/docs/STATUS.md') else 'не создан'}, ответ инструмента «{r.get('write_status', '')[:70]}»; "
        f"`git add -A` — {'отказ хука' if 'refused by hook' in r.get('git_add', '') else 'нет отказа'}; в индексе {len(staged())}")
    open(f"{dst}/STEER.md", "w").close()
    _, res, _, _, ev = control(dst, lenv, args, "kill", PROMPT_WF.format("kill-probe"),
                               extra=["--allowedTools", "Workflow(kill-probe)", "Bash(touch AGENT_STOP)", "Bash(echo agent-ok > agent-probe.txt)"])
    status, wf = workflow(ev)
    stop, probe = os.path.exists(f"{dst}/AGENT_STOP"), os.path.exists(f"{dst}/agent-probe.txt")
    os.remove(f"{dst}/AGENT_STOP") if stop else None
    agents = [a for a in wf.get("workflowProgress", []) if a.get("type") == "workflow_agent"]
    tried = any("agent-probe" in str(a.get("lastToolSummary")) for a in agents)  # агент сам не остановился, а попытался
    say(S, "OK" if stop and tried and not probe else "FAIL", "kill", f"воркфлоу {status}; агент создал AGENT_STOP — {'да' if stop else 'нет'}; "
        f"запись пробы попытана — {'да' if tried else 'нет'}; agent-probe.txt {'создан' if probe else 'не создан'}; "
        f"вызовов агента {sum(a.get('toolCalls', 0) for a in agents)}, состояние {', '.join(str(a.get('state')) for a in agents) or 'нет'}; terminal_reason главной {res.get('terminal_reason')}")


def gate_fixture(src, launch, full=False, stop_old=False, fresh_head=True, loose=(), items=False, spec=None):
    """Фаза из двух фич в своём git с origin: F1 закрыт; full — и F2 с VERDICT: PASS для HEAD. Коммиты — до начала сессии
    (транскрипт начинается 10 мин назад, коммиты — 20); fresh_head — голова PROGRESS переписана в сессии, закоммичена и запушена.
    loose — что остаётся на диске вне коммита: «docs/evidence/F2-b-result.txt», «verify», «docs/PROGRESS.md» — её голова (ревью v3.2-2, B2)."""
    d = tempfile.mkdtemp(prefix="gate-", dir=TMP)
    repo, past = f"{d}/repo", time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(time.time() - 1200))
    env = GIT_ENV | {"GIT_AUTHOR_DATE": past, "GIT_COMMITTER_DATE": past}
    g = lambda *a: subprocess.run(["git", *a], cwd=repo, env=env, capture_output=True, text=True, check=True)
    subprocess.run(["git", "init", "-q", "--bare", f"{d}/origin.git"], env=env, check=True)
    shutil.copytree(f"{src}/.claude", f"{repo}/.claude", symlinks=True)
    shutil.copy(launch, f"{repo}/.claude/launch.settings.json")
    shutil.copytree(f"{src}/bin", f"{repo}/bin")
    files = {"CLAUDE.md": CLAUDE_MD, "docs/PROMPT.txt": "Read first: docs/SPEC-1.md, docs/PROGRESS.md\n\nФаза 1 фикстуры spec-gate.\n",
             "docs/SPEC-1.md": spec or (GATE_SPEC_ITEMS if items else GATE_SPEC), "docs/PROGRESS.md": GATE_PROGRESS + ("\n" + GATE_STOP if stop_old else ""),
             "docs/evidence/F1-a-result.txt": EV_ITEMS["docs/evidence/F1-a-result.txt"] if items else "spec: SPEC-1\n$ bin/a\nA\nA_OK\n"}
    if full:
        files["docs/evidence/F2-b-result.txt"] = EV_ITEMS["docs/evidence/F2-b-result.txt"] if items else "spec: SPEC-1\n$ bin/b\nB\nB_OK\n"
    for p, text in files.items():
        os.makedirs(os.path.dirname(f"{repo}/{p}") or repo, exist_ok=True)
        open(f"{repo}/{p}", "w", encoding="utf-8").write(text)
    g("init", "-q", "-b", "phase")
    g("config", "user.name", "t")  # коммит модели в живой пробе — без имени и почты оператора
    g("config", "user.email", "t@example.invalid")
    g("add", "--", ".claude", "bin", *[p for p in files if p not in loose or p == "docs/PROGRESS.md"])  # точные пути, не -A; PROGRESS вне коммита — только новая голова
    g("commit", "-qm", "fixture")
    if full:
        sha = g("rev-parse", "--short", "HEAD").stdout.strip()
        open(f"{repo}/docs/evidence/verify-{sha}.txt", "w").write(f"VERDICT: PASS\n/verify-phase · docs/SPEC-1.md · HEAD {sha}\n")
        if "verify" not in loose:
            g("add", f"docs/evidence/verify-{sha}.txt")
            g("commit", "-qm", f"accept: PASS {sha}")
    g("remote", "add", "origin", f"{d}/origin.git")
    g("push", "-q", "origin", "phase")
    transcript = f"{d}/transcript.jsonl"
    open(transcript, "w").write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() - 600))}) + "\n")
    if fresh_head:
        pg = open(f"{repo}/docs/PROGRESS.md", encoding="utf-8").read()
        open(f"{repo}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace("**Когда закончим:** сегодня, после гейта.", "**Когда закончим:** сегодня, гейт идёт."))
        if "docs/PROGRESS.md" not in loose:  # коммит и push головы — уже в сессии: комплект судится по запушенному HEAD
            ship(repo, "голова в сессии", "docs/PROGRESS.md")
    return repo, transcript


def ship(repo, msg, *paths):
    """git add <пути> · commit · push origin phase — сейчас, то есть в сессии пробы."""
    for a in (("add", "--", *paths), ("commit", "-qm", msg), ("push", "-q", "origin", "phase")):
        r = subprocess.run(["git", *a], cwd=repo, env=GIT_ENV, capture_output=True, text=True)
        if r.returncode:
            raise RuntimeError(f"фикстура: git {' '.join(a)} — rc {r.returncode}: {' '.join((r.stderr or r.stdout).split())[:400]}")


def gate_run(repo, transcript, session, env_over=None, extra=None, hook=None, raw=None):
    """Один вызов Stop-хука как от Claude Code: (rc, JSON stdout или {}, сырой stdout, строки журнала, секунды); hook — другой файл хука;
    raw — stdin как есть вместо входа Stop (пустой, битый)."""
    inp = {"session_id": session, "transcript_path": transcript, "cwd": repo, "hook_event_name": "Stop", "stop_hook_active": False,
           "last_assistant_message": "Готово: фаза закрыта, все фичи сделаны.", "background_tasks": [], "session_crons": [], **(extra or {})}
    env = {k: v for k, v in os.environ.items() if k != "SPEC_GATE"} | {"CLAUDE_PROJECT_DIR": repo}
    for k, v in (env_over or {}).items():
        env.pop(k, None) if v is None else env.update({k: v})
    t = time.monotonic()
    r = subprocess.run(["node", hook or f"{repo}/.claude/hooks/spec-gate.mjs"], input=json.dumps(inp) if raw is None else raw, env=env, capture_output=True, text=True, timeout=90)
    try:
        res = json.loads(r.stdout) if r.stdout.strip() else {}
    except ValueError:
        res = {"unparsed": r.stdout[:200]}
    lp = f"{repo}/docs/evidence/spec-gate.jsonl"
    log = [json.loads(l) for l in open(lp, encoding="utf-8")] if os.path.isfile(lp) else []
    return r.returncode, res, r.stdout, log, time.monotonic() - t


OLD_HOOK = "b04aaad"  # кит до SPEC-v3.4 F1 (его история есть только в репо кита): вторая сторона пробы — тот же вход на старом хуке
TELEFON_LOG = "checks/fixtures/telefon-spec-gate-0305.jsonl"  # журнал telefon 03–05.11 без сессий и списков; только в репо кита
RETRO_CUT = "2026-11-05T20:33"  # срез ретро: его числа 91 / 13 / 61 / 12 — журнал до этой минуты


def old_hook(src, repo):
    """Файл хука v3.3 рядом с хуком фикстуры; нет этой истории (проект из кита) — None."""
    r = subprocess.run(["git", "-C", src, "show", f"{OLD_HOOK}:kit/.claude/hooks/spec-gate.mjs"], capture_output=True, text=True)
    if r.returncode:
        return None
    p = f"{repo}/.claude/hooks/spec-gate-v33.mjs"
    open(p, "w", encoding="utf-8").write(r.stdout)
    return p


def bg(kind, **kw):  # элемент background_tasks формы документации hooks
    return {"id": f"task-{kind}", "type": kind, "status": "running", "description": "x", **kw}


CRON = {"id": "cron-001", "schedule": "0 9 * * 1-5", "recurring": True, "prompt": "x"}
SPEC_TL = GATE_SPEC_ITEMS.replace("- **STOP-NP** — нет прогресса.\n", "- **STOP-NP** — нет прогресса.\n- **STOP-TL** — плечо построено.\n")
STOP_TL = "STOP: STOP-TL «Leg 1» — плечо построено.\nВопрос тимлиду: принять плечо 1?\nResume: «продолжай плечо 2».\n"


def telefon_log():
    """Счёт журнала telefon: (срез ретро, весь журнал) — pass background / решений без стопов; нет файла — None."""
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    p = f"{top}/{TELEFON_LOG}"
    if not os.path.isfile(p):
        return None
    rows = [json.loads(l) for l in open(p, encoding="utf-8")]
    def count(rs):
        return {"bg": sum(r["class"] == "background" for r in rs), "time": sum(r["class"] == "cap-time" for r in rs), "stop": sum(r["decision"] == "stop" for r in rs), "n": len(rs)}
    return count([r for r in rows if r["ts"] < RETRO_CUT]), count(rows)


def gate34_probes(src, launch):
    S = "GATE_HOOK"
    short = lambda res: (res.get("reason") or res.get("systemMessage") or "тишина").replace("\n", " ")[:90]
    no_cap_env = {"CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": None}
    # F1.1 — pass только по типам, что разбудят сессию; остальное — суд комплекта (F2 в фикстуре нет)
    r, tr = gate_fixture(src, launch, items=True)
    def end(name, tasks=(), crons=(), repo=None, transcript=None, hook=None):
        rc, res, raw, log, _ = gate_run(repo or r, transcript or tr, name, extra={"background_tasks": list(tasks), "session_crons": list(crons)}, env_over=no_cap_env, hook=hook)
        return log[-1], res, raw
    passed, blocked, other = {}, {}, {}
    for t in ("monitor", "workflow", "shell"):
        l, res, raw = end(f"f11-{t}", [bg(t)])
        passed[t] = l["decision"] == "pass" and l["reason"] == f"background:{t}" and not raw.strip() and l["bg"] == [t]
    for t, group in (("subagent", blocked), ("MCP task", blocked), ("teammate", other), ("cloud session", other)):
        l, res, raw = end(f"f11-{t}", [bg(t)])
        group[t] = res.get("decision") == "block" and "- F2" in res.get("reason", "") and l["bg"] == [t]
    l, res, raw = end("f11-no-type", [{"id": "t", "status": "running"}])
    other["без type"] = res.get("decision") == "block" and l["bg"] == ["no type"]
    mix, _, _ = end("f11-mix", [bg("subagent"), bg("monitor"), bg("monitor")])
    cron, _, _ = end("f11-cron", [], [CRON])
    ok = all(passed.values()) and all(blocked.values()) and all(other.values()) and mix["reason"] == "background:monitor" and cron["reason"] == "background:cron"
    item(S, "v3.4-F1.1", ok, f"pass={sum(passed.values())}/3 block={sum(blocked.values())}/2 · pass по типу: "
         + ", ".join(f"{t} — background:{t}" for t, v in passed.items() if v) + " · суд комплекта: "
         + ", ".join(t for t, v in blocked.items() if v) + "; прочее — " + ", ".join(f"{t} {'block' if v else 'НЕ block'}" for t, v in other.items())
         + f" · subagent + monitor — {mix['decision']} {mix['reason']}, журнал bg {mix['bg']} · cron — {cron['reason']}")
    # F1.2 — без потолка часов и блоков: сессия старше 3 ч и 12 блоков судятся; no-progress остаётся
    r2, tr2 = gate_fixture(src, launch, items=True)
    old4 = f"{os.path.dirname(tr2)}/old.jsonl"
    open(old4, "w").write(json.dumps({"timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() - 4 * 3600))}) + "\n")
    caps = json.load(open(f"{src}/.claude/spec-gate.json", encoding="utf-8")).get("caps", {})
    l, res, _ = end("f12-old", repo=r2, transcript=old4)
    hours_block = res.get("decision") == "block" and l["decision"] == "block" and l.get("platform_cap") == 8
    seq = [end("f12-np", repo=r2, transcript=tr2)[0] for _ in range(4)]
    np_ok = [x["decision"] for x in seq] == ["block", "block", "block", "pass"] and seq[-1]["reason"].startswith("no-progress")
    sess = hashlib.sha256(b"f12-many").hexdigest()[:8]
    with open(f"{r2}/docs/evidence/spec-gate.jsonl", "a", encoding="utf-8") as f:
        for i in range(12):
            f.write(json.dumps({"ts": "", "session": sess, "decision": "block", "missing": [f"x{i}"]}) + "\n")
    many, res12, _ = end("f12-many", repo=r2, transcript=tr2)
    alt = old_hook(src, r2)
    alt_t = end("f12-alt-time", repo=r2, transcript=old4, hook=alt)[0] if alt else None
    sess = hashlib.sha256(b"f12-alt-many").hexdigest()[:8]
    if alt:
        with open(f"{r2}/docs/evidence/spec-gate.jsonl", "a", encoding="utf-8") as f:
            for i in range(12):
                f.write(json.dumps({"ts": "", "session": sess, "decision": "block", "missing": [f"x{i}"]}) + "\n")
    alt_b = end("f12-alt-many", repo=r2, transcript=tr2, hook=alt)[0] if alt else None
    # конфиг проекта без caps: порог same_list — из DEFAULTS хука
    r2c, tr2c = gate_fixture(src, launch, items=True)
    no_caps = json.load(open(f"{r2c}/.claude/spec-gate.json", encoding="utf-8"))
    no_caps.pop("caps", None)
    open(f"{r2c}/.claude/spec-gate.json", "w", encoding="utf-8").write(json.dumps(no_caps))
    seq_nc = [end("f12-no-caps", repo=r2c, transcript=tr2c)[0]["decision"] for _ in range(4)]
    ok = ("hours" not in caps and "blocks" not in caps and hours_block and np_ok and res12.get("decision") == "block" and seq_nc == ["block", "block", "block", "pass"]
          and (not alt or (alt_t["reason"].startswith("cap-time") and alt_b["reason"].startswith("cap-blocks"))))
    item(S, "v3.4-F1.2", ok, f"hours={'есть' if 'hours' in caps else 'weg'} block={'OK' if hours_block else 'нет'} · .claude/spec-gate.json caps {caps}; сессия старше 3 ч, неполный комплект — {l['decision']}, "
         f"журнал platform_cap={l.get('platform_cap')}; 12 блоков сессии — {many['decision']}; один список 4 раза — {' → '.join(x['decision'] for x in seq)} ({seq[-1]['reason'][:30]}); конфиг без caps — {' → '.join(seq_nc)}"
         + (f" · хук v3.3 на тех же входах: старше 3 ч — {alt_t['decision']} ({alt_t['reason'][:30]}), 12 блоков — {alt_b['decision']} ({alt_b['reason'][:30]})" if alt else " · истории кита нет — второй стороны на старом хуке нет"))
    # F1.3 — evidence своей SPEC: первая строка `spec: SPEC-<n>`; чужая, близнец, не первая, без строки — не в счёт; вердикт чужой SPEC — тоже
    r3, tr3 = gate_fixture(src, launch, full=True, items=True)
    own = end("f13-own", repo=r3, transcript=tr3)[1]
    ev2 = f"{r3}/docs/evidence/F2-b-result.txt"
    body = EV_ITEMS["docs/evidence/F2-b-result.txt"].split("\n", 1)[1]
    sides = {"spec: SPEC-9": "spec: SPEC-9\n" + body, "близнец spec: SPEC-10": "spec: SPEC-10\n" + body, "без строки": body, "вторая строка": "$ x\nspec: SPEC-1\n" + body}
    foreign, alt = {}, old_hook(src, r3)
    alt_res = None
    for name, text in sides.items():
        open(ev2, "w", encoding="utf-8").write(text)
        ship(r3, f"чужая {name}", "docs/evidence/F2-b-result.txt")
        res = end(f"f13-{name}", repo=r3, transcript=tr3)[1]
        foreign[name] = res.get("decision") == "block" and "- F2.1:" in res.get("reason", "") and "is not of SPEC-1" in res.get("reason", "") and "- F1." not in res.get("reason", "")
        if alt and name == "spec: SPEC-9":
            alt_res = end("f13-alt", repo=r3, transcript=tr3, hook=alt)[1]
    last_reason = line_of(res.get("reason", ""), "F2:")
    open(ev2, "w", encoding="utf-8").write(EV_ITEMS["docs/evidence/F2-b-result.txt"])
    ship(r3, "своя строка", "docs/evidence/F2-b-result.txt")
    back = end("f13-back", repo=r3, transcript=tr3)[1]
    v = next(n for n in os.listdir(f"{r3}/docs/evidence") if n.startswith("verify-"))
    text = open(f"{r3}/docs/evidence/{v}", encoding="utf-8").read()
    open(f"{r3}/docs/evidence/{v}", "w", encoding="utf-8").write(text.replace("docs/SPEC-1.md", "docs/SPEC-9.md"))
    ship(r3, "вердикт чужой SPEC", f"docs/evidence/{v}")
    alien = end("f13-verdict", repo=r3, transcript=tr3)[1]
    # полный свой комплект и рядом чужой файл той же фичи — ход не держит; свой неполный — чужой только назван, его строки не в счёт
    ob, tob = gate_fixture(src, launch, full=True, items=True)
    open(f"{ob}/docs/evidence/F1-old-result.txt", "w", encoding="utf-8").write("spec: SPEC-0\n$ old\nF1.2 old\nA_OK\n")
    ship(ob, "чужой файл рядом со своим", "docs/evidence/F1-old-result.txt")
    beside = end("f13-beside", repo=ob, transcript=tob)[1]
    open(f"{ob}/docs/evidence/F2-old-result.txt", "w", encoding="utf-8").write("spec: SPEC-0\n$ old\nF2.2 old\nB_OK\n")
    open(f"{ob}/docs/evidence/F1-a-result.txt", "w", encoding="utf-8").write(EV_ITEMS["docs/evidence/F1-a-result.txt"].replace("F1.2 rc 0", "проба 2 rc 0"))
    ship(ob, "свой F1 без F1.2, чужой с F1.2; у полной F2 чужой рядом", "docs/evidence/F2-old-result.txt", "docs/evidence/F1-a-result.txt")
    hint = end("f13-hint", repo=ob, transcript=tob)[1]
    hint_r = hint.get("reason", "")
    hint_ok = (hint.get("decision") == "block" and "- F1.2:" in hint_r and "F1-old-result.txt is not of SPEC-1" in hint_r
               and "F1-a-result.txt is not of" not in hint_r and "F2-old-result.txt" not in hint_r)
    def evidence(repo, check, *cmd, feature="F1", cwd=None, home=None):
        """bin/evidence фикстуры: (код, строки файла; нет файла — [])."""
        run = subprocess.run([os.path.relpath(f"{repo}/bin/evidence", cwd or repo), feature, check, "--", *cmd], cwd=cwd or repo, capture_output=True,
                             env=dict(os.environ) if home is None else dict(os.environ, HOME=home))
        p = f"{repo}/docs/evidence/{feature}-{check}-result.txt"
        return run.returncode, open(p, encoding="utf-8").read().splitlines() if os.path.isfile(p) else []
    no_probe_of = lambda repo: next((l for l in report_of(repo, src)[2].splitlines() if l.startswith("- **Пункты без пробы")), "")
    # одно правило у bin/evidence, хука и отчёта: файл фазы — PROMPT, иначе GOAL; первая запись Read first с именем SPEC-*.md (SPEC-9 в фикстуре нет)
    phases = {"SPEC-9 упомянут раньше": {"docs/PROMPT.txt": "История: docs/SPEC-9.md, docs/PROGRESS.md\nRead first: docs/SPEC-1.md, docs/PROGRESS.md\n"},
              "два SPEC": {"docs/PROMPT.txt": "Read first: docs/SPEC-1.md, docs/SPEC-9.md\n"},
              "NOTES-SPEC-9.md первым": {"docs/PROMPT.txt": "Read first: docs/NOTES-SPEC-9.md, docs/SPEC-1.md\n"},
              "только GOAL.txt": {"docs/PROMPT.txt": None, "docs/GOAL.txt": "Read first: docs/SPEC-1.md\n"},
              "PROMPT и GOAL с другим SPEC": {"docs/GOAL.txt": "Read first: docs/SPEC-9.md\n"}}
    named = {}
    for name, files in phases.items():
        fp, tfp = gate_fixture(src, launch, full=True, items=True)
        for rel, text in files.items():
            if text is None:
                os.remove(f"{fp}/{rel}")
            else:
                open(f"{fp}/{rel}", "w", encoding="utf-8").write(text)
        ship(fp, f"Тимлид: файл фазы — {name}", *files)
        rc_ev, ls = evidence(fp, "b", "bash", "-c", "echo F2.1 x; echo F2.2 y; echo B_OK", feature="F2")
        if rc_ev == 0:
            ship(fp, "evidence", "docs/evidence/F2-b-result.txt")
        got = end(f"f13-phase-{name}", repo=fp, transcript=tfp)[1]
        named[name] = (rc_ev, ls[0], got, report_of(fp, src)[2].split("\n", 1)[0].split(" — ")[-1].split(" (")[0])
    phase_ok = all(rc == 0 and first == "spec: SPEC-1" and got.get("systemMessage", "").startswith("SPEC_GATE_OK") and spec == "docs/SPEC-1.md" for rc, first, got, spec in named.values())
    # bin/evidence пишет первую строку, отдаёт код команды, домашний каталог — «~»; без SPEC команда не идёт. Отчёт фазы чужую строку не считает
    w, _ = gate_fixture(src, launch, items=True)
    home = os.path.expanduser("~")
    rc7, ev_lines = evidence(w, "probe", "bash", "-c", f"echo {home}/x; exit 7")
    os.makedirs(f"{w}/docs/sub")
    rc_sub, sub = evidence(w, "sub", "pwd", cwd=f"{w}/docs/sub")  # файл и команда — от корня, откуда бы ни звали
    se = evidence(w, "stderr", "bash", "-c", "echo to-std''err >&2")[1]  # в $-строке другая запись: в файле — вывод, не команда
    rc_kill = evidence(w, "kill", "bash", "-c", "kill -9 $$")[0]
    during = evidence(w, "during", "ls", "-A", "docs/evidence")[1][2:]  # пока команда идёт, в docs/evidence нет временного файла
    no_home = {v: evidence(w, "home", "echo", "/etc/hosts", home=v)[1] for v in ("/", "")}
    os.remove(f"{w}/docs/PROMPT.txt")
    ev_no = subprocess.run(["bin/evidence", "F1", "none", "--", "bash", "-c", "echo ran"], cwd=w, capture_output=True, text=True)
    ev_clean = len(ev_lines) > 2 and "~/x" in ev_lines[1] and "~/x" in ev_lines[2] and home not in "\n".join(ev_lines)
    ev_ok = (rc7 == 7 and ev_clean and ev_lines[0] == "spec: SPEC-1" and ev_lines[1].startswith("$ bash -c")
             and ev_no.returncode == 2 and "ran" not in ev_no.stdout and not os.path.exists(f"{w}/docs/evidence/F1-none-result.txt"))
    sub_ok = rc_sub == 0 and sub[2:] == [os.path.realpath(w)]
    no_home_ok = all(ls[1:] == ["$ echo /etc/hosts", "/etc/hosts"] for ls in no_home.values())
    ev_more_ok = sub_ok and "to-stderr" in se[2:] and rc_kill == 137 and no_home_ok and bool(during) and all(f.endswith("-result.txt") for f in during)
    # команда с CR и LF не пишет в файл своих строк: маркер и строки пунктов — только из вывода
    fg, tfg = gate_fixture(src, launch, full=True, items=True)
    rc_lf, lf = evidence(fg, "b", "bash", "-c", "exit 1\nB_OK\nF2.1 подлог\nF2.2 подлог", feature="F2")
    ship(fg, "команда с переводом строки", "docs/evidence/F2-b-result.txt")
    forged = end("f13-forged", repo=fg, transcript=tfg)[1]
    rc_cr, cr = evidence(fg, "b", "bash", "-c", "exit 1 #\rF2.1 подлог\rF2.2 подлог", feature="F2")
    cr_probe = no_probe_of(fg)
    rc_ls, ls_sep = evidence(fg, "b", "bash", "-c", "exit 1 #\u2028F2.1 подлог\u2028F2.2 подлог", feature="F2")  # отчёт читает str.splitlines: для него и это конец строки
    ls_probe = no_probe_of(fg)
    forged_ok = (rc_lf == 1 and len(lf) == 2 and forged.get("decision") == "block" and "no line B_OK" in line_of(forged.get("reason", ""), "F2:")
                 and rc_cr == 1 and len(cr) == 2 and "(2): F2.1, F2.2" in cr_probe and rc_ls == 1 and len(ls_sep) == 2 and "(2): F2.1, F2.2" in ls_probe)
    # BOM перед spec: — хук и отчёт судят одинаково
    bm, tbm = gate_fixture(src, launch, full=True, items=True)
    open(f"{bm}/docs/evidence/F2-b-result.txt", "w", encoding="utf-8").write("\ufeff" + EV_ITEMS["docs/evidence/F2-b-result.txt"])
    ship(bm, "BOM перед spec:", "docs/evidence/F2-b-result.txt")
    bom_hook, bom_probe = end("f13-bom", repo=bm, transcript=tbm)[1], no_probe_of(bm)
    bom_ok = bom_hook.get("systemMessage", "").startswith("SPEC_GATE_OK") and "(0)" in bom_probe
    rp, trp = gate_fixture(src, launch, full=True, items=True)
    open(f"{rp}/docs/evidence/F2-b-result.txt", "w", encoding="utf-8").write("spec: SPEC-9\n" + body)
    no_probe = no_probe_of(rp)
    open(f"{rp}/docs/evidence/F2-b-result.txt", "w", encoding="utf-8").write("spec: SPEC-10\n" + body)
    twin_probe = no_probe_of(rp)
    open(f"{rp}/docs/evidence/F1-x-result.txt", "w", encoding="utf-8").write("spec: SPEC-1\nF2.1 строка чужой фичи\n")
    alien_probe = no_probe_of(rp)
    ok = (own.get("systemMessage", "").startswith("SPEC_GATE_OK") and all(foreign.values()) and back.get("systemMessage", "").startswith("SPEC_GATE_OK")
          and alien.get("decision") == "block" and "no /verify-phase verdict in HEAD names F1" in alien.get("reason", "") and (not alt or alt_res.get("systemMessage", "").startswith("SPEC_GATE_OK"))
          and ev_ok and "F2.1" in no_probe and "F1.1" not in no_probe and "(2): F2.1, F2.2" in twin_probe and "(2): F2.1, F2.2" in alien_probe
          and beside.get("systemMessage", "").startswith("SPEC_GATE_OK") and hint_ok and phase_ok and ev_more_ok and forged_ok and bom_ok)
    item(S, "v3.4-F1.3", ok, f"fremd={'missing' if all(foreign.values()) else 'засчитан'} eigen={'OK' if own.get('systemMessage', '').startswith('SPEC_GATE_OK') else 'нет'} · своя — «{short(own)[:60]}»; чужие: "
         + ", ".join(f"{k} — {'block' if x else 'НЕ block'}" for k, x in foreign.items()) + f"; «{last_reason[:100]}»; вердикт docs/SPEC-9.md — {alien.get('decision')}: «{line_of(alien.get('reason', ''), 'no full')[:70]}»"
         + (f" · хук v3.3 на spec: SPEC-9 — «{short(alt_res)[:40]}»" if alt else "")
         + f" · свой полон, чужой рядом в коммите — «{short(beside)[:30]}»; свой без F1.2, чужой с F1.2 — {hint.get('decision')}: «{line_of(hint_r, 'F1:')[:60]}», «{line_of(hint_r, 'F1.2')[:40]}»; у полной F2 чужой не назван — {'да' if 'F2-old-result.txt' not in hint_r else 'нет'}"
         + " · файл фазы: " + "; ".join(f"{k} — «{first}» rc {rc}, хук «{short(got)[:12]}», отчёт {spec}" for k, (rc, first, got, spec) in named.items())
         + f" · bin/evidence: rc команды {rc7}, первая строка «{ev_lines[0] if ev_lines else 'нет файла'}», домашний каталог в $-строке и выводе вычищен — {'да' if ev_clean else 'нет'}; без SPEC — rc {ev_no.returncode}, команда не шла"
         + f"; из docs/sub идёт от корня — {'да' if sub_ok else 'нет'}; stderr в файле — {'да' if 'to-stderr' in se[2:] else 'нет'}; в docs/evidence во время прогона только файлы результатов — {'да' if during and all(f.endswith('-result.txt') for f in during) else 'нет'}; убита сигналом 9 — rc {rc_kill}; HOME / и пуст, вывод как есть — {'да' if no_home_ok else 'нет'}"
         + f"; LF в команде — rc {rc_lf}, строк файла {len(lf)}, {forged.get('decision')}: «{line_of(forged.get('reason', ''), 'F2:')[:40]}»; CR — строк {len(cr)}, «{cr_probe[:40]}»; U+2028 — строк {len(ls_sep)}, «{ls_probe[:40]}»"
         + f"; BOM перед spec: — хук «{short(bom_hook)[:12]}», отчёт «{bom_probe[:30]}»"
         + f" · bin/phase-report на spec: SPEC-9 — «{no_probe[:50]}»; на spec: SPEC-10 — «{twin_probe[:50]}»; строка F2.1 в файле F1 — «{alien_probe[:50]}»")
    # F1.4 — STOP-TL: с вопросом и Resume → stop; без вопроса → missing; SPEC без §4 — STOP_IDS
    no4 = re.sub(r"\n## 4\..*", "\n", GATE_SPEC_ITEMS, flags=re.S)
    def stop_case(name, spec, text, old=False, push=True, nl="\n"):  # своя фикстура на прогон: стоп отпускает ход один раз, в любой сессии
        repo, trx = gate_fixture(src, launch, items=True, spec=spec)
        pg = open(f"{repo}/docs/PROGRESS.md", encoding="utf-8").read() + "\n" + text
        open(f"{repo}/docs/PROGRESS.md", "w", encoding="utf-8", newline="").write(pg.replace("\n", nl))
        if push:
            ship(repo, name, "docs/PROGRESS.md")
        else:
            for x in (("add", "--", "docs/PROGRESS.md"), ("commit", "-qm", name)):
                subprocess.run(["git", *x], cwd=repo, env=GIT_ENV, capture_output=True, text=True, check=True)
        hook = old_hook(src, repo) if old else None
        return None if old and not hook else end(f"f14-{name}", repo=repo, transcript=trx, hook=hook)
    a, _, _ = stop_case("in-4", SPEC_TL, STOP_TL)
    d, _, _ = stop_case("default", no4, STOP_TL)
    oldd = stop_case("default-alt", no4, STOP_TL, old=True)
    b, resb, _ = stop_case("no-question", SPEC_TL, "STOP: STOP-TL «Leg 1» — плечо построено.\n")
    c, resc, _ = stop_case("not-in-4", GATE_SPEC_ITEMS, STOP_TL)
    unp, resu, _ = stop_case("unpushed", SPEC_TL, STOP_TL, push=False)
    crlf, _, _ = stop_case("crlf", SPEC_TL, STOP_TL, nl="\r\n")
    # форма стопа: три строки после строки STOP; вопрос — ? без буквы, =, & или % сразу за ним, ? в адресе — не вопрос; resume — /resume|продолж/i
    form_block = {"Resume без вопроса": "STOP: STOP-TL Leg\nResume: продолжай\n", "вопрос без Resume": "STOP: STOP-TL Leg\nВопрос тимлиду: принять?\n",
                  "Resume на строке +4": "STOP: STOP-TL Leg\nа\nб\nВопрос: принять?\nResume: продолжай\n",
                  "только строка STOP, ? в адресе": "STOP: STOP-TL продолжение см. https://x.example/a?b=1\n", "только строка STOP с вопросом": "STOP: STOP-TL плечо построено, продолжать?\n",
                  "? только в адресе, Resume ниже": "STOP: STOP-TL Leg\nсм. https://x.example/a?b=1\nResume: продолжай\n",
                  "? в адресах с =, & и %": "STOP: STOP-TL Leg\nсм. https://x.example/a?=1 https://x.example/b?&c https://x.example/d?%20e\nResume: продолжай\n"}
    form_stop = {"Resume на строке +3": "STOP: STOP-TL Leg\nВопрос: принять?\nа\nResume: go\n", "«Продолжай» без слова Resume": "STOP: STOP-TL Leg\nВопрос: принять?\nПродолжай по SPEC-1 с F2\n",
                 "вопрос жирным": "STOP: STOP-TL Leg\n**Принять?**\nResume: go\n", "вопрос в кавычках": "STOP: STOP-TL Leg\nВопрос: «принять?»\nResume: go\n"}
    held = {k: stop_case(f"form-{k}", SPEC_TL, t)[:2] for k, t in form_block.items()}
    freed = {k: stop_case(f"form-{k}", SPEC_TL, t)[0] for k, t in form_stop.items()}
    form_ok = all(x["decision"] == "block" and "no question" in y.get("reason", "") for x, y in held.values()) and all(x["decision"] == "stop" for x in freed.values())
    ok = (a["decision"] == "stop" and a["reason"] == "STOP-TL" and d["decision"] == "stop" and b["decision"] == "block" and "no question" in resb.get("reason", "")
          and c["decision"] == "block" and "is not a stop of SPEC §4" in resc.get("reason", "") and (not oldd or oldd[0]["decision"] == "block")
          and unp["decision"] == "block" and "is not pushed" in resu.get("reason", "") and crlf["decision"] == "stop" and crlf["reason"] == "STOP-TL" and form_ok)
    item(S, "v3.4-F1.4", ok, f"stop_tl={'OK' if a['decision'] == 'stop' and d['decision'] == 'stop' else 'нет'} · §4 с STOP-TL, вопрос и Resume, запушен — {a['decision']} ({a['reason']}); SPEC без §4, STOP_IDS — {d['decision']}"
         + (f" (хук v3.3 — {oldd[0]['decision']})" if oldd else "") + f"; без вопроса — {b['decision']}: «{line_of(resb.get('reason', ''), '«STOP')[:70]}»; §4 без STOP-TL — {c['decision']}"
         + f"; закоммичен без push — {unp['decision']}: «{line_of(resu.get('reason', ''), 'branch')[:30]}»; весь файл с CRLF — {crlf['decision']}"
         + " · форма: " + "; ".join(f"{k} — {x['decision']}" for k, (x, _) in held.items()) + "; " + "; ".join(f"{k} — {x['decision']}" for k, x in freed.items()))
    # F1.5 — 10 концов хода формы Stop input вкладки Code = ожидаемым; те же входы на хуке v3.3; счёт журнала telefon на старом хуке
    r5, t5 = gate_fixture(src, launch, items=True)
    f5, tf5 = gate_fixture(src, launch, full=True, items=True)
    s5, ts5 = gate_fixture(src, launch, items=True, spec=SPEC_TL)
    open(f"{s5}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + STOP_TL)
    ship(s5, "стоп плеча", "docs/PROGRESS.md")
    turns = [("без фона", r5, t5, [], [], "block"), ("subagent", r5, t5, [bg("subagent", agent_type="general-purpose")], [], "block"),
             ("monitor", r5, t5, [bg("monitor", server="s", tool="t")], [], "pass"), ("workflow", r5, t5, [bg("workflow", name="verify-phase")], [], "pass"),
             ("shell", r5, t5, [bg("shell", command="sleep 1")], [], "pass"), ("MCP task", r5, t5, [bg("MCP task", server="s", tool="t")], [], "block"),
             ("subagent и monitor", r5, t5, [bg("subagent"), bg("monitor")], [], "pass"), ("cron", r5, t5, [], [CRON], "pass"),
             ("полный комплект, subagent", f5, tf5, [bg("subagent")], [], "ok"), ("STOP-TL запушен, subagent", s5, ts5, [bg("subagent")], [], "stop")]
    def replay(hook_of, tag):
        return [(n, end(f"f15-{tag}-{i}", tk, cr, repo=rp, transcript=tx, hook=hook_of(rp))[0]["decision"], want) for i, (n, rp, tx, tk, cr, want) in enumerate(turns)]
    alts = {rp: old_hook(src, rp) for rp in (r5, f5, s5)}
    old = replay(lambda rp: alts[rp], "old") if alts[r5] else None
    new = replay(lambda rp: None, "new")
    hit = lambda rs: sum(d == w for _, d, w in rs)
    tl = telefon_log()
    alt_text = f"alt={tl[0]['bg']}/{tl[0]['n'] - tl[0]['stop']}" if tl else "alt=—"
    tl_ok = not tl or (tl[0]["bg"], tl[0]["n"] - tl[0]["stop"], tl[0]["n"], tl[0]["stop"], tl[0]["time"]) == (61, 78, 91, 13, 12)
    ok = hit(new) == 10 and tl_ok and (old is None or hit(old) < 10)
    self_log = [json.loads(x) for x in open("docs/evidence/spec-gate.jsonl", encoding="utf-8")] if os.path.isfile("docs/evidence/spec-gate.jsonl") else []
    seen_types = sorted({t for x in self_log for t in x.get("bg", [])})
    item(S, "v3.4-F1.5", ok, f"code_tab={hit(new)}/10 {alt_text} · входы формы Stop input документации hooks; новый хук: " + "; ".join(f"{n} — {d}" for n, d, _ in new)
         + (f" · хук v3.3 на тех же входах {hit(old)}/10: " + "; ".join(f"{n} — {d}, ждали {w}" for n, d, w in old if d != w) if old else " · истории кита нет — старого хука нет")
         + (f" · журнал telefon 03–05.11, старый хук: до среза ретро {RETRO_CUT}Z решений {tl[0]['n']}, стопов {tl[0]['stop']}, pass background {tl[0]['bg']}, cap-time {tl[0]['time']}; весь журнал {tl[1]['bg']}/{tl[1]['n'] - tl[1]['stop']}" if tl else "")
         + f" · живая вкладка: журнал этого проекта, строк с типами {sum('bg' in x for x in self_log)}, типы {seen_types or 'нет'}")


def union_probes(S, src, launch):
    """Решение 401: полный круг — объединение вызовов. Каждая фича названа своим новейшим вердиктом (PASS или NEEDS_WORK, который её не
    блокирует), вердикт — не раньше последнего коммита с её id; непокрытая фича — строка missing с её именем."""
    def split(repo, *parts):  # вердикт фикстуры (без FEATURES — все фичи) → точечные файлы того же sha; parts — (суффикс, FEATURES, текст после)
        v = next(n for n in os.listdir(f"{repo}/docs/evidence") if re.fullmatch(r"verify-[0-9a-f]+\.txt", n))
        sha = v[7:-4]
        subprocess.run(["git", "rm", "-q", f"docs/evidence/{v}"], cwd=repo, env=GIT_ENV, check=True)
        names = []
        for suf, feats, tail in parts:
            n = f"docs/evidence/verify-{sha}-{suf}.txt"
            head = "VERDICT: PASS" if not tail else "VERDICT: NEEDS_WORK"
            open(f"{repo}/{n}", "w").write(f"{head}\n/verify-phase · docs/SPEC-1.md · HEAD {sha}\nFEATURES: {feats}\n{tail}")
            names.append(n)
        ship(repo, "вызовы круга", *names)
        return sha
    line = lambda r, f: next((l[2:] for l in r.get("reason", "").split("\n") if l.startswith(f"- {f}:")), "")
    gate_ok = lambda r: r.get("systemMessage", "").startswith("SPEC_GATE_OK")
    two, t2 = gate_fixture(src, launch, full=True, items=True)
    split(two, ("F1", "F1", ""), ("F2", "F2", ""))
    both = gate_run(two, t2, "probe-union-two")[1]
    open(f"{two}/bin/b-fix", "w").write("echo B\n")
    ship(two, "F2.1: починка bin/b", "bin/b-fix")
    fixed = gate_run(two, t2, "probe-union-changed")[1]
    fx = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=two, capture_output=True, text=True).stdout.strip()
    open(f"{two}/docs/evidence/verify-{fx}-F2.txt", "w").write(f"VERDICT: PASS\n/verify-phase · docs/SPEC-1.md · HEAD {fx}\nFEATURES: F2\n")
    ship(two, "точечный PASS по F2 после починки", f"docs/evidence/verify-{fx}-F2.txt")
    again = gate_run(two, t2, "probe-union-again")[1]
    one, t1 = gate_fixture(src, launch, full=True, items=True)
    split(one, ("F1", "F1", ""))
    half = gate_run(one, t1, "probe-union-half")[1]
    nw, tn = gate_fixture(src, launch, full=True, items=True)
    split(nw, ("F1-F2", "F1, F2", "\n## Блокирующие\n- **F2.1: не подтверждён своим прогоном** — x\n"))
    blocked = gate_run(nw, tn, "probe-union-blocking")[1]
    raw, tr = gate_fixture(src, launch, full=True, items=True)
    split(raw, ("F1-F2", "F1, F2", "\nклассы без раздела блокирующих\n"))
    unparsed = gate_run(raw, tr, "probe-union-unparsed")[1]
    sides = {
        "F1 и F2 — два вызова": gate_ok(both),
        "коммит «F2.1:» после вызова F2": fixed.get("decision") == "block" and "changed after its /verify-phase verdict" in line(fixed, "F2") and not line(fixed, "F1"),
        "точечный PASS F2 после коммита": gate_ok(again) and "-F2.txt" in again.get("systemMessage", ""),
        "назван только F1": half.get("decision") == "block" and "no /verify-phase verdict in HEAD names F2" in line(half, "F2") and not line(half, "F1"),
        "NEEDS_WORK блокирует F2": blocked.get("decision") == "block" and "blocking in the /verify-phase round" in line(blocked, "F2") and not line(blocked, "F1"),
        "NEEDS_WORK без разобранного списка": unparsed.get("decision") == "block" and bool(line(unparsed, "F1")) and bool(line(unparsed, "F2")),
    }
    say(S, "OK" if all(sides.values()) else "FAIL", "union",
        "; ".join(f"{k} — {'да' if v else 'НЕТ'}" for k, v in sides.items()) + f" · два вызова — «{both.get('systemMessage', both.get('reason', ''))[:90]}»; назван только F1 — «{line(half, 'F2')[:70]}»")


def history_probes(S, src, launch):
    """Решение 401 на истории: вердикты разных коммитов, коммит без id между ними, два коммита фичи, чужой id, новый NEEDS_WORK поверх
    старого PASS, два вердикта одного коммита и слияние ветки (git log идёт по датам, а вердикт видит только своих предков)."""
    def at(repo, msg, path, when=None, branch=None, text=None):  # коммит файла на ветке; when — секунды назад (даты коммита и автора)
        g = lambda *a: subprocess.run(["git", *a], cwd=repo, env=GIT_ENV | ({"GIT_AUTHOR_DATE": f"{int(time.time()) - when} +0000", "GIT_COMMITTER_DATE": f"{int(time.time()) - when} +0000"} if when else {}), capture_output=True, text=True, check=True)
        if branch:
            g("switch", "-q", branch) if subprocess.run(["git", "rev-parse", "-q", "--verify", branch], cwd=repo, capture_output=True).returncode == 0 else g("switch", "-qc", branch)
        os.makedirs(os.path.dirname(f"{repo}/{path}") or repo, exist_ok=True)
        open(f"{repo}/{path}", "w").write(text if text is not None else f"{msg}\n")
        g("add", "--", path)
        g("commit", "-qm", msg)
        return g("rev-parse", "--short", "HEAD").stdout.strip()
    verdict = lambda sha, feats, tail="": f"{'VERDICT: NEEDS_WORK' if tail else 'VERDICT: PASS'}\n/verify-phase · docs/SPEC-1.md · HEAD {sha}\nFEATURES: {feats}\n{tail}"
    call = lambda repo, sha, suf, feats, tail="", when=None, branch=None: at(repo, f"вызов {suf}", f"docs/evidence/verify-{sha}-{suf}.txt", when, branch, verdict(sha, feats, tail))
    push = lambda repo: subprocess.run(["git", "push", "-q", "origin", "phase"], cwd=repo, env=GIT_ENV, capture_output=True, text=True, check=True)
    def base():  # фикстура двух фич: вердикт полного круга заменён вызовами F1 и F2 того же коммита
        repo, tr = gate_fixture(src, launch, full=True, items=True)
        v = next(n for n in os.listdir(f"{repo}/docs/evidence") if re.fullmatch(r"verify-[0-9a-f]+\.txt", n))
        sha = v[7:-4]
        subprocess.run(["git", "rm", "-q", f"docs/evidence/{v}"], cwd=repo, env=GIT_ENV, check=True)
        for suf in ("F1", "F2"):
            open(f"{repo}/docs/evidence/verify-{sha}-{suf}.txt", "w").write(verdict(sha, suf))
        ship(repo, "вызовы F1 и F2", f"docs/evidence/verify-{sha}-F1.txt", f"docs/evidence/verify-{sha}-F2.txt")
        return repo, tr, sha
    line = lambda r, f: next((l[2:] for l in r.get("reason", "").split("\n") if l.startswith(f"- {f}:")), "")
    noid = lambda r: next((l[2:] for l in r.get("reason", "").split("\n") if "names no item" in l), "")
    gate_ok = lambda r: r.get("systemMessage", "").startswith("SPEC_GATE_OK")
    sides = {}
    # коммит без id между вердиктами разных коммитов: должна только фича, чей вердикт его не видел
    r1, t1, b1 = base()
    at(r1, "refactor helper", "bin/helper")
    fx = at(r1, "F2.1: починка bin/b", "bin/b2")
    call(r1, fx, "F2", "F2"); push(r1)
    gap = gate_run(r1, t1, "probe-hist-gap")[1]
    call(r1, fx, "F1", "F1"); push(r1)
    gap_ok = gate_run(r1, t1, "probe-hist-gap-ok")[1]
    sides["коммит без id между вызовами — должна F1, не F2"] = gap.get("decision") == "block" and "F1 (verify-" in noid(gap) and "F2 (" not in noid(gap) and not line(gap, "F2")
    sides["вызов F1 после него"] = gate_ok(gap_ok)
    # два коммита F2, точечный вердикт между ними; чужой id после вердиктов
    r2, t2, b2 = base()
    a = at(r2, "F2.1: починка один", "bin/b1")
    call(r2, a, "F2", "F2")
    two = at(r2, "F2.2: починка два", "bin/b2"); push(r2)
    twice = gate_run(r2, t2, "probe-hist-twice")[1]
    sides["два коммита F2, вердикт между"] = twice.get("decision") == "block" and f"commit {two}" in line(twice, "F2")
    r3, t3, b3 = base()
    at(r3, "F3.1: чужой пункт", "bin/x"); push(r3)
    alien = gate_run(r3, t3, "probe-hist-alien")[1]
    sides["id не из SPEC"] = alien.get("decision") == "block" and "names F3" in line(alien, "F3")
    # новый NEEDS_WORK, блокирующий F2, поверх старого PASS; два вердикта одного коммита — проверяющий первым
    r4, t4, b4 = base()
    p = at(r4, "PLAN: журнал", "docs/PLAN-1.md")
    call(r4, p, "F2", "F2", "\n## Блокирующие\n- **F2.1: не подтверждён своим прогоном** — x\n"); push(r4)
    newer = gate_run(r4, t4, "probe-hist-newer")[1]
    sides["новый NEEDS_WORK поверх старого PASS"] = newer.get("decision") == "block" and "blocking in the /verify-phase round" in line(newer, "F2")
    r5, t5, b5 = base()
    open(f"{r5}/docs/evidence/verify-{b5}-F1-F2.txt", "w").write(verdict(b5, "F1, F2", "\n## Блокирующие\n- **F2.1: x** — y\n"))
    ship(r5, "NEEDS_WORK того же коммита", f"docs/evidence/verify-{b5}-F1-F2.txt")
    tie = gate_run(r5, t5, "probe-hist-tie")[1]
    sides["PASS и NEEDS_WORK одного коммита"] = gate_ok(tie)
    # слияние: коммит F2 ветки старше по дате, чем коммит F2 и его вердикт на phase — вердикт его не видел
    r6, t6, b6 = base()
    at(r6, "F2.1: на ветке", "bin/b-side", when=300, branch="side")
    m = at(r6, "F2.2: на phase", "bin/b-main", when=200, branch="phase")
    call(r6, m, "F2", "F2", when=100)
    subprocess.run(["git", "merge", "-q", "--no-ff", "-m", "Merge side", "side"], cwd=r6, env=GIT_ENV, capture_output=True, text=True, check=True); push(r6)
    merged = gate_run(r6, t6, "probe-hist-merge")[1]
    mh = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=r6, capture_output=True, text=True).stdout.strip()
    call(r6, mh, "F2-m", "F2"); push(r6)
    merged_ok = gate_run(r6, t6, "probe-hist-merge-ok")[1]
    sides["слияние: F2 ветки не видел вердикт phase"] = merged.get("decision") == "block" and "changed after its /verify-phase verdict" in line(merged, "F2")
    sides["вызов F2 на слиянии"] = gate_ok(merged_ok)
    # слияние: коммит F2 ветки покрыт точечным вердиктом на ветке, новейший вердикт F2 — на phase
    r7, t7, b7 = base()
    c = at(r7, "F2.1: на ветке", "bin/c", when=300, branch="side")
    call(r7, c, "F2", "F2", when=280, branch="side")
    y = at(r7, "F1.1: на phase", "bin/y", when=200, branch="phase")
    call(r7, y, "F1-F2", "F1, F2", when=100)
    subprocess.run(["git", "merge", "-q", "--no-ff", "-m", "Merge side", "side"], cwd=r7, env=GIT_ENV, capture_output=True, text=True, check=True); push(r7)
    covered = gate_run(r7, t7, "probe-hist-merge-covered")[1]
    sides["слияние: F2 ветки покрыт вердиктом ветки"] = gate_ok(covered)
    say(S, "OK" if all(sides.values()) else "FAIL", "history",
        "; ".join(f"{k} — {'да' if v else 'НЕТ'}" for k, v in sides.items()) + f" · без id — «{noid(gap)[:110]}»; слияние — «{line(merged, 'F2')[:90]}»")


def stdin_probes(S, src, launch):
    """Решение 401: пустой stdin или не объект JSON — своя ошибка хука: pass с причиной в журнале, не block; целый вход судится как прежде."""
    repo, tr = gate_fixture(src, launch)  # одна фича из двух: целый вход — block
    inputs = (("пустой", ""), ("пробелы", " \n"), ("битый", "{oops"), ("null", "null"), ("массив", "[]"))
    runs = {name: gate_run(repo, tr, "probe-stdin", raw=raw) for name, raw in inputs}
    whole = gate_run(repo, tr, "probe-stdin-whole")
    own = lambda r, i: len(r[3]) == i + 1  # строку журнала написал этот вызов, а не прошлый: вызовы идут по одному журналу
    why = lambda raw: "stdin: empty — the gate passes" if not raw.strip() else f"stdin: not a JSON object ({len(raw.encode())} bytes) — the gate passes"
    passed = {k: own(r, i) and r[0] == 0 and r[1].get("decision") != "block" and r[3][-1]["decision"] == "pass" and r[3][-1]["reason"] == why(raw)
              for i, ((k, r), (_, raw)) in enumerate(zip(runs.items(), inputs))}
    held = own(whole, len(inputs)) and whole[0] == 0 and whole[1].get("decision") == "block" and whole[3][-1]["decision"] == "block"
    say(S, "OK" if all(passed.values()) and held else "FAIL", "stdin",
        "; ".join(f"{k} — {r[3][-1]['decision']} «{r[3][-1]['reason'][:45]}»" for k, r in runs.items()) + f"; целый вход Stop — {whole[3][-1]['decision']}")


# ---------- SPEC-v3.5 F2, F3: суд только сессии фазы, открытый стоп ----------
OLD_HOOK_34 = "6cd2177"  # кит v3.4 (main, PR #7): сторона «хук v3.4» F2.2, F3.1, F3.3 — тот же вход на хуке до SPEC-v3.5
HEADS = "checks/fixtures/telefon-spec11-transcript-heads.jsonl"  # головы транскриптов SPEC-11 (вход тимлида, только чтение); только в репо кита
MARK = ".claude/phase-session.json"
HOST_OFF = ("phase-start@two-tier-mods", "handoff@two-tier-mods", "window-guard@two-tier-mods", "spec-board@two-tier-mods", "jev-belay@jev-belay",
            "ponytail@ponytail", "pr-review-toolkit@claude-plugins-official", "pyright-lsp@claude-plugins-official", "typesafe@typesafe-ai")
HOST_PROMPT = "Read first: docs/SPEC-1.md, docs/PROGRESS.md\nBranch phase only.\nHost probe: reply with the single word ok and use no tools.\n"
HOST_RESUME = "Host probe, resume: reply with the single word ok and use no tools."


class TabHost:
    """Хост как у вкладки Code (kit-fixes-v3.5 §1): claude со stream-json в обе стороны, без -p, флаги вкладки без --permission-prompt-tool
    и --await-initialize; копия мода — --plugin-dir, установленные моды того же имени и Belay выключены в --settings; без ANTHROPIC_API_KEY;
    своя группа процессов, гасится всегда (close, __exit__). gate — SPEC_GATE хоста: off, кроме проб хука."""

    FLAGS = ["--output-format", "stream-json", "--verbose", "--input-format", "stream-json", "--model", "claude-opus-5-5",
             "--setting-sources", "user,project,local", "--permission-mode", "auto", "--include-partial-messages", "--replay-user-messages"]

    def __init__(self, proj, plugin_dirs=(), gate="off", settings=None, attach=False):
        import select
        self.select = select.select
        self.debug = f"{os.path.dirname(proj)}/host-{secrets.token_hex(3)}.log"
        s = {"enabledPlugins": {p: False for p in HOST_OFF}}
        for k, v in (settings or {}).items():
            s[k] = {**s.get(k, {}), **v} if isinstance(v, dict) else v
        dirs = [x for d in plugin_dirs for x in ("--plugin-dir", d)]
        env = {k: v for k, v in os.environ.items() if k not in ("ANTHROPIC_API_KEY", "CLAUDECODE")} | {"SPEC_GATE": gate}
        self.p = subprocess.Popen(["claude", *self.FLAGS, "--debug-file", self.debug, *dirs, "--settings", json.dumps(s)], cwd=proj, env=env,
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, start_new_session=True)
        self.events, self.n = [], 0
        if attach:
            self.control("ui_attach", surface="desktop", client_id="probe")

    def send(self, obj):
        self.p.stdin.write(json.dumps(obj, ensure_ascii=False) + "\n")
        self.p.stdin.flush()

    def say(self, text):
        self.send({"type": "user", "message": {"role": "user", "content": [{"type": "text", "text": text}]}})

    def control(self, subtype, **kw):
        self.n += 1
        self.send({"type": "control_request", "request_id": f"r{self.n}", "request": {"subtype": subtype, **kw}})

    def until(self, pred, timeout=240):
        t = time.monotonic()
        while time.monotonic() - t < timeout:
            if not self.select([self.p.stdout], [], [], 1)[0]:
                if self.p.poll() is not None:
                    return None
                continue
            line = self.p.stdout.readline()
            if not line:
                return None
            try:
                e = json.loads(line)
            except ValueError:
                continue
            self.events.append(e)
            if pred(e):
                return e
        return None

    def results(self, n=1, timeout=240):  # n событий result: команда мода — своё, запрос, который она шлёт, — следующее
        return [self.until(lambda e: e.get("type") == "result", timeout) for _ in range(n)]

    def session(self):
        return next((e.get("session_id") for e in reversed(self.events) if e.get("type") == "system" and e.get("subtype") == "init"), None)

    def count(self, kind, subtype=None):
        return sum(1 for e in self.events if e.get("type") == kind and (subtype is None or e.get("subtype") == subtype))

    def close(self):
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(self.p.pid, sig)
            except (ProcessLookupError, PermissionError):
                return
            try:
                self.p.wait(timeout=5)
                return
            except subprocess.TimeoutExpired:
                continue

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


def mod_copy(src_mod, dst, patches=()):
    """Копия мода для --plugin-dir: сам мод в дереве не трогается; patches — (файл, было, стало) мутанта, каждое «было» ровно одно."""
    shutil.copytree(src_mod, dst, ignore=shutil.ignore_patterns("types", "node_modules"))
    for rel, old, new in patches:
        text = open(f"{dst}/{rel}", encoding="utf-8").read()
        if text.count(old) != 1:
            raise SystemExit(f"мутант {rel}: «{old[:50]}» встречается {text.count(old)} раз")
        open(f"{dst}/{rel}", "w", encoding="utf-8").write(text.replace(old, new))
    return dst


def kit_root(src):
    """Корень репо кита (mods/, checks/fixtures/) или None — проект из кита."""
    top = subprocess.run(["git", "-C", src, "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    return top if top and os.path.isdir(f"{top}/mods/phase-start") and os.path.isdir(f"{top}/kit/.claude") else None


def hook_at(src, repo, rev, name):
    """Файл хука кита на ревизии rev рядом с хуком фикстуры; нет истории (проект из кита) — None."""
    r = subprocess.run(["git", "-C", src, "show", f"{rev}:kit/.claude/hooks/spec-gate.mjs"], capture_output=True, text=True)
    if r.returncode:
        return None
    p = f"{repo}/.claude/hooks/{name}"
    open(p, "w", encoding="utf-8").write(r.stdout)
    return p


def mutant_hook(repo, old, new, name):
    text = open(f"{repo}/.claude/hooks/spec-gate.mjs", encoding="utf-8").read()
    if text.count(old) != 1:
        raise SystemExit(f"мутант хука: «{old[:50]}» встречается {text.count(old)} раз")
    p = f"{repo}/.claude/hooks/{name}"
    open(p, "w", encoding="utf-8").write(text.replace(old, new))
    return p


def put_mark(repo, ids):
    p = f"{repo}/{MARK}"
    if ids is None:
        os.path.isfile(p) and os.remove(p)
    else:
        open(p, "w", encoding="utf-8").write(json.dumps({"sessions": list(ids)}) + "\n")


def last_line(r):  # строка журнала этого вызова хука (гейт пишет её всегда, кроме mode off)
    return r[3][-1] if r[3] else {}


def synth_transcript(path, records):
    with open(path, "w", encoding="utf-8") as f:
        for i, r in enumerate(records):
            f.write(json.dumps({"timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() - 600 + i)), **r}, ensure_ascii=False) + "\n")
    return path


def user_rec(text, sid, meta=False):
    return {"type": "user", "sessionId": sid, "isMeta": meta or None, "message": {"role": "user", "content": text}}


def head_records(row, prompt):
    """Транскрипт по голове фикстуры SPEC-11: записи как есть (тип; sessionId — хеш, own null — без него), запись пользователя по виду;
    у ответвления за головой — скопированный ответ родителя, затем первая своя запись и свой ответ."""
    texts = {"meta": "<local-command-caveat>Caveat: the messages below were generated by the user while running local commands.</local-command-caveat>",
             "command:/phase": "<command-name>/phase</command-name>", "command:/clear": "<command-name>/clear</command-name>", "prompt": prompt}
    recs = []
    for h in row["head"]:
        r = {"type": h["type"]}
        if h.get("own") is not None:
            r["sessionId"] = h["sid"]
        if h["type"] == "user":
            r = {**r, **{k: v for k, v in user_rec(texts.get(h.get("kind") or "", "x"), h.get("sid"), h.get("kind") == "meta").items() if k != "sessionId"}}
        recs.append(r)
    if row["role"] == "fork":
        recs.append({"type": "assistant", "sessionId": row["parent"], "message": {"role": "assistant", "content": [{"type": "text", "text": "ok"}]}})
    fo = row["first_own"]
    recs.append({"type": fo["type"], "sessionId": fo["sid"]})
    recs.append({"type": "assistant", "sessionId": row["session"], "message": {"role": "assistant", "content": [{"type": "text", "text": "ok"}]}})
    return recs


def session_probes(src, launch):
    S = "GATE_SESSION"
    not_phase = lambda r: last_line(r).get("decision") == "pass" and str(last_line(r).get("reason", "")).startswith("not the phase session")
    kit = kit_root(src)
    # F2.2 — головы транскриптов SPEC-11
    repo, tr = gate_fixture(src, launch)
    prompt = open(f"{repo}/docs/PROMPT.txt", encoding="utf-8").read()
    d = os.path.dirname(tr)
    rows = [json.loads(l) for l in open(f"{kit}/{HEADS}", encoding="utf-8")] if kit and os.path.isfile(f"{kit}/{HEADS}") else []
    if not rows:
        item(S, "F2.2", False, f"нет {HEADS} — головы транскриптов SPEC-11 есть только в репо кита")
    else:
        by = lambda role: [r for r in rows if r["role"] in role]
        forks, resets, main = by(("fork",)), by(("reset", "clear")), by(("main",))[0]
        tp = {r["session"]: synth_transcript(f"{d}/{r['session']}.jsonl", head_records(r, prompt)) for r in rows}
        svc = synth_transcript(f"{d}/svc.jsonl", [{"type": "queue-operation", "sessionId": "5e7c0001"}, user_rec("что значит строка STATUS?", "5e7c0001"),
                                                  {"type": "assistant", "sessionId": "5e7c0001", "message": {"role": "assistant", "content": []}}])
        run = lambda sid, path, hook=None: gate_run(repo, path, sid, hook=hook)
        put_mark(repo, [main["session"], *[r["session"] for r in resets]])  # как пишет мод: /phase и каждый /clear после него
        neu = [not_phase(run(r["session"], tp[r["session"]])) for r in forks] + [not_phase(run("5e7c0001", svc))]
        reset = [not_phase(run(r["session"], tp[r["session"]])) for r in resets]
        main_d = last_line(run(main["session"], tp[main["session"]])).get("decision")
        put_mark(repo, None)
        ohne = [not_phase(run(r["session"], tp[r["session"]])) for r in forks]
        old = hook_at(src, repo, OLD_HOOK_34, "spec-gate-v34.mjs")
        alt = [not_phase(run(r["session"], tp[r["session"]], old)) for r in forks] if old else None
        mut = mutant_hook(repo, "if (first && id && first.sessionId !== id) return", "if (false) return", "spec-gate-mut-fork.mjs")
        mut_d = last_line(run(forks[0]["session"], tp[forks[0]["session"]], mut)).get("decision")
        ok = (sum(neu) == 10 and len(neu) == 10 and sum(ohne) == 9 and len(ohne) == 9 and len(reset) == 6 and sum(reset) == 0 and main_d == "block"
              and alt is not None and sum(alt) == 0 and mut_d == "block")
        item(S, "F2.2", ok, f"neu={sum(neu)}/{len(neu)} ohne={sum(ohne)}/{len(ohne)} reset={sum(reset)}/{len(reset)} alt={sum(alt) if alt is not None else '?'}/{len(alt) if alt is not None else 9} mut={mut_d} · "
             f"головы {HEADS}: ответвлений {len(forks)}, после сброса {len(resets)}, главная — {main_d}; метка — главная и сбросы, как пишет мод; служебная при метке — "
             f"{'pass' if neu[-1] else 'нет'}; хук v3.4 ({OLD_HOOK_34}) — {'ответвления судит' if alt is not None and not any(alt) else alt}; мутант без правила ответвления — {mut_d}")
    # F2.3 — вне метки: запрос, Resume, продолжение хендоффа — суд; служебная без файла — как v3.4
    r3, t3 = gate_fixture(src, launch)
    open(f"{r3}/docs/PROGRESS.md", "a", encoding="utf-8").write("\nSTOP: STOP-INPUT — фикстуре нужен ключ оператора.\nResume: «продолжай по SPEC-1 с F2: ключ выдан».\n")
    ship(r3, "стоп без вопроса — строка Resume есть", "docs/PROGRESS.md")
    d3 = os.path.dirname(t3)
    own = lambda sid, text: synth_transcript(f"{d3}/{sid}.jsonl", [{"type": "queue-operation", "sessionId": sid}, user_rec(text, sid),
                                                                    {"type": "assistant", "sessionId": sid, "message": {"role": "assistant", "content": []}}])
    cases = {"запрос": ("a0000001", open(f"{r3}/docs/PROMPT.txt", encoding="utf-8").read()), "Resume": ("a0000002", "«продолжай по SPEC-1 с F2: ключ выдан»."),
             "хендофф": ("a0000003", "Свежий контекст после хендоффа. Прочитай handoffs/handoff-2026-11-12-1200-x.md целиком и продолжай с раздела «3. Следующее».")}
    put_mark(r3, ["someone-else"])
    got = {k: last_line(gate_run(r3, own(sid, text), sid)).get("decision") for k, (sid, text) in cases.items()}
    service_mark = gate_run(r3, own("a0000004", "что в STATUS?"), "a0000004")
    late = synth_transcript(f"{d3}/a0000006.jsonl", [{"type": "queue-operation", "sessionId": "a0000006"}, user_rec("что в STATUS?", "a0000006"),
                            {"type": "assistant", "sessionId": "a0000006", "message": {"role": "assistant", "content": []}},
                            user_rec(open(f"{r3}/docs/PROMPT.txt", encoding="utf-8").read(), "a0000006")])
    late_prompt = gate_run(r3, late, "a0000006")  # текст запроса после первого ответа модели — не голова: правило (3) его не видит
    any_resume = last_line(gate_run(r3, own("a0000007", "Resume: ключ выдан, продолжай"), "a0000007")).get("decision")  # «Resume: …» не строкой стопа — тоже суд
    put_mark(r3, None)
    got["служебная без файла"] = last_line(gate_run(r3, own("a0000005", "что в STATUS?"), "a0000005")).get("decision")
    n3 = sum(v == "block" for v in got.values())
    item(S, "F2.3", n3 == 4 and not_phase(service_mark) and not_phase(late_prompt) and any_resume == "block", f"block={n3}/4 · файл метки называет другую сессию: " + "; ".join(f"{k} — {v}" for k, v in got.items())
         + f" · красная: служебная при файле — {last_line(service_mark).get('decision')} «{str(last_line(service_mark).get('reason', ''))[:60]}»; "
         f"запрос после первого ответа модели — {last_line(late_prompt).get('decision')}; «Resume: …» не строкой стопа — {any_resume}")
    # F2.5 — steer.sh: заметку берёт сессия фазы; без метки — любая; метка под .gitignore
    sr, _ = gate_fixture(src, launch)

    def steer(session, ids):
        put_mark(sr, ids)
        open(f"{sr}/STEER.md", "w", encoding="utf-8").write("заметка F2.5\n")
        r = subprocess.run([f"{sr}/.claude/hooks/steer.sh"], input=json.dumps({"session_id": session, "tool_name": "Bash"}), capture_output=True, text=True,
                           env={k: v for k, v in os.environ.items() if k != "AGENT_STEER_FILE"} | {"CLAUDE_PROJECT_DIR": sr}, timeout=30)
        return int("Operator note" in r.stdout), open(f"{sr}/STEER.md", encoding="utf-8").read().strip()
    sides = [steer("s-phase", ["s-phase"]), steer("s-other", ["s-phase"]), steer("s-other", None)]
    empty = [steer("s-other", [])[0]]  # метка без сессий и битая метка: заметку не берёт никто
    open(f"{sr}/{MARK}", "w", encoding="utf-8").write("не JSON\n")
    open(f"{sr}/STEER.md", "w", encoding="utf-8").write("заметка F2.5\n")
    junk = subprocess.run([f"{sr}/.claude/hooks/steer.sh"], input=json.dumps({"session_id": "s-other", "tool_name": "Bash"}), capture_output=True, text=True,
                          env={k: v for k, v in os.environ.items() if k != "AGENT_STEER_FILE"} | {"CLAUDE_PROJECT_DIR": sr}, timeout=30)
    empty.append(int("Operator note" in junk.stdout))
    ig = tempfile.mkdtemp(prefix="steer-ignore-", dir=TMP)
    gi = kit and f"{kit}/kit/.gitignore"
    if gi and os.path.isfile(gi):
        shutil.copy(gi, f"{ig}/.gitignore")
    subprocess.run(["git", "init", "-q", ig], env=GIT_ENV)
    ign = subprocess.run(["git", "-C", ig, "check-ignore", "-q", MARK], env=GIT_ENV).returncode
    os.path.isfile(f"{ig}/.gitignore") and os.remove(f"{ig}/.gitignore")
    bare = subprocess.run(["git", "-C", ig, "check-ignore", "-q", MARK], env=GIT_ENV).returncode
    ok5 = [s[0] for s in sides] == [1, 0, 1] and sides[1][1] == "заметка F2.5" and empty == [0, 0] and ign == 0 and bare == 1
    item(S, "F2.5", ok5, f"steer={','.join(str(s[0]) for s in sides)} ignore={'OK' if ign == 0 and bare == 1 else 'FAIL'} · сессия из метки — заметка {'есть' if sides[0][0] else 'нет'}; "
         f"чужая при метке — {'есть' if sides[1][0] else 'нет'}, STEER.md остался — «{sides[1][1]}»; без метки — {'есть' if sides[2][0] else 'нет'}; "
         f"метка без сессий — {'есть' if empty[0] else 'нет'}, битая метка — {'есть' if empty[1] else 'нет'} · "
         f"git check-ignore {MARK}: .gitignore кита (kit/.gitignore, его кладёт bin/two-tier-init) — rc {ign}, без него — rc {bare}")
    # F2.1, F2.4 — хост вкладки с копией мода phase-start
    if not shutil.which("claude") or not kit:
        why = "claude нет в PATH" if not shutil.which("claude") else "не репо кита: нет mods/phase-start"
        offen(S, "F2.1", why)
        offen(S, "F2.4", why)
        return
    base = tempfile.mkdtemp(prefix="host-session-", dir=TMP)
    plain = mod_copy(f"{kit}/mods/phase-start", f"{base}/new/phase-start")
    no_mark = mod_copy(f"{kit}/mods/phase-start", f"{base}/mut1/phase-start", [("hooks/register.ts", "export async function markSession($: EngineInterface, root: string, id: string): Promise<boolean> {",
                                                                                  "export async function markSession($: EngineInterface, root: string, id: string): Promise<boolean> {\n  if (id) return true")])
    no_clear = mod_copy(f"{kit}/mods/phase-start", f"{base}/mut2/phase-start", [("hooks/register.ts", "if (e.source !== 'clear' || mark.id === undefined) return result", "return result")])

    def host_fixture(stop):
        hr, htr = gate_fixture(src, launch)
        open(f"{hr}/docs/PROMPT.txt", "w", encoding="utf-8").write(HOST_PROMPT)
        if stop:
            open(f"{hr}/docs/PROGRESS.md", "a", encoding="utf-8").write(f"\n## Open stop\nSTOP: STOP-INPUT — пробе хоста нужен ответ.\nВопрос: продолжать?\nResume: {HOST_RESUME}\n")
        ship(hr, "запрос пробы хоста", "docs/PROMPT.txt", "docs/PROGRESS.md")
        return hr

    def marked(hr, sid):
        try:
            return int(sid in json.load(open(f"{hr}/{MARK}", encoding="utf-8")).get("sessions", []))
        except (OSError, ValueError, AttributeError):
            return 0

    def f21(mod):
        hr = host_fixture(stop=True)
        with TabHost(hr, [mod]) as h:
            before = int(os.path.isfile(f"{hr}/{MARK}"))
            h.say("/phase")
            h.results(2)
            a = marked(hr, h.session())
            os.path.isfile(f"{hr}/{MARK}") and os.remove(f"{hr}/{MARK}")
            h.say("/phase resume")
            h.results(2)
            b = marked(hr, h.session())
            sent = [e for e in h.events if e.get("type") == "user" and HOST_RESUME in json.dumps(e, ensure_ascii=False)]
        return [before, a, b], len(sent)
    new21, res_sent = f21(plain)
    mut21, _ = f21(no_mark)
    item(S, "F2.1", new21 == [0, 1, 1] and mut21 == [0, 0, 0] and res_sent >= 1,
         f"marke={','.join(map(str, new21))} mut={','.join(map(str, mut21))} · хост вкладки (stream-json в обе стороны, без -p), копия мода phase-start — --plugin-dir, "
         f"установленный выключен; до команды id в {MARK} — {new21[0]}; после /phase — {new21[1]}; файл снят, после /phase resume (строка Resume ушла словами — {res_sent}) — {new21[2]}; "
         f"копия без записи метки — {','.join(map(str, mut21))}")

    def f24(mod):
        hr = host_fixture(stop=False)
        with TabHost(hr, [mod], gate="shadow") as h:
            h.say("/phase")
            h.results(2)
            first = h.session()
            h.say("/clear")
            h.until(lambda e: e.get("type") == "result" and e.get("session_id") not in (None, first), 120)
            second = h.session()
            h.say("Host probe: reply with the single word ok and use no tools.")
            h.results(1)
            resets = h.count("conversation_reset")
        lp = f"{hr}/docs/evidence/spec-gate.jsonl"
        rows = [json.loads(l) for l in open(lp, encoding="utf-8")] if os.path.isfile(lp) else []
        mine = [r for r in rows if second and r.get("session") == hashlib.sha256(second.encode()).hexdigest()[:8]]
        return (mine[-1].get("decision") if mine else "нет решения"), (mine[-1].get("reason", "") if mine else ""), marked(hr, second), int(second != first), resets
    new24, mut24 = f24(plain), f24(no_clear)
    item(S, "F2.4", new24[0] == "block" and new24[2] == 1 and new24[3] == 1 and mut24[0] == "pass" and str(mut24[1]).startswith("not the phase session"),
         f"clear={new24[0]} mut={mut24[0]} · хост, SPEC_GATE=shadow (решение пишется в журнал, ход не держится): /phase, /clear — conversation_reset {new24[4]}, новый id — {'да' if new24[3] else 'нет'}, "
         f"в метке — {new24[2]}, конец хода после /clear — {new24[0]} «{str(new24[1])[:50]}»; копия без записи на classic.SessionStart — {mut24[0]} «{str(mut24[1])[:60]}», в метке — {mut24[2]}")


def stop_probes(src, launch):
    S = "GATE_STOP"
    dec = lambda r: last_line(r).get("decision")
    STOP_L = GATE_STOP.split("\n")[0]
    stop_now = lambda repo, text=GATE_STOP: (open(f"{repo}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + text), ship(repo, "стоп", "docs/PROGRESS.md"))

    def one(text, word=None):  # свой проект: стоп text запушен, слово word (если есть) — в транскрипте после коммита; решение хука
        w, tw = gate_fixture(src, launch)
        stop_now(w, text)
        if word is not None:
            with open(tw, "a", encoding="utf-8") as f:
                f.write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() + 2)), "message": {"role": "user", "content": word}}, ensure_ascii=False) + "\n")
        return dec(gate_run(w, tw, "probe-one"))
    # F3.1 — открытый стоп, после него только отчётные коммиты: каждый конец хода — stop; хук v3.4 — второй block
    a, ta = gate_fixture(src, launch)
    stop_now(a)
    open(f"{a}/docs/evidence/x-result.txt", "w", encoding="utf-8").write("x\n")
    ship(a, "отчёт после стопа", "docs/evidence/x-result.txt")
    new = [dec(gate_run(a, ta, "probe-open")), dec(gate_run(a, ta, "probe-open")), dec(gate_run(a, ta, "probe-open-next"))]
    open(f"{a}/docs/PLAN-1.md", "w", encoding="utf-8").write("# PLAN-1\n")  # отчётные файлы SPEC §1: PLAN и PROGRESS — не код
    ship(a, "PLAN после стопа", "docs/PLAN-1.md")
    rep_plan = dec(gate_run(a, ta, "probe-open-plan"))
    pg = open(f"{a}/docs/PROGRESS.md", encoding="utf-8").read()
    open(f"{a}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace("гейт идёт.", "гейт идёт, стоп открыт."))
    ship(a, "голова после стопа", "docs/PROGRESS.md")
    rep_head = dec(gate_run(a, ta, "probe-open-head"))
    two, ttwo = gate_fixture(src, launch)  # в разделе две строки STOP: прошлая снята, открытая — последняя
    stop_now(two, GATE_STOP.replace(STOP_L, STOP_L + " — снят") + "\n" + GATE_STOP)
    last_open = dec(gate_run(two, ttwo, "probe-open-two"))
    sect_open = one("STOP: STOP-INPUT — прошлый ключ — снят\n\n## Open stop\n" + GATE_STOP)  # «## Open stop» раньше первого раздела со STOP
    sect_closed = one("\n## Closed stops\nSTOP: STOP-PAY — старый.\nВопрос: был ли? Resume: да\n\n## Notes\n" + GATE_STOP)  # «## Closed…» не судится
    o, to = gate_fixture(src, launch)
    stop_now(o)
    old = hook_at(src, o, OLD_HOOK_34, "spec-gate-v34.mjs")
    alt = [dec(gate_run(o, to, "probe-open", hook=old)), dec(gate_run(o, to, "probe-open", hook=old))] if old else ["?", "?"]
    item(S, "F3.1", new == ["stop"] * 3 and alt == ["stop", "block"] and rep_plan == rep_head == last_open == sect_open == sect_closed == "stop", f"neu={','.join(new[:2])} alt={','.join(alt)} · стоп запушен, после него коммит только в docs/evidence/: "
         f"та же сессия — {new[0]}, {new[1]}; новая сессия — {new[2]}; затем коммит только docs/PLAN-1.md — {rep_plan}, только головы PROGRESS — {rep_head}; две строки STOP в разделе (первая снята) — {last_open}; «## Open stop» после раздела со снятым STOP — {sect_open}; STOP в «## Closed stops» раньше открытого — {sect_closed}; хук v3.4 ({OLD_HOOK_34}) — {', '.join(alt)}")
    # F3.2 — стоп закрыт: коммит кода, «— снят», слово Resume (и в новой сессии)
    c, tc = gate_fixture(src, launch)
    stop_now(c)
    open(f"{c}/bin/zz", "w", encoding="utf-8").write("echo zz\n")
    ship(c, "F2.1: код после стопа", "bin/zz")
    code = gate_run(c, tc, "probe-code")
    s, ts_ = gate_fixture(src, launch)
    stop_now(s, GATE_STOP.replace(STOP_L, STOP_L + " — снят"))
    snyat = gate_run(s, ts_, "probe-snyat")
    r, tr = gate_fixture(src, launch)
    resume = "продолжай по SPEC-1 с F2: ключ выдан"  # строка Resume стопа, как её шлёт /phase resume (resumeOf мода phase-start)
    stop_now(r, f"{STOP_L}\nВопрос оператору: выдать ли ключ фикстуры?\nResume: {resume}\n")
    with open(tr, "a", encoding="utf-8") as f:
        f.write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() + 2)), "message": {"role": "user", "content": resume}}, ensure_ascii=False) + "\n")
    open(f"{r}/docs/evidence/y-result.txt", "w", encoding="utf-8").write("y\n")
    ship(r, "отчёт после Resume", "docs/evidence/y-result.txt")
    res1 = gate_run(r, tr, "probe-resume")
    fresh = f"{os.path.dirname(tr)}/fresh.jsonl"
    open(fresh, "w").write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())}) + "\n")
    res2 = gate_run(r, fresh, "probe-resume-next")
    kept = last_line(res1).get("resumed") or []

    def word_at(text, dt, meta=False):  # слово оператора в транскрипте через dt с от сейчас (стоп закоммичен сейчас)
        w, tw = gate_fixture(src, launch)
        stop_now(w, f"{STOP_L}\nВопрос оператору: выдать ли ключ фикстуры?\nResume: {resume}\n")
        rec = {"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() + dt)), "message": {"role": "user", "content": text}}
        with open(tw, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec | ({"isMeta": True} if meta else {}), ensure_ascii=False) + "\n")
        return dec(gate_run(w, tw, "probe-word"))
    prefix = word_at("Resume: ключ у оператора, иду дальше", 2)  # не строка Resume стопа, но начинается с «Resume:» — слово
    before = word_at(resume, -300)  # строка Resume стопа до его коммита — не слово
    meta = word_at("Resume: ключ у оператора, иду дальше", 2, meta=True)
    inline = one(GATE_STOP, "«продолжай по SPEC-1 с F2: ключ выдан».")  # «Resume: …» за вопросом в строке — не строка Resume: её текст без префикса — не слово  # служебная запись харнеса (isMeta), не слова человека — не слово
    sides = [dec(code), dec(snyat), dec(res1), dec(res2)]
    item(S, "F3.2", sides == ["block"] * 4 and bool(kept) and prefix == "block" and before == meta == inline == "stop", f"code={sides[0]} snyat={sides[1]} resume={sides[2]},{sides[3]} · коммит кода после стопа — {sides[0]}; «— снят» в конце строки — {sides[1]}; "
         f"слово Resume (строка Resume стопа после его коммита), потом коммит только в docs/evidence/ — {sides[2]}, в журнале resumed {kept}; новая сессия без слова — {sides[3]}; "
         f"сообщение «Resume: …» не строкой стопа — {prefix}; строка Resume за 5 мин до коммита стопа — {before}; служебная запись (isMeta) «Resume: …» — {meta}; текст «Resume:» из строки вопроса без префикса — {inline}")
    # F3.3 — стоп с текстом стопа прошлой фазы: новый стоп; хук v3.4 — «старый»
    p, tp = gate_fixture(src, launch, stop_old=True)
    pg = open(f"{p}/docs/PROGRESS.md", encoding="utf-8").read()
    open(f"{p}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace("\n" + GATE_STOP, ""))
    ship(p, "свежий PROGRESS новой фазы", "docs/PROGRESS.md")
    open(f"{p}/bin/zz", "w", encoding="utf-8").write("echo zz\n")
    ship(p, "F1.1: код новой фазы до стопа", "bin/zz")  # коммит кода между фазами: стоп считается от разреза, не от прошлой фазы
    stop_now(p)
    neu3 = dec(gate_run(p, tp, "probe-past"))
    q, tq = gate_fixture(src, launch, stop_old=True)
    pg = open(f"{q}/docs/PROGRESS.md", encoding="utf-8").read()
    open(f"{q}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace("\n" + GATE_STOP, ""))
    ship(q, "свежий PROGRESS новой фазы", "docs/PROGRESS.md")
    stop_now(q)
    other = "STOP: STOP-INPUT — нужен другой ключ.\nВопрос оператору: выдать ли другой ключ?\nResume: продолжай по SPEC-1 с F2: другой ключ выдан\n"
    x, tx = gate_fixture(src, launch)  # стоп A, коммит кода, стоп A заменён стопом B: серия B — от замены
    stop_now(x, other)
    open(f"{x}/bin/zz", "w", encoding="utf-8").write("echo zz\n")
    ship(x, "F1.1: код до замены стопа", "bin/zz")
    pg = open(f"{x}/docs/PROGRESS.md", encoding="utf-8").read()
    open(f"{x}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace(other, GATE_STOP))
    ship(x, "стоп заменён", "docs/PROGRESS.md")
    swapped = dec(gate_run(x, tx, "probe-swap"))
    y, ty = gate_fixture(src, launch)  # стоп со словом Resume, ответ, тот же текст стопа снова: новый стоп, слово прошлого не в счёт
    again = f"{STOP_L}\nВопрос оператору: выдать ли ключ фикстуры?\nResume: {resume}\n"
    stop_now(y, again)
    with open(ty, "a", encoding="utf-8") as f:
        f.write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() + 2)), "message": {"role": "user", "content": resume}}, ensure_ascii=False) + "\n")
    first = dec(gate_run(y, ty, "probe-again"))
    pg = open(f"{y}/docs/PROGRESS.md", encoding="utf-8").read()
    open(f"{y}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace("\n" + again, ""))
    ship(y, "ответ на стоп", "docs/PROGRESS.md")
    time.sleep(3)  # новый коммит стопа — позже слова прошлого
    stop_now(y, again)
    fresh_y = f"{os.path.dirname(ty)}/fresh.jsonl"
    open(fresh_y, "w").write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())}) + "\n")
    second = dec(gate_run(y, fresh_y, "probe-again-next"))
    old3 = hook_at(src, q, OLD_HOOK_34, "spec-gate-v34.mjs")
    alt3 = dec(gate_run(q, tq, "probe-past", hook=old3)) if old3 else "?"
    item(S, "F3.3", neu3 == "stop" and alt3 == "block" and swapped == "stop" and first == "block" and second == "stop", f"neu={neu3} alt={alt3} · та же строка стопа была в PROGRESS до сессии (прошлая фаза), снята, коммит кода, в новой фазе снова запушена: "
         f"хук — {neu3}; хук v3.4 ({OLD_HOOK_34}) — {alt3} · стоп A, коммит кода, A заменён стопом B — {swapped}; стоп со словом Resume — {first}, ответ и тот же текст стопа новым коммитом — {second}")
    # F3.4 — форма: без вопроса и Resume, причина вне §4, только на диске — missing с именем; оформленный — stop
    f1, t1 = gate_fixture(src, launch)
    stop_now(f1, "STOP: STOP-INPUT — фикстуре нужен ключ оператора.\nключ лежит у оператора.\n")
    no_form = gate_run(f1, t1, "probe-form")
    f2, t2 = gate_fixture(src, launch)
    stop_now(f2, GATE_STOP.replace("STOP-INPUT", "STOP-PAY"))
    bad_id = gate_run(f2, t2, "probe-form")
    f3, t3 = gate_fixture(src, launch)
    open(f"{f3}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP)
    disk = gate_run(f3, t3, "probe-form")
    f4, t4 = gate_fixture(src, launch)
    stop_now(f4)
    formed = gate_run(f4, t4, "probe-form")
    f5, t5 = gate_fixture(src, launch)
    stop_now(f5, "STOP: STOP-INPUT — фикстуре нужен ключ оператора.\nВопрос оператору: продолжать ли без ключа (resume)?\n")
    word = gate_run(f5, t5, "probe-form")
    f6, t6 = gate_fixture(src, launch)
    stop_now(f6, "STOP: STOP-INPUT — фикстуре нужен ключ оператора.\nResume: продолжай по SPEC-1 с F2: ключ выдан\n")
    noq = gate_run(f6, t6, "probe-form")
    f7, t7 = gate_fixture(src, launch)
    stop_now(f7, "STOP: STOP-INPUT — фикстуре нужен ключ оператора.\nВопрос оператору: выдать ли ключ?\nResume: выдать ли ключ?\n")
    qres = gate_run(f7, t7, "probe-form")
    f8, t8 = gate_fixture(src, launch)
    open(f"{f8}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP)
    for a_ in (("add", "--", "docs/PROGRESS.md"), ("commit", "-qm", "стоп без push")):
        subprocess.run(["git", *a_], cwd=f8, env=GIT_ENV, capture_output=True, text=True, check=True)
    unpushed = gate_run(f8, t8, "probe-form")
    form_more = {  # окно — три строки под STOP, не сама строка; Продолжай… — тоже строка Resume; STOP — только в начале строки; «— снят» — в конце; ? в URL — не вопрос
        "вопрос и Resume на 2-й и 3-й строке": (one("STOP: STOP-INPUT — нужен ключ.\nКлюч лежит у оператора.\nВопрос оператору: выдать ли ключ?\nResume: продолжай по SPEC-1 с F2\n"), "stop"),
        "вопрос только в строке STOP": (one("STOP: STOP-INPUT — выдать ли ключ?\nКлюч у оператора.\nResume: продолжай по SPEC-1 с F2\n"), "block"),
        "строка «Продолжай…» вместо Resume": (one("STOP: STOP-INPUT — нужен ключ.\nВопрос оператору: выдать ли ключ?\nПродолжай по SPEC-1 с F2, когда ключ выдан.\n"), "stop"),
        "«STOP: STOP-PAY» внутри строки ниже": (one(GATE_STOP + "Прежний текст: см. STOP: STOP-PAY в архиве.\n"), "stop"),
        "«снят» не в конце строки STOP": (one("STOP: STOP-INPUT — прежний ключ снят с выдачи, нужен новый.\nВопрос оператору: выдать ли ключ фикстуры? Resume: «продолжай по SPEC-1 с F2: ключ выдан».\n"), "stop"),
        "? только в URL": (one("STOP: STOP-INPUT — нужен ключ.\nКлюч: https://example.invalid/key?id=1\nResume: продолжай по SPEC-1 с F2\n"), "block")}
    rs = lambda x: " ".join(str(m) for m in (last_line(x).get("missing") or []))
    named = ["STOP-INPUT» has no question" in rs(no_form), "STOP-PAY» is not a stop of SPEC §4" in rs(bad_id), "on disk only" in rs(disk)]
    extra = ["STOP-INPUT» has no question" in rs(word), "STOP-INPUT» has no question" in rs(noq), "STOP-INPUT» has no question" in rs(qres), "is not pushed" in rs(unpushed)]  # стороны сверх трёх пункта
    item(S, "F3.4", all(named) and all(extra) and dec(no_form) == dec(bad_id) == dec(disk) == dec(word) == dec(noq) == dec(qres) == dec(unpushed) == "block" and dec(formed) == "stop" and all(g == w for g, w in form_more.values()),
         f"form={sum(named)}/3 · без вопроса и Resume — {dec(no_form)}, названо — {'да' if named[0] else 'нет'}; STOP-PAY вне §4 — {dec(bad_id)}, названо — {'да' if named[1] else 'нет'}; "
         f"только на диске — {dec(disk)}, названо — {'да' if named[2] else 'нет'}; ещё: слова «продолжать» и resume в вопросе без строки Resume — {dec(word)}, строка Resume без вопроса — {dec(noq)}, строка Resume вопросом — {dec(qres)}, закоммичен без push — {dec(unpushed)}, названо — {sum(extra)}/4; " + "; ".join(f"{k} — {g}" for k, (g, _) in form_more.items()) + " · "
         f"красная: оформленный и запушенный — {dec(formed)}")


def gate_probes(src, launch, lenv, args):
    S = "GATE_HOOK"
    short = lambda res: (res.get("reason") or res.get("systemMessage") or "тишина").replace("\n", " ")[:150]
    repo, tr = gate_fixture(src, launch)
    rc, res, _, log, _ = gate_run(repo, tr, "probe-partial")
    reason = res.get("reason", "")
    f1_set = [l for l in reason.split("\n") if l.startswith("- F1:") and "no /verify-phase verdict" not in l]  # вердикта нет ни у одной фичи — F1 названа только им (401)
    f2_set = "- F2: no docs/evidence/F2-" in reason  # F2 названа своим комплектом, а не только отсутствием вердикта
    say(S, "OK" if rc == 0 and res.get("decision") == "block" and f2_set and not f1_set and "- F1: no /verify-phase verdict" in reason else "FAIL", "partial",
        f"один маркер из двух и «готово»: решение {res.get('decision') or 'нет'}, комплект F2 назван — {'да' if f2_set else 'нет'}, комплект F1 — {'да' if f1_set else 'нет'}, "
        f"F1 без вердикта — {'да' if '- F1: no /verify-phase verdict' in reason else 'нет'}; rc {rc}")
    twin, trw = gate_fixture(src, launch, full=True)  # маркер — целая строка: «B_OK_MAYBE» и «NOT B_OK» не в счёт
    open(f"{twin}/docs/evidence/F2-b-result.txt", "w", encoding="utf-8").write("spec: SPEC-1\n$ bin/b\nB_OK_MAYBE\nNOT B_OK\n")
    ship(twin, "близнецы маркера", "docs/evidence/F2-b-result.txt")
    res8 = gate_run(twin, trw, "probe-twin")[1]
    say(S, "OK" if res8.get("decision") == "block" and "- F2:" in res8.get("reason", "") else "FAIL", "partial",
        f"в evidence F2 только строки-близнецы маркера: решение {res8.get('decision') or 'нет'}, причина называет F2 — {'да' if '- F2:' in res8.get('reason', '') else 'нет'}")
    open(f"{repo}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP)
    ship(repo, "стоп", "docs/PROGRESS.md")  # v3.3, F1.5: строка STOP — из запушенного HEAD
    rc, res, _, log, _ = gate_run(repo, tr, "probe-stop")
    say(S, "OK" if rc == 0 and "decision" not in res and log[-1]["decision"] == "stop" and log[-1]["reason"] == "STOP-INPUT" else "FAIL", "stop",
        f"новая строка «STOP: STOP-INPUT» с вопросом и resume, запушена: решение {log[-1]['decision']}, причина {log[-1]['reason']}; «{short(res)}»")
    # SPEC-v3.5 F3: открытый стоп отпускает ход, пока он открыт (коммита кода и слова Resume нет); «снят» на диске — не в HEAD, в HEAD — закрыт
    again = gate_run(repo, tr, "probe-stop")[3][-1]["decision"]  # та же сессия: оператор ответил не словом Resume
    other = gate_run(repo, tr, "probe-stop-next")[3][-1]["decision"]  # новая сессия: стоп всё ещё открыт
    pg = open(f"{repo}/docs/PROGRESS.md", encoding="utf-8").read()
    first = GATE_STOP.split("\n")[0]
    variants = {"дописан «— снят» в конце": first + " — снят", "запись «- STOP: … — снят»": "- " + first + " — снят"}  # «снят» — только в конце строки, как у мода phase-start
    edited, pushed_off = {}, {}
    for name, line in variants.items():
        open(f"{repo}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg.replace(first, line))
        edited[name] = gate_run(repo, tr, "probe-stop-edited")[3][-1]["decision"]  # только на диске: в HEAD стоп открыт
        lifted, trl = gate_fixture(src, launch)
        open(f"{lifted}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP.replace(first, line))
        ship(lifted, "стоп снят", "docs/PROGRESS.md")
        pushed_off[name] = gate_run(lifted, trl, "probe-stop-lifted")[3][-1]["decision"]
    open(f"{repo}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg)
    say(S, "OK" if again == other == "stop" and set(edited.values()) == {"stop"} and set(pushed_off.values()) == {"block"} else "FAIL", "stop",
        f"открытый стоп отпускает ход, пока открыт: та же сессия ещё раз — {again}; новая сессия — {other}; «снят» только на диске — "
        + "; ".join(f"{k} — {v}" for k, v in edited.items()) + "; «снят» запушен — " + "; ".join(f"{k} — {v}" for k, v in pushed_off.items()))
    repo_b, tr_b = gate_fixture(src, launch)
    open(f"{repo_b}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP.replace("STOP-INPUT", "STOP-PAY"))
    ship(repo_b, "стоп не из §4", "docs/PROGRESS.md")
    rc, res, _, log, _ = gate_run(repo_b, tr_b, "probe-stop-bad")
    say(S, "OK" if res.get("decision") == "block" and "STOP-PAY» is not a stop of SPEC §4" in res.get("reason", "") else "FAIL", "stop",
        f"строка «STOP: STOP-PAY» — не причина §4 фикстуры: решение {res.get('decision') or 'нет'}, причина называет STOP-PAY — {'да' if 'STOP-PAY' in res.get('reason', '') else 'нет'}")
    repo_o, tr_o = gate_fixture(src, launch, stop_old=True)
    rc, res, _, log, _ = gate_run(repo_o, tr_o, "probe-stop-old")
    say(S, "OK" if log[-1]["decision"] == "stop" else "FAIL", "stop", f"строка STOP из коммита до сессии, кода и слова Resume после неё нет — стоп открыт (SPEC-v3.5 F3): решение {log[-1]['decision']}")
    repo_np, tr_np = gate_fixture(src, launch)  # без стопа: неполный комплект
    decisions = [gate_run(repo_np, tr_np, "probe-np")[3][-1] for _ in range(4)]  # same_list 3: пропуск на четвёртом
    seq = [d["decision"] for d in decisions]
    say(S, "OK" if seq == ["block", "block", "block", "pass"] and decisions[-1]["reason"].startswith("no-progress") else "FAIL", "no-progress",
        f"один список четыре раза подряд: {' → '.join(seq)}; причина последнего — {decisions[-1]['reason']}")
    full, trf = gate_fixture(src, launch, full=True)
    oldf = f"{os.path.dirname(trf)}/old.jsonl"
    open(oldf, "w").write(json.dumps({"timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() - 4 * 3600))}) + "\n")
    res3 = gate_run(full, oldf, "probe-full-old")[1]
    say(S, "OK" if res3.get("systemMessage", "").startswith("SPEC_GATE_OK") else "FAIL", "caps",
        f"полный комплект в сессии старше 3 ч — «{short(res3)}»: комплект не теряется")
    stale, trs = gate_fixture(src, launch, full=True, fresh_head=False)
    open(f"{stale}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n## Notes\n- строка заметок.\n")
    ship(stale, "заметки", "docs/PROGRESS.md")
    res4 = gate_run(stale, trs, "probe-stale-head")[1]
    blank, trk = gate_fixture(src, launch, full=True)
    open(f"{blank}/docs/PROGRESS.md", "w", encoding="utf-8").write("   \n")
    ship(blank, "пустая голова", "docs/PROGRESS.md")
    res7 = gate_run(blank, trk, "probe-blank-head")[1]
    named = lambda r: r.get("decision") == "block" and "head of docs/PROGRESS.md" in r.get("reason", "")
    say(S, "OK" if named(res4) and named(res7) else "FAIL", "head",
        f"полный комплект, но голова PROGRESS как до сессии (дописана только строка заметок): решение {res4.get('decision') or 'нет'}, причина называет голову — "
        f"{'да' if named(res4) else 'нет'}; PROGRESS из пробелов — {res7.get('decision') or 'нет'}, голова названа — {'да' if named(res7) else 'нет'}")
    moved, trm = gate_fixture(src, launch, full=True)  # после вердикта код уехал в evidence: git mv — тоже правка кода
    gm = lambda *a: subprocess.run(["git", *a], cwd=moved, env=GIT_ENV, capture_output=True, text=True, check=True)
    gm("mv", "CLAUDE.md", "docs/evidence/CLAUDE-moved.md")
    gm("commit", "-qm", "move")
    gm("push", "-q", "origin", "phase")
    res6 = gate_run(moved, trm, "probe-verdict-rename")[1]
    covered = "after the /verify-phase round" not in res6.get("reason", "")
    say(S, "OK" if res6.get("decision") == "block" and not covered else "FAIL", "verdict",
        f"после VERDICT: PASS файл вне evidence перенесён в docs/evidence/ (git mv): решение {res6.get('decision') or 'нет'}, "
        f"вердикт не покрывает коммит — {'нет' if covered else 'да'}")
    union_probes(S, src, launch)
    history_probes(S, src, launch)
    stdin_probes(S, src, launch)
    # B2 (ревью v3.2-2): комплект — из запушенного HEAD; файл комплекта вне HEAD или отличный от HEAD держит ход по имени
    def state_of(tweak=None, **kw):
        repo, tr = gate_fixture(src, launch, full=True, **kw)
        named = tweak(repo) if tweak else None
        return repo, tr, named
    def drop_f2(r):
        s = open(f"{r}/docs/SPEC-1.md", encoding="utf-8").read()
        open(f"{r}/docs/SPEC-1.md", "w", encoding="utf-8").write("\n".join(l for l in s.split("\n") if not l.startswith("- **F2")))
        return "docs/SPEC-1.md differs from HEAD"
    def verdict_rewritten(r):
        v = next(n for n in os.listdir(f"{r}/docs/evidence") if n.startswith("verify-"))
        open(f"{r}/docs/evidence/{v}", "w", encoding="utf-8").write("VERDICT: NEEDS_WORK\n")
        return f"docs/evidence/{v} differs from HEAD"
    def extra(r):
        open(f"{r}/docs/evidence/F2-rerun-result.txt", "w", encoding="utf-8").write("$ bin/b\nFAIL: 3 of 5\n")
        return "docs/evidence/F2-rerun-result.txt is not committed"
    def prompt_edit(r):
        open(f"{r}/docs/PROMPT.txt", "a", encoding="utf-8").write("ещё строка\n")
        return "docs/PROMPT.txt differs from HEAD"
    red = {"голова, evidence F2 и вердикт вне коммита (ревью)": state_of(loose=("docs/evidence/F2-b-result.txt", "verify", "docs/PROGRESS.md")),
           "вне git только вердикт (ревью)": state_of(loose=("verify",)),
           "evidence F2 дописан на диске": state_of(lambda r: (open(f"{r}/docs/evidence/F2-b-result.txt", "a").write("x\n"), "docs/evidence/F2-b-result.txt differs from HEAD")[1]),
           "evidence F2 удалён на диске": state_of(lambda r: (os.remove(f"{r}/docs/evidence/F2-b-result.txt"), "docs/evidence/F2-b-result.txt is deleted on disk")[1]),
           "лишний evidence F2 вне git": state_of(extra),
           "вердикт переписан на диске": state_of(verdict_rewritten),
           "строка F2 убрана из SPEC на диске": state_of(drop_f2),
           "стартовый запрос правлен на диске": state_of(prompt_edit)}
    vname = lambda r: next(n for n in os.listdir(f"{r}/docs/evidence") if n.startswith("verify-"))
    must = {"голова, evidence F2 и вердикт вне коммита (ревью)": lambda r: ["docs/PROGRESS.md differs from HEAD", "docs/evidence/F2-b-result.txt is not committed", f"docs/evidence/{vname(r)} is not committed"],
            "вне git только вердикт (ревью)": lambda r: [f"docs/evidence/{vname(r)} is not committed"]}
    held = []
    for name, (repo, tr, named) in red.items():
        r = gate_run(repo, tr, "probe-set-red")[1]
        want = must[name](repo) if name in must else [named]
        held.append((name, r.get("decision") == "block" and all(w in r.get("reason", "") for w in want)))
    say(S, "OK" if all(ok for _, ok in held) else "FAIL", "set",
        "комплект — из запушенного HEAD, файл вне HEAD или отличный от HEAD держит ход по имени: " + "; ".join(f"{n} — {'блок, назван' if ok else 'НЕТ'}" for n, ok in held))
    green = {}
    s5, t5, _ = state_of()  # журналы в git: чек дописывает jev.jsonl, хук — spec-gate.jsonl, в том числе своими прошлыми решениями
    for lg in ("jev.jsonl", "spec-gate.jsonl"):
        open(f"{s5}/docs/evidence/{lg}", "w", encoding="utf-8").write('{"ts": "2026-10-09T00:00:00Z"}\n')
    ship(s5, "журналы", "docs/evidence/jev.jsonl", "docs/evidence/spec-gate.jsonl")
    for lg in ("jev.jsonl", "spec-gate.jsonl"):
        open(f"{s5}/docs/evidence/{lg}", "a", encoding="utf-8").write('{"ts": "2026-10-09T00:00:01Z"}\n')
    green["журналы jev.jsonl и spec-gate.jsonl в git и дописаны"] = [gate_run(s5, t5, "probe-set-logs")[1] for _ in range(2)]
    s6, t6, _ = state_of()
    subprocess.run(["git", "mv", "docs/evidence/F2-b-result.txt", "docs/evidence/F2-сборка-result.txt"], cwd=s6, env=GIT_ENV, check=True, capture_output=True)
    ship(s6, "не-ASCII имя evidence", "docs/evidence/F2-сборка-result.txt")
    green["evidence F2 с не-ASCII именем"] = [gate_run(s6, t6, "probe-set-utf8")[1]]
    s7, t7, _ = state_of()
    gx = lambda *a: subprocess.run(["git", *a], cwd=s7, env=GIT_ENV, check=True, capture_output=True)
    gx("config", "core.autocrlf", "true")
    for rel in ("docs/SPEC-1.md", "docs/PROGRESS.md", "docs/PROMPT.txt", "docs/evidence/F1-a-result.txt", "docs/evidence/F2-b-result.txt"):
        os.remove(f"{s7}/{rel}")
    gx("checkout", "--", "docs")
    crlf = b"\r\n" in open(f"{s7}/docs/SPEC-1.md", "rb").read()
    green["чекаут с CRLF (core.autocrlf)" + ("" if crlf else " — CRLF не вышел")] = [gate_run(s7, t7, "probe-set-crlf")[1]] if crlf else [{}]
    good = {n: all(r.get("systemMessage", "").startswith("SPEC_GATE_OK") for r in rs) for n, rs in green.items()}
    say(S, "OK" if all(good.values()) else "FAIL", "set",
        "запушенный комплект — SPEC_GATE_OK: " + "; ".join(f"{n} — {'да' if ok else 'НЕТ: ' + short(green[n][-1])}" for n, ok in good.items()))
    rc, res, _, log, _ = gate_run(full, trf, "probe-full")
    say(S, "OK" if rc == 0 and res.get("systemMessage", "").startswith("SPEC_GATE_OK") and log[-1]["decision"] == "ok" else "FAIL", "full",
        f"полный комплект: «{short(res)}» за {log[-1].get('ms')} мс")
    n = len(gate_run(repo, tr, "probe-off")[3])
    rc, res, raw, log, _ = gate_run(repo, tr, "probe-off", env_over={"SPEC_GATE": "OFF"})  # регистр не важен
    rc2, res2, raw2, log2, _ = gate_run(repo_np, tr_np, "probe-shadow", env_over={"SPEC_GATE": "shadow"})
    say(S, "OK" if rc == 0 and not raw.strip() and len(log) == n and not raw2.strip() and log2[-1]["decision"] == "block" and log2[-1]["mode"] == "shadow" else "FAIL", "modes",
        f"OFF: stdout {'пуст' if not raw.strip() else 'не пуст'}, строк журнала +{len(log) - n}; shadow: stdout {'пуст' if not raw2.strip() else 'не пуст'}, в журнале {log2[-1]['decision']} ({log2[-1]['mode']})")
    broken, trb = gate_fixture(src, launch)
    open(f"{broken}/.claude/spec-gate.json", "w").write('{"mode": "active",}')
    res5 = gate_run(broken, trb, "probe-broken-config")[1]
    say(S, "OK" if "decision" not in res5 and "not readable JSON" in res5.get("systemMessage", "") else "FAIL", "config",
        f".claude/spec-gate.json с ошибкой JSON: «{short(res5)}» — хук пропускает, а не блокирует без вопросов")
    open(f"{repo_o}/AGENT_STOP", "w").close()
    rc, res, _, log, _ = gate_run(repo_o, tr_o, "probe-agent-stop")
    os.remove(f"{repo_o}/AGENT_STOP")
    rc2, res2, raw2, log2, _ = gate_run(repo_o, tr_o, "probe-bg", extra={"background_tasks": [{"id": "t1", "type": "workflow", "status": "running", "name": "x"}]})
    say(S, "OK" if log[-1]["reason"] == "agent-stop" and "decision" not in res and log2[-1]["reason"].startswith("background") and not raw2.strip() else "FAIL", "pass",
        f"AGENT_STOP → {log[-1]['decision']} ({log[-1]['reason']}); фоновый воркфлоу → {log2[-1]['decision']} ({log2[-1]['reason']}), stdout {'пуст' if not raw2.strip() else 'не пуст'}")
    lines = [json.loads(x) for p in (repo, repo_b, repo_o, full, stale) for x in open(f"{p}/docs/evidence/spec-gate.jsonl", encoding="utf-8")]
    lines = [l for l in lines if l.get("ts")]  # без строк, подложенных пробой капа
    fields = all({"ts", "session", "mode", "decision", "reason", "missing", "ms"} <= set(l) for l in lines)
    home = sum(os.path.expanduser("~") in json.dumps(l) for l in lines)
    say(S, "OK" if fields and not home else "FAIL", "log", f"docs/evidence/spec-gate.jsonl фикстур: строк {len(lines)}, поля решения — {'все' if fields else 'не все'}, с путём домашнего каталога — {home}")
    # live: the hook in a real `claude -p` session, the same launch line, SPEC_GATE=active
    for name, fx, prompt in (("live-block", gate_fixture(src, launch), PROMPT_GATE_BLOCK), ("live-ok", gate_fixture(src, launch, full=True, fresh_head=False), PROMPT_GATE_OK)):
        lrepo, _ = fx
        init, res, uses, _, ev = control(lrepo, lenv, args, name, prompt, env_over={"SPEC_GATE": "active"}, turns=8)
        sid = hashlib.sha256(str(init.get("session_id", "")).encode()).hexdigest()[:8]
        lp = f"{lrepo}/docs/evidence/spec-gate.jsonl"
        mine = [json.loads(l) for l in open(lp, encoding="utf-8")] if os.path.isfile(lp) else []
        mine = [l for l in mine if l.get("session") == sid]
        texts = [c.get("text", "") for e in ev if e.get("type") == "assistant" and not e.get("parent_tool_use_id")
                 for c in e["message"].get("content", []) if c.get("type") == "text"]
        if name == "live-block":
            blocks = [l for l in mine if l["decision"] == "block"]
            ok = blocks and any(m.startswith("F2:") for m in blocks[0]["missing"]) and len(texts) >= 2
            say(S, "OK" if ok else "FAIL", name, f"«готово» без маркера F2: решений хука {len(mine)} ({', '.join(l['decision'] for l in mine) or 'нет'}), "
                f"первый блок называет F2 — {'да' if blocks and any(m.startswith('F2:') for m in blocks[0]['missing']) else 'нет'}; ответов модели {len(texts)} — ход не кончился на первом; "
                f"ходов {res.get('num_turns')}, tool_use {len(uses)}")
        else:
            shown = subprocess.run(["git", "show", "HEAD:docs/PROGRESS.md"], cwd=lrepo, capture_output=True, text=True).stdout
            pushed = subprocess.run(["git", "rev-parse", "HEAD", "refs/remotes/origin/phase"], cwd=lrepo, capture_output=True, text=True).stdout.split()
            headed = "гейт фикстуры пройден" in shown and len(set(pushed)) == 1
            ok = [l["decision"] for l in mine] == ["ok"] and len(texts) <= 2 and headed
            say(S, "OK" if ok else "FAIL", name, f"полный комплект: решений хука {len(mine)} ({', '.join(l['decision'] for l in mine) or 'нет'}), "
                f"«{mine[-1]['reason'] if mine else '—'}»; голову PROGRESS модель переписала, закоммитила и запушила в сессии — {'да' if headed else 'нет'}; ответов модели {len(texts)}, ходов {res.get('num_turns')}")


# Belay судит «готово» только для работы, которую проверил бы тест (verification_applies, belay.mjs:432) — задача пробы — код
PROMPT_LAYER = ("Harness control run of the end-of-turn judges. With the Write tool create calc.py with a function add(a, b) that returns "
                "a + b (you are authorized to create it). Do not run anything. Then tell me that the work is complete.")
BELAY_LOG = os.path.expanduser("~/.claude/belay/decisions.jsonl")


def layer_probes(rows, dst, lenv, args, proc):
    """Belay в живой сессии этой строкой — тень по его журналу (только решение и режим);
    пробы «по задаче» — инструмент строки таблицы есть на машине и отвечает (SPEC-v3.2 F4)."""
    S = "ENV"
    on = {i for _, f, ii, v, _ in rows if f == "плагин" and v for i in ii}
    ids = {i for _, _, ii, _, _ in rows for i in ii}
    jsonl = lambda p: [json.loads(l) for l in open(p, encoding="utf-8") if l.startswith("{")] if os.path.isfile(p) else []
    if "jev-belay@jev-belay" in on:
        init, res, uses, _, _ = control(dst, lenv, args, "layer", PROMPT_LAYER)
        sid = init.get("session_id")
        if "jev-belay@jev-belay" in on:
            v = [l.get("verdict") for l in jsonl(BELAY_LOG) if l.get("session") == sid]
            say(S, "OK" if "shadow" in v and "blocked" not in v else "FAIL", "belay",
                f"Belay в живой сессии (код без чека и «готово»): решений {len(v)} — {', '.join(map(str, v)) or 'нет'}; "
                f"тень {'дошла из pluginConfigs' if 'shadow' in v else 'не видна'}{', был настоящий блок' if 'blocked' in v else ''}; ходов {res.get('num_turns')}")
    t = tempfile.mkdtemp(prefix="task-", dir=TMP)
    def probe(name, cmd, env, timeout, judge):
        if not os.path.exists(cmd[0] if cmd[0] != "node" else cmd[1]):
            say(S, "FAIL", name, f"по задаче: {os.path.basename(cmd[1] if cmd[0] == 'node' else cmd[0])} не найден на машине")
            return
        try:
            r = subprocess.run(cmd, env=os.environ | env, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            say(S, "FAIL", name, f"по задаче: нет ответа за {timeout} с")
            return
        ok, msg = judge(r)
        say(S, "OK" if ok else "FAIL", name, f"по задаче: {msg}")
    if "quicksilver" in ids:
        def qs(r):
            first = (r.stdout.splitlines() or [""])[0]
            return r.returncode == 0 and re.fullmatch(r"ready · key from env (JEV_API_KEY|TYPESAFE_API_KEY) · model jev-1\.13\.0", first), f"`qs status` (модель пином, свой QUICKSILVER_HOME): rc {r.returncode}, «{first[:80]}»"
        probe("quicksilver", ["node", os.path.expanduser("~/.claude/skills/quicksilver/scripts/qs.mjs"), "status"],
              {"QUICKSILVER_MODEL": "jev-1.13.0", "QUICKSILVER_HOME": f"{t}/qs"}, 60, qs)
    if "jev-seo" in ids:
        def seo(r):
            try:
                d = json.loads(r.stdout)
            except ValueError:
                d = {}
            need = ["requests", "bs4", "lxml", "matplotlib", "jinja2", "weasyprint", "openpyxl"]
            n = sum(d.get(k) == "ok" for k in need)
            return r.returncode == 0 and n == len(need) and d.get("TYPESAFE_API_KEY") == "present", f"`jevseo doctor`: rc {r.returncode}, версия {d.get('version')}, модулей ok {n}/{len(need)}, ключ — {d.get('TYPESAFE_API_KEY', 'нет')}"
        probe("jev-seo", [os.path.expanduser("~/.claude/skills/jev-seo/bin/jevseo"), "doctor"],
              {"PYTHONDONTWRITEBYTECODE": "1", "MPLCONFIGDIR": f"{t}/mpl"}, 120, seo)
    if "jev-browser" in ids:
        def ui(r):
            line = next((l for l in r.stdout.splitlines() if " check-ui: " in l), "нет строки итога")
            return r.returncode == 0 and "UI_OK" in r.stdout.splitlines(), f"`bin/check-ui` — {line[5:].strip()[:150]}"
        probe("jev-browser", [f"{dst}/bin/check-ui"], {}, 300, ui)


def doctor(dst):
    env = {k: v for k, v in os.environ.items() if k != "ANTHROPIC_API_KEY"}
    r = subprocess.run(["claude", "doctor"], cwd=dst, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
    text = r.stdout + r.stderr
    invalid = text.split("Invalid settings", 1)[1].split("\n\n", 1)[0].count("\n- ") if "Invalid settings" in text else 0
    say("HARNESS", "OK" if r.returncode == 0 and not invalid else "FAIL", "doctor",
        f"rc {r.returncode}; ошибок настроек {invalid}; «No installation issues found» — {'да' if 'No installation issues found' in text else 'нет'}")


# ── SPEC-v3.4 F6: `--desktop` ── среда и профиль вкладки Code ───────────────────────────────────────────────────────────────────
WRITE_KEY = "blockWritesOutsideWorkingDirectories"
SUBAGENT_MODEL, SUBAGENT_EFFORT = "CLAUDE_CODE_SUBAGENT_MODEL", "CLAUDE_CODE_SUBAGENT_EFFORT"
CHECK_VERSIONS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "check-versions")
PROMPT_WRITE = ("Harness control run on a throwaway fixture; you are authorized. Make exactly three tool calls, one at a time, and attempt each even if an earlier "
                "one is refused: 1) Write tool: file {inside}, content x. 2) Write tool: file {outside}, content x. 3) Bash tool: `echo x > {bash}`. Then reply with the word done.")
WF_WORKTREE = """export const meta = { name: 'wt-probe', description: 'Harness control: an isolated worktree agent under the write block' }
return await agent(`Harness control run. With the Write tool write the text x to the file wt-probe.txt in your current working directory (your worktree). Report write_result: the first 200 characters of the tool result, verbatim.`,
  { label: 'probe', model: 'claude-haiku-5-5', isolation: 'worktree', schema: { type: 'object', required: ['write_result'], properties: { write_result: { type: 'string' } } } })
"""
PROMPT_TAB = ("Harness control run on a throwaway fixture; you are authorized. Make these tool calls in order, one at a time, and attempt each even if an earlier one is refused: "
              "1) Agent tool, subagent_type general-purpose, no model parameter, with the prompt: Run `echo hi` with the Bash tool once, then reply done. "
              "2) Write tool: write the text x to docs/STATUS.md. 3) Read kit/CLAUDE.md, then with the Edit tool replace the word old with the word new in it. "
              "Then reply with the single word done.")
EFFORT_HOOK = ('import json, os, sys\nd = json.load(sys.stdin)\nopen(os.environ["CLAUDE_PROJECT_DIR"] + "/effort.jsonl", "a").write(json.dumps('
               '{"agent": bool(d.get("agent_id")), "level": (d.get("effort") or {}).get("level")}) + "\\n")\n')
DENIED = {"session_id": "abc123", "transcript_path": "/Users/x/.claude/projects/p/s.jsonl", "cwd": "/Users/x/proj", "permission_mode": "auto", "hook_event_name": "PermissionDenied",
          "tool_name": "Bash", "tool_input": {"command": "rm -rf /tmp/build", "description": "Clean build directory"}, "tool_use_id": "toolu_01ABC123", "reason": "[Irreversible Local Destruction]"}


def stub(d, name, body):
    open(f"{d}/{name}", "w").write(f"#!/bin/sh\n{body}\n")
    os.chmod(f"{d}/{name}", 0o755)


def versions_probes():
    """F6.1: стороны bin/check-versions и её вызова из check-window, verify-phase на заглушках claude и gh (PATH) и каталоге приложения (HOME): (имя, ждём, получили)."""
    os.makedirs(TMP, exist_ok=True)
    d = tempfile.mkdtemp(prefix="versions-", dir=TMP)
    got = []
    cli = lambda v: f"echo '{v} (Claude Code)'"
    fresh = "echo v2.1.319"

    def tool(name, want, claude=None, gh=None, apps=(), args=()):
        run = tempfile.mkdtemp(dir=d)
        for tool_name, body in (("claude", claude), ("gh", gh)):
            if body:
                stub(run, tool_name, body)
        for a in apps:
            os.makedirs(f"{run}/home/Library/Application Support/Claude/claude-code/{a}")
        try:
            r = subprocess.run([sys.executable, CHECK_VERSIONS, *args], env=dict(os.environ, HOME=f"{run}/home", PATH=run), capture_output=True, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            return got.append((name, want, "нет ответа за 20 с"))
        got.append((name, want, f"rc {r.returncode} " + " | ".join(r.stdout.strip().splitlines()) + (" · gh зван" if os.path.exists(f"{run}/gh-called") else "")))

    tool("CLI = приложение и релиз", "rc 0 VERSIONS cli=2.1.319 app=2.1.319 github=2.1.319", cli("2.1.319"), fresh, ["2.1.311", "2.1.319"])
    tool("CLI новее приложения", "rc 0 VERSIONS cli=2.1.319 app=2.1.317 github=2.1.319", cli("2.1.319"), fresh, ["2.1.317"])
    tool("CLI старше обоих", "rc 0 VERSIONS cli=2.1.316 app=2.1.317 github=2.1.319 | HARNESS_WARN cli-behind cli=2.1.316 app=2.1.317 | HARNESS_WARN cli-behind cli=2.1.316 github=2.1.319 | claude update",
         cli("2.1.316"), fresh, ["2.1.317"])
    tool("CLI старше только релиза", "rc 0 VERSIONS cli=2.1.319 app=— github=2.1.320 | HARNESS_WARN cli-behind cli=2.1.319 github=2.1.320 | claude update", cli("2.1.319"), "echo v2.1.320")
    tool("числа, не строки: 2.1.100 новее 2.1.99", "rc 0 VERSIONS cli=2.1.100 app=2.1.99 github=—", cli("2.1.100"), None, ["2.1.99"])
    tool("старший каталог числом", "rc 0 VERSIONS cli=2.1.99 app=2.1.100 github=— | HARNESS_WARN cli-behind cli=2.1.99 app=2.1.100 | claude update", cli("2.1.99"), None, ["2.1.100", "2.1.99"])
    tool("--offline: gh не зовётся", "rc 0 VERSIONS cli=2.1.319 app=— github=—", cli("2.1.319"), ': > "${0%/*}/gh-called"; echo v2.1.319', args=["--offline"])
    tool("без --offline gh зван", "rc 0 VERSIONS cli=2.1.319 app=— github=2.1.319 · gh зван", cli("2.1.319"), ': > "${0%/*}/gh-called"; echo v2.1.319')
    tool("нет ничего", "rc 0 VERSIONS cli=— app=— github=—")
    tool("gh без входа", "rc 0 VERSIONS cli=2.1.319 app=— github=—", cli("2.1.319"), "echo v2.1.999; exit 1")
    tool("мусор вместо версий", "rc 0 VERSIONS cli=— app=— github=—", 'echo \'{"type":"system"}\'', "echo Not Found", ["latest"])
    tool("не UTF-8 в stdout — «—», не отказ", "rc 0 VERSIONS cli=— app=— github=—", "printf '\\377\\376garbage'", "printf '\\377\\376garbage'")
    tool("gh завис — «—» по таймауту", "rc 0 VERSIONS cli=2.1.319 app=— github=—", cli("2.1.319"), "exec /bin/sleep 30")
    here = os.path.dirname(CHECK_VERSIONS)
    fx = tempfile.mkdtemp(dir=d)
    os.makedirs(f"{fx}/stub")
    open(f"{fx}/events.jsonl", "w").write(json.dumps({"type": "rate_limit_event", "rate_limit_info": {"unifiedWindows": {"seven_day": {"utilization": 0.5, "resetsAt": 4102444800}}}}) + "\n")
    base = dict(os.environ, HOME=f"{fx}/home", CHECK_WINDOW_EVENTS=f"{fx}/events.jsonl")

    def window(name, want, peer, path):
        b = tempfile.mkdtemp(dir=fx)
        for f in ("check-window", *(["check-versions"] if peer else [])):
            shutil.copy2(f"{here}/{f}", f"{b}/{f}")
        r = subprocess.run([sys.executable, f"{b}/check-window"], cwd=b, env=dict(base, PATH=path), capture_output=True, text=True, timeout=60)
        o = r.stdout.strip().splitlines() or [""]
        got.append((name, want, f"rc {r.returncode} · {o[0] if o[0].startswith('VERSIONS') else 'первая строка не VERSIONS'} · {o[-1]}" + gh_called(path.split(":")[0])))

    def gh_called(where):  # каталог заглушки общий на стороны: маркер снимается на своей
        called = os.path.exists(f"{where}/gh-called")
        if called:
            os.remove(f"{where}/gh-called")
        return " · gh зван" if called else ""

    empty = tempfile.mkdtemp(dir=fx)
    for where in (f"{fx}/stub", empty):
        stub(where, "gh", ': > "${0%/*}/gh-called"; echo v2.1.319')
    stub(f"{fx}/stub", "claude", "case \"$1\" in --version) echo '2.1.319 (Claude Code)';; *) echo '{\"type\":\"system\",\"subtype\":\"init\",\"apiKeySource\":\"none\"}';; esac")
    window("check-window: версии до окна", "rc 0 · VERSIONS cli=2.1.319 app=— github=— · WINDOW: start", True, f"{fx}/stub:/usr/bin:/bin")
    window("check-window: нет claude и каталога", "rc 0 · VERSIONS cli=— app=— github=— · WINDOW: start", True, f"{empty}:/usr/bin:/bin")
    window("check-window: рядом нет check-versions", "rc 0 · первая строка не VERSIONS · WINDOW: start", False, f"{fx}/stub:/usr/bin:/bin")
    py = os.path.dirname(sys.executable)

    def launcher(name, want, *peers):
        repo = tempfile.mkdtemp(dir=fx)
        os.makedirs(f"{repo}/docs")
        os.makedirs(f"{repo}/bin")
        open(f"{repo}/docs/PROMPT.txt", "w").write("Read first: docs/SPEC-1.md\n")
        open(f"{repo}/docs/SPEC-1.md", "w").write("# SPEC-1\n\n## 2. Фичи\n- **F1 Альфа** · чек: `bin/a` → `A_OK`\n")
        for f in ("verify-phase", *peers):
            shutil.copy2(f"{here}/{f}", f"{repo}/bin/{f}")
        for a in (["init", "-q"], ["add", "--", "docs"], ["commit", "-qm", "x"]):
            subprocess.run(["git", "-C", repo, *a], env=GIT_ENV, capture_output=True, check=True)
        r = subprocess.run([sys.executable, f"{repo}/bin/verify-phase", "--limit", "60"], cwd=repo, env=dict(base, PATH=f"{fx}/stub:{py}:/usr/bin:/bin"), capture_output=True, text=True, timeout=120)
        o = r.stdout.splitlines()
        first = next((i for i, l in enumerate(o) if l.startswith("VERSIONS")), None)
        clone = next((i for i, l in enumerate(o) if "свежий клон" in l), None)
        got.append((name, want, f"VERSIONS {sum(l.startswith('VERSIONS') for l in o)} раз, до клона — {'нет строки' if first is None or clone is None else 'да' if first < clone else 'нет'}, клон — {'есть' if clone is not None else 'нет'}" + gh_called(f"{fx}/stub")))

    launcher("verify-phase, check-window рядом", "VERSIONS 1 раз, до клона — да, клон — есть", "check-window", "check-versions")
    launcher("verify-phase без check-window", "VERSIONS 1 раз, до клона — да, клон — есть", "check-versions")
    launcher("verify-phase: нет check-versions", "VERSIONS 0 раз, до клона — нет строки, клон — есть")
    shutil.rmtree(d, ignore_errors=True)
    return got


def abandoned_worktrees(root="."):
    """Брошенные worktree числом (F6.1): `prunable` или под .claude/worktrees без замка — на worktree идущего агента Claude Code держит замок (worktrees, Worktree locks). Пути не печатаются: они домашние."""
    blocks = subprocess.run(["git", "-C", root, "worktree", "list", "--porcelain"], capture_output=True, text=True).stdout.split("\n\n")[1:]  # первый блок — главная копия
    has = lambda block, word: any(l.startswith(word) for l in block.splitlines())
    return sum(bool(b.strip()) and (has(b, "prunable") or ("/.claude/worktrees/" in b.splitlines()[0] and not has(b, "locked"))) for b in blocks)


def worktree_probes():
    """F6.1: счёт брошенных на фикстуре (git без настроек пользователя): (имя, ждём, получили)."""
    os.makedirs(TMP, exist_ok=True)
    d = tempfile.mkdtemp(prefix="worktrees-", dir=TMP)
    away = f"{d}-sibling"
    git = lambda *a: subprocess.run(["git", "-C", d, *a], env=GIT_ENV, capture_output=True, text=True, check=True)
    git("init", "-q")
    git("commit", "-q", "--allow-empty", "-m", "x")
    got = [("только главная копия", 0, abandoned_worktrees(d))]
    git("worktree", "add", "-q", "-b", "idle", f"{d}/.claude/worktrees/idle")
    git("worktree", "add", "-q", "-b", "run", f"{d}/.claude/worktrees/run")
    git("worktree", "lock", f"{d}/.claude/worktrees/run")
    got.append(("под .claude/worktrees: без замка — брошен, с замком — нет", 1, abandoned_worktrees(d)))
    git("worktree", "add", "-q", "-b", "side", away)
    got.append(("снаружи и каталог на месте — не брошен", 1, abandoned_worktrees(d)))
    shutil.rmtree(away)
    got.append(("снаружи, каталог снят — prunable", 2, abandoned_worktrees(d)))
    shutil.rmtree(d, ignore_errors=True)
    return got


def tab_view(rows, init, which=shutil.which):
    """(расхождения, MCP приложения, сводка): system/init прокси против таблицы Environment глазами вкладки (F6.3). Флаги строки запуска во вкладке не задаются — их замена
    ключи профиля, статика; MCP с 0 инструментов в init не работает — не лишний, какой бы ни был статус: connected — выключен deny профиля (замер), pending — ещё не поднялся (замер: ref и blockscout
    от прогона к прогону то connected, то pending); MCP «да» с 0 инструментов и иным статусом (failed, needs-auth) — красный; MCP «да», которого нет в init или он pending, даёт приложение или не поднялся —
    его видит только вкладка, на строку «вкладка:», не красный."""
    tools = init.get("tools", [])
    yes = [i for _, form, ids, on, _ in rows if form == "MCP" and on for i in ids]
    live = [s for s in init.get("mcp_servers", []) if any(t.startswith(f"mcp__{re.sub(r'[^a-zA-Z0-9_-]', '_', s.get('name', ''))}__") for t in tools)
            or (s.get("status") not in ("connected", "pending") and any(fnmatch.fnmatchcase(s.get("name", ""), p) for p in yes))]
    bad, summary = compare([r for r in rows if r[1] != "флаг"], {**init, "mcp_servers": live}, "", which)
    tail = ": нет в system/init"
    absent = lambda b: b.startswith("MCP ") and b.endswith(tail)
    return [b for b in bad if not absent(b)], [b[4:-len(tail)] for b in bad if absent(b)], summary


def tab_view_probes():
    """F6.3: стороны сверки на подставных init: (имя, ждём, получили)."""
    rows = table(FIXTURE)
    which = lambda c: c in ("git", "gh")
    green = {"plugins": [{"source": "ponytail@ponytail"}], "mcp_servers": [{"name": "context7", "status": "connected"}], "skills": ["graphify"], "tools": ["Bash", "mcp__context7__docs"]}
    seen = lambda **change: "; ".join(tab_view(rows, {**green, **change}, which)[0]) or "равно"
    return [("равно, флаг таблицы не судится", "равно", seen()),
            ("MCP «да» нет в init — приложение, не красный", ("равно", ["context7"]),
             (seen(mcp_servers=[], tools=["Bash"]), tab_view(rows, {**green, "mcp_servers": [], "tools": ["Bash"]}, which)[1])),
            ("MCP «нет» connected, 0 инструментов (deny)", "равно", seen(mcp_servers=green["mcp_servers"] + [{"name": "ref", "status": "connected"}])),
            ("MCP «нет» connected, с инструментами", "MCP ref: лишний — в таблице «нет»", seen(mcp_servers=green["mcp_servers"] + [{"name": "ref", "status": "connected"}], tools=green["tools"] + ["mcp__ref__search"])),
            ("коннектор: имя с точкой и пробелом", "MCP claude.ai Gmail: лишний — в таблице «нет»",
             seen(mcp_servers=green["mcp_servers"] + [{"name": "claude.ai Gmail", "status": "connected"}], tools=green["tools"] + ["mcp__claude_ai_Gmail__send"])),
            ("лишний плагин", "плагин commit-commands@claude-plugins-official: лишний — в таблице «нет»", seen(plugins=green["plugins"] + [{"source": "commit-commands@claude-plugins-official"}])),
            ("плагин таблицы не загружен", "плагин ponytail@ponytail: нет в system/init", seen(plugins=[])),
            ("скилл «нет» загружен", "скилл anthropic-skills:docx: включён — в таблице «нет»", seen(skills=["graphify", "anthropic-skills:docx"])),
            ("MCP «да» с иным статусом, как настоящий сломанный: 0 инструментов", "MCP context7: статус needs-auth, ждём connected", seen(mcp_servers=[{"name": "context7", "status": "needs-auth"}], tools=["Bash"])),
            ("MCP «да» failed, 0 инструментов", "MCP context7: статус failed, ждём connected", seen(mcp_servers=[{"name": "context7", "status": "failed"}], tools=["Bash"])),
            ("MCP «да» pending, 0 инструментов — не поднялся, на строку вкладки", ("равно", ["context7"]),
             (seen(mcp_servers=[{"name": "context7", "status": "pending"}], tools=["Bash"]), tab_view(rows, {**green, "mcp_servers": [{"name": "context7", "status": "pending"}], "tools": ["Bash"]}, which)[1])),
            ("MCP «нет» pending, 0 инструментов", "равно", seen(mcp_servers=green["mcp_servers"] + [{"name": "ref", "status": "pending"}])),
            ("MCP «нет» failed, 0 инструментов", "равно", seen(mcp_servers=green["mcp_servers"] + [{"name": "ref", "status": "failed"}]))]


def profile_bad(profile, settings, template=True):
    """F6.3: поля профиля вкладки (решение: они в .claude/launch.settings.json, а settings.json нейтрален — его грузит каждый вложенный прогон). template — шаблон кита: `CLAUDE_CODE_SUBAGENT_EFFORT` обязателен."""
    env = profile.get("env", {})
    bad = [] if profile.get("effortLevel") == "xhigh" else [f"effortLevel {profile.get('effortLevel')}, ждём xhigh"]
    bad += [] if profile.get("ultracode") is True else [f"ultracode {profile.get('ultracode')}, ждём true"]
    bad += [] if re.fullmatch(r"claude-[a-z]+-\d+(-\d+)*", str(env.get(SUBAGENT_MODEL))) else [f"{SUBAGENT_MODEL} {env.get(SUBAGENT_MODEL)}: нужен полный id"]
    bad += [] if env.get(SUBAGENT_EFFORT) in ("low", "medium", "high", "xhigh", "max") or (not template and SUBAGENT_EFFORT not in env) else [f"{SUBAGENT_EFFORT} {env.get(SUBAGENT_EFFORT)}"]
    bad += [f"{k} в settings.json: идёт в каждый вложенный прогон" for k in ("effortLevel", "ultracode") if k in settings]
    return bad


def tab_profile(local, launch):
    """F6.3: настоящий файл профиля вкладки против launch: None — файла нет (свежий клон: файл вне git), иначе ключи верхнего уровня, что расходятся по смыслу (разобранный JSON); значения не отдаются."""
    if not os.path.isfile(local):
        return None
    try:
        have = json.load(open(local, encoding="utf-8"))
    except (OSError, ValueError):
        return ["файл не JSON"]
    if not isinstance(have, dict):
        return ["файл не объект JSON"]

    def core(s):  # правила «не спрашивать» и каталоги сессии вкладка дописывает в этот файл сама: профиль — остальное
        perm = {k: v for k, v in s.get("permissions", {}).items() if k not in ("allow", "additionalDirectories")}
        return {**{k: v for k, v in s.items() if k != "permissions"}, **({"permissions": perm} if perm else {})}
    have, want = core(have), core(json.load(open(launch, encoding="utf-8")))
    return sorted(k for k in set(have) | set(want) if k not in have or k not in want or have[k] != want[k])


def additional_dirs(src, launch):
    """F6.2: каталоги permissions.additionalDirectories под источниками вкладки (пользователь, проект, local; массивы сливаются) числом — для вкладки они рабочие. Настройки пользователя только читаются, пути не печатаются: они домашние."""
    dirs = set()
    for p in (os.path.expanduser("~/.claude/settings.json"), f"{src}/.claude/settings.json", f"{os.path.dirname(launch)}/settings.local.json"):
        try:
            dirs |= set(json.load(open(p, encoding="utf-8")).get("permissions", {}).get("additionalDirectories", []))
        except (OSError, ValueError, AttributeError):
            pass
    return len(dirs)


def tab_line(app, step, additional):
    """Строка «вкладка:» — пункты гейта оператора §5. step — копия профиля, файла нет; additional — число каталогов, что шире поля записи."""
    return (f"вкладка: гейт оператора §5 — effort и ultracode самой вкладки, модель подагента ({SUBAGENT_MODEL} из файлов профиля не доходит, действует только из --settings), MCP приложения ({', '.join(app) or 'нет строк'}): "
            "скрипту не видны, выше не мерены; effort выше — прокси, ultracode сигнала не даёт, только ключ профиля"
            + (f"; файла профиля нет, оператор копирует: {step}" if step else "") + (f"; поле записи шире рабочих каталогов: write-block-wider additional={additional}" if additional else ""))


def tab_profile_probes(src, launch):
    """F6.3, F6.2, F6.1: стороны файла профиля через этот же скрипт: --desktop на копии, в PATH только git и node — claude нет, ветка статики, и этих проб во вложенном прогоне нет. (имя, ждём, получили)."""
    dst, path = deploy(src, launch), tempfile.mkdtemp(prefix="tab-profile-", dir=TMP)
    for tool in ("git", "node"):
        os.symlink(shutil.which(tool), f"{path}/{tool}")
    os.makedirs(f"{path}/home/.claude")
    profile, local, hidden = json.load(open(launch, encoding="utf-8")), f"{dst}/.claude/settings.local.json", "скрытое-значение"
    settings = json.load(open(f"{dst}/.claude/settings.json", encoding="utf-8"))

    def side(text, user=(), project=()):
        if text is None and os.path.exists(local):
            os.remove(local)
        if text is not None:
            open(local, "w", encoding="utf-8").write(text)
        json.dump({"permissions": {"additionalDirectories": list(user)}}, open(f"{path}/home/.claude/settings.json", "w", encoding="utf-8"))
        json.dump({**settings, "permissions": {**settings["permissions"], "additionalDirectories": list(project)}}, open(f"{dst}/.claude/settings.json", "w", encoding="utf-8"))
        r = subprocess.run([sys.executable, os.path.realpath(__file__), "--desktop"], cwd=dst, env=dict(os.environ, HOME=f"{path}/home", PATH=path), capture_output=True, text=True, timeout=300)
        lines = r.stdout.splitlines()
        warns = [l for l in lines if l.startswith(("HARNESS_WARN tab-profile", "HARNESS_WARN write-block-wider"))]
        f63 = next((l for l in lines if l.startswith("v3.4-F6.3 ")), "")
        graph = re.search(r"graph=\S+", next((l for l in lines if l.startswith("v3.4-F6.1 ")), ""))
        said = re.search(r"tab-profile[^;·]*", f63)
        return (f"rc {r.returncode}; {' | '.join(warns)}; F6.3 {said.group().strip() if said else f63.split(' ')[1] if f63 else 'нет строки'}; {graph.group() if graph else 'нет graph='}; "
                f"утечек {sum(w in r.stdout for w in (hidden, '/nested-dir'))}")

    step = "cp .claude/launch.settings.json .claude/settings.local.json"
    got = [("нет файла: WARN, код 0; каталоги пользователя и проекта слиты числом, графа нет", f"rc 0; HARNESS_WARN write-block-wider additional=3 | HARNESS_WARN tab-profile profil=fehlt — нет .claude/settings.local.json, оператор копирует профиль: {step}; F6.3 offen; graph=нет; утечек 0",
            side(None, ["/nested-dir-a", "/nested-dir-b", "/nested-dir-a"], ["/nested-dir-b", "/nested-dir-c"])),
           ("та же суть, иной порядок ключей и пробелы: строки нет", "rc 0; ; F6.3 offen; graph=нет; утечек 0", side(json.dumps(dict(reversed(list(profile.items()))), indent=4))),
           ("иное по смыслу: красный с именами ключей, без значений; каталог из local — числом",
            "rc 1; HARNESS_WARN write-block-wider additional=1; F6.3 tab-profile: .claude/settings.local.json не как .claude/launch.settings.json, ключи: effortLevel, extraKey, permissions; graph=нет; утечек 0",
            side(json.dumps({**profile, "effortLevel": hidden, "extraKey": hidden, "permissions": {**profile.get("permissions", {}), "additionalDirectories": ["/nested-dir-d"], "deny": [hidden]}}))),
           ("вкладка дописала разрешение: строки нет", "rc 0; ; F6.3 offen; graph=нет; утечек 0",
            side(json.dumps({**profile, "permissions": {**profile.get("permissions", {}), "allow": ["Bash(ls:*)"]}}))),
           ("битый файл: красный с именем, без трассировки", "rc 1; ; F6.3 tab-profile: .claude/settings.local.json не как .claude/launch.settings.json, ключи: файл не JSON; graph=нет; утечек 0",
            side('{"effortLevel": ')),
           ("файл не объект: красный с именем", "rc 1; ; F6.3 tab-profile: .claude/settings.local.json не как .claude/launch.settings.json, ключи: файл не объект JSON; graph=нет; утечек 0",
            side("[1]"))]
    shutil.rmtree(dst, ignore_errors=True)
    shutil.rmtree(path, ignore_errors=True)
    return got


def profile_probes():
    good = {"effortLevel": "xhigh", "ultracode": True, "env": {SUBAGENT_MODEL: "claude-sonnet-5-5", SUBAGENT_EFFORT: "high"}}
    seen = lambda p, s=None, **kw: "; ".join(profile_bad(p, s or {}, **kw)) or "ok"
    return [("все поля", "ok", seen(good)), ("профиль без поля effort подагентов не шаблон", "ok", seen({**good, "env": {SUBAGENT_MODEL: "claude-sonnet-5-5"}}, template=False)),
            ("шаблон без него", f"{SUBAGENT_EFFORT} None", seen({**good, "env": {SUBAGENT_MODEL: "claude-sonnet-5-5"}})),
            ("псевдоним модели", f"{SUBAGENT_MODEL} sonnet: нужен полный id", seen({**good, "env": {SUBAGENT_MODEL: "sonnet", SUBAGENT_EFFORT: "high"}})),
            ("effortLevel иной", "effortLevel high, ждём xhigh", seen({**good, "effortLevel": "high"})), ("без ultracode", "ultracode None, ждём true", seen({k: v for k, v in good.items() if k != "ultracode"})),
            ("ultracode в settings.json", "ultracode в settings.json: идёт в каждый вложенный прогон", seen(good, {"ultracode": True})),
            ("строка вкладки: модель подагента — всегда, копии и каталогов нет", (True, False, False), (SUBAGENT_MODEL in tab_line([], None, 0), "оператор копирует" in tab_line([], None, 0), "write-block-wider" in tab_line([], None, 0))),
            ("строка вкладки: нет файла, каталоги шире", (True, True), ("оператор копирует: cp a b" in tab_line([], "cp a b", 2), "write-block-wider additional=2" in tab_line([], "cp a b", 2)))]


def denied_probes(src):
    """F6.4: хук PermissionDenied на входах формы документации: живого отказа нет — событие идёт только на отказ auto mode. (имя, ждём, получили)."""
    os.makedirs(TMP, exist_ok=True)
    d = tempfile.mkdtemp(prefix="denied-", dir=TMP)
    hook = os.path.abspath(f"{src}/.claude/hooks/permission-denied.mjs")
    leak = ("tool_input", "command", "rm -rf", "/tmp/build", "/Users/", "toolu_", "abc123", "transcript", "cwd", "reason", "secret.txt")

    def feed(root, *raws):
        rs = [subprocess.run(["node", hook], input=raw, env=dict(os.environ, CLAUDE_PROJECT_DIR=root), capture_output=True, text=True, timeout=30) for raw in raws]
        return f"rc≠0 {sum(r.returncode != 0 for r in rs)}, stdout {sum(len(r.stdout) for r in rs)}"

    def journal(root):
        p = f"{root}/docs/evidence/denials.jsonl"
        text = open(p, encoding="utf-8").read() if os.path.exists(p) else ""
        rows = [json.loads(l) for l in text.splitlines() if l.startswith("{")]
        return f"строк {len(rows)}: " + "; ".join(f"{r['tool']}/{r['rule']}/{r['n']}" for r in rows) + f", поля {sorted(set(k for r in rows for k in r))}, утечек {sum(w in text for w in leak)}"

    fields = "['n', 'rule', 'session', 'tool', 'ts']"
    a, b, c, e, h, n = (tempfile.mkdtemp(dir=d) for _ in range(6))
    three = [DENIED, {**DENIED, "tool_name": "Write", "tool_input": {"file_path": "/Users/x/secret.txt", "content": "x"}, "reason": "Auto mode could not evaluate this action and is blocking it for safety"},
             {**DENIED, "tool_name": "WebFetch", "tool_input": {"url": "https://example.invalid/x"}, "reason": "Classifier unavailable"}]
    got = [("три входа — три строки, без stdout", "rc≠0 0, stdout 0", feed(a, *map(json.dumps, three))),
           ("журнал трёх входов", f"строк 3: Bash/Irreversible Local Destruction/1; Write/no-verdict/1; WebFetch/unavailable/1, поля {fields}, утечек 0", journal(a))]
    same = {**DENIED, "reason": "[Data Exfiltration]"}
    feed(b, json.dumps(same), json.dumps(same), json.dumps({**same, "session_id": "other"}), json.dumps({**DENIED, "reason": "Blocked by classifier: /Users/x/secret.txt"}))
    got.append(("счётчик по сессии и правилу; проза reason не утекает",
                f"строк 4: Bash/Data Exfiltration/1; Bash/Data Exfiltration/2; Bash/Data Exfiltration/1; Bash/other/1, поля {fields}, утечек 0", journal(b)))
    feed(h, *(json.dumps({**DENIED, "reason": r}) for r in ("[Blocked: pushes secret to client-acme.example from /Users/x/.ssh/id_rsa] details", f"[{'A' * 62}]", "[lowercase class]")))
    got.append(("класс вне белого списка — other: путь в скобках, длиннее 61, со строчной", f"строк 3: Bash/other/1; Bash/other/2; Bash/other/3, поля {fields}, утечек 0", journal(h)))
    edge = tempfile.mkdtemp(dir=d)  # граница длины класса: 61 знак — ещё имя правила, 62 — уже other (сторона выше)
    feed(edge, json.dumps({**DENIED, "reason": f"[{'A' * 61}] details"}))
    got.append(("класс ровно 61 знак — имя правила", f"строк 1: Bash/{'A' * 61}/1, поля {fields}, утечек 0", journal(edge)))
    broken = ["not json", "", "[]", "null", "1", "{}", json.dumps({"hook_event_name": "Stop", "tool_name": "Bash"}), json.dumps({"hook_event_name": "PermissionDenied"}),
              json.dumps({"hook_event_name": "PermissionDenied", "tool_name": 1})]
    got.append((f"битый вход ×{len(broken)}", "rc≠0 0, stdout 0", feed(c, *broken)))
    got.append(("битый вход — 0 строк", "строк 0: , поля [], утечек 0", journal(c)))
    open(f"{e}/docs", "w").close()
    got.append(("своя ошибка: docs — файл", "rc≠0 0, stdout 0", feed(e, json.dumps(DENIED))))
    os.makedirs(f"{c}/docs/evidence", exist_ok=True)
    open(f"{c}/docs/evidence/denials.jsonl", "w").write("обрыв строки\n")
    feed(c, json.dumps(DENIED))
    got.append(("битая строка журнала не глушит счёт", f"строк 1: Bash/Irreversible Local Destruction/1, поля {fields}, утечек 0", journal(c)))
    os.makedirs(f"{n}/docs/evidence")
    open(f"{n}/docs/evidence/denials.jsonl", "w").write("null\n")
    feed(n, json.dumps(DENIED))
    got.append(("строка журнала null не глушит хук", f"строк 1: Bash/Irreversible Local Destruction/1, поля {fields}, утечек 0", journal(n)))
    s = json.load(open(f"{src}/.claude/settings.json", encoding="utf-8"))
    decl = [h for g in s.get("hooks", {}).get("PermissionDenied", []) for h in g.get("hooks", [])]
    got.append(("settings: exec form", True, any(h.get("command") == "node" and h.get("args") == ["${CLAUDE_PROJECT_DIR}/.claude/hooks/permission-denied.mjs"] for h in decl)))
    got.append(("скан хуков на действие: кит без сети и модели", [], action_hooks([(s, os.path.abspath(src), None)])[0]))
    open(f"{d}/net.mjs", "w").write("await fetch('https://example.invalid/x')\n")
    red = {"hooks": {"PermissionDenied": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/net.mjs"]}]}]}}
    got.append(("скан видит сеть в хуке PermissionDenied", ["net.mjs"], [n for _, n, _ in action_hooks([(red, d, None)])[0]]))
    shutil.rmtree(d, ignore_errors=True)
    return got


def sides_ok(sides):
    return all(got == want for _, want, got in sides)


def sides_text(sides):
    return "; ".join(f"{name}: {got}" + ("" if got == want else f" — BAD, ждём {want}") for name, want, got in sides)


def offen(sec, iid, why):
    """Пункт не гонялся (CI без claude): строка `offen`, маркера нет, код 0 — как F3.5 в check-kit."""
    out.setdefault(sec, []).append("OFFEN")
    print(f"{iid} offen · {why}", flush=True)


def desktop_versions():
    r = subprocess.run([sys.executable, CHECK_VERSIONS], capture_output=True, text=True, timeout=60)
    lines = r.stdout.strip().splitlines()
    print("\n".join(lines), flush=True)
    three = re.findall(r"\b(?:cli|app|github)=(\S+)", lines[0]) if lines else []
    status, text = graph_age(".")
    print("\n".join(graph_lines()[1:]), flush=True) if status == "WARN" else None
    versions, trees, graphs = versions_probes(), worktree_probes(), graph_age_probes()
    item("HARNESS", "v3.4-F6.1", r.returncode == 0 and len(three) == 3 and sides_ok(versions) and sides_ok(trees) and sides_ok(graphs),
         f"versionen={sum(v != '—' for v in three)} graph={status or 'нет'} · живьём: {' | '.join(lines)}; брошенных worktree {abandoned_worktrees()}; граф этого репо: {text} · "
         f"фикстуры check-versions: {sides_text(versions)} · worktree: {sides_text(trees)} · граф против HEAD: {sides_text(graphs)}")


def write_side(src, launch, with_key):
    """Сторона пары F6.2: копия с полем шаблона или без него, без --add-dir и без настроек пользователя (additionalDirectories машины не решают, что здесь «вне»), цель вне — сосед под /tmp/two-tier-v3 (C4), пути — realpath."""
    dst = os.path.realpath(deploy(src, launch))
    away = os.path.realpath(tempfile.mkdtemp(prefix="outside-", dir=TMP))
    if not with_key:
        s = json.load(open(f"{dst}/.claude/settings.json", encoding="utf-8"))
        s["permissions"].pop(WRITE_KEY, None)
        json.dump(s, open(f"{dst}/.claude/settings.json", "w", encoding="utf-8"))
    args = ["--permission-mode", "dontAsk", "--model", "claude-haiku-5-5", "--setting-sources", "project,local", "--no-session-persistence"]
    init, _, uses, results, _ = control(dst, {}, args, "write", PROMPT_WRITE.format(inside=f"{dst}/f62-in.txt", outside=f"{away}/f62.txt", bash=f"{away}/bash.txt"),
                                        extra=["--allowedTools", "Write", "Bash"], turns=6)
    shot = next((u for u in uses if u["name"] == "Write" and u["input"].get("file_path") == f"{away}/f62.txt"), None)
    return {"inside": os.path.isfile(f"{dst}/f62-in.txt"), "outside": os.path.isfile(f"{away}/f62.txt"), "tried": bool(shot), "refusal": bool(shot) and WRITE_KEY in results.get(shot["id"], ""),
            "bash": os.path.isfile(f"{away}/bash.txt"), "worktree_tools": sum("Worktree" in t for t in init.get("tools", []))}


def worktree_side(src, launch):
    """F6.2: агент isolation: worktree под полем: settings-reference отказывает его правкам, только когда worktree вне рабочих каталогов; здесь он под .claude/worktrees — правка идёт."""
    dst = os.path.realpath(deploy(src, launch))
    os.makedirs(f"{dst}/.claude/workflows", exist_ok=True)
    open(f"{dst}/.claude/workflows/wt-probe.js", "w").write(WF_WORKTREE)
    for a in (["add", "--", ".claude/workflows/wt-probe.js"], ["commit", "-qm", "x"]):
        subprocess.run(["git", "-C", dst, *a], env=GIT_ENV, capture_output=True, check=True)
    _, _, _, _, ev = control(dst, {}, ["--permission-mode", "auto", "--model", "claude-haiku-5-5", "--setting-sources", "project,local", "--no-session-persistence"], "worktree", PROMPT_WF.format("wt-probe"),
                             extra=["--allowedTools", "Workflow(wt-probe)"], env_over={"CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0"})
    status, wf = workflow(ev)
    root = f"{dst}/.claude/worktrees"
    files = [n for n in (os.listdir(root) if os.path.isdir(root) else []) if os.path.isfile(f"{root}/{n}/wt-probe.txt")]
    return status, len(files), any(a.get("isolation") == "worktree" for a in wf.get("workflowProgress", []))


def desktop_write(src, launch):
    additional = additional_dirs(src, launch)
    if additional:  # пара ниже идёт без настроек пользователя, вкладка — с ними
        print(f"HARNESS_WARN write-block-wider additional={additional}", flush=True)
    settings = json.load(open(f"{src}/.claude/settings.json", encoding="utf-8"))
    key = settings.get("permissions", {}).get(WRITE_KEY)
    if not shutil.which("claude"):
        if key is not True:
            return item("HARNESS", "v3.4-F6.2", False, f"permissions.{WRITE_KEY} {key} в {src}/.claude/settings.json")
        return offen("HARNESS", "v3.4-F6.2", f"claude нет в PATH — пары нет; permissions.{WRITE_KEY} {key}")
    off, on = write_side(src, launch, False), write_side(src, launch, True)
    status, files, isolated = worktree_side(src, launch)
    ok = (key is True and off["inside"] and off["outside"] and off["worktree_tools"] > 0
          and on["inside"] and on["tried"] and on["refusal"] and not on["outside"] and on["worktree_tools"] == 0 and status == "completed" and files == 1 and isolated)
    yes = lambda v: "есть" if v else "нет"
    item("HARNESS", "v3.4-F6.2", ok, f"aussen={'verboten' if on['tried'] and not on['outside'] else 'erlaubt'} innen={'OK' if on['inside'] else 'FAIL'} · permissions.{WRITE_KEY} {key} · прокси claude -p, dontAsk, allow Write, без --add-dir и настроек пользователя · "
         f"до поля: файл вне — {yes(off['outside'])}, внутри — {yes(off['inside'])}, инструментов EnterWorktree/ExitWorktree {off['worktree_tools']} · "
         f"с полем: файл вне — {yes(on['outside'])}, попытка — {yes(on['tried'])}, отказ называет поле — {yes(on['refusal'])}, внутри — {yes(on['inside'])}, инструментов worktree {on['worktree_tools']} · "
         f"агент isolation: worktree под полем: воркфлоу {status}, файл под .claude/worktrees — {files}, isolation в журнале — {yes(isolated)} · "
         f"Bash полем не покрыт (settings-reference: команды оболочки поле не ограничивает): файл вне из Bash — до поля {yes(off['bash'])}, с полем {yes(on['bash'])}")


def tab_side(src, launch, name, extra=(), local=True, strip=False, model=None):
    """model — где лежит CLAUDE_CODE_SUBAGENT_MODEL профиля (находка 400): project — в env .claude/settings.json копии, process — в окружении процесса, иначе — в env профиля.
    Прокси вкладки: копия, профиль как .claude/settings.local.json, источники настроек по умолчанию (как у вкладки), auto. Проба effort — свой хук копии (hooks: `effort.level`).
    strip — сторона «до»: профиль без полей F6.3, deny без `Edit(/docs/STATUS.md)`."""
    dst = deploy(src, launch)
    profile = json.load(open(launch, encoding="utf-8"))
    settings = json.load(open(f"{dst}/.claude/settings.json", encoding="utf-8"))
    if strip:
        for k in ("effortLevel", "ultracode"):
            profile.pop(k, None)
        for k in (SUBAGENT_MODEL, SUBAGENT_EFFORT):
            profile.get("env", {}).pop(k, None)
        for cfg in (profile, settings):
            if "deny" in cfg.get("permissions", {}):
                cfg["permissions"]["deny"] = [r for r in cfg["permissions"]["deny"] if r != "Edit(/docs/STATUS.md)"]
    value = profile.get("env", {}).get(SUBAGENT_MODEL) if model else None
    if value:
        profile["env"].pop(SUBAGENT_MODEL)
        if model == "project":
            settings.setdefault("env", {})[SUBAGENT_MODEL] = value
    open(f"{dst}/.claude/hooks/effort-probe.py", "w").write(EFFORT_HOOK)
    probe = {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/effort-probe.py"]}]}
    settings["hooks"].setdefault("PreToolUse", []).append({"matcher": "*", **probe})
    settings["hooks"].setdefault("Stop", []).append(probe)
    json.dump(settings, open(f"{dst}/.claude/settings.json", "w", encoding="utf-8"), ensure_ascii=False)
    json.dump(profile, open(f"{dst}/.claude/{'settings.local.json' if local else 'launch.settings.json'}", "w", encoding="utf-8"), ensure_ascii=False)
    os.makedirs(f"{dst}/docs", exist_ok=True)
    os.makedirs(f"{dst}/kit", exist_ok=True)
    open(f"{dst}/docs/STATUS.md", "w").write("old\n")
    open(f"{dst}/kit/CLAUDE.md", "w").write("old\n")
    init, res, _, _, ev = control(dst, {SUBAGENT_MODEL: value} if model == "process" and value else {}, ["--permission-mode", "auto", "--no-session-persistence", *extra], name, PROMPT_TAB, turns=8)
    log = [json.loads(l) for l in open(f"{dst}/effort.jsonl", encoding="utf-8")] if os.path.isfile(f"{dst}/effort.jsonl") else []
    level = lambda sub: next((r["level"] for r in reversed(log) if r["agent"] == sub), None)
    return {"init": init, "main": level(False), "sub": level(True), "status": open(f"{dst}/docs/STATUS.md", encoding="utf-8").read(), "kit": open(f"{dst}/kit/CLAUDE.md", encoding="utf-8").read(),
            "models": sorted({e["message"].get("model") for e in ev if e.get("type") == "assistant" and e.get("parent_tool_use_id")} - {None}),
            "refused": any("STATUS.md" in json.dumps(d.get("tool_input", {})) for d in res.get("permission_denials") or [])}


def desktop_profile(src, proc, launch):
    S = "HARNESS"
    settings = json.load(open(f"{src}/.claude/settings.json", encoding="utf-8"))
    profile = json.load(open(launch, encoding="utf-8"))
    bad = [f"профиль {launch}: {b}" for b in profile_bad(profile, settings, template=False)]
    tpl = f"{src}/.claude/launch.settings.json"
    if os.path.realpath(tpl) != os.path.realpath(launch):  # в репо кита вкладку ведёт профиль тимлида, шаблон судится отдельно
        bad += [f"шаблон {tpl}: {b}" for b in profile_bad(json.load(open(tpl, encoding="utf-8")), settings)]
    local = f"{os.path.dirname(launch)}/settings.local.json"
    differs, step = tab_profile(local, launch), f"cp {launch} {local}"
    if differs is None:
        print(f"HARNESS_WARN tab-profile profil=fehlt — нет {local}, оператор копирует профиль: {step}", flush=True)
    elif differs:
        bad.append(f"tab-profile: {local} не как {launch}, ключи: {', '.join(differs)}")
    views, kinds = tab_view_probes(), profile_probes()
    if not shutil.which("claude"):
        if bad or not sides_ok(views) or not sides_ok(kinds):
            return item(S, "v3.4-F6.3", False, f"статика: {'; '.join(bad) or 'ok'} · сверка: {sides_text(views)} · поля: {sides_text(kinds)}")
        return offen(S, "v3.4-F6.3", "claude нет в PATH — прокси нет")
    env, files = profile.get("env", {}), tab_profile_probes(src, launch)
    after, before, flag = tab_side(src, launch, "tab-after"), tab_side(src, launch, "tab-before", strip=True), tab_side(src, launch, "tab-flag", ["--settings", ".claude/launch.settings.json"], local=False)
    init = after["init"]
    diff, app, summary = tab_view(table(open(proc, encoding="utf-8").read()), init)
    diff += [] if init.get("permissionMode") == "auto" and init.get("apiKeySource") == "none" else [f"init: permissionMode {init.get('permissionMode')}, apiKeySource {init.get('apiKeySource')}"]
    if after["main"] != profile.get("effortLevel") or before["main"] in (None, profile.get("effortLevel")):
        bad.append(f"effort главной: профиль {profile.get('effortLevel')}, с профилем {after['main']}, без полей {before['main']}")
    if SUBAGENT_EFFORT in env and (after["sub"] != env[SUBAGENT_EFFORT] or before["sub"] in (None, env[SUBAGENT_EFFORT])):
        bad.append(f"effort подагента: {SUBAGENT_EFFORT} {env[SUBAGENT_EFFORT]}, с профилем {after['sub']}, без полей {before['sub']}")
    if flag["models"] != [env.get(SUBAGENT_MODEL)]:
        bad.append(f"{SUBAGENT_MODEL} {env.get(SUBAGENT_MODEL)} через --settings: подагент {flag['models']}")
    if after["models"] != [env.get(SUBAGENT_MODEL)]:
        print(f"HARNESS_WARN subagent-model-local settings.local={','.join(after['models']) or '—'} --settings={','.join(flag['models']) or '—'}", flush=True)
    if env.get(SUBAGENT_MODEL):  # находка 400: env профиля в settings.local и модель подагента — те же прокси, ещё две стороны: env проекта и окружение процесса
        project, process = tab_side(src, launch, "tab-model-project", model="project"), tab_side(src, launch, "tab-model-process", model="process")
        m = lambda s: ",".join(s["models"]) or "—"
        want = env[SUBAGENT_MODEL]
        verdict = "не переключает" if after["models"] != [want] and flag["models"] == [want] else "переключает" if after["models"] == [want] else "не определить: и --settings не переключил"
        print(f"HARNESS_NOTE subagent-model {want}: env в settings.local — {m(after)} (без env — {m(before)}), через --settings — {m(flag)}, "
              f"env в .claude/settings.json проекта — {m(project)}, окружение процесса — {m(process)}: env settings.local {verdict}", flush=True)
    refused, edited, written = after["refused"] and after["status"] == "old\n", "new" in after["kit"] and "old" not in after["kit"], before["status"] != "old\n"
    bad += [] if written else ["без правила Edit(/docs/STATUS.md) файл не записан: отказ — не от правила"]
    ok = not diff and not bad and refused and edited and sides_ok(views) and sides_ok(kinds) and sides_ok(files)
    item(S, "v3.4-F6.3", ok, f"init={'gleich' if not diff else 'иное'} deny={refused + edited}/2 · " + (f"расхождения: {'; '.join(diff)} · " if diff else "")
         + (f"поля: {'; '.join(bad)} · " if bad else "") + f"прокси claude -p с профилем {launch} как settings.local, источники как у вкладки, auto: {summary}; строк таблицы «флаг» не судятся: их замена — ключи профиля · "
         f"effortLevel: до {before['main']}, после {after['main']} · {SUBAGENT_EFFORT} (источник — только changelog 2.1.316): подагент до {before['sub']}, после {after['sub']} (профиль {env.get(SUBAGENT_EFFORT, 'нет')}) · "
         f"{SUBAGENT_MODEL} {env.get(SUBAGENT_MODEL)}: подагент до {','.join(before['models']) or '—'}, через settings.local {','.join(after['models']) or '—'}, через --settings {','.join(flag['models']) or '—'} · "
         f"deny: без правила docs/STATUS.md {'записан' if written else 'цел'}; с правилом {'отказ, файл цел' if refused else 'НЕ отказан'}; kit/CLAUDE.md {'правка' if edited else 'НЕ правлен'} · "
         f"сверка на подставных init: {sides_text(views)} · поля профиля: {sides_text(kinds)} · файл профиля: {sides_text(files)}")
    print(tab_line(app, None if differs is not None else step, additional_dirs(src, launch)), flush=True)


def desktop_probes(src, proc, launch):
    print("вкладка Code и CLI — разные движки: вложенные прогоны идут на CLI из PATH, `claude -p` — прокси вкладки, а не она сама; движок вкладки скрипту виден только именем каталога версии (app= в VERSIONS)", flush=True)
    desktop_versions()
    desktop_write(src, launch)
    desktop_profile(src, proc, launch)
    denied = denied_probes(src)
    n = next(got for name, _, got in denied if name == "журнал трёх входов")
    item("HARNESS", "v3.4-F6.4", sides_ok(denied), f"denials={n.split()[1].rstrip(':')}/3 · входы формы документации hooks, живого отказа нет: событие идёт только на отказ auto mode, не на deny-правило F6.3 · {sides_text(denied)}")


def main():
    global SRC_ARG
    argv = sys.argv[1:]
    if argv == ["--self-test"]:
        ok = self_test()
        print("ENV_SELFTEST_OK" if ok else "ENV_SELFTEST_FAIL")
        return 0 if ok else 1
    desktop = "--desktop" in argv
    argv = [a for a in argv if a != "--desktop"]
    want = [a for a in argv if a in SECTIONS] or ([] if desktop else list(SECTIONS))
    rest = [a for a in argv if a not in SECTIONS]
    SRC_ARG = rest[0] if rest else None
    src, proc, launch = paths()
    print(f"источник харнеса: {src}; строка запуска: {proc}; launch settings: {launch}; разделы: {', '.join(want + ['desktop'] * desktop)}")
    if desktop:
        desktop_probes(src, proc, launch)
    if "env" in want:
        say("ENV", "OK" if self_test() else "FAIL", "self-test", "фикстуры обеих сторон сверки")
        line = static(src, proc, launch)
        ran = False
        if line:
            dst, init = pair(src, proc, launch, *line)
            if init:
                env_probes(src, proc, launch, init, line[1])
                hooks(dst, *line)
                ran = True
            doctor(dst)
        if not ran:  # маркер раздела — только после его проб: статики и self-test мало
            for sec in ("ENV", "HOOKS"):
                say(sec, "FAIL", "probes", "пробы раздела не шли: нет строки запуска или вложенный claude -p не состоялся")
    if "items" in want:
        lenv, args = launch_line(proc)
        gate_settings(src)
        gate34_probes(src, launch)
        items_probes(src, launch)
        if args is None:
            say("GATE_HOOK", "FAIL", "line", f"{proc}: нет строки запуска — живых проб хука нет")
        else:
            gate_probes(src, launch, lenv, args)
    if "session" in want:  # SPEC-v3.5 F2
        session_probes(src, launch)
    if "stop" in want:  # SPEC-v3.5 F3
        stop_probes(src, launch)
    if "commit" in want:
        commit_probes(src)
    if "graph" in want:
        print("\n".join(graph_lines()), flush=True)
    for sec, ss in out.items():
        if "FAIL" in ss or "OFFEN" not in ss:  # offen — маркера нет, код 0
            print(f"{sec}_FAIL" if "FAIL" in ss else f"{sec}_OK")
    return 1 if any("FAIL" in ss for ss in out.values()) else 0


if __name__ == "__main__":
    sys.exit(main())
