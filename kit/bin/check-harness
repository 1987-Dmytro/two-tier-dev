          and tl_add[0] == 1 and "team-lead-files: CLAUDE.md" in tl_add[1] and tl_dir[0] == 1 and "team-lead-files: intent/INTENT.md" in tl_dir[1]
          and tl_nocolon[0] == 1 and "team-lead-files: docs/STATUS.md" in tl_nocolon[1] and tl_prompt[0] == 1 and "team-lead-files: docs/PROMPT.txt" in tl_prompt[1]
