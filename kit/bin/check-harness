    ok = (rc == 0 and sha["F1.1:"] in row and "F1-a-result.txt" in row and "A напечатано" in row and "(1): F1.2" in lists["Пункты без коммитов"]
          and all(sha[k] in lists["Коммиты без пункта"] for k in ("разное", "F1.10:", "F9.9:")) and "(3)" in lists["Коммиты без пункта"] and "(1): F1.2" in lists["Пункты без пробы"]
          and sha["F2.1:"] in next((l for l in rep.splitlines() if l.startswith("| F2.1 |")), ""))
    item(S, "v3.3-F1.4", ok, f"bin/phase-report rc {rc} · строка матрицы «{row[:120]}» · " + " · ".join(f"«{v[:90]}»" for v in lists.values()))
    # F1.5 — STOP только из запушенного HEAD; пропуск хука — строкой с причиной в отчёте фазы
    s1, ts1 = gate_fixture(src, launch, items=True)
    open(f"{s1}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP)
    on_disk = gate_run(s1, ts1, "items-stop")[1]
    for a in (("add", "--", "docs/PROGRESS.md"), ("commit", "-qm", "стоп без push")):
        subprocess.run(["git", *a], cwd=s1, env=GIT_ENV, capture_output=True)
    unpushed = gate_run(s1, ts1, "items-stop-unpushed")[1]
    subprocess.run(["git", "push", "-q", "origin", "phase"], cwd=s1, env=GIT_ENV, capture_output=True)
    rc1, pushed, _, log1, _ = gate_run(s1, ts1, "items-stop")
    s4, ts4 = gate_fixture(src, launch, items=True)
    open(f"{s4}/docs/PROGRESS.md", "a", encoding="utf-8").write("\nSTOP: STOP-INPUT — нужен ключ фикстуры.\n\n\n\nВопрос оператору: выдать ключ?\nResume: «продолжай с F2».\n")
    ship(s4, "стоп с вопросом далеко", "docs/PROGRESS.md")
    far = gate_run(s4, ts4, "items-far")[1]
    s3, ts3 = gate_fixture(src, launch, items=True)
    open(f"{s3}/docs/PROGRESS.md", "a", encoding="utf-8").write("\nSTOP: STOP-INPUT\nВопрос оператору: выдать ключ?\nResume: «продолжай с F2».\n")
    ship(s3, "короткий стоп", "docs/PROGRESS.md")
    short1 = gate_run(s3, ts3, "items-short")[3][-1]
    pg = open(f"{s3}/docs/PROGRESS.md", encoding="utf-8").read().replace("STOP: STOP-INPUT\n", "STOP: STOP-INPUT — снят\n")
    open(f"{s3}/docs/PROGRESS.md", "w", encoding="utf-8").write(pg + "\nSTOP: STOP-INPUT — отказ вложенного claude -p, нужен вход оператора.\nВопрос оператору: запустить снова?\nResume: «продолжай с приёмки».\n")
    ship(s3, "второй стоп", "docs/PROGRESS.md")
    short2 = gate_run(s3, ts3, "items-short")[3][-1]
    s2, ts2 = gate_fixture(src, launch, items=True)
    gate_run(s2, ts2, "items-shadow", env_over={"SPEC_GATE": "shadow"})
    cap = [gate_run(s2, ts2, "items-np")[3][-1] for _ in range(4)][-1]
    rc2, _, rep2 = report_of(s2, src)
    pass_line = next((l for l in rep2.split("## Пропуски spec-gate", 1)[-1].splitlines() if "no-progress" in l), "")
    shadow_line = next((l for l in rep2.split("## Пропуски spec-gate", 1)[-1].splitlines() if "· shadow ·" in l), "")
    ok = (on_disk.get("decision") == "block" and "on disk only" in on_disk.get("reason", "") and rc1 == 0 and "decision" not in pushed
          and unpushed.get("decision") == "block" and "is not pushed" in unpushed.get("reason", "")
          and log1[-1]["decision"] == "stop" and cap["decision"] == "pass" and rc2 == 0 and pass_line and shadow_line
          and short1["decision"] == "stop" and short2["decision"] == "stop" and far.get("decision") == "block" and "no question" in far.get("reason", ""))
    item(S, "v3.3-F1.5", ok, f"STOP только на диске — {on_disk.get('decision')}: «{line_of(on_disk.get('reason', ''), '«STOP')[:110]}»; закоммичен без push — "
         f"{unpushed.get('decision')}: «{line_of(unpushed.get('reason', ''), 'branch')[:60]}»; закоммичен и запушен — "
         f"{log1[-1]['decision']} ({log1[-1]['reason']}); короткая строка «STOP: STOP-INPUT», затем другая того же id — {short1['decision']}, {short2['decision']}; вопрос через четыре строки — {far.get('decision')}; "
         f"один список 4 раза — {cap['decision']} ({cap['reason'][:30]}); отчёт фазы: «{pass_line.strip()[:110]}», блок в тени: «{shadow_line.strip()[:80]}»")
    # F1.6 — Jev в тени: статусы в отчёте; ошибка и таймаут — статус, rc 0; решение хука с Jev и без — одно
    jv = FakeJev()
    key = {"TYPESAFE_API_KEY": "fixture-key", "JEV_LOG": f"{TMP}/items-jev.jsonl"}
    shown = {}
    for mode, extra in (("ok", {}), ("e500", {}), ("hang", {"JEV_TIMEOUT_MS": "1500"})):
        rc, _, rep = report_of(g, src, key | extra | {"TYPESAFE_BASE_URL": f"{jv.url}/{mode}"}, no_jev=False)
        shown[mode] = (rc, [l.split("|")[5].strip() for l in rep.splitlines() if re.match(r"\| F\d\.\d \|", l)])
    jv.close()
    t = time.monotonic()
    a = gate_run(g, transcript_now(os.path.dirname(trg), "new-session-2"), "items-jev-on", env_over={"TYPESAFE_BASE_URL": f"{jv.url}/ok"} | key)[1]
    b = gate_run(g, transcript_now(os.path.dirname(trg), "new-session-3"), "items-jev-off", env_over={"TYPESAFE_API_KEY": None, "TYPESAFE_BASE_URL": "http://127.0.0.1:9"})[1]
    sec = time.monotonic() - t
    st = shown["ok"][1]
    ok = (all(rc == 0 for rc, _ in shown.values()) and st[:3] == ["подтверждает 0.90", "противоречит 0.90", "молчит 0.90"]
          and all(s.startswith("ошибка") and "500" in s for s in shown["e500"][1]) and all(s == "таймаут" for s in shown["hang"][1])
          and a.get("systemMessage", "")[:40] == b.get("systemMessage", "")[:40] and a.get("systemMessage", "").startswith("SPEC_GATE_OK") and sec < 10)
    item(S, "v3.3-F1.6", ok, f"фейковый Jev — статусы {st}; HTTP 500 — rc {shown['e500'][0]}, «{(shown['e500'][1] or ['—'])[0][:50]}»; висит — rc {shown['hang'][0]}, "
         f"«{(shown['hang'][1] or ['—'])[0]}»; хук с Jev — «{short(a)[:50]}», без ключа и с мёртвым адресом — «{short(b)[:50]}», оба за {sec:.1f} с")


RUBRIC_FIXTURE = [  # F2.4: рубрика-фикстура — правило печати ключа фикстуры и правило литерала (копия правила рубрики репо кита 10.10)
    {"id": "no-print-credential", "text": "Code never prints or logs the value of FIXTURE_SECRET, the fixture's credential; reporting its presence or length is fine.",
     "scope": ["**/*"], "when": "edit", "status": "active", "source": {"path": "CLAUDE.md", "line": 1},
     "check": {"type": "model", "question": {"type": "boolean", "instructions": "Does this change print, echo or log the value of the credential FIXTURE_SECRET? Reporting only its presence or length is not a violation.",
                                             "criteria": {"true": "print(os.environ['FIXTURE_SECRET'])", "false": "print('secret set:', 'FIXTURE_SECRET' in os.environ)"}}}},
    {"id": "no-secret-values", "text": "No secret, API key, token or password value appears in any file, log line, evidence file or commit message; credentials are read from the environment only.",
     "scope": ["**/*"], "when": "edit", "status": "active", "source": {"path": "CLAUDE.md", "line": 2},
     "check": {"type": "model", "question": {"type": "boolean", "instructions": "Does this change put a literal secret value (API key, token, password) into a file, log line, evidence file or commit message, instead of reading it from the environment?", "criteria": {"true": "API_KEY = \"sk-live-9f3a…\"", "false": "key = process.env.TYPESAFE_API_KEY"}}}},
]


def rubric_doc(rules):  # форма рубрики, которую читает `abide check`: без compiledAt и sources — «No rubric yet»
    return {"version": 1, "compiledAt": "2026-10-10T00:00:00.000Z", "compiledBy": "check-harness", "sources": [{"path": "CLAUDE.md", "sha": "0" * 64, "scope": "**/*"}], "rules": rules}


def cfix(src, rubric=None):
    """Фикстура суда коммита: repo с хуками кита (core.hooksPath .githooks) и bare origin во /tmp/two-tier-v3."""
    d = tempfile.mkdtemp(prefix="commit-", dir=TMP)
    repo = f"{d}/repo"
    subprocess.run(["git", "init", "-q", "--bare", f"{d}/origin.git"], env=GIT_ENV, check=True)
    os.makedirs(f"{repo}/docs/evidence")
    shutil.copytree(f"{src}/.githooks", f"{repo}/.githooks")
    files = {"budgets.json": json.dumps({"defaults": {"owner": ["docs/STATUS.md", "intent/", "budgets.json", "docs/SPEC-*.md"]}, "project": {"owner_add": ["CLAUDE.md"]}}), "CLAUDE.md": "c\n",
             "docs/STATUS.md": "s\n", "a.txt": "a\n", "README.md": "r\n"}
    if rubric is not None:
        files[".abide/rubric.json"] = json.dumps(rubric_doc(rubric))
    for rel, text in files.items():
        os.makedirs(os.path.dirname(f"{repo}/{rel}") or repo, exist_ok=True)
        open(f"{repo}/{rel}", "w", encoding="utf-8").write(text)
    g = lambda *a: subprocess.run(["git", *a], cwd=repo, env=GIT_ENV, capture_output=True, text=True, check=True)
    g("init", "-q", "-b", "v")
    g("add", "--", ".githooks", *files)
    g("-c", "core.hooksPath=/dev/null", "commit", "-qm", "фикстура")
    g("config", "core.hooksPath", ".githooks")
    g("remote", "add", "origin", f"{d}/origin.git")
    g("-c", "core.hooksPath=/dev/null", "push", "-q", "origin", "v")
    return repo


def gc(repo, *args, env=None, cwd=None):
    """git как исполнитель: (rc, stderr одной строкой)."""
    r = subprocess.run(["git", *args], cwd=cwd or repo, env=GIT_ENV | {"ABIDE_HOME_DIR": f"{TMP}/abide-home"} | (env or {}), capture_output=True, text=True, timeout=120)
    return r.returncode, " ".join((r.stderr or "").split())[:220]


def put(repo, rel, text):
    os.makedirs(os.path.dirname(f"{repo}/{rel}") or repo, exist_ok=True)
    open(f"{repo}/{rel}", "w", encoding="utf-8").write(text)


def abide_p(repo, rel, text, rule):
    """Вероятность правила rule у `abide check` на патче нового файла rel с одной строкой text."""
    d = tempfile.mkdtemp(prefix="abide-sample-", dir=TMP)
    patch = f"{d}/p.patch"
    open(patch, "w", encoding="utf-8").write(f"diff --git a/{rel} b/{rel}\nnew file mode 100644\n--- /dev/null\n+++ b/{rel}\n@@ -0,0 +1 @@\n+{text}\n")
    env = dict(os.environ, ABIDE_HOME_DIR=f"{TMP}/abide-home")
    env.setdefault("TYPESAFE_AI_API_KEY", env.get("TYPESAFE_API_KEY", ""))
    try:
        r = subprocess.run(["abide", "check", "--json", "--phase", "edit", "--diff", patch], cwd=repo, env=env, capture_output=True, text=True, timeout=60)
        data = json.loads(r.stdout)
    except (ValueError, subprocess.TimeoutExpired, FileNotFoundError) as e:
        return None, f"ошибка abide check ({e.__class__.__name__})"
    ps = [v["probability"] for s in data.get("sections", []) for v in s.get("verdicts", []) if v.get("ruleId") == rule]
    return (max(ps) if ps else 0.0), "ok"


def sample_path(scope):
    p = (scope or ["**/*"])[0]
    return "bin/sample.py" if p in ("**/*", "**") else p[:-3] + "/sample.py" if p.endswith("/**") else p.replace("**", "x").replace("*", "x")


def rubric_check(path, limit):
    """F2.5: (ok, строка) — правил не больше limit и красный образец (criteria.true) каждого ≥ 0,8, до 3 прогонов."""
    rules = json.load(open(path, encoding="utf-8")).get("rules", [])
    if len(rules) > limit:
        return False, f"правил {len(rules)} > {limit}: сверх предела — {', '.join(r.get('id', '?') for r in rules[limit:])}", []
    root = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    res = []
    for r in rules:
        sample = ((r.get("check") or {}).get("question") or {}).get("criteria", {}).get("true")
        if not sample:
            res.append((r.get("id"), None, "нет красного образца"))
            continue
        runs = []
        for _ in range(3):
            p, why = abide_p(root, sample_path(r.get("scope")), sample, r.get("id"))
            runs.append(p)
            if p is not None and p >= 0.8:
                break
        res.append((r.get("id"), max([x for x in runs if x is not None], default=None), f"прогонов {len(runs)}"))
    bad = [x for x in res if x[1] is not None and x[1] < 0.8]  # судья ответил: правило своего красного образца не ловит
    unscored = [i for i, p, _ in res if p is None]  # ответа нет (не JSON, таймаут) — калибровка и транспорт, не механизм (решение 397)
    return not bad, (f"правил {len(rules)} ≤ {limit}; " + ", ".join(f"{i} {('%.2f' % p) if p is not None else '—'}" for i, p, _ in res)
                     + (f"; ниже 0,8 — {', '.join(i for i, _, _ in bad)}" if bad else "") + (f"; без оценки — {', '.join(unscored)}" if unscored else "")), unscored


def commit_probes(src):
    S = "COMMIT"
    warns = []  # живой суд abide — калибровка модели (решение 397): COMMIT_WARN с числами, не FAIL
    secret = "sk-" + "proj-" + secrets.token_hex(16)  # литерал собирается здесь: в исходнике чека его нет
    # F2.1 — секрет в любом файле, домашний путь и почта в evidence и сообщении; noreply@ соавтора проходит
    r = cfix(src)
    put(r, "bin/s.py", f"KEY = '{secret}'\n"); gc(r, "add", "--", "bin/s.py")
    lit = gc(r, "commit", "-qm", "F2.1: литерал"); gc(r, "reset", "-q", "--", "bin/s.py"); os.remove(f"{r}/bin/s.py")
    tok = secrets.token_hex(12)
    put(r, "bin/e.py", f"x = '{tok}'\n"); gc(r, "add", "--", "bin/e.py")
    envv = gc(r, "commit", "-qm", "F2.1: значение из окружения", env={"FIXTURE_TOKEN": tok}); gc(r, "reset", "-q", "--", "bin/e.py"); os.remove(f"{r}/bin/e.py")
    put(r, "docs/evidence/F1-x-result.txt", "ran in /Users/" + "alex" + "/kit · rc 0\n"); gc(r, "add", "--", "docs/evidence/F1-x-result.txt")
    home = gc(r, "commit", "-qm", "F2.1: домашний путь")
    gc(r, "reset", "-q", "--", "docs/evidence/F1-x-result.txt")
    put(r, "bin/заметки.py", f"KEY = '{secret}'\n"); gc(r, "add", "--", "bin/заметки.py")
    utf = gc(r, "commit", "-qm", "F2.1: не-ASCII путь"); gc(r, "reset", "-q", "--", "bin/заметки.py"); os.remove(f"{r}/bin/заметки.py")
    open(f"{r}/bin/blob.bin", "wb").write(b"\x00\x01" + f"KEY = '{secret}'\n".encode())
    gc(r, "add", "--", "bin/blob.bin")
    nul = gc(r, "commit", "-qm", "F2.1: бинарный по git"); gc(r, "reset", "-q", "--", "bin/blob.bin"); os.remove(f"{r}/bin/blob.bin")
    gc(r, "add", "--", "docs/evidence/F1-x-result.txt")
    put(r, "docs/evidence/F1-x-result.txt", "rc 0 · X_OK · /tmp/two-tier-v3/x/run1.jsonl\n"); gc(r, "add", "--", "docs/evidence/F1-x-result.txt")
    mail = gc(r, "commit", "-qm", "F2.1: прогнал " + "alex" + "@" + "example.com")
    hashl = gc(r, "commit", "-qm", f"F2.1: чистый\n\n# {secret}")  # строку на «#» git с -m сохраняет
    shapes = {"AKIA": "AKIA" + secrets.token_hex(8).upper(), "ghp_": "ghp" + "_" + secrets.token_hex(18), "github_pat_": "github" + "_pat_" + secrets.token_hex(18),
              "xoxb-": "xox" + "b-" + secrets.token_hex(8), "AIza": "AIza" + secrets.token_hex(18)[:35], "PRIVATE KEY": "-----BEGIN " + "RSA PRIVATE KEY-----",
              "присваивание": "api_key = '" + secrets.token_hex(10) + "'", "KEY=value без кавычек": "API_KEY=" + secrets.token_hex(12),
              "sk_live_": "sk" + "_live_" + secrets.token_hex(12), "строка с «+» в начале": "+" + secret}
    shaped = {}
    for k, v in shapes.items():
        put(r, "bin/shape.py", v + "\n"); gc(r, "add", "--", "bin/shape.py")
        shaped[k] = gc(r, "commit", "-qm", f"F2.1: форма {k}")
        gc(r, "reset", "-q", "--", "bin/shape.py")
    os.remove(f"{r}/bin/shape.py")
