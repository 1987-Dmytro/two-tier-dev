                  "Then reply with the single word done.")
out, seen = {}, {}
GATE_SPEC_ITEMS = """# SPEC-1 — фикстура spec-gate с пунктами

## 2. Фичи
- **F1 Альфа** · оператор получает A · готово: F1.1–F1.2 · чек: `bin/a` → `A_OK` · служит: S1 · after: —
  - `F1.1` `bin/a` печатает A
  - `F1.2` маркер `A_OK` — только после проверок
- **F2 Бета** · оператор получает B · готово: F2.1–F2.2 · чек: `bin/b` → `B_OK` · служит: S1 · after: —
  - `F2.1` `bin/b` печатает B
  - `F2.2` на красном образце `bin/b` — отказ

## 3. Инварианты и границы
- C1: из репо ничего не удаляется · судья: код

## 4. Стопы
- **STOP-SCOPE** — реальная смена объёма.
- **STOP-INPUT** — нужен вход оператора.
- **STOP-NP** — нет прогресса.
"""
EV_ITEMS = {"docs/evidence/F1-a-result.txt": "$ bin/a\nF1.1 rc 0 · A напечатано\nF1.2 rc 0 · A_OK после проверок\nA_OK\n",
            "docs/evidence/F2-b-result.txt": "$ bin/b\nF2.1 rc 0 · B напечатано\nF2.2 красный образец — rc 1, отказ · зелёный — rc 0\nB_OK\n"}
SECTIONS = {"env": ("ENV", "HARNESS", "HOOKS"), "items": ("ITEMS", "GATE_HOOK"), "commit": ("COMMIT",)}
SRC_ARG = None


def item(sec, iid, ok, msg):
    """Строка пункта SPEC: «F<n>.<k> <сырой вывод обеих сторон>», FAIL — сразу после id."""
    out.setdefault(sec, []).append("OK" if ok else "FAIL")
    print(f"{iid} {'' if ok else 'FAIL: '}{' '.join(str(msg).split())}", flush=True)


def gate_settings(src):
    s = json.load(open(f"{src}/.claude/settings.json", encoding="utf-8"))
    stop = [h for g in s.get("hooks", {}).get("Stop", []) for h in g.get("hooks", [])]
    gate = [h for h in stop if h.get("command") == "node" and h.get("args") == ["${CLAUDE_PROJECT_DIR}/.claude/hooks/spec-gate.mjs"]]
    cfg = json.load(open(f"{src}/.claude/spec-gate.json", encoding="utf-8")) if os.path.isfile(f"{src}/.claude/spec-gate.json") else {}
    say("GATE_HOOK", "OK" if gate and os.path.isfile(f"{src}/.claude/hooks/spec-gate.mjs") and cfg.get("mode") in ("off", "shadow", "active") else "FAIL", "settings",
        f"Stop-хук spec-gate (node, exec form): {'есть' if gate else 'нет'}, таймаут {gate[0].get('timeout') if gate else '—'} с; "
        f".claude/spec-gate.json: режим {cfg.get('mode')}, вопросов Jev {len(cfg.get('questions', {}))} (ячейка отчёта, не хука), капы {cfg.get('caps')}")


def transcript_now(d, name):
    p = f"{d}/{name}.jsonl"
    open(p, "w").write(json.dumps({"type": "user", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(time.time() + 2))}) + "\n")
    return p


def line_of(reason, iid):
    return next((l[2:] for l in reason.split("\n") if l.startswith(f"- {iid}")), "нет строки")


class FakeJev:
    """Фейковый TypeSafe на 127.0.0.1 для bin/jev: путь задаёт ответ — /ok (choice по кругу), /e500, /hang."""
    def __init__(self):
        import http.server
        cycle = ["confirms", "contradicts", "silent"]
        class H(http.server.BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass
            def do_POST(self):
                body = json.loads(self.rfile.read(int(self.headers.get("content-length", 0))) or b"{}")
                if self.path.startswith("/hang"):
                    time.sleep(8)
                if self.path.startswith("/e500"):
                    self.send_response(500); self.end_headers(); self.wfile.write(b'{"detail":"fixture 500"}'); return
                ans = {k: {"type": "choice", "choice": cycle[i % 3], "probabilities": {cycle[i % 3]: 0.9}, "confidence": 0.9}
                       for i, k in enumerate(sorted(body.get("questions", {}), key=lambda k: int(k.split(":")[1])))}
                data = json.dumps({"model": body.get("model"), "answers": ans, "usage": {"input_tokens": 10, "output_tokens": 0}}).encode()
                self.send_response(200); self.send_header("content-type", "application/json"); self.end_headers(); self.wfile.write(data)
        class Quiet(http.server.ThreadingHTTPServer):
            def handle_error(self, *a):  # клиент bin/jev ушёл по своему таймауту — это и есть проба, не ошибка
                pass
        self.srv = Quiet(("127.0.0.1", 0), H)
        self.url = f"http://127.0.0.1:{self.srv.server_address[1]}"
        threading.Thread(target=self.srv.serve_forever, daemon=True).start()

    def close(self):
        self.srv.shutdown()


def report_of(repo, src, env_over=None, no_jev=True):
    env = dict(os.environ) | (env_over or {})
    r = subprocess.run([f"{os.path.abspath(src)}/bin/phase-report", *(["--no-jev"] if no_jev else [])], cwd=repo, env=env, capture_output=True, text=True, timeout=120)
    text = open(f"{repo}/docs/evidence/phase-report.md", encoding="utf-8").read() if os.path.isfile(f"{repo}/docs/evidence/phase-report.md") else ""
    return r.returncode, r.stdout.strip(), text


def items_probes(src, launch):
    S = "ITEMS"
    short = lambda res: (res.get("reason") or res.get("systemMessage") or "тишина").replace("\n", " ")[:160]
    g, trg = gate_fixture(src, launch, full=True, items=True)
    full = gate_run(g, trg, "items-full")[1]
    # F1.1 — нет строки пункта при маркере фичи; близнецы id; строка только на диске
    r, tr = gate_fixture(src, launch, full=True, items=True)
    ev = f"{r}/docs/evidence/F2-b-result.txt"
    open(ev, "w", encoding="utf-8").write(EV_ITEMS["docs/evidence/F2-b-result.txt"].replace("F2.2 красный", "проба 2 красный"))
    ship(r, "evidence без строки F2.2", "docs/evidence/F2-b-result.txt")
    miss = gate_run(r, tr, "items-miss")[1]
    open(ev, "w", encoding="utf-8").write(EV_ITEMS["docs/evidence/F2-b-result.txt"].replace("F2.2 красный", "F2.20 rc 0 · x\nxF2.2 красный"))
    ship(r, "близнецы F2.2", "docs/evidence/F2-b-result.txt")
    twin = gate_run(r, tr, "items-twin")[1]
    open(ev, "w", encoding="utf-8").write(EV_ITEMS["docs/evidence/F2-b-result.txt"])
    disk = gate_run(r, tr, "items-disk")[1]
    gap, tg = gate_fixture(src, launch, full=True, items=True, spec=GATE_SPEC_ITEMS.replace("  - `F2.2`", "\n  - `F2.2`"))
    open(f"{gap}/docs/evidence/F2-b-result.txt", "w", encoding="utf-8").write(EV_ITEMS["docs/evidence/F2-b-result.txt"].replace("F2.2 красный", "проба 2 красный"))
    ship(gap, "evidence без строки F2.2", "docs/evidence/F2-b-result.txt")
    blank = gate_run(gap, tg, "items-gap")[1]
    rm, rt, rd = miss.get("reason", ""), twin.get("reason", ""), disk.get("reason", "")
    ok = (full.get("systemMessage", "").startswith("SPEC_GATE_OK") and "items 4" in full["systemMessage"]
          and miss.get("decision") == "block" and "- F2.2:" in rm and "- F2.1:" not in rm and "- F1." not in rm
          and twin.get("decision") == "block" and "- F2.2:" in rt and disk.get("decision") == "block" and "on disk only" in line_of(rd, "F2.2")
          and blank.get("decision") == "block" and "- F2.2:" in blank.get("reason", ""))
    item(S, "F1.1", ok, f"нет строки F2.2 при маркере B_OK — {miss.get('decision')}: «{line_of(rm, 'F2.2')}»; близнецы F2.20 и xF2.2 — {twin.get('decision')}: "
         f"«{line_of(rt, 'F2.2')[:60]}»; строка F2.2 только на диске — {disk.get('decision')}: «{line_of(rd, 'F2.2')}»; пустая строка перед F2.2 в SPEC — "
         f"{blank.get('decision')}: «{line_of(blank.get('reason', ''), 'F2.2')[:60]}»; все строки в HEAD — «{short(full)}»")
    # F1.2 — полный комплект; новая сессия на закрытой фазе; голова не переписана за фазу; сессия с коммитом без новой головы
    closed = gate_run(g, transcript_now(os.path.dirname(trg), "new-session"), "items-closed-new")[1]
    c1, tc1 = gate_fixture(src, launch, full=True, items=True, fresh_head=False)
    never = gate_run(c1, transcript_now(os.path.dirname(tc1), "new-session"), "items-never")[1]
    c2, tc2 = gate_fixture(src, launch, full=True, items=True, fresh_head=False)
    open(f"{c2}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n## Notes\n- строка заметок.\n")
    ship(c2, "заметки в сессии", "docs/PROGRESS.md")
    stale = gate_run(c2, tc2, "items-stale")[1]
    ok = (full.get("systemMessage", "").startswith("SPEC_GATE_OK") and closed.get("systemMessage", "").startswith("SPEC_GATE_OK")
          and never.get("decision") == "block" and "not updated in this phase" in never.get("reason", "")
          and stale.get("decision") == "block" and "not updated in this session" in stale.get("reason", ""))
    item(S, "F1.2", ok, f"полный комплект — «{short(full)}»; новая сессия на закрытой фазе без коммитов — «{short(closed)}»; "
         f"голова не переписана с коммита запроса — {never.get('decision')}: «{line_of(never.get('reason', ''), 'the head')}»; "
         f"сессия закоммитила заметки без новой головы — {stale.get('decision')}: «{line_of(stale.get('reason', ''), 'the head')}»")
    # F1.3 — правила SPEC в bin/check-budget: место чтения пункта, судья строки §3, блок фичи
    d = tempfile.mkdtemp(prefix="items-budget-", dir=TMP)
    os.makedirs(f"{d}/bin"); os.makedirs(f"{d}/intent"); os.makedirs(f"{d}/docs")
    shutil.copy(f"{src}/bin/check-budget", f"{d}/bin/check-budget")
    shutil.copy(f"{src}/budgets.json", f"{d}/budgets.json")
    open(f"{d}/intent/INTENT.md", "w", encoding="utf-8").write("**S1** — фикстура\n")
    open(f"{d}/docs/PROMPT.txt", "w", encoding="utf-8").write("Read first: docs/SPEC-1.md\n")
    pin = subprocess.run(["git", "hash-object", f"{d}/intent/INTENT.md"], capture_output=True, text=True).stdout.strip()[:12]
    def budget(it="  - `F9.1` `bin/x` печатает X", s3="- C1: из репо ничего не удаляется · судья: код", rng=False):
        open(f"{d}/docs/SPEC-1.md", "w", encoding="utf-8").write(
            f"**intent:** `intent/INTENT.md @ {pin}`\n\n## 2. Фичи\n- **F9 Фикстура** · оператор получает X · готово: {'F9.1–F9.2' if rng else 'F9.1'} · чек: `bin/x` → `X_OK` · служит: S1 · after: —\n"
            f"{it}\n\n## 3. Инварианты и границы\n{s3}\n- Вне объёма: перевод проекта.\n\n## 4. Стопы\n")
        o = subprocess.run(["python3", "bin/check-budget"], cwd=d, capture_output=True, text=True).stdout
        return [l for l in o.splitlines() if re.match(r"(OK|FAIL)\s+spec_(items|judges|block_chars)", l)]
    green = budget()
    reds = {"место": budget(it="  - `F9.1` всё работает быстро и надёжно"), "судья": budget(s3="- C1: из репо ничего не удаляется"),
            "блок": budget(it="  - `F9.1` `bin/x` печатает X " + "y" * 900), "диапазон": budget(rng=True),
            "пустой судья": budget(s3="- C1: из репо ничего не удаляется · судья:")}
    want = {"место": ("spec_items", "F9.1"), "судья": ("spec_judges", "C1: из репо"), "блок": ("spec_block_chars", "F9:"), "диапазон": ("spec_items", "без строки пункта — F9.2"), "пустой судья": ("spec_judges", "C1: из репо")}
    hit = {k: next((l for l in ls if l.startswith("FAIL") and want[k][0] in l and want[k][1] in l), None) for k, ls in reds.items()}
    ok = len(green) == 3 and all(l.startswith("OK") for l in green) and all(hit.values())
    sp = lambda l: " ".join((l or "нет FAIL").split())
    item(S, "F1.3", ok, "зелёная SPEC — " + " · ".join(sp(l) for l in green) + " ‖ красные: " + " · ".join(f"{k} — «{sp(v)}»" for k, v in hit.items()))
    # F1.4 — отчёт фазы на фикстуре: матрица и три списка от кода
    p = tempfile.mkdtemp(prefix="items-report-", dir=TMP)
    gx = lambda *a: subprocess.run(["git", *a], cwd=p, env=GIT_ENV, capture_output=True, text=True, check=True)
    def put(rel, text):
        os.makedirs(os.path.dirname(f"{p}/{rel}") or p, exist_ok=True)
        open(f"{p}/{rel}", "w", encoding="utf-8").write(text)
    put("docs/PROMPT.txt", "Read first: docs/SPEC-1.md\n")
    put("docs/SPEC-1.md", GATE_SPEC_ITEMS.replace("  - `F2.2` на красном образце `bin/b` — отказ\n", "").replace("готово: F2.1–F2.2", "готово: F2.1"))
    gx("init", "-q", "-b", "main"); gx("add", "--", "docs/PROMPT.txt", "docs/SPEC-1.md"); gx("commit", "-qm", "Тимлид: SPEC-1"); gx("switch", "-qc", "v")
    put("bin/a", "echo A\n"); gx("add", "--", "bin/a"); gx("commit", "-qm", "F1.1: bin/a печатает A")
    put("notes.txt", "x\n"); gx("add", "--", "notes.txt"); gx("commit", "-qm", "разное без пункта")
    put("typo.txt", "x\n"); gx("add", "--", "typo.txt"); gx("commit", "-qm", "F1.10: опечатка id пункта")
    put("alien.txt", "x\n"); gx("add", "--", "alien.txt"); gx("commit", "-qm", "F9.9: чужой пункт")
    put("docs/evidence/F1-a-result.txt", "F1.1 rc 0 · A напечатано\n"); put("docs/evidence/F2-b-result.txt", "F2.1 rc 0 · B напечатано\n")
    gx("add", "--", "docs/evidence/F1-a-result.txt", "docs/evidence/F2-b-result.txt"); gx("commit", "-qm", "F2.1: evidence")
    sha = {s: gx("log", "--format=%h", f"--grep={s}", "-1").stdout.strip() for s in ("F1.1:", "разное", "F2.1:", "F1.10:", "F9.9:")}
    rc, summary, rep = report_of(p, src)
    row = next((l for l in rep.splitlines() if l.startswith("| F1.1 |")), "")
    lists = {k: next((l for l in rep.splitlines() if l.startswith(f"- **{k}")), "") for k in ("Пункты без коммитов", "Коммиты без пункта", "Пункты без пробы")}
    ok = (rc == 0 and sha["F1.1:"] in row and "F1-a-result.txt" in row and "A напечатано" in row and "(1): F1.2" in lists["Пункты без коммитов"]
          and all(sha[k] in lists["Коммиты без пункта"] for k in ("разное", "F1.10:", "F9.9:")) and "(3)" in lists["Коммиты без пункта"] and "(1): F1.2" in lists["Пункты без пробы"]
          and sha["F2.1:"] in next((l for l in rep.splitlines() if l.startswith("| F2.1 |")), ""))
    item(S, "F1.4", ok, f"bin/phase-report rc {rc} · строка матрицы «{row[:120]}» · " + " · ".join(f"«{v[:90]}»" for v in lists.values()))
    # F1.5 — STOP только из запушенного HEAD; пропуск хука — строкой с причиной в отчёте фазы
    s1, ts1 = gate_fixture(src, launch, items=True)
    open(f"{s1}/docs/PROGRESS.md", "a", encoding="utf-8").write("\n" + GATE_STOP)
