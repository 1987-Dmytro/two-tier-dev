#!/usr/bin/env python3
"""check-fenster [<журнал>] — окно деплоя (SPEC-v3.4 F4.1): каждый `DEPLOY_OK … linie=1` журнала docs/evidence/deploy-window.log закрыт строкой `LIVE_OK` или
`ROLLBACK_OK` до следующего деплоя (один деплой на окно); `linie=0` окна не открывает. Незакрытый — `FENSTER_ROT sha=<sha> — …`, код 1; все закрыты —
`FENSTER_GRUEN деплоев на линию <k>`. Нет журнала — деплоев не было, зелёный. Этот чек зовёт гейт фазы: пункт окна.
"""
import os, sys


def main(argv):
    path = argv[0] if argv else "docs/evidence/deploy-window.log"
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    opened, red, n = None, [], 0
    for line in lines:
        w = line.split()
        if not w:
            continue
        if w[0] == "DEPLOY_OK":
            if opened:
                red.append(opened)
            opened = next((x[4:] for x in w if x.startswith("sha=")), "?") if "linie=1" in w else None
            n += opened is not None
        elif w[0] in ("LIVE_OK", "ROLLBACK_OK"):
            opened = None
    if opened:
        red.append(opened)
    for sha in red:
        print(f"FENSTER_ROT sha={sha} — DEPLOY_OK на линию без LIVE_OK или ROLLBACK_OK после него ({os.path.basename(path)})")
    if red:
        return 1
    print(f"FENSTER_GRUEN деплоев на линию {n}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
