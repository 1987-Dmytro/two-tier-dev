#!/usr/bin/env python3
"""check-window [--override] — окно подписки до запуска плеча (SPEC-v3.3 F5; окно 5 ч снято словом оператора 06.11: тариф его отменил).

Числа: один ход `claude -p` на Haiku во временном каталоге /tmp/two-tier-v3 (без ANTHROPIC_API_KEY, SPEC_GATE=off, 120 с),
последнее событие rate_limit_event с ключом seven_day (нет такого — просто последнее), поле rate_limit_info.unifiedWindows.seven_day (недокументированное — исключение C2): доля 0..1 × 100; другие окна события не судятся.
Порог — budgets.json корня проекта (git toplevel): defaults, в репо кита без ключа — kit/budgets.json, иначе 85;
project только ужесточает. Неделя > window_seven_day_pct — «WINDOW: refuse», rc 1; равно — проходит, «WINDOW: start», rc 0. Числа не сняты — отказ с причиной, rc 1: нет события, нет или пусто поле unifiedWindows, ошибка claude, seven_day без числа.
В unifiedWindows нет ключа seven_day (решение 396, SPEC-v3.4 F5.5: судится одна неделя) — «WINDOW_WARN seven_day=fehlt», неделя не судится, «WINDOW: start», rc 0: тариф уже снимал окно этим способом, и строка запуска падать от этого не должна.
--override — rc 0 всегда, обход печатается. --repair — прежний флаг плеча починки: его порог был у окна 5 ч, теперь без действия; строка запуска проекта с ним не падает. CHECK_WINDOW_EVENTS=<файл> — строки stream-json вместо живого хода
(подставленные значения проб), CHECK_WINDOW_RC — код выхода claude к ним. Данных аккаунта не печатает.
"""
import json, os, re, shutil, subprocess, sys, tempfile, time

KEYS = {"window_seven_day_pct": 85}
CMD = ["claude", "-p", "reply ok", "--model", "claude-haiku-5-5", "--max-turns", "1", "--output-format", "stream-json", "--verbose",
       "--setting-sources", "project,local", "--strict-mcp-config", "--no-chrome", "--no-session-persistence"]


def load(p):
    try:
        with open(p, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def thresholds(top):
    raw = load(f"{top}/budgets.json")
    d, p, kit = raw.get("defaults", {}), raw.get("project") or {}, load(f"{top}/kit/budgets.json").get("defaults", {})
    th, notes = {}, []
    for k, v in KEYS.items():
        th[k] = (d[k], "budgets.json defaults") if k in d else (kit[k], "kit/budgets.json defaults") if k in kit else (v, "встроенный")
        if k in p:
            if type(p[k]) is int and p[k] <= th[k][0]:
                th[k] = (p[k], "budgets.json project")
            else:
                notes.append(f"project.{k}={p[k]!r} ослабляет — взят {th[k][0]} ({th[k][1]})")
    return th, notes


def events():
    f = os.environ.get("CHECK_WINDOW_EVENTS")
    if f:
        with open(f, encoding="utf-8") as fh:
            return fh.read(), int(os.environ.get("CHECK_WINDOW_RC", "0")), "", None
    env = {k: v for k, v in os.environ.items() if k != "ANTHROPIC_API_KEY"}
    env["SPEC_GATE"] = "off"
    os.makedirs("/tmp/two-tier-v3", exist_ok=True)
    d = tempfile.mkdtemp(prefix="check-window-", dir="/tmp/two-tier-v3")  # без настроек и хуков проекта
    try:
        r = subprocess.run(CMD, cwd=d, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        return r.stdout, r.returncode, r.stderr, None
    except FileNotFoundError:
        return "", None, "", "claude нет в PATH"
    except subprocess.TimeoutExpired:
        return "", None, "", "claude не ответил за 120 с"
    finally:
        shutil.rmtree(d, ignore_errors=True)


def clean(s):  # текст ошибки — без почты и домашнего каталога, одной строкой
    s = re.sub(r"\S+@\S+", "<почта>", " ".join(s.split())).replace(os.path.expanduser("~"), "~")
    return s[:160] or "без текста"


def parse(text, rc, err):
    ev, res = None, None
    week_in = lambda e: "seven_day" in (((e.get("rate_limit_info") or {}).get("unifiedWindows")) or {})
    for line in text.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if isinstance(o, dict) and o.get("type") == "rate_limit_event":
            ev = o if ev is None or week_in(o) or not week_in(ev) else ev  # событие без ключа не прячет уже увиденную неделю
        elif isinstance(o, dict) and o.get("type") == "result":
            res = o
    w = ((ev or {}).get("rate_limit_info") or {}).get("unifiedWindows")
    week = (w or {}).get("seven_day")
    if isinstance(week, dict) and isinstance(week.get("utilization"), (int, float)):
        return (round(week["utilization"] * 100, 1), week.get("resetsAt")), None
    if rc or (res or {}).get("is_error"):
        return None, f"ошибка claude (rc {rc}): {clean(str((res or {}).get('result') or err))}"
    if ev is None:
        return None, "нет события rate_limit_event"
    if not w:
        return None, "нет поля unifiedWindows в событии"
    return None, None if "seven_day" not in w else "окно seven_day без числа utilization"  # (None, None) — ключа нет: F5.5


def at(ts):
    if not isinstance(ts, (int, float)):
        return "?"
    t = time.localtime(ts)
    return time.strftime("%H:%M" if t[:3] == time.localtime()[:3] else "%d.%m %H:%M", t)


args = sys.argv[1:]
if set(args) - {"--repair", "--override"}:
    print("usage: check-window [--override]")
    sys.exit(2)
cv = os.path.join(os.path.dirname(os.path.realpath(__file__)), "check-versions")
if os.path.isfile(cv):  # F6.1: версии — до хода, без сети; нет claude или приложения — «—», не отказ
    try:
        print(subprocess.run([sys.executable, cv, "--offline"], capture_output=True, text=True, timeout=30).stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or os.getcwd()
th, notes = thresholds(top)
t7, s7 = th["window_seven_day_pct"]
print(f"порог: неделя {t7} % (window_seven_day_pct, {s7})" + "".join(f" · {n}" for n in notes))
text, rc, err, why = events()
nums, why = parse(text, rc, err) if why is None else (None, why)
if nums:
    p7, r7 = nums
    print(f"неделя {p7:g} % (порог {t7} %, сброс {at(r7)})")
    why = f"неделя {p7:g} % > {t7} % — ждать сброса до {at(r7)}" if p7 > t7 else None
elif why:
    why = f"окна не сняты: {why}"
else:
    print("WINDOW_WARN seven_day=fehlt — неделя не судится")
if "--override" in args:
    print(f"WINDOW: обход флагом --override — {'был бы отказ: ' + why if why else 'был бы старт'}")
    sys.exit(0)
print(f"WINDOW: refuse — {why}" if why else "WINDOW: start")
sys.exit(1 if why else 0)
