def f81_log(cl):
    """Что не так с записью v3.4 текста CHANGELOG cl: список строк с именем; пусто — запись полна."""
    if not re.search(r"^## v3\.4 — \d{4}-\d{2}-\d{2} — ", cl, re.M) or cl.find("\n## v3.4") > cl.find("\n## v3.3"):
        return ["нет записи «## v3.4 — <дата> — …» над v3.3"]
    e, un = entry(cl, "v3.4", "v3.3"), cl.split("\n## v3.4", 1)[0]
    rows5 = [[c.strip() for c in r.strip().strip("|").split("|")] for r in e.splitlines() if r.startswith("| ") and r.count("|") >= 6]
    rows2 = [[c.strip() for c in r.strip().strip("|").split("|")] for r in e.splitlines() if r.startswith("|") and r.count("|") == 3]
    good = lambda c: "https://" in c[2] and all(x not in ("", "—", "-") for x in c[3:5])
    bad = [f"поле {f}" for f in FIELDS34 if not any(f in c[0] and good(c) for c in rows5)]
    opens = lambda c: re.search(r"https://[^)\s]*#", c[2]) or "измерено" in c[2] or "Source sweep" in c[2]  # источник открывается: якорь, сверка или своя проба (чтение F8.1)
    bad += [f"источник без якоря {f}" for f in FIELDS34 if any(f in c[0] and good(c) and not opens(c) for c in rows5)]
    bad += [] if any("CLAUDE_CODE_SUBAGENT_EFFORT" in c[0] and "changelog only" in c[2] for c in rows5) else ["CLAUDE_CODE_SUBAGENT_EFFORT без «changelog only»"]
    bad += [f"снятое {r}" for r in RETIRED34 if not any(l.startswith("  - ") and f"`{r}`" in l and " — " in l for l in e.splitlines())]
    bad += [f"вошло без вышло {i}" for i in IN34 if not any(i in c[0] and c[1] not in ("", "—", "-") for c in rows2)]
    bad += [f"не в записи {m}" for m in MOVED34 if m not in e or m in un]
    bad += [f"мод {m} без строк validate" for m in ("window-guard", "phase-start") if not re.search(MOD_LINES.format(m=re.escape(m)), e + "\n")]
    bad += [] if "WINDOW_WARN seven_day=fehlt" in entry(cl, "v3.3", "v3.2") else ["строка долга v3.3 о пропавшем поле без случая ключа"]
    return bad


def f81_doc(doc, text):
    """Слов фазы нет и мёртвые ссылки документа: список; пусто — документ годен."""
    return [f"{doc}: {w}" for w in NEED81[doc] if w not in text] + [f"{doc}: мёртвая {d}" for d in links_paths(doc, text)[2]]


g34 = f81_log(CL)
g_docs = {d: f81_doc(d, read(d)) for d in NEED81}
n_docs = (not g34) + sum(not v for v in g_docs.values())


def drop(text, pred):
    return "\n".join(l for l in text.split("\n") if not pred(l))


r_field = f81_log(drop(CL, lambda l: l.startswith("| ") and "PermissionDenied" in l.split("|")[1]))
r_anchor = f81_log(re.sub(r"^\| workflow `args`.*$", lambda m: re.sub(r"#[\w-]+", "", m[0]), CL, flags=re.M))
r_ret = f81_log(drop(CL, lambda l: l.startswith("  - `P1-4`")))
r_out = f81_log(re.sub(r"^(\| lint `risk-tier`[^|]*\|)[^|]*\|$", r"\1 — |", CL, flags=re.M))
r_mod = f81_log(CL.replace("- `phase-start` 0.1.0 (`mods/phase-start`), «Validation passed»:", "- phase-start, «Validation passed»:"))
r_word = f81_doc("docs/LAUNCH.md", read("docs/LAUNCH.md").replace("blockWritesOutsideWorkingDirectories", "поле записи"))
r_dead = f81_doc("README.md", rd + "\n[пропавший](docs/no-such-file.md)\n")
item("F8.1", n_docs == 4 and not g34,
     f"docs={n_docs} · CHANGELOG: полей с источником и до/после {len(FIELDS34)}, снятых строкой {len(RETIRED34)}, вошло → вышло {len(IN34)}, строки Unreleased и моды в записи; "
     f"README.md, docs/LAUNCH.md, docs/dev-system.ru.md: слов фазы {sum(map(len, NEED81.values()))}; расхождения — {'; '.join(g34 + [x for v in g_docs.values() for x in v]) or 'нет'}",
     "поле PermissionDenied" in r_field and "источник без якоря {features, prior}" in r_anchor and "снятое P1-4" in r_ret and "вошло без вышло risk-tier" in r_out and "не в записи `phase-start` 0.1.0" in r_mod
     and r_word == ["docs/LAUNCH.md: blockWritesOutsideWorkingDirectories"] and r_dead == ["README.md: мёртвая docs/no-such-file.md"],
     f"без строки поля — {'; '.join(r_field)}; источник без якоря — {'; '.join(r_anchor)}; без строки снятого — {'; '.join(r_ret)}; без ячейки «вышло» — {'; '.join(r_out)}; без блока мода — {'; '.join(r_mod)}; "
     f"LAUNCH без поля — {'; '.join(r_word)}; README с мёртвой ссылкой — {'; '.join(r_dead)}")



def new_hooks(settings, log):
    """(хуки .mjs настроек вне списка v3.2, те из них без строки таблицы текста log: имя в первой ячейке, https-источник)."""
    rows = [[c.strip() for c in r.strip().strip("|").split("|")] for r in log.splitlines() if r.startswith("| ") and r.count("|") >= 6]
    new = sorted(set(re.findall(r"[\w-]+\.mjs", json.dumps(settings.get("hooks", {})))) - set(need32))
    return new, [h for h in new if not any(h in c[0] and "https://" in c[2] for c in rows)]


s34 = json.loads(read("kit/.claude/settings.json"))
