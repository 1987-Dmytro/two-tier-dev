           f"({'; '.join(sorted({DELTAS82[k] for k in t_seen}))}); только в ките — строка звена вендора; (ae)–(ah) в PROCESS telefon и в шаблоне кита — {4 - len(t_letters)}/4")
    r_tel = f82_spec("\n".join(l for l in kit_spec.splitlines() if not l.startswith("- Фаза доводки")), read(f"{TELEFON}/{SPEC_T}"))[0]
