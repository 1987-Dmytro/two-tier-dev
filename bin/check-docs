def f82_spec(kit_text, tel_text):
    """SPEC §2–§5: (строки telefon без пары в ките, названные дельты, строк telefon). Строка дельты годна, только если в ките есть строка с тем же началом."""
    sec = lambda text, n: next(iter(re.findall(rf"^## {n}\b.*?(?=^## |\Z)", text, re.M | re.S)), "")
    miss, seen, n = [], set(), 0
    for s in (2, 3, 4, 5):
        kit_lines = set(sec(kit_text, s).splitlines())
        for line in filter(str.strip, sec(tel_text, s).splitlines()):
            n += 1
            key = next((k for k in DELTAS82 if line.startswith(k)), None)
            if line in kit_lines:
                continue
            if key and any(x.startswith(key) for x in kit_lines):
                seen.add(key)
            else:
                miss.append(line[:60])
    return miss, seen, n


kit_spec, kit_proc = read(f"kit/{SPEC_T}"), read(f"kit/{PROC_T}")
