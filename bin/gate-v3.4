#!/usr/bin/env bash
# gate-v3.4 — гейт кита v3.4 (SPEC-v3.4 F7.4, F8.5). Без ветки — GATE_SKIP, rc 0: чеки кита ждут ветку, красный там был бы ложным (K80).
# Тело гейта — маркеры F1–F7 и v3.3 — ставит F8.5; до него хвост красный: зелёным случайно не станет. bin/verify-phase берёт этот файл
# гейтом фазы из docs/PROMPT.txt: rc 1 круга не держит, строк фич в логе нет — проверяющие гоняют чеки сами.
set -uo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)
if ! git -C "$REPO" symbolic-ref -q HEAD >/dev/null; then
  echo "GATE_SKIP reason=detached sha=$(git -C "$REPO" rev-parse --short=7 HEAD)"
  exit 0
fi
echo "gate-v3.4: ветка $(git -C "$REPO" branch --show-current), HEAD $(git -C "$REPO" rev-parse --short=7 HEAD)"

# заглушка до F8.5
echo "GATE_FAIL reason=stub — тела гейта ещё нет (F8.5)"
exit 1
