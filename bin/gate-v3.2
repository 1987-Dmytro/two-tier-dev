#!/usr/bin/env bash
# gate-v3.2 — гейт кита v3.2 (SPEC-v3.2 F10): кит на пустом репо (свой t3 во /tmp/two-tier-v3), маркеры F1–F9 фазы с номером
# фичи, уцелевшие маркеры v3.1 (HARNESS_OK, HOOKS_OK, VERIFY_OK, KIT_OK, OWNER_OK), затем «F10 GATE_OK».
# t3: bin/jev, check-harness, check-budget (шаблоны, владение), check-kit; корень ветки: check-harness, check-budget --templates
# (кит без схемы GOAL), check-kit (мод handoff), check-verify, check-spend, check-docs, two-tier-upgrade --self-test. Долгие чеки идут параллельно. Подготовка строки запуска
# шаблона — скилл graphify для --add-dir /tmp/two-tier-v3/skills (так её делает оператор перед запуском).
# В репо ничего не пишет, кроме журнала расхода bin/jev и check-ui: полные логи — свой каталог /tmp/two-tier-v3/gate32-*, в вывод —
# команда, итог и строки FAIL/WARN/BAD.
set -uo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p /tmp/two-tier-v3/skills/.claude/skills
[ -d ~/.claude/skills/graphify ] && ln -sfn ~/.claude/skills/graphify /tmp/two-tier-v3/skills/.claude/skills/graphify
T3=$(mktemp -d /tmp/two-tier-v3/t32-XXXXXX)
LOGS=$(mktemp -d /tmp/two-tier-v3/gate32-XXXXXX)
git init -q "$T3"
echo "F10: bin/two-tier-init t3 — файлов кита $("$REPO/bin/two-tier-init" "$T3" | grep -c 'wrote:'); логи — ${LOGS}"

run() {  # run <имя> <каталог> <команда…>: лог и код выхода в $LOGS
  local name=$1 dir=$2; shift 2
  ( cd "$dir" && "$@" ) > "$LOGS/$name.log" 2>&1
  echo $? > "$LOGS/$name.rc"
  echo "$name: ($([ "$dir" = "$T3" ] && echo t3 || echo корень ветки)) $* — rc $(cat "$LOGS/$name.rc")"
}
run harness-t3 "$T3" bin/check-harness &
run harness-repo "$REPO" bin/check-harness &
run verify "$REPO" bin/check-verify &
run init "$T3" bin/check-budget
run jev "$T3" bin/jev --self-test
run templates "$T3" bin/check-budget --templates
run templates-repo "$REPO" bin/check-budget --templates
run owner "$T3" bin/check-budget --self-test intent owner
run kit-t3 "$T3" bin/check-kit
run kit-repo "$REPO" bin/check-kit
run upgrade "$REPO" bin/two-tier-upgrade --self-test
run spend "$REPO" bin/check-spend
run docs "$REPO" bin/check-docs
wait

fails=0
mark() {  # mark <F> <маркер> <лог…>: в каждом логе rc 0 и строка, равная маркеру
  local f=$1 m=$2 why="" l rc; shift 2
  for l in "$@"; do
    grep -E '^(FAIL|WARN|BAD)' "$LOGS/$l.log" | sed "s/^/    $l: /"
    rc=$(cat "$LOGS/$l.rc")
    grep -qx "$m" "$LOGS/$l.log" || why="$why${why:+; }$l: нет $m"
    [ "$rc" = 0 ] || why="$why${why:+; }$l: rc $rc"
  done
  if [ -z "$why" ]; then echo "$f $m"; else echo "$f FAIL: $m — $why"; fails=$((fails + 1)); fi
}
mark F10-init BUDGET_OK init
mark F1 JEV_OK jev
mark F2 GATE_HOOK_OK harness-t3 harness-repo
mark F3 ABIDE_OK harness-t3 harness-repo
mark F4 ENV_OK harness-t3 harness-repo
mark F5 TOOLGATE_OK harness-t3 harness-repo
mark F6 HANDOFF_OK kit-repo
mark F7 BUDGET_OK templates templates-repo
mark F7 UPGRADE_OK upgrade
mark F8 SPEND_OK spend
mark F9 DOCS_OK docs
mark v3.1 HARNESS_OK harness-t3 harness-repo
mark v3.1 HOOKS_OK harness-t3 harness-repo
mark v3.1 VERIFY_OK verify
mark v3.1 KIT_OK kit-t3 kit-repo
mark v3.1 OWNER_OK owner
[ "$fails" -eq 0 ] && echo "F10 GATE_OK" && echo GATE_OK || { echo "GATE_FAIL: $fails"; exit 1; }
