#!/usr/bin/env bash
# gate-v3.3 — гейт кита v3.3 (SPEC-v3.3 F7): кит на пустом репо (свой t3 во /tmp/two-tier-v3 от bin/two-tier-init), маркеры F1–F6 фазы
# с номером фичи, уцелевшие маркеры v3.2 (JEV_OK, GATE_HOOK_OK, HARNESS_OK, HOOKS_OK, KIT_OK, HANDOFF_OK, OWNER_OK, BUDGET_OK, SPEND_OK,
# UPGRADE_OK), строки F7.1–F7.3, затем «F7 GATE_OK». F7.3 — два своих проекта от bin/two-tier-init (f73-*): суд коммита по базе
# рубрики кита и без неё, сверка базы с рубрикой корня.
# t3: check-harness items · commit · env, check-kit, bin/jev, check-budget (шаблоны, владение); корень ветки: check-kit (мод handoff),
# check-verify, check-docs, check-spend, check-budget --templates, two-tier-upgrade --self-test (киты v3.1 и v3.2 — в истории репо).
# Долгие чеки идут параллельно. Подготовка строки запуска шаблона — скилл graphify для --add-dir /tmp/two-tier-v3/skills (так её
# делает оператор перед запуском). В репо ничего не пишет, кроме журналов (jev.jsonl): полные логи — свой каталог
# /tmp/two-tier-v3/gate33-*, в вывод — команда, итог и строки FAIL/WARN/BAD.
set -uo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p /tmp/two-tier-v3/skills/.claude/skills
[ -d ~/.claude/skills/graphify ] && ln -sfn ~/.claude/skills/graphify /tmp/two-tier-v3/skills/.claude/skills/graphify
T3=$(mktemp -d /tmp/two-tier-v3/t33-XXXXXX)
LOGS=$(mktemp -d /tmp/two-tier-v3/gate33-XXXXXX)
git init -q "$T3"
n=$("$REPO/bin/two-tier-init" "$T3" | grep -c 'wrote:')
m=$(git -C "$REPO" ls-files kit | wc -l | tr -d ' ')  # в проект ложится ровно кит из git: ни кэша, ни чужих файлов
hp=$(git -C "$T3" config --get core.hooksPath || echo нет)
echo "F7: bin/two-tier-init t3 — файлов кита $n (в git $m), core.hooksPath $hp; логи — ${LOGS}"

run() {  # run <имя> <каталог> <команда…>: лог и код выхода в $LOGS
  local name=$1 dir=$2; shift 2
  ( cd "$dir" && "$@" ) > "$LOGS/$name.log" 2>&1
  echo $? > "$LOGS/$name.rc"
  echo "$name: ($([ "$dir" = "$T3" ] && echo t3 || echo корень ветки)) $* — rc $(cat "$LOGS/$name.rc")"
}
run items-t3 "$T3" bin/check-harness items &
run commit-t3 "$T3" bin/check-harness commit &
run env-t3 "$T3" bin/check-harness env &
run verify "$REPO" bin/check-verify &
run upgrade "$REPO" bin/two-tier-upgrade --self-test &
run init "$T3" bin/check-budget
run jev "$T3" bin/jev --self-test
run templates "$T3" bin/check-budget --templates
run templates-repo "$REPO" bin/check-budget --templates
run owner "$T3" bin/check-budget --self-test intent owner
run kit-t3 "$T3" bin/check-kit
run kit-repo "$REPO" bin/check-kit
run spend "$REPO" bin/check-spend
run docs "$REPO" bin/check-docs

# F7.3: проект от bin/two-tier-init без ручных шагов — коммит скрипта, печатающего ключ, отказан abide check с именем правила; скрипт с
# присутствием и длиной ключа проходит, bin/check-budget зелёный. Красная сторона — такой же проект без .abide/rubric.json: суда модели
# нет, bin/check-budget красный с причиной — одним FAIL. База рубрики кита —
# правила корня без привязки (scope, source); красный образец сверки — копия базы с переписанным вопросом и без правила.
P73=$(mktemp -d /tmp/two-tier-v3/f73-XXXXXX)
for p in kit bare; do git init -q "$P73/$p" && "$REPO/bin/two-tier-init" "$P73/$p" >/dev/null; done
rm -f "$P73/bare/.abide/rubric.json"
c73() {  # c73 <проект> <файл> <строка скрипта>: коммит одного нового файла хуками кита — rc, строка хука и запись журнала судей;
  local d=$P73/$1 out rc  # отказан — файл вне индекса
  mkdir -p "$d/$(dirname "$2")" && printf '#!/usr/bin/env bash\n%s\n' "$3" > "$d/$2"
  git -C "$d" add -- "$2"
  out=$(cd "$d" && git -c user.name=gate -c user.email=gate@example.invalid commit -qm "F7.3: $2" 2>&1); rc=$?
  [ "$rc" = 0 ] || git -C "$d" rm -q --cached -- "$2"
  echo "rc $rc «$(grep -m1 -E '^(commit refused|abide check|commit-msg hook)' <<<"$out" | cut -c1-100)» журнал: $(python3 -c 'import json, sys
l = json.loads(open(sys.argv[1]).read().splitlines()[-1]); print(l["decision"], l["judge"], l.get("rule"), l.get("score"))' "$d/docs/evidence/commit-judge.jsonl" 2>&1 | tail -1)"
}
cmp73() {  # cmp73 <рубрика>: правила — правила рубрики корня без привязки (scope, source); rc 1 — id расхождений
  python3 - "$1" "$REPO/.abide/rubric.json" <<'EOF'
import json, sys
kit, root = ({r["id"]: {k: v for k, v in r.items() if k not in ("scope", "source")} for r in json.load(open(p, encoding="utf-8"))["rules"]} for p in sys.argv[1:])
bad = [i for i in root if kit.get(i) != root[i]] + [i for i in kit if i not in root]
print(f"правил {len(kit)} из {len(root)} корня; " + (f"не как в корне — {', '.join(bad)}" if bad else "id, тексты, вопросы и образцы — как в корне"))
sys.exit(1 if bad else 0)
EOF
}
leak='echo "key: $TYPESAFE_API_KEY"'
k_leak=$(c73 kit tools/show-key.sh "$leak")
k_safe=$(c73 kit tools/key-set.sh '[ -n "$TYPESAFE_API_KEY" ] && echo "key set, length ${#TYPESAFE_API_KEY}"')
b_leak=$(c73 bare tools/show-key.sh "$leak")
bud73() {  # bud73 <проект>: bin/check-budget — rc, строка abide_rules и итог
  local out rc; out=$(cd "$P73/$1" && bin/check-budget 2>&1); rc=$?
  echo "rc $rc «$(grep -m1 abide_rules <<<"$out" | cut -c1-150)» $(tail -1 <<<"$out")"
}
k_bud=$(bud73 kit); b_bud=$(bud73 bare)
python3 -c 'import json, sys; r = json.load(open(sys.argv[1])); r["rules"] = [x for x in r["rules"] if x["id"] != "evidence-anonymized"]
[x["check"]["question"].update(instructions=x["check"]["question"]["instructions"] + " Logging it is fine.") for x in r["rules"] if x["id"] == "no-print-credential"]
json.dump(r, open(sys.argv[2], "w"))' "$P73/kit/.abide/rubric.json" "$P73/reworded.json"
same=$(cmp73 "$P73/kit/.abide/rubric.json"); same_rc=$?
diff73=$(cmp73 "$P73/reworded.json"); diff_rc=$?
scopes=$(python3 -c 'import json, sys; print(", ".join("%s %s" % (r["id"], " ".join(r["scope"])) for r in json.load(open(sys.argv[1]))["rules"]))' "$P73/kit/.abide/rubric.json")
wait

fails=0
mark() {  # mark <F> <маркер> <лог…>: в каждом логе rc 0 и строка, равная маркеру
  local f=$1 m=$2 why="" l rc; shift 2
  for l in "$@"; do
    grep -E '^(F[0-9]+\.[0-9]+ FAIL|FAIL|WARN|BAD)' "$LOGS/$l.log" | sed "s/^/    $l: /"
    rc=$(cat "$LOGS/$l.rc")
    grep -qx "$m" "$LOGS/$l.log" || why="$why${why:+; }$l: нет $m"
    [ "$rc" = 0 ] || why="$why${why:+; }$l: rc $rc"
  done
  if [ -z "$why" ]; then echo "$f $m"; else echo "$f FAIL: $m — $why"; fails=$((fails + 1)); fi
}
# красный образец самой разметки: лог без маркера и с rc 1 — FAIL, гейт его не пропускает
printf 'OK   x\n' > "$LOGS/red-sample.log"; echo 1 > "$LOGS/red-sample.rc"
red=$(fails=0; mark F0 RED_OK red-sample 2>&1 | tail -1)

mark F7-init BUDGET_OK init
mark F1 ITEMS_OK items-t3
mark F2 COMMIT_OK commit-t3
mark F3 ENV_OK env-t3
mark F4 VERIFY_OK verify
mark F5 WINDOW_OK kit-t3 kit-repo
mark F6 DOCS_OK docs
f16=$fails
mark v3.2 JEV_OK jev
mark v3.2 GATE_HOOK_OK items-t3
mark v3.2 HARNESS_OK env-t3
mark v3.2 HOOKS_OK env-t3
mark v3.2 KIT_OK kit-t3 kit-repo
mark v3.2 HANDOFF_OK kit-repo
mark v3.2 OWNER_OK owner
mark v3.2 BUDGET_OK templates templates-repo
mark v3.2 SPEND_OK spend
mark v3.2 UPGRADE_OK upgrade
f72=$((fails - f16))
[ "$n" = "$m" ] || { echo "F7 FAIL: two-tier-init положил файлов $n, в git кита $m"; fails=$((fails + 1)); }
[ "$hp" = .githooks ] || { echo "F7 FAIL: core.hooksPath проекта — $hp, ждём .githooks"; fails=$((fails + 1)); }
arch=$([ -f "$REPO/docs/archive/gate-v3.2/gate-v3.2" ] && [ ! -e "$REPO/bin/gate-v3.2" ] && echo "в docs/archive/gate-v3.2/" || echo "НЕ в архиве")
f71=$([ "$f16" -eq 0 ] && [ "$n" = "$m" ] && [ "$hp" = .githooks ] && [[ $red == *FAIL* ]] && echo ok)
echo "F7.1 $([ -n "$f71" ] || echo 'FAIL: ')проект t3 от bin/two-tier-init: файлов кита $n из $m, core.hooksPath $hp; BUDGET_OK проекта и маркеры F1–F6 с номером фичи — красных $f16; красный образец разметки (лог без маркера, rc 1) — «${red}»"
[ -n "$f71" ] || fails=$((fails + 1))
echo "F7.2 $([ "$f72" -eq 0 ] && [ "$arch" != "НЕ в архиве" ] || echo 'FAIL: ')уцелевшие маркеры v3.2 — 10, красных $f72; bin/gate-v3.2 — $arch"
[ "$f72" -eq 0 ] && [ "$arch" != "НЕ в архиве" ] || fails=$((fails + 1))
f73=$([[ $k_leak == "rc 1 «commit refused once by abide check — rule no-print-credential "* ]] \
  && [[ $k_safe =~ ^rc\ 0\ .*журнал:\ (pass|note)\ abide\ no- ]] \
  && [[ $b_leak == "rc 0 «abide check — skip: no rubric"* ]] && [ "$same_rc" = 0 ] && [ "$diff_rc" = 1 ] \
  && [[ $k_bud == "rc 0 «OK   abide_rules: .abide/rubric.json, правил 4/"*"» BUDGET_OK" ]] \
  && [[ $b_bud == "rc 1 «FAIL abide_rules: нет .abide/rubric.json — abide check в хуке коммита пропускает суд модели"*"» BUDGET_FAIL: 1" ]] \
  && [[ $diff73 == *no-print-credential* && $diff73 == *evidence-anonymized* ]] && echo ok)
echo "F7.3 $([ -n "$f73" ] || echo 'FAIL: ')проект от bin/two-tier-init ($P73/kit), без ручных шагов: печать ключа tools/show-key.sh — $k_leak;" \
  "присутствие и длина ключа tools/key-set.sh — $k_safe; bin/check-budget — $k_bud ‖ без .abide/rubric.json ($P73/bare): печать ключа — $b_leak;" \
  "bin/check-budget — $b_bud ‖ база кита — $same;" \
  "scope — $scopes ‖ копия базы с переписанным вопросом и без правила — $diff73"
[ -n "$f73" ] || fails=$((fails + 1))
[ "$fails" -eq 0 ] && echo "F7 GATE_OK" && echo GATE_OK || { echo "GATE_FAIL: $fails"; exit 1; }
