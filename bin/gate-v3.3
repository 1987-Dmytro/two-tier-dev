#!/usr/bin/env bash
# gate-v3.3 — гейт кита v3.3 (SPEC-v3.3 F7): кит на пустом репо (свой t3 во /tmp/two-tier-v3 от bin/two-tier-init), маркеры F1–F6 фазы
# с номером фичи, уцелевшие маркеры v3.2 (JEV_OK, GATE_HOOK_OK, HARNESS_OK, HOOKS_OK, KIT_OK, HANDOFF_OK, OWNER_OK, BUDGET_OK, SPEND_OK,
# UPGRADE_OK), строки F7.1 и F7.2, затем «F7 GATE_OK».
# t3: check-harness items · commit · env, check-kit, bin/jev, check-budget (шаблоны, владение); корень ветки: check-kit (мод handoff),
# check-verify, check-docs, check-spend, check-budget --templates, two-tier-upgrade --self-test (киты v3.1 и v3.2 — в истории репо).
# Долгие чеки идут параллельно. Подготовка строки запуска шаблона — скилл graphify для --add-dir /tmp/two-tier-v3/skills (так её
# делает оператор перед запуском). В репо ничего не пишет, кроме журналов (jev.jsonl): полные логи — свой каталог
# /tmp/two-tier-v3/gate33-*, в вывод — команда, итог и строки FAIL/WARN/BAD.
set -uo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p /tmp/two-tier-v3/skills/.claude/skills
[ -d ~/.claude/skills/graphify ] && ln -sfn ~/.claude/skills/graphify /tmp/two-tier-v3/skills/.claude/skills/graphify
T3=$(mktemp -d /tmp/two-tier-v3/t33-XXXXXX)
LOGS=$(mktemp -d /tmp/two-tier-v3/gate33-XXXXXX)
git init -q "$T3"
n=$("$REPO/bin/two-tier-init" "$T3" | grep -c 'wrote:')
m=$(git -C "$REPO" ls-files kit | wc -l | tr -d ' ')  # в проект ложится ровно кит из git: ни кэша, ни чужих файлов
hp=$(git -C "$T3" config --get core.hooksPath || echo нет)
echo "F7: bin/two-tier-init t3 — файлов кита $n (в git $m), core.hooksPath $hp; логи — ${LOGS}"

run() {  # run <имя> <каталог> <команда…>: лог и код выхода в $LOGS
  local name=$1 dir=$2; shift 2
  ( cd "$dir" && "$@" ) > "$LOGS/$name.log" 2>&1
  echo $? > "$LOGS/$name.rc"
  echo "$name: ($([ "$dir" = "$T3" ] && echo t3 || echo корень ветки)) $* — rc $(cat "$LOGS/$name.rc")"
}
run items-t3 "$T3" bin/check-harness items &
run commit-t3 "$T3" bin/check-harness commit &
run env-t3 "$T3" bin/check-harness env &
run verify "$REPO" bin/check-verify &
run upgrade "$REPO" bin/two-tier-upgrade --self-test &
run init "$T3" bin/check-budget
run jev "$T3" bin/jev --self-test
run templates "$T3" bin/check-budget --templates
run templates-repo "$REPO" bin/check-budget --templates
run owner "$T3" bin/check-budget --self-test intent owner
run kit-t3 "$T3" bin/check-kit
run kit-repo "$REPO" bin/check-kit
run spend "$REPO" bin/check-spend
run docs "$REPO" bin/check-docs
wait

fails=0
mark() {  # mark <F> <маркер> <лог…>: в каждом логе rc 0 и строка, равная маркеру
  local f=$1 m=$2 why="" l rc; shift 2
  for l in "$@"; do
    grep -E '^(F[0-9]+\.[0-9]+ FAIL|FAIL|WARN|BAD)' "$LOGS/$l.log" | sed "s/^/    $l: /"
    rc=$(cat "$LOGS/$l.rc")
    grep -qx "$m" "$LOGS/$l.log" || why="$why${why:+; }$l: нет $m"
    [ "$rc" = 0 ] || why="$why${why:+; }$l: rc $rc"
  done
  if [ -z "$why" ]; then echo "$f $m"; else echo "$f FAIL: $m — $why"; fails=$((fails + 1)); fi
}
# красный образец самой разметки: лог без маркера и с rc 1 — FAIL, гейт его не пропускает
printf 'OK   x\n' > "$LOGS/red-sample.log"; echo 1 > "$LOGS/red-sample.rc"
red=$(fails=0; mark F0 RED_OK red-sample 2>&1 | tail -1)

mark F7-init BUDGET_OK init
mark F1 ITEMS_OK items-t3
mark F2 COMMIT_OK commit-t3
mark F3 ENV_OK env-t3
mark F4 VERIFY_OK verify
mark F5 WINDOW_OK kit-t3 kit-repo
mark F6 DOCS_OK docs
f16=$fails
mark v3.2 JEV_OK jev
mark v3.2 GATE_HOOK_OK items-t3
mark v3.2 HARNESS_OK env-t3
mark v3.2 HOOKS_OK env-t3
mark v3.2 KIT_OK kit-t3 kit-repo
mark v3.2 HANDOFF_OK kit-repo
mark v3.2 OWNER_OK owner
mark v3.2 BUDGET_OK templates templates-repo
mark v3.2 SPEND_OK spend
mark v3.2 UPGRADE_OK upgrade
f72=$((fails - f16))
[ "$n" = "$m" ] || { echo "F7 FAIL: two-tier-init положил файлов $n, в git кита $m"; fails=$((fails + 1)); }
[ "$hp" = .githooks ] || { echo "F7 FAIL: core.hooksPath проекта — $hp, ждём .githooks"; fails=$((fails + 1)); }
arch=$([ -f "$REPO/docs/archive/gate-v3.2/gate-v3.2" ] && [ ! -e "$REPO/bin/gate-v3.2" ] && echo "в docs/archive/gate-v3.2/" || echo "НЕ в архиве")
f71=$([ "$f16" -eq 0 ] && [ "$n" = "$m" ] && [ "$hp" = .githooks ] && [[ $red == *FAIL* ]] && echo ok)
echo "F7.1 $([ -n "$f71" ] || echo 'FAIL: ')проект t3 от bin/two-tier-init: файлов кита $n из $m, core.hooksPath $hp; BUDGET_OK проекта и маркеры F1–F6 с номером фичи — красных $f16; красный образец разметки (лог без маркера, rc 1) — «${red}»"
[ -n "$f71" ] || fails=$((fails + 1))
echo "F7.2 $([ "$f72" -eq 0 ] && [ "$arch" != "НЕ в архиве" ] || echo 'FAIL: ')уцелевшие маркеры v3.2 — 10, красных $f72; bin/gate-v3.2 — $arch"
[ "$f72" -eq 0 ] && [ "$arch" != "НЕ в архиве" ] || fails=$((fails + 1))
[ "$fails" -eq 0 ] && echo "F7 GATE_OK" && echo GATE_OK || { echo "GATE_FAIL: $fails"; exit 1; }
