#!/usr/bin/env bash
# two-tier-init — развернуть кит two-tier-dev v3 в целевом репозитории.
#
#   bin/two-tier-init <target-dir>
#
# Содержимое kit/ ложится в КОРЕНЬ цели: kit/CLAUDE.md → <target>/CLAUDE.md,
# kit/.claude/ → <target>/.claude/, kit/bin/ → <target>/bin/; вложенного kit/ в цели нет.
# Существующий файл не перезаписывается — печатается «skip (exists)».
# Режимы сохраняются (cp -p): хуки должны остаться исполняемыми. Кэш Python (__pycache__) не копируется.
# Цель должна существовать; git init скрипт не делает и не требует.
set -euo pipefail

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
[ $# -eq 1 ] || usage
case "$1" in -h|--help) usage;; esac

[ -d "$1" ] || { echo "two-tier-init: нет каталога $1" >&2; exit 1; }
TARGET="$(cd "$1" && pwd)"

HERE="$(cd "$(dirname "$0")/.." && pwd)"
KIT="$HERE/kit"
[ -d "$KIT" ] || { echo "two-tier-init: нет $KIT" >&2; exit 1; }

echo "two-tier-dev kit → $TARGET"
cd "$KIT"
find . -name __pycache__ -prune -o -type f -print | LC_ALL=C sort | while IFS= read -r src; do
  rel="${src#./}"
  dst="$TARGET/$rel"
  if [ -e "$dst" ]; then
    echo "  skip (exists): $rel"
    continue
  fi
  mkdir -p "$(dirname "$dst")"
  cp -p "$src" "$dst"
  echo "  wrote: $rel"
done

cat <<'EOF'

Дальше:
  1. Тимлид: intent/INTENT.md, docs/SPEC-1.md, стартовый запрос docs/PROMPT.txt — по шаблонам docs/*.template.*;
     .claude/launch.settings.json — доверенная инфраструктура проекта; коммиты «Тимлид: …».
     .abide/rubric.json — база рубрики кита (четыре правила): по ней abide check судит коммит с первого; правит тимлид.
  2. CLAUDE.md — факты проекта; docs/PROCESS.md — Environment, Деньги, каталог развилок.
  3. bin/check-budget → BUDGET_OK; запуск исполнителя и контрольный прогон — docs/LAUNCH.md.
  Остановить исполнителя: touch AGENT_STOP (снять — rm AGENT_STOP); подсказать — строка в STEER.md.
EOF
# v3.3, F2: судьи коммита кита — хуки git .githooks/ (commit-msg, pre-push); core.hooksPath — локальный конфиг, в клон не едет
if git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$TARGET" config core.hooksPath .githooks
  echo "  core.hooksPath .githooks — судьи коммита кита включены в этом клоне; в другом клоне: git config core.hooksPath .githooks"
else
  echo "  не git-репо: после git init — git config core.hooksPath .githooks (судьи коммита кита)"
fi
echo "  4. Мод handoff (строка таблицы Environment) — оператор ставит его один раз на машину:"
echo "     claude plugin marketplace add \"$HERE/mods\" && claude plugin install handoff@two-tier-mods"
